@{
    ViewData["Title"] = "Sell by Class";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var years = ViewBag.YearList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var classes = ViewBag.ClassList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                  ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var locations = ViewBag.Locations as List<EduCoreDataAccessLayer.Models.ERP.InventoryLocation>
                    ?? new List<EduCoreDataAccessLayer.Models.ERP.InventoryLocation>();
    string schoolName    = ViewBag.SchoolName as string ?? "";      // for the "Items given" slip
    string schoolAddress = ViewBag.SchoolAddress as string ?? "";
    string schoolLogo    = ViewBag.SchoolLogo as string ?? "";
    string receiptFormat = ViewBag.ReceiptFormat as string ?? "A4";
    string givenBy       = User.FindFirst(EduCoreDataAccessLayer.Helpers.Common.SK_UserName)?.Value ?? "";
}

@section PageStyles {
<style>
  .cs-wrap { overflow:auto; max-height:65vh; }
  .cs-table { border-collapse:separate; border-spacing:0; min-width:100%; }
  .cs-table th, .cs-table td { padding:.45rem .6rem; border-bottom:1px solid var(--bs-border-color); text-align:center; white-space:nowrap; vertical-align:middle; }
  .cs-table thead th { position:sticky; top:0; background:var(--bs-tertiary-bg); z-index:2; font-size:.75rem; }
  .cs-table .cs-name { position:sticky; left:0; background:var(--bs-body-bg); text-align:left; z-index:1; }
  .cs-table thead .cs-name { z-index:3; background:var(--bs-tertiary-bg); }
  .cs-yes { color:#16a34a; font-weight:900; font-size:1.05rem; }
  .cs-sub { display:block; font-size:.62rem; color:var(--bs-secondary-color); line-height:1.1; }
  .cs-unpaid { display:block; font-size:.6rem; color:#dc2626; font-weight:700; }
  .cs-table .form-check-input { width:1.2rem; height:1.2rem; cursor:pointer; }
  .cs-size { min-width:72px; }
  .cs-picked { background:#fff7e6 !important; }
  .cs-bar { position:sticky; bottom:0; z-index:4; background:var(--bs-body-bg); border-top:2px solid var(--ec-primary, #ff8a00);
            padding:.65rem .9rem; display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; justify-content:space-between; }
  .cs-bar .cs-total { font-size:1.15rem; font-weight:900; }
  /* phone: a narrow name column (name on two lines, roll only) so 2-3 items fit beside it */
  @@media (max-width:575.98px) {
    .cs-table th, .cs-table td { padding:.4rem .35rem; }
    .cs-table .cs-name { max-width:105px; min-width:105px; white-space:normal; font-size:.8rem; }
    .cs-table .cs-name .fw-semibold { line-height:1.15; }
    .cs-adm { display:none; }
    .cs-size { min-width:58px; padding-left:.35rem; padding-right:1.4rem; }
  }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-group fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Sell by Class</h4>
            <div class="ec-page-subtitle" id="csSubtitle">Pick a class: ✓ already has it — tick what each child takes now</div>
          </div>
        </div>
      </div>
    </div>

    @await Html.PartialAsync("_StudentItemsTabs", "class")

    <div class="ec-card mb-3"><div class="ec-card-body d-flex flex-wrap gap-2 align-items-end">
      <div>
        <label class="form-label mb-1">Session</label>
        <select id="csYear" class="form-select form-select-sm">
          @foreach (var y in years)
          {
              <option value="@y.Text" selected="@y.Selected">@y.Text</option>
          }
        </select>
      </div>
      <div>
        <label class="form-label mb-1">Class</label>
        <select id="csClass" class="form-select form-select-sm">
          <option value="">Choose class</option>
          @foreach (var c in classes)
          {
              <option value="@c.Text">@c.Text</option>
          }
        </select>
      </div>
      <div>
        <label class="form-label mb-1">Section</label>
        <select id="csSec" class="form-select form-select-sm"><option value="">All sections</option></select>
      </div>
      <div class="@(locations.Count > 1 ? "" : "d-none")">
        <label class="form-label mb-1">From store</label>
        <select id="csLoc" class="form-select form-select-sm">
          @foreach (var l in locations)
          {
              <option value="@l.LocationId" selected="@l.IsDefault">@l.LocationName</option>
          }
        </select>
      </div>
      <div>
        <label class="form-label mb-1">Find in class</label>
        <input id="csFind" class="form-control form-control-sm" placeholder="Name, roll or adm. no">
      </div>
      <div class="form-check ms-1 mb-1">
        <input class="form-check-input" type="checkbox" id="csPending">
        <label class="form-check-label small" for="csPending">Only children with something pending</label>
      </div>
    </div></div>

    <div class="ec-card mb-3"><div class="ec-card-body p-0">
      <div id="csBody" class="p-3 text-muted small">Choose a class to see its children.</div>
      <div class="cs-bar d-none" id="csBar">
        <div><span class="text-muted small" id="csCount">Nothing ticked</span> <span class="cs-total ms-2" id="csTotal">₹0.00</span></div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" id="csClear" style="width:auto">Clear</button>
          <button type="button" class="btn btn-sm btn-primary" id="csGive" style="width:auto" disabled><i class="bx bx-check me-1"></i>Give ticked items &amp; add to fee accounts</button>
        </div>
      </div>
    </div></div>

    <div class="ec-card d-none" id="csDoneCard"><div class="ec-card-body">
      <h6 class="mb-2">Just given</h6>
      <div id="csDone"></div>
    </div></div>

    @Html.AntiForgeryToken()
  </div>
</div>

@await Html.PartialAsync("_FeeReceiptModal")

@section PageScripts {
<script src="~/js/fee-receipt.js" asp-append-version="true"></script>
<script>
$(function () {
    var URL = {
        reg:     '@Url.Action("Data", "StoreRegister", new { area = "Inventory" })',
        items:   '@Url.Action("SaleItems", "Inventory", new { area = "Inventory" })',
        sell:    '@Url.Action("Sell", "Inventory", new { area = "Inventory" })',
        secs:    '@Url.Action("PromotionSections", "Student", new { area = "Students" })',
        collect: '@Url.Action("ManageFee", "Fee", new { area = "Fees" })'
    };
    var SCHOOL = { name:    '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(schoolName))',
                   address: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(schoolAddress))',
                   logo:    '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(schoolLogo))' };
    var RECEIPT_FORMAT = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(receiptFormat))';
    var GIVEN_BY = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(givenBy))';

    var reg = null;        // StoreRegister/Data: students, items, held
    var sale = {};         // itemId -> {price, stock, name} from SaleItems (what can be sold now)
    var cols = [];         // [{name, category, items:[itemId]}]
    var picked = {};       // studentId -> {column name -> itemId}
    var slips = {};        // studentId -> the last slip, for its print button
    var loadNo = 0;        // only the latest load is drawn: changing the class loads twice
                           // (all sections, then the section) and the first could land last

    function token() { return $('input[name="__RequestVerificationToken"]').val(); }
    function q() { return { year: $('#csYear').val(), cls: $('#csClass').val(), sec: $('#csSec').val() || '' }; }

    // "Uniform - 28" under the "Uniform" column -> "28"
    function variant(i) { return i.column === i.name ? '' : i.name.substring(i.column.length).replace(/^\s*-\s*/, ''); }

    /* ── load the class: who has what (register) + what can be sold now (price, stock) ── */
    function load() {
        var f = q();
        picked = {};
        $('#csBar').addClass('d-none');
        if (!f.cls) { $('#csBody').html('Choose a class to see its children.'); return; }
        $('#csBody').html('Loading…');
        var mine = ++loadNo;
        $.when($.getJSON(URL.reg, f), $.getJSON(URL.items, { cls: f.cls, location: $('#csLoc').val() || null }))
            .done(function (a, b) {
                if (mine !== loadNo) return;   // a newer load is on its way
                var r = a[0], list = b[0] || [];
                if (!r || !r.success) { $('#csBody').html(''); ecToast('error', (r && r.message) || 'Could not load the class.'); return; }
                reg = r;
                sale = {};
                list.forEach(function (i) { sale[i.id] = i; });
                cols = []; var byCol = {};
                reg.items.forEach(function (i) {
                    if (!byCol[i.column]) { byCol[i.column] = { name: i.column, category: i.category, items: [] }; cols.push(byCol[i.column]); }
                    byCol[i.column].items.push(i);
                });
                $('#csSubtitle').text(f.cls + (f.sec ? ' – ' + f.sec : '') + ' · ' + f.year + ': ✓ already has it — tick what each child takes now');
                render();
            })
            .fail(function () { $('#csBody').html(''); ecToast('error', 'Could not load the class.'); });
    }

    function render() {
        if (!reg.students.length) { $('#csBody').html('No children in this class for that session.'); return; }
        if (!cols.length) { $('#csBody').html('No item is for this class yet. In Inventory › Store, an item "Given to students" shows here when it is for all classes or for this class.'); return; }

        var held = {};
        reg.held.forEach(function (h) { (held[h.s] = held[h.s] || {})[h.i] = h; });
        var find = ($('#csFind').val() || '').toLowerCase().trim();
        var onlyPending = $('#csPending').is(':checked');

        var head = '<tr><th class="cs-name">Student</th>' + cols.map(function (c, ci) {
            var sellable = c.items.filter(function (i) { return sale[i.id]; });
            var price = sellable.length === 1 ? EC.money(sale[sellable[0].id].price) : (sellable.length ? 'sizes' : 'not on sale');
            var all = sellable.length === 1 ? '<div><input type="checkbox" class="form-check-input cs-all mt-1" data-c="' + ci + '" title="Tick for every child who does not have it"></div>' : '';
            return '<th>' + EC.esc(c.name) + '<span class="cs-sub">' + EC.esc(price) + '</span>' + all + '</th>';
        }).join('') + '<th>Pending</th></tr>';

        var shown = 0;
        var rows = reg.students.map(function (s) {
            if (find && (s.name + ' ' + s.roll + ' ' + s.admNo).toLowerCase().indexOf(find) < 0) return '';
            var mine = held[s.id] || {}, pending = 0, unpaid = 0;
            var cells = cols.map(function (c, ci) {
                var got = c.items.filter(function (i) { return mine[i.id] && mine[i.id].qty > 0; });
                if (got.length) {
                    var sub = got.map(function (i) {
                        var v = variant(i), n = mine[i.id].qty;
                        return (v || '') + (n !== 1 ? (v ? ' ' : '') + '×' + EC.num(n) : '');
                    }).filter(Boolean).join(', ');
                    var owed = got.reduce(function (t, i) { return t + (mine[i.id].unpaid || 0); }, 0);
                    unpaid += owed;
                    return '<td><span class="cs-yes">✓</span>' + (sub ? '<span class="cs-sub">' + EC.esc(sub) + '</span>' : '')
                         + (owed > 0 ? '<span class="cs-unpaid">unpaid ' + EC.money(owed) + '</span>' : '') + '</td>';
                }
                pending++;
                var sellable = c.items.filter(function (i) { return sale[i.id]; });
                var mark = (picked[s.id] || {})[c.name];
                if (!sellable.length) return '<td class="text-muted" title="Not on sale now (no price, or not for this class)">—</td>';
                if (sellable.length === 1) {
                    var it = sellable[0], out = sale[it.id].stock <= 0;
                    return '<td class="' + (mark ? 'cs-picked' : '') + '"><input type="checkbox" class="form-check-input cs-tick" data-s="' + s.id + '" data-c="' + ci + '" data-i="' + it.id + '"'
                         + (mark ? ' checked' : '') + (out ? ' disabled title="Out of stock"' : '') + '>'
                         + (out ? '<span class="cs-sub">out of stock</span>' : '') + '</td>';
                }
                // sizes: pick one
                return '<td class="' + (mark ? 'cs-picked' : '') + '"><select class="form-select form-select-sm cs-size" data-s="' + s.id + '" data-c="' + ci + '"><option value="">—</option>'
                     + sellable.map(function (i) {
                         var out = sale[i.id].stock <= 0;
                         return '<option value="' + i.id + '"' + (mark === i.id ? ' selected' : '') + (out ? ' disabled' : '') + '>'
                              + EC.esc(variant(i) || i.name) + (out ? ' (out)' : '') + '</option>';
                       }).join('') + '</select></td>';
            });
            if (onlyPending && !pending) return '';
            shown++;
            return '<tr><td class="cs-name"><div class="fw-semibold">' + EC.esc(s.name) + '</div>'
                 + '<div class="small text-muted">' + (s.roll ? 'Roll ' + EC.esc(s.roll) : '') + '<span class="cs-adm">' + (s.roll ? ' · ' : '') + EC.esc(s.admNo) + '</span>' + (s.sec ? ' · ' + EC.esc(s.sec) : '') + '</div></td>'
                 + cells.join('')
                 + '<td>' + (pending ? '<span class="badge bg-label-danger">' + pending + ' pending</span>' : '<span class="badge bg-label-success">All</span>')
                 + (unpaid > 0 ? '<span class="cs-unpaid">unpaid ' + EC.money(unpaid) + '</span>' : '') + '</td></tr>';
        }).join('');

        $('#csBody').html('<div class="cs-wrap"><table class="cs-table"><thead>' + head + '</thead><tbody>'
            + (shown ? rows : '<tr><td class="cs-name text-muted" colspan="' + (cols.length + 2) + '">' + (find ? 'No child matches "' + EC.esc(find) + '".' : 'Every child has everything.') + '</td></tr>')
            + '</tbody></table></div>');
        $('#csBar').removeClass('d-none');
        total();
    }

    /* ── ticking ── */
    function setPick(sid, colName, itemId) {
        picked[sid] = picked[sid] || {};
        if (itemId) picked[sid][colName] = itemId; else delete picked[sid][colName];
    }
    $('#csBody').on('change', '.cs-tick', function () {
        var c = cols[$(this).data('c')];
        setPick($(this).data('s'), c.name, this.checked ? +$(this).data('i') : null);
        $(this).closest('td').toggleClass('cs-picked', this.checked);
        total();
    });
    $('#csBody').on('change', '.cs-size', function () {
        var c = cols[$(this).data('c')];
        setPick($(this).data('s'), c.name, +$(this).val() || null);
        $(this).closest('td').toggleClass('cs-picked', !!$(this).val());
        total();
    });
    // header tick: every child shown who does not have it yet
    $('#csBody').on('change', '.cs-all', function () {
        var on = this.checked, ci = $(this).data('c');
        $('#csBody .cs-tick[data-c="' + ci + '"]:not(:disabled)').each(function () {
            if (this.checked !== on) { this.checked = on; $(this).trigger('change'); }
        });
    });
    $('#csClear').on('click', function () { picked = {}; render(); });

    // What is ticked, per child, and checked against the stock on hand.
    function selection() {
        var kids = [], count = 0, sum = 0, need = {};
        Object.keys(picked).forEach(function (sid) {
            var lines = Object.keys(picked[sid]).map(function (col) { return picked[sid][col]; });
            if (!lines.length) return;
            kids.push({ id: +sid, lines: lines });
            lines.forEach(function (id) { count++; sum += sale[id].price; need[id] = (need[id] || 0) + 1; });
        });
        var short = Object.keys(need).filter(function (id) { return need[id] > sale[id].stock; })
                          .map(function (id) { return sale[id].name + ' (ticked ' + need[id] + ', in stock ' + EC.num(sale[id].stock) + ')'; });
        return { kids: kids, count: count, sum: sum, short: short };
    }

    function total() {
        var sel = selection();
        $('#csCount').text(sel.count ? sel.count + ' item' + (sel.count === 1 ? '' : 's') + ' for ' + sel.kids.length + ' child' + (sel.kids.length === 1 ? '' : 'ren') : 'Nothing ticked');
        $('#csTotal').text(EC.money(sel.sum));
        $('#csGive').prop('disabled', !sel.count);
        return sel;
    }

    /* ── give: one Sell per child, one after the other ── */
    $('#csGive').on('click', function () {
        var sel = total();
        if (!sel.count) return;
        if (sel.short.length) { ecToast('error', 'Not enough in stock: ' + sel.short.join('; ')); return; }
        var f = q();
        EC.confirm({
            title: 'Give these items?',
            message: sel.count + ' item(s) to ' + sel.kids.length + ' child(ren). ' + EC.money(sel.sum) + ' goes on their fee accounts for ' + f.year + '; parents pay at Collect Fees.',
            okText: 'Give items', danger: false, icon: 'bx-gift'
        }).then(function (ok) {
            if (!ok) return;
            var $btn = $('#csGive'), done = [], failed = [], i = 0;
            var names = {}; reg.students.forEach(function (s) { names[s.id] = s; });
            EC.buttonBusy($btn, 'Giving…');
            function next() {
                if (i >= sel.kids.length) { finish(); return; }
                var k = sel.kids[i++], s = names[k.id];
                $btn.html('Giving… ' + i + ' of ' + sel.kids.length);
                $.ajax({ url: URL.sell, type: 'POST', contentType: 'application/json',
                         headers: { 'RequestVerificationToken': token() },
                         data: JSON.stringify({ studentId: k.id, academicYear: f.year, locationId: $('#csLoc').val() || null,
                                                items: k.lines.map(function (id) { return { itemId: id, qty: 1 }; }) }) })
                    .done(function (r) {
                        if (r && r.success) {
                            slips[k.id] = { student: s.name, admNo: s.admNo, cls: f.cls, sec: s.sec || f.sec, year: f.year, total: r.total,
                                            lines: k.lines.map(function (id) { return { name: sale[id].name, qty: 1, price: sale[id].price }; }) };
                            done.push({ s: s, total: r.total });
                        } else failed.push({ s: s, msg: (r && r.message) || 'Could not give the items.' });
                    })
                    .fail(function (xhr) { failed.push({ s: s, msg: EC.ajaxError(xhr, 'Could not give the items') }); })
                    .always(next);
            }
            function finish() {
                EC.buttonReset($btn);
                $('#csDoneCard').removeClass('d-none');
                $('#csDone').html(done.map(function (d) {
                    return '<div class="d-flex flex-wrap align-items-center gap-2 py-1 border-bottom">'
                         + '<span class="text-success fw-bold">✓</span><b>' + EC.esc(d.s.name) + '</b>'
                         + '<span class="text-muted small">' + EC.esc(d.s.admNo) + '</span>'
                         + '<span class="ms-auto">' + EC.money(d.total) + ' on fee account</span>'
                         + '<a class="btn btn-sm btn-outline-success" style="width:auto" href="' + URL.collect + '?adm=' + encodeURIComponent(d.s.admNo) + '&session=' + encodeURIComponent(f.year) + '">Collect</a>'
                         + '<button type="button" class="btn btn-sm btn-outline-secondary cs-slip" style="width:auto" data-s="' + d.s.id + '"><i class="bx bx-printer me-1"></i>Slip</button></div>';
                }).join('') + failed.map(function (x) {
                    return '<div class="py-1 border-bottom text-danger"><b>✗ ' + EC.esc(x.s.name) + '</b> — ' + EC.esc(x.msg) + '</div>';
                }).join(''));
                if (done.length) ecToast('success', 'Items given to ' + done.length + ' child(ren).');
                if (failed.length) ecToast('error', failed.length + ' could not be given — see the list.');
                load();   // fresh ✓ and stock
            }
            next();
        });
    });

    // the "Items given" slip, the same one Give Items prints
    $('#csDone').on('click', '.cs-slip', function () {
        var d = slips[$(this).data('s')];
        if (!d) return;
        EcReceipt.showItemsGiven({
            school: { name: SCHOOL.name, address: SCHOOL.address, logo: SCHOOL.logo || null },
            format: RECEIPT_FORMAT || 'A4', date: EC.today(), amount: d.total, givenBy: GIVEN_BY,
            student: { name: d.student, admNo: d.admNo, className: d.cls, section: d.sec, session: d.year },
            lines: d.lines
        });
    });

    /* ── filters ── */
    function loadSections() {
        var cls = $('#csClass').val();
        $('#csSec').html('<option value="">All sections</option>');
        if (!cls) { load(); return; }
        $.getJSON(URL.secs, { 'class': cls, year: $('#csYear').val() }).done(function (list) {
            (list || []).forEach(function (name) { $('#csSec').append('<option value="' + EC.esc(name) + '">' + EC.esc(name) + '</option>'); });
        }).always(load);
    }
    $('#csClass, #csYear').on('change', loadSections);
    $('#csSec, #csLoc').on('change', load);
    $('#csFind').on('input', function () { if (reg) render(); });
    $('#csPending').on('change', function () { if (reg) render(); });
});
</script>
}
