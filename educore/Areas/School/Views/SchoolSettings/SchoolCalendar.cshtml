@{
    ViewData["Title"] = "School Calendar";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var canManage = (bool?)ViewBag.CanManage ?? false;   // academics.manage
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/SchoolSettings/SchoolCalendar.css" asp-append-version="true" />
    <style>
        /* events and exams on a day of the month grid */
        .sc-ev { display:block; font-size:.62rem; font-weight:700; line-height:1.25; padding:1px 4px; margin-top:2px;
                 border-radius:4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; cursor:pointer; }
        .sc-ev-PTM { background:#ede9fe; color:#5b21b6; }   .sc-ev-Event { background:#dbeafe; color:#1e40af; }
        .sc-ev-Sports { background:#dcfce7; color:#166534; } .sc-ev-Trip { background:#fef3c7; color:#92400e; }
        .sc-ev-Meeting { background:#e0f2fe; color:#075985; } .sc-ev-Other { background:#f1f5f9; color:#334155; }
        .sc-ev-Exam { background:#fee2e2; color:#991b1b; }
        .sc-ev-more { font-size:.6rem; color:var(--bs-secondary-color); }
        .sc-l-ev { background:#dbeafe; } .sc-l-exam { background:#fee2e2; }
        .ev-row { display:flex; gap:.75rem; align-items:flex-start; padding:.6rem 0; border-bottom:1px solid var(--bs-border-color); cursor:pointer; }
        .ev-row:last-child { border-bottom:0; }
        .ev-date { min-width:64px; font-weight:800; font-size:.8rem; }
        .ev-date small { display:block; font-weight:600; color:var(--bs-secondary-color); }
    </style>
    @if (!canManage)
    {
        @* View-only role (e.g. Teacher): hide the buttons the server would refuse. *@
        <style>
            #btnSaveWeekly, #btnRange, #dmSave, #dmClear, #rmSave, #rmDelete, .js-del,
            #btnAddEvent, #emSave, #emDelete, #dmForm, #dmAddEvent { display: none !important; }
        </style>
    }
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <!-- Header -->
    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
          <div class="ec-page-title-wrap">
            <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
              <i class="bx bx-calendar-event fs-4"></i>
            </div>
            <div>
              <h4 class="ec-page-title mb-1">School Calendar</h4>
              <div class="ec-page-subtitle">Holidays, exams and school events (PTM, functions, trips) in one place — the Smart Bell stays silent on closed days</div>
            </div>
          </div>
          <div class="sc-yearnav">
            <button class="sc-nav-btn" id="yrPrev"><i class="bx bx-chevron-left"></i></button>
            <span class="sc-year" id="yrLabel">—</span>
            <button class="sc-nav-btn" id="yrNext"><i class="bx bx-chevron-right"></i></button>
          </div>
        </div>
      </div>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="sc-card">
          <div class="sc-card-ic sc-ic-red"><i class="bx bx-calendar-star"></i></div>
          <div><div class="sc-card-val" id="cHolidays">—</div><div class="sc-card-lbl">Holidays</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="sc-card">
          <div class="sc-card-ic sc-ic-orange"><i class="bx bx-time-five"></i></div>
          <div><div class="sc-card-val" id="cHalf">—</div><div class="sc-card-lbl">Half Days</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="sc-card">
          <div class="sc-card-ic sc-ic-green"><i class="bx bx-briefcase"></i></div>
          <div><div class="sc-card-val" id="cWorking">—</div><div class="sc-card-lbl">Working Overrides</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="sc-card">
          <div class="sc-card-ic sc-ic-blue"><i class="bx bx-calendar-x"></i></div>
          <div><div class="sc-card-val" id="cWeekly">—</div><div class="sc-card-lbl">Weekly Offs</div></div>
        </div>
      </div>
    </div>

    <!-- Weekly pattern -->
    <div class="ec-card mb-4">
      <div class="ec-card-header">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
          <div class="ec-section-title-wrap">
            <span class="ec-section-icon"><i class="bx bx-repeat"></i></span>
            <div>
              <div class="ec-section-title">Weekly Offs</div>
              <div class="ec-section-subtitle">Days the school is closed every week. A dated entry below always wins over this.</div>
            </div>
          </div>
          <button class="btn btn-primary" id="btnSaveWeekly"><i class="bx bx-save me-1"></i>Save Weekly Offs</button>
        </div>
      </div>
      <div class="ec-card-body pt-2">
        <div class="sc-dow" id="dowPicker"></div>
      </div>
    </div>

    <div class="row g-3">
      <!-- Month grid -->
      <div class="col-12 col-lg-8">
        <div class="ec-card mb-0 h-100">
          <div class="ec-card-header">
            <div class="d-flex justify-content-between align-items-center gap-2">
              <div class="ec-section-title-wrap">
                <span class="ec-section-icon"><i class="bx bx-calendar"></i></span>
                <div>
                  <div class="ec-section-title" id="monLabel">—</div>
                  <div class="ec-section-subtitle">@(canManage ? "Click a date to mark a holiday or add an event; click an event to open it" : "Click a date or an event to see what is on")</div>
                </div>
              </div>
              <div class="sc-yearnav">
                <button class="sc-nav-btn" id="monPrev"><i class="bx bx-chevron-left"></i></button>
                <button class="sc-nav-btn" id="monToday" title="Today"><i class="bx bx-target-lock"></i></button>
                <button class="sc-nav-btn" id="monNext"><i class="bx bx-chevron-right"></i></button>
              </div>
            </div>
          </div>
          <div class="ec-card-body pt-2">
            <div class="sc-grid-head" id="gridHead"></div>
            <div class="sc-grid" id="grid"></div>
            <div class="sc-legend mt-3">
              <span><span class="sc-l-dot sc-l-holiday"></span>Holiday</span>
              <span><span class="sc-l-dot sc-l-half"></span>Half day</span>
              <span><span class="sc-l-dot sc-l-working"></span>Working override</span>
              <span><span class="sc-l-dot sc-l-off"></span>Weekly off</span>
              <span><span class="sc-l-dot sc-l-ev"></span>Event</span>
              <span><span class="sc-l-dot sc-l-exam"></span>Exam</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Entry list -->
      <div class="col-12 col-lg-4">
        <div class="ec-card mb-0 h-100">
          <div class="ec-card-header">
            <div class="d-flex justify-content-between align-items-center gap-2">
              <div class="ec-section-title-wrap">
                <span class="ec-section-icon"><i class="bx bx-list-ul"></i></span>
                <div>
                  <div class="ec-section-title">Dated Entries</div>
                  <div class="ec-section-subtitle" id="listSub">—</div>
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" id="btnRange"><i class="bx bx-calendar-plus me-1"></i>Date range</button>
            </div>
          </div>
          <div class="ec-card-body pt-2">
            <div class="sc-list" id="entryList"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Events & exams of the year -->
    <div class="ec-card mt-4 mb-0">
      <div class="ec-card-header">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <div class="ec-section-title-wrap">
            <span class="ec-section-icon"><i class="bx bx-party"></i></span>
            <div>
              <div class="ec-section-title">Events &amp; Exams</div>
              <div class="ec-section-subtitle" id="evSub">—</div>
            </div>
          </div>
          <button type="button" class="btn btn-sm btn-primary text-nowrap" id="btnAddEvent"><i class="bx bx-plus me-1"></i>Add event</button>
        </div>
      </div>
      <div class="ec-card-body pt-2">
        <div id="eventList"></div>
      </div>
    </div>

    @Html.AntiForgeryToken()
  </div>
</div>

<!-- Event modal: add / edit (or just read, for view-only staff) -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:0;border-radius:20px;overflow:hidden;">
      <div class="ec-card-header d-flex align-items-center justify-content-between p-3 p-lg-4">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-party"></i></span>
          <div>
            <div class="ec-section-title" id="emTitle">Add Event</div>
            <div class="ec-section-subtitle">PTM, annual function, sports day, trip, meeting ...</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="ec-card-body p-3 p-lg-4">
        <div class="row g-3">
          <div class="col-12 col-sm-8">
            <label class="form-label sc-modal-lbl">Name</label>
            <input type="text" class="form-control" id="emName" maxlength="120" placeholder="e.g. PTM - Term 1 / Annual Day">
          </div>
          <div class="col-12 col-sm-4">
            <label class="form-label sc-modal-lbl">Type</label>
            <select class="form-select" id="emType">
              <option value="PTM">PTM</option>
              <option value="Event">Event / Function</option>
              <option value="Sports">Sports</option>
              <option value="Trip">Trip</option>
              <option value="Meeting">Staff meeting</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label sc-modal-lbl">From</label>
            <input type="date" class="form-control" id="emFrom">
          </div>
          <div class="col-6">
            <label class="form-label sc-modal-lbl">To</label>
            <input type="date" class="form-control" id="emTo">
          </div>
          <div class="col-6">
            <label class="form-label sc-modal-lbl">Starts at <span class="text-muted">(optional)</span></label>
            <input type="time" class="form-control" id="emStart">
          </div>
          <div class="col-6">
            <label class="form-label sc-modal-lbl">Ends at <span class="text-muted">(optional)</span></label>
            <input type="time" class="form-control" id="emEnd">
          </div>
          <div class="col-12">
            <label class="form-label sc-modal-lbl">For <span class="text-muted">(optional)</span></label>
            <input type="text" class="form-control" id="emFor" maxlength="120" placeholder="Everyone / Class 1-5 parents / all teachers">
          </div>
          <div class="col-12">
            <label class="form-label sc-modal-lbl">Notes <span class="text-muted">(optional)</span></label>
            <textarea class="form-control" id="emNotes" rows="2" maxlength="1000"></textarea>
          </div>
        </div>
      </div>
      <div class="ec-card-body pt-0 p-3 p-lg-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
        <button type="button" class="btn btn-outline-danger px-3 d-none" id="emDelete"><i class="bx bx-trash me-1"></i>Remove</button>
        <div class="d-flex flex-column flex-sm-row gap-2 ms-sm-auto">
          <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary px-4" id="emSave"><i class="bx bx-check me-1"></i>Save</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Day modal -->
<div class="modal fade" id="dayModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:0;border-radius:20px;overflow:hidden;">
      <div class="ec-card-header d-flex align-items-center justify-content-between p-3 p-lg-4">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-calendar-event"></i></span>
          <div>
            <div class="ec-section-title" id="dmTitle">Mark Day</div>
            <div class="ec-section-subtitle" id="dmDate">—</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="ec-card-body p-3 p-lg-4">
        <div id="dmOn" class="mb-3"></div>
        <button type="button" class="btn btn-sm btn-outline-primary mb-3" id="dmAddEvent"><i class="bx bx-plus me-1"></i>Add an event on this day</button>
        <div class="row g-3" id="dmForm">
          <div class="col-12">
            <label class="form-label sc-modal-lbl">This day is</label>
            <select class="form-select" id="dmType">
              <option value="holiday">Holiday — school closed, no bells</option>
              <option value="half_day">Half day — bells stop at a set time</option>
              <option value="working">Working day — overrides the weekly off</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label sc-modal-lbl">Name</label>
            <input type="text" class="form-control" id="dmName" placeholder="e.g. Diwali / Annual Day">
          </div>
          <div class="col-12 d-none" id="dmEndWrap">
            <label class="form-label sc-modal-lbl">School closes at</label>
            <input type="time" class="form-control" id="dmEnd">
            <div class="sc-hint mt-1">Periods starting after this are skipped; a period running through it ends here.</div>
          </div>
        </div>
      </div>
      <div class="ec-card-body pt-0 p-3 p-lg-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
        <button type="button" class="btn btn-outline-danger px-3 d-none" id="dmClear"><i class="bx bx-trash me-1"></i>Clear</button>
        <div class="d-flex flex-column flex-sm-row gap-2 ms-sm-auto">
          <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary px-4" id="dmSave"><i class="bx bx-check me-1"></i>Save</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Date range modal: one entry per day from..to, or remove every entry in the range -->
<div class="modal fade" id="rangeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:0;border-radius:20px;overflow:hidden;">
      <div class="ec-card-header d-flex align-items-center justify-content-between p-3 p-lg-4">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-calendar-plus"></i></span>
          <div>
            <div class="ec-section-title">Date Range</div>
            <div class="ec-section-subtitle">Mark several days at once, e.g. a vacation week</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="ec-card-body p-3 p-lg-4">
        <div class="row g-3">
          <div class="col-6">
            <label class="form-label sc-modal-lbl">From</label>
            <input type="date" class="form-control" id="rmFrom">
          </div>
          <div class="col-6">
            <label class="form-label sc-modal-lbl">To</label>
            <input type="date" class="form-control" id="rmTo">
          </div>
          <div class="col-12">
            <label class="form-label sc-modal-lbl">These days are</label>
            <select class="form-select" id="rmType">
              <option value="holiday">Holiday — school closed, no bells</option>
              <option value="half_day">Half day — bells stop at a set time</option>
              <option value="working">Working day — overrides the weekly off</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label sc-modal-lbl">Name</label>
            <input type="text" class="form-control" id="rmName" maxlength="100" placeholder="e.g. Diwali Vacation">
          </div>
          <div class="col-12 d-none" id="rmEndWrap">
            <label class="form-label sc-modal-lbl">School closes at</label>
            <input type="time" class="form-control" id="rmEnd" value="12:30">
          </div>
          <div class="col-12">
            <div class="sc-hint">One entry is added per day. Days that already have an entry are left as they are, and a holiday or half-day range skips the weekly offs.</div>
          </div>
        </div>
      </div>
      <div class="ec-card-body pt-0 p-3 p-lg-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
        <button type="button" class="btn btn-outline-danger px-3" id="rmDelete"><i class="bx bx-trash me-1"></i>Remove entries in range</button>
        <div class="d-flex flex-column flex-sm-row gap-2 ms-sm-auto">
          <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary px-4" id="rmSave"><i class="bx bx-check me-1"></i>Add range</button>
        </div>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
(function(){
'use strict';

var DATA_URL   ='@Url.Action("SchoolCalendarData","SchoolSettings",new{area="School"})';
var SAVE_URL   ='@Url.Action("SaveCalendarEntry","SchoolSettings",new{area="School"})';
var DELETE_URL ='@Url.Action("DeleteCalendarEntry","SchoolSettings",new{area="School"})';
var WEEKLY_URL ='@Url.Action("SaveWeeklyOff","SchoolSettings",new{area="School"})';
var RANGE_URL  ='@Url.Action("SaveCalendarRange","SchoolSettings",new{area="School"})';
var RANGE_DELETE_URL='@Url.Action("DeleteCalendarRange","SchoolSettings",new{area="School"})';
var EVENT_SAVE_URL='@Url.Action("SaveSchoolEvent","SchoolSettings",new{area="School"})';
var EVENT_DELETE_URL='@Url.Action("DeleteSchoolEvent","SchoolSettings",new{area="School"})';
var CAN_MANAGE=@(canManage ? "true" : "false");

var DOW=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
var DOW_SHORT=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
var MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];

var today=new Date();
var year=today.getFullYear(), month=today.getMonth();
var WEEKLY=[0], ENTRIES={}, editDate=null;
var EVENTS=[], editEvent=null;     // events + exam periods of the year (from the server)
var TYPE_LABEL={PTM:'PTM', Event:'Event', Sports:'Sports', Trip:'Trip', Meeting:'Staff meeting', Other:'Other', Exam:'Exam'};

function el(id){ return document.getElementById(id); }
function two(n){ return (n<10?'0':'')+n; }
/* Build date keys from parts — never via Date.toISOString, which shifts by timezone. */
function key(y,m,d){ return y+'-'+two(m+1)+'-'+two(d); }
function parseKey(k){ var p=k.split('-'); return {y:+p[0], m:+p[1]-1, d:+p[2]}; }
function fmt12(t){ if(!t) return '—'; var p=String(t).split(':'),h=parseInt(p[0],10),m=p[1]; var ap=h>=12?'PM':'AM'; var hh=h%12||12; return hh+':'+m+' '+ap; }
function longDate(k){ var o=parseKey(k); return DOW[new Date(o.y,o.m,o.d).getDay()]+', '+o.d+' '+MONTHS[o.m]+' '+o.y; }
function token(){ var t=document.querySelector('input[name="__RequestVerificationToken"]'); return t?t.value:''; }
function post(url,payload){
  return $.ajax({ url:url, type:'POST', contentType:'application/json',
    headers:{ 'RequestVerificationToken':token(), 'X-Requested-With':'XMLHttpRequest' },
    data:JSON.stringify(payload) });
}
function typeLabel(t){ return {holiday:'Holiday', half_day:'Half day', working:'Working day'}[t]||t; }

/* ---------------- load ---------------- */
function load(){
  $.getJSON(DATA_URL, {year:year})
    .done(function(res){
      WEEKLY=(res && res.weeklyOffDays) || [];
      ENTRIES={};
      ((res && res.entries)||[]).forEach(function(e){ ENTRIES[e.date]=e; });
      EVENTS=(res && res.events) || [];
      renderAll();
    })
    .fail(function(){ ecToast('error','Could not load the calendar.'); });
}

function renderAll(){ renderDow(); renderCards(); renderMonth(); renderList(); renderEvents(); }

/* events (and exam periods) on one date; keys compare as text (yyyy-MM-dd) */
function eventsOn(k){ return EVENTS.filter(function(v){ return v.startDate<=k && v.endDate>=k; }); }
function eventWhen(v){
  var o=parseKey(v.startDate), t=o.d+' '+MONTHS[o.m].slice(0,3);
  if(v.endDate!==v.startDate){ var e=parseKey(v.endDate); t+=' – '+e.d+' '+MONTHS[e.m].slice(0,3); }
  if(v.startTime) t+=' · '+fmt12(v.startTime)+(v.endTime ? ' – '+fmt12(v.endTime) : '');
  return t;
}

/* ---------------- weekly offs ---------------- */
function renderDow(){
  el('yrLabel').textContent=year;
  el('dowPicker').innerHTML=DOW.map(function(d,i){
    var on=WEEKLY.indexOf(i)>=0;
    return '<button type="button" class="sc-dow-chip'+(on?' on':'')+'" data-d="'+i+'">'
         +   '<i class="bx '+(on?'bx-calendar-x':'bx-calendar-check')+'"></i>'+d
         + '</button>';
  }).join('');
  el('dowPicker').querySelectorAll('.sc-dow-chip').forEach(function(b){
    b.addEventListener('click',function(){
      var d=parseInt(this.dataset.d,10), i=WEEKLY.indexOf(d);
      if(i>=0) WEEKLY.splice(i,1); else WEEKLY.push(d);
      renderDow(); renderCards(); renderMonth();
    });
  });
}

el('btnSaveWeekly').addEventListener('click',function(){
  post(WEEKLY_URL,{days:WEEKLY.slice().sort()})
    .done(function(res){
      if(res && res.success){ ecToast('success',res.message||'Weekly offs saved.'); load(); }
      else ecToast('error',(res&&res.message)||'Save failed.');
    })
    .fail(function(xhr){ ecToast('error', EC.ajaxError(xhr, 'Save failed')); });
});

/* ---------------- summary ---------------- */
function renderCards(){
  var list=Object.keys(ENTRIES).map(function(k){ return ENTRIES[k]; });
  el('cHolidays').textContent=list.filter(function(e){ return e.dayType==='holiday'; }).length;
  el('cHalf').textContent    =list.filter(function(e){ return e.dayType==='half_day'; }).length;
  el('cWorking').textContent =list.filter(function(e){ return e.dayType==='working'; }).length;
  el('cWeekly').textContent  =WEEKLY.length ? WEEKLY.map(function(d){ return DOW_SHORT[d]; }).join(', ') : 'None';
}

/* ---------------- month grid ---------------- */
function renderMonth(){
  el('monLabel').textContent=MONTHS[month]+' '+year;
  el('gridHead').innerHTML=DOW_SHORT.map(function(d){ return '<div>'+d+'</div>'; }).join('');

  var first=new Date(year,month,1).getDay();
  var days=new Date(year,month+1,0).getDate();
  var todayKey=key(today.getFullYear(),today.getMonth(),today.getDate());
  var cells=[];

  for(var i=0;i<first;i++) cells.push('<div class="sc-cell empty"></div>');

  for(var d=1;d<=days;d++){
    var k=key(year,month,d), e=ENTRIES[k], dow=new Date(year,month,d).getDay();
    var cls='sc-cell', badge='';
    if(e){
      cls+=' t-'+e.dayType;
      badge='<span class="sc-cell-tag">'+EC.esc(e.dayType==='half_day' ? fmt12(e.halfDayEnd) : e.title)+'</span>';
    } else if(WEEKLY.indexOf(dow)>=0){
      cls+=' t-weekly';
      badge='<span class="sc-cell-tag">Weekly off</span>';
    }
    if(k===todayKey) cls+=' today';
    var on=eventsOn(k), chips=on.slice(0,2).map(function(v){
      return '<span class="sc-ev sc-ev-'+EC.esc(v.eventType)+'" data-ev="'+EVENTS.indexOf(v)+'" title="'+EC.esc(v.title)+'">'+EC.esc(v.title)+'</span>';
    }).join('') + (on.length>2 ? '<span class="sc-ev-more">+'+(on.length-2)+' more</span>' : '');
    cells.push('<div class="'+cls+'" data-k="'+k+'"><span class="sc-cell-day">'+d+'</span>'+badge+chips+'</div>');
  }

  el('grid').innerHTML=cells.join('');
  el('grid').querySelectorAll('.sc-cell[data-k]').forEach(function(c){
    c.addEventListener('click',function(){ openModal(this.dataset.k); });
  });
  el('grid').querySelectorAll('.sc-ev[data-ev]').forEach(function(c){
    c.addEventListener('click',function(ev){ ev.stopPropagation(); openEvent(EVENTS[+this.dataset.ev]); });
  });
}

el('monPrev').addEventListener('click',function(){
  month--; if(month<0){ month=11; year--; load(); return; }
  renderMonth();
});
el('monNext').addEventListener('click',function(){
  month++; if(month>11){ month=0; year++; load(); return; }
  renderMonth();
});
el('monToday').addEventListener('click',function(){
  var changed=(year!==today.getFullYear());
  year=today.getFullYear(); month=today.getMonth();
  if(changed) load(); else renderMonth();
});
el('yrPrev').addEventListener('click',function(){ year--; load(); });
el('yrNext').addEventListener('click',function(){ year++; load(); });

/* ---------------- entry list ---------------- */
function renderList(){
  var list=Object.keys(ENTRIES).sort().map(function(k){ return ENTRIES[k]; });
  el('listSub').textContent=list.length ? list.length+' entries in '+year : 'Nothing marked in '+year;

  if(!list.length){
    el('entryList').innerHTML='<div class="sc-empty"><i class="bx bx-calendar-x"></i><div>No holidays marked yet.<br>Click a date on the calendar to add one.</div></div>';
    return;
  }

  el('entryList').innerHTML=list.map(function(e){
    var o=parseKey(e.date);
    return '<div class="sc-row t-'+e.dayType+'">'
      +'<div class="sc-row-date"><strong>'+o.d+'</strong><small>'+MONTHS[o.m].slice(0,3)+'</small></div>'
      +'<div class="sc-row-info">'
      +  '<div class="sc-row-name">'+EC.esc(e.title)+'</div>'
      +  '<div class="sc-row-meta">'+typeLabel(e.dayType)
      +    (e.dayType==='half_day' ? ' · closes '+fmt12(e.halfDayEnd) : '')+'</div>'
      +'</div>'
      +'<button class="sc-icon-btn js-del" data-id="'+e.calendarId+'" title="Remove"><i class="bx bx-trash"></i></button>'
      +'</div>';
  }).join('');

  el('entryList').querySelectorAll('.js-del').forEach(function(b){
    b.addEventListener('click',function(){ del(parseInt(this.dataset.id,10)); });
  });
}

function del(id){
  if(!id) return;
  post(DELETE_URL,{id:id})
    .done(function(res){
      if(res && res.success){ ecToast('info',res.message||'Entry removed.'); load(); }
      else ecToast('error',(res&&res.message)||'Could not remove the entry.');
    })
    .fail(function(){ ecToast('error','Could not remove the entry.'); });
}

/* ---------------- modal ---------------- */
function syncEndVisibility(){ el('dmEndWrap').classList.toggle('d-none', el('dmType').value!=='half_day'); }
el('dmType').addEventListener('change', syncEndVisibility);

function openModal(k){
  editDate=k;
  var e=ENTRIES[k];
  el('dmTitle').textContent=!CAN_MANAGE ? 'What is on' : e?'Edit Day':'Mark Day';
  el('dmDate').textContent=longDate(k);
  el('dmType').value=e?e.dayType:'holiday';
  el('dmName').value=e?e.title:'';
  el('dmEnd').value=(e&&e.halfDayEnd)?e.halfDayEnd:'12:30';
  el('dmClear').classList.toggle('d-none', !e);
  el('dmClear').dataset.id=e?e.calendarId:'';
  syncEndVisibility();
  var on=eventsOn(k);
  el('dmOn').innerHTML = (!CAN_MANAGE && e ? '<div class="mb-2"><b>'+typeLabel(e.dayType)+'</b>'+(e.title ? ' · '+EC.esc(e.title) : '')+'</div>' : '')
    + (on.length ? on.map(function(v){
        return '<span class="sc-ev sc-ev-'+EC.esc(v.eventType)+' mb-1" style="font-size:.78rem;padding:4px 8px" data-ev="'+EVENTS.indexOf(v)+'">'
             + EC.esc(TYPE_LABEL[v.eventType]||v.eventType)+': '+EC.esc(v.title)+'</span>';
      }).join('') : (CAN_MANAGE ? '' : '<div class="text-muted small">Nothing on this day.</div>'));
  el('dmOn').querySelectorAll('[data-ev]').forEach(function(c){
    c.addEventListener('click',function(){ bootstrap.Modal.getInstance(el('dayModal')).hide(); openEvent(EVENTS[+this.dataset.ev]); });
  });
  new bootstrap.Modal(el('dayModal')).show();
}

el('dmSave').addEventListener('click',function(){
  var type=el('dmType').value, name=el('dmName').value.trim(), end=el('dmEnd').value;
  if(type==='half_day' && !end){ ecToast('error','Set the closing time for a half day.'); return; }
  /* A working-day override only opens a weekly off; on a normal weekday it changes nothing. */
  var dk=parseKey(editDate);
  if(type==='working' && WEEKLY.indexOf(new Date(dk.y,dk.m,dk.d).getDay())<0){
    ecToast('warning', longDate(editDate)+' is already a working day. A working-day override is only for a weekly off.');
    return;
  }

  post(SAVE_URL,{ date:editDate, dayType:type, title:name, halfDayEnd:(type==='half_day'?end:null) })
    .done(function(res){
      if(res && res.success){
        bootstrap.Modal.getInstance(el('dayModal')).hide();
        ecToast('success',res.message||'Calendar updated.');
        load();
      } else ecToast('error',(res&&res.message)||'Save failed.');
    })
    .fail(function(xhr){ ecToast('error', EC.ajaxError(xhr, 'Save failed')); });
});

el('dmAddEvent').addEventListener('click',function(){
  bootstrap.Modal.getInstance(el('dayModal')).hide();
  openEvent(null, editDate);
});

el('dmClear').addEventListener('click',function(){
  var id=parseInt(this.dataset.id,10);
  bootstrap.Modal.getInstance(el('dayModal')).hide();
  del(id);
});

/* ---------------- date range ---------------- */
el('rmType').addEventListener('change',function(){ el('rmEndWrap').classList.toggle('d-none', this.value!=='half_day'); });

el('btnRange').addEventListener('click',function(){
  /* start on the month on screen */
  var first=key(year,month,1);
  el('rmFrom').value=first; el('rmTo').value=first;
  el('rmType').value='holiday'; el('rmName').value='';
  el('rmEndWrap').classList.add('d-none');
  new bootstrap.Modal(el('rangeModal')).show();
});

function readRange(){
  var from=el('rmFrom').value, to=el('rmTo').value;
  if(!from || !to){ ecToast('error','Pick the first and last date.'); return null; }
  if(to<from){ ecToast('error','The range ends before it starts.'); return null; }
  return {from:from, to:to};
}

el('rmSave').addEventListener('click',function(){
  var r=readRange(); if(!r) return;
  var type=el('rmType').value, end=el('rmEnd').value;
  if(type==='half_day' && !end){ ecToast('error','Set the closing time for a half day.'); return; }
  var $btn=$(this);
  EC.buttonBusy($btn,'Saving…');
  post(RANGE_URL,{ from:r.from, to:r.to, dayType:type, title:el('rmName').value.trim(),
                   halfDayEnd:(type==='half_day'?end:null) })
    .done(function(res){
      if(res && res.success){
        bootstrap.Modal.getInstance(el('rangeModal')).hide();
        ecToast('success',res.message||'Calendar updated.');
        load();
      } else ecToast('error',(res&&res.message)||'Save failed.');
    })
    .fail(function(xhr){ ecToast('error', EC.ajaxError(xhr, 'Save failed')); })
    .always(function(){ EC.buttonReset($btn); });
});

el('rmDelete').addEventListener('click',function(){
  var r=readRange(); if(!r) return;
  /* close the range dialog first: two Bootstrap modals on top of each other strand the backdrop */
  bootstrap.Modal.getInstance(el('rangeModal')).hide();
  EC.confirm({ title:'Remove every entry in this range?',
               name:longDate(r.from)+(r.to!==r.from ? ' – '+longDate(r.to) : ''),
               message:'Holidays, half days and working-day overrides in the range are removed. Those days go back to the weekly pattern.',
               okText:'Remove entries' }).then(function(ok){
    if(!ok) return;
    post(RANGE_DELETE_URL,{ from:r.from, to:r.to })
      .done(function(res){
        if(res && res.success){
          ecToast('info',res.message||'Entries removed.');
          load();
        } else ecToast('error',(res&&res.message)||'Could not remove the entries.');
      })
      .fail(function(xhr){ ecToast('error', EC.ajaxError(xhr, 'Remove failed')); });
  });
});

/* ---------------- events & exams ---------------- */
function renderEvents(){
  var list=EVENTS.slice().sort(function(a,b){ return a.startDate<b.startDate ? -1 : a.startDate>b.startDate ? 1 : 0; });
  var nEv=list.filter(function(v){ return v.kind==='Event'; }).length, nEx=list.length-nEv;
  el('evSub').textContent = list.length ? nEv+' event(s), '+nEx+' exam(s) in '+year : 'Nothing planned in '+year+' yet';
  if(!list.length){
    el('eventList').innerHTML='<div class="sc-empty"><i class="bx bx-party"></i><div>No events or exams in '+year+'.'
      +(CAN_MANAGE ? '<br>Use "Add event" for a PTM, function or trip. Exams appear here from the Exam Schedule.' : '')+'</div></div>';
    return;
  }
  var todayKey=key(today.getFullYear(),today.getMonth(),today.getDate());
  el('eventList').innerHTML=list.map(function(v){
    var past=v.endDate<todayKey;
    return '<div class="ev-row'+(past?' opacity-50':'')+'" data-ev="'+EVENTS.indexOf(v)+'">'
      +'<div class="ev-date">'+EC.esc(eventWhen(v).split(' · ')[0])+(v.startTime ? '<small>'+fmt12(v.startTime)+'</small>' : '')+'</div>'
      +'<div class="flex-grow-1"><div class="fw-semibold">'+EC.esc(v.title)
      +  (v.kind==='Exam' && v.status && v.status!=='Published' ? ' <span class="text-muted small">('+EC.esc(v.status)+')</span>' : '')+'</div>'
      +  '<div class="small text-muted">'+EC.esc(v.forWhom || (v.kind==='Exam' ? '' : 'Everyone'))+'</div></div>'
      +'<span class="sc-ev sc-ev-'+EC.esc(v.eventType)+'" style="font-size:.7rem;padding:2px 8px">'+EC.esc(TYPE_LABEL[v.eventType]||v.eventType)+'</span>'
      +'</div>';
  }).join('');
  el('eventList').querySelectorAll('.ev-row').forEach(function(r){
    r.addEventListener('click',function(){ openEvent(EVENTS[+this.dataset.ev]); });
  });
}

/* An exam is changed on the Exam Schedule, not here: it opens read-only. */
function openEvent(v, onDate){
  if(v && v.kind==='Exam'){
    ecToast('info', v.title+': '+eventWhen(v)+(v.forWhom ? ' · '+v.forWhom : '')+'. Change it on Exams › Exam Schedule.');
    return;
  }
  editEvent=v||null;
  var d=onDate || key(year,month,1);
  el('emTitle').textContent=v ? (CAN_MANAGE ? 'Edit Event' : 'Event') : 'Add Event';
  el('emName').value=v?v.title:'';
  el('emType').value=v?v.eventType:'PTM';
  el('emFrom').value=v?v.startDate:d;
  el('emTo').value=v?v.endDate:d;
  el('emStart').value=v&&v.startTime?v.startTime:'';
  el('emEnd').value=v&&v.endTime?v.endTime:'';
  el('emFor').value=v&&v.forWhom?v.forWhom:'';
  el('emNotes').value=v&&v.notes?v.notes:'';
  el('emDelete').classList.toggle('d-none', !v);
  ['emName','emType','emFrom','emTo','emStart','emEnd','emFor','emNotes'].forEach(function(id){ el(id).disabled=!CAN_MANAGE; });
  new bootstrap.Modal(el('eventModal')).show();
}

el('btnAddEvent').addEventListener('click',function(){ openEvent(null); });
el('emFrom').addEventListener('change',function(){ if(!el('emTo').value || el('emTo').value<this.value) el('emTo').value=this.value; });

el('emSave').addEventListener('click',function(){
  var name=el('emName').value.trim(), from=el('emFrom').value, to=el('emTo').value||from;
  if(!name){ ecToast('error','Give the event a name.'); return; }
  if(!from){ ecToast('error','Pick the date of the event.'); return; }
  if(to<from){ ecToast('error','The event ends before it starts.'); return; }
  var $btn=$(this);
  EC.buttonBusy($btn,'Saving…');
  post(EVENT_SAVE_URL,{ id:editEvent?editEvent.id:0, title:name, eventType:el('emType').value, startDate:from, endDate:to,
                        startTime:el('emStart').value||null, endTime:el('emEnd').value||null,
                        forWhom:el('emFor').value.trim()||null, notes:el('emNotes').value.trim()||null })
    .done(function(res){
      if(res && res.success){
        bootstrap.Modal.getInstance(el('eventModal')).hide();
        ecToast('success',res.message||'Event saved.');
        load();
      } else ecToast('error',(res&&res.message)||'Save failed.');
    })
    .fail(function(xhr){ ecToast('error', EC.ajaxError(xhr, 'Save failed')); })
    .always(function(){ EC.buttonReset($btn); });
});

el('emDelete').addEventListener('click',function(){
  if(!editEvent) return;
  var v=editEvent;
  bootstrap.Modal.getInstance(el('eventModal')).hide();
  EC.confirm({ title:'Remove this event?', name:v.title+' · '+eventWhen(v), okText:'Remove' }).then(function(ok){
    if(!ok) return;
    post(EVENT_DELETE_URL,{ id:v.id })
      .done(function(res){
        if(res && res.success){ ecToast('info',res.message||'Event removed.'); load(); }
        else ecToast('error',(res&&res.message)||'Could not remove the event.');
      })
      .fail(function(xhr){ ecToast('error', EC.ajaxError(xhr, 'Remove failed')); });
  });
});

/* init */
load();

})();
</script>
}
