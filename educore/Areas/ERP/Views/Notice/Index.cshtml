@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Notice Board";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var canManage = (bool?)ViewBag.CanManage ?? false;
    var categories = ViewBag.Categories as string[] ?? Array.Empty<string>();
}

@*
   Notice Board — announcements for the whole school (core.sp_announcement_manage).
   Everyone reads; notices.manage posts / edits / deletes. Opening the board marks
   the notices read ("Seen by"). Parents get a notice as a printed circular or
   through the WhatsApp button.
*@

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Notice/Notice.css" asp-append-version="true" />
}

<div class="ec-page-shell nb-page">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="d-flex align-items-center gap-2">
          <div class="ec-page-icon"><i class="bx bx-broadcast"></i></div>
          <div><h4 class="ec-page-title mb-1">Notice Board</h4>
            <p class="ec-page-subtitle">School announcements, circulars, holidays and events</p></div>
        </div>
        @if (canManage)
        {
            <button id="btnNew" class="btn btn-primary btn-sm"><i class="bx bx-plus me-1"></i>New notice</button>
        }
      </div>
    </div>

    <div class="ec-card mb-3"><div class="ec-card-body nb-tools">
      <div class="nb-chips" id="nbCats">
        <button class="on" data-c="">All</button>
        @foreach (var c in categories)
        {
            <button data-c="@c">@c</button>
        }
      </div>
      <input id="nbSearch" class="form-control form-control-sm" placeholder="Search notices">
    </div></div>

    <div id="nbList"></div>

  </div>
</div>

@if (canManage)
{
<div class="modal fade" id="nbModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="nbModalTitle">New notice</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Title <span class="text-danger">*</span></label>
          <input id="fTitle" class="form-control" maxlength="200" placeholder="e.g. School closed on Monday">
        </div>
        <div class="row g-3 mb-3">
          <div class="col-12 col-md-6">
            <label class="form-label">Category</label>
            <select id="fCategory" class="form-select">
              @foreach (var c in categories)
              {
                  <option value="@c">@c</option>
              }
            </select>
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label">For</label>
            <select id="fAudience" class="form-select">
              <option value="Everyone">Everyone</option>
              <option value="Staff">Staff only</option>
              <option value="Parents">All parents</option>
              <option value="Classes">Parents of selected classes</option>
            </select>
          </div>
        </div>
        <div class="mb-3 d-none" id="fClassWrap">
          <label class="form-label">Classes <span class="text-danger">*</span></label>
          <div id="fClasses" class="nb-classes"></div>
        </div>
        <div class="mb-3">
          <label class="form-label">Message <span class="text-danger">*</span></label>
          <textarea id="fBody" class="form-control" rows="6" maxlength="4000"></textarea>
        </div>
        <div class="row g-3 align-items-end">
          <div class="col-12 col-md-6">
            <label class="form-label">Show until <small class="text-muted">(optional)</small></label>
            <input id="fUntil" type="date" class="form-control">
          </div>
          <div class="col-12 col-md-6">
            <div class="form-check"><input id="fPinned" class="form-check-input" type="checkbox">
              <label class="form-check-label" for="fPinned">Pin to the top</label></div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="btnSave"><i class="bx bx-send me-1"></i>Post notice</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="nbSeenModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Seen by</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="nbSeenList"></div>
    </div>
  </div>
</div>
}

@Html.AntiForgeryToken()

@section PageScripts {
<script>
$(function () {
    'use strict';

    var CSRF = $('input[name="__RequestVerificationToken"]').val();
    var URL = {
        list:    '@Url.Action("List","Notice",new{area="ERP"})',
        save:    '@Url.Action("Save","Notice",new{area="ERP"})',
        del:     '@Url.Action("Delete","Notice",new{area="ERP"})',
        seen:    '@Url.Action("SeenBy","Notice",new{area="ERP"})',
        classes: '@Url.Action("Classes","Notice",new{area="ERP"})',
        print:   '@Url.Action("Print","Notice",new{area="ERP"})'
    };
    var CAN_MANAGE = @(canManage ? "true" : "false");   // notices.manage

    var notices = [];
    var cat = '';
    var editId = 0;

    function load() {
        EC.listLoading('#nbList', 'Loading notices...');
        $.getJSON(URL.list).done(function (rows) {
            notices = rows || [];
            draw();
        }).fail(function () { ecToast('error', 'Could not load the notices.'); });
    }

    function draw() {
        var q = $('#nbSearch').val().trim().toLowerCase();
        var list = notices.filter(function (n) {
            if (cat && n.category !== cat) return false;
            return !q || (n.title + ' ' + n.body).toLowerCase().indexOf(q) >= 0;
        });
        if (!list.length) {
            EC.listEmpty('#nbList', notices.length ? 'No notices match.' : 'No notices yet.', 'bx-broadcast');
            return;
        }
        $('#nbList').html(list.map(card).join(''));
    }

    function card(n) {
        var tags = '<span class="nb-cat c-' + EC.esc(n.category) + '">' + EC.esc(n.category) + '</span>'
                 + (n.pinned ? '<span class="nb-tag pin"><i class="bx bxs-pin"></i> Pinned</span>' : '')
                 + (n.isNew ? '<span class="nb-tag new">New</span>' : '')
                 + (n.expired ? '<span class="nb-tag old">Expired</span>' : '');
        var meta = ['For: ' + n.audienceText, n.posted, n.by ? 'by ' + n.by : '', n.until ? 'until ' + n.until : '']
                   .filter(Boolean).map(EC.esc).join(' · ');
        var acts = '<a class="btn btn-xs ec-btn-soft" target="_blank" href="' + URL.print + '/' + n.id + '"><i class="bx bx-printer me-1"></i>Print</a>'
                 + '<a class="btn btn-xs nb-wa" target="_blank" rel="noopener" href="https://wa.me/?text=' + encodeURIComponent('*' + n.title + '*\n\n' + n.body) + '"><i class="bx bxl-whatsapp me-1"></i>WhatsApp</a>';
        if (CAN_MANAGE) {
            acts += '<button class="btn btn-xs btn-outline-secondary nb-edit" data-id="' + n.id + '"><i class="bx bx-edit-alt me-1"></i>Edit</button>'
                  + '<button class="btn btn-xs btn-outline-danger nb-del" data-id="' + n.id + '"><i class="bx bx-trash"></i></button>'
                  + '<button class="btn btn-xs btn-link nb-seen" data-id="' + n.id + '">Seen by ' + n.seen + ' of ' + n.staff + '</button>';
        }
        return '<div class="ec-card nb-card' + (n.expired ? ' is-old' : '') + '"><div class="nb-bar c-' + EC.esc(n.category) + '"></div><div class="nb-in">'
             + '<div class="nb-tags">' + tags + '</div>'
             + '<div class="nb-title">' + EC.esc(n.title) + '</div>'
             + '<div class="nb-body">' + EC.esc(n.body) + '</div>'
             + '<div class="nb-meta">' + meta + '</div>'
             + '<div class="nb-acts">' + acts + '</div></div></div>';
    }

    $('#nbCats').on('click', 'button', function () {
        $('#nbCats button').removeClass('on'); $(this).addClass('on');
        cat = $(this).data('c'); draw();
    });
    $('#nbSearch').on('input', draw);

    // ── posting / editing (notices.manage) ─────────────────────────────
    var classesLoaded = false;
    function loadClasses(selected) {
        function tick() {
            $('#fClasses input').each(function () { this.checked = selected.indexOf(this.value) >= 0; });
        }
        if (classesLoaded) { tick(); return; }
        $.getJSON(URL.classes).done(function (names) {
            classesLoaded = true;
            $('#fClasses').html((names || []).map(function (c) {
                return '<label class="nb-class"><input type="checkbox" value="' + EC.esc(c) + '"> ' + EC.esc(c) + '</label>';
            }).join('') || '<span class="text-muted">No classes set up yet.</span>');
            tick();
        });
    }

    function openForm(n) {
        editId = n ? n.id : 0;
        $('#nbModalTitle').text(n ? 'Edit notice' : 'New notice');
        $('#btnSave').html(n ? '<i class="bx bx-save me-1"></i>Save changes' : '<i class="bx bx-send me-1"></i>Post notice');
        $('#fTitle').val(n ? n.title : '');
        $('#fBody').val(n ? n.body : '');
        $('#fCategory').val(n ? n.category : 'General');
        $('#fAudience').val(n ? n.audience : 'Everyone').trigger('change');
        $('#fUntil').val(n && n.until ? n.until : '');
        $('#fPinned').prop('checked', !!(n && n.pinned));
        loadClasses(n && n.classes ? n.classes.split(',') : []);
        bootstrap.Modal.getOrCreateInstance(document.getElementById('nbModal')).show();
    }

    $('#fAudience').on('change', function () { $('#fClassWrap').toggleClass('d-none', this.value !== 'Classes'); });
    $('#btnNew').on('click', function () { openForm(null); });
    $('#nbList').on('click', '.nb-edit', function () {
        var id = $(this).data('id');
        openForm(notices.filter(function (n) { return n.id === id; })[0]);
    });

    $('#btnSave').on('click', function () {
        var body = {
            id: editId || null,
            title: $('#fTitle').val().trim(),
            body: $('#fBody').val().trim(),
            category: $('#fCategory').val(),
            audience: $('#fAudience').val(),
            classes: $('#fClasses input:checked').map(function () { return this.value; }).get(),
            pinned: $('#fPinned').is(':checked'),
            until: $('#fUntil').val() || null
        };
        if (!body.title || !body.body) { ecToast('error', 'Title and message are required.'); return; }
        if (body.audience === 'Classes' && !body.classes.length) { ecToast('error', 'Pick at least one class.'); return; }

        var $b = $(this); EC.buttonBusy($b);
        $.ajax({ url: URL.save, type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': CSRF }, data: JSON.stringify(body) })
            .done(function (r) {
                ecToast(r.success ? 'success' : 'error', r.message);
                if (r.success) { bootstrap.Modal.getInstance(document.getElementById('nbModal')).hide(); load(); }
            })
            .fail(function () { ecToast('error', 'Could not save. Please try again.'); })
            .always(function () { EC.buttonReset($b); });
    });

    $('#nbList').on('click', '.nb-del', function () {
        var id = $(this).data('id'), n = notices.filter(function (x) { return x.id === id; })[0];
        EC.confirm({ title: 'Delete this notice?', name: n ? n.title : '', okText: 'Delete notice' }).then(function (ok) {
            if (!ok) return;
            $.ajax({ url: URL.del + '?id=' + id, type: 'POST', headers: { 'RequestVerificationToken': CSRF } })
                .done(function (r) { ecToast(r.success ? 'success' : 'error', r.message); if (r.success) load(); })
                .fail(function () { ecToast('error', 'Could not delete. Please try again.'); });
        });
    });

    $('#nbList').on('click', '.nb-seen', function () {
        $('#nbSeenList').html('<div class="text-muted">Loading...</div>');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('nbSeenModal')).show();
        $.getJSON(URL.seen, { id: $(this).data('id') }).done(function (rows) {
            $('#nbSeenList').html((rows || []).map(function (r) {
                return '<div class="nb-reader"><span>' + EC.esc(r.name) + '</span><small>' + EC.esc(r.at || '') + '</small></div>';
            }).join('') || '<div class="text-muted">Nobody has opened it yet.</div>');
        });
    });

    load();
});
</script>
}
