@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Student ID Cards";
    // ERP area views get no layout from the root _ViewStart — set it explicitly.
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";

    var classList = ViewBag.ClassList as List<SelectListItem> ?? new();
    var yearList  = ViewBag.YearList  as List<SelectListItem> ?? new();
    var defFormat = (ViewBag.DefaultFormat as string) ?? "Portrait";
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-id-card fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Student ID Cards</h4>
            <div class="ec-page-subtitle">Pick a class to print the whole batch on A4 sheets</div>
          </div>
        </div>
      </div>
    </div>

    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-printer"></i></span>
          <div>
            <div class="ec-section-title">Print a class set</div>
            <div class="ec-section-subtitle">Section is optional — leave it blank to include every section of the class.</div>
          </div>
        </div>
      </div>

      <div class="ec-card-body">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label">Class</label>
            @* The students table stores class_name as TEXT, so the filter value must
               be the class NAME (c.Text), not its code — same as the Student list. *@
            <select class="form-select" id="idClass">
              <option value="">Select class</option>
              @foreach (var c in classList)
              {
                  <option value="@c.Text">@c.Text</option>
              }
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Section <span class="text-muted">(optional)</span></label>
            <select class="form-select" id="idSection">
              <option value="">All sections</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Academic Year</label>
            <select class="form-select" id="idYear">
              <option value="">All years</option>
              @foreach (var y in yearList)
              {
                  <option value="@y.Text">@y.Text</option>
              }
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Layout</label>
            <select class="form-select" id="idFormat">
              <option value="Portrait" selected="@(defFormat == "Portrait")">Portrait</option>
              <option value="Landscape" selected="@(defFormat == "Landscape")">Landscape</option>
            </select>
          </div>
        </div>

        <div class="mt-3 d-flex gap-2 flex-wrap">
          <button type="button" class="btn btn-primary" id="idOpenSheet">
            <i class="bx bx-id-card me-1"></i>Open ID card sheet
          </button>
          <span class="text-muted" style="font-size:.85rem; align-self:center;">
            Opens in a new tab with a print button.
          </span>
        </div>
      </div>
    </div>

  </div>
</div>

@section PageScripts {
<script>
    $(function () {

        // When the class changes, load the sections that actually have students.
        $('#idClass').on('change', function () {
            var cls = $(this).val();
            var $sec = $('#idSection');
            $sec.html('<option value="">All sections</option>');
            if (!cls) return;

            $.getJSON('@Url.Action("Sections", "IdCard", new { area = "ERP" })',
                { "class": cls, year: $('#idYear').val() || '' })
            .done(function (list) {
                $.each(list || [], function (i, s) {
                    $sec.append($('<option>').val(s).text(s));
                });
            });
        });

        $('#idOpenSheet').on('click', function () {
            var cls = $('#idClass').val();
            if (!cls) { ecToast('error', 'Choose a class.'); return; }

            var url = '@Url.Action("Print", "IdCard", new { area = "ERP" })'
                + '?class='   + encodeURIComponent(cls)
                + '&section=' + encodeURIComponent($('#idSection').val() || '')
                + '&year='    + encodeURIComponent($('#idYear').val() || '')
                + '&format='  + encodeURIComponent($('#idFormat').val());

            window.open(url, '_blank');
        });

    });
</script>
}
