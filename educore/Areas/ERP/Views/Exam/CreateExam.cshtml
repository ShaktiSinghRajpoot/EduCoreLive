@using EduCoreDataAccessLayer.Models.ERP
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Exam Schedule";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";

    var classes   = ViewBag.Classes   as List<SubjectClassItem> ?? new List<SubjectClassItem>();
    var examTypes = ViewBag.ExamTypes as List<SelectListItem>   ?? new List<SelectListItem>();
    var yearName  = ViewBag.AcademicYearName as string ?? string.Empty;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Exam/CreateExam.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="ec-page-shell exam-page">
    <div class="ec-page-content">

        <!-- ── Page Header ── -->
        <div class="ec-page-header">
            <div class="ec-page-title-wrap d-flex align-items-start gap-3">
                <div class="ec-page-icon"><i class="bx bx-spreadsheet"></i></div>
                <div>
                    <h4 class="ec-page-title mb-1">Exam Schedule</h4>
                    <div class="ec-page-subtitle">
                        One exam covers many classes. Name it once, then set each class&#39;s subjects, dates and marks.
                    </div>
                </div>
            </div>
        </div>

        <!-- ════ SECTION 1 — Exam Details ════ -->
        <div class="ec-card mb-3">
            <div class="ec-card-body">
                <div class="exam-section-head">
                    <div class="exam-section-num">1</div>
                    <div>
                        <div class="exam-section-title">Exam Details</div>
                        <div class="exam-section-sub">Name, type and the window it runs in</div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6" id="examNameWrap">
                        <div class="exam-field-label">EXAM NAME <span style="color:var(--ec-danger)">*</span></div>
                        <input type="text" class="form-control" id="examName" maxlength="80"
                               placeholder="e.g. Unit Test 1">
                        <div class="field-error" id="examNameErr">Please enter an exam name.</div>
                        <div class="exam-hint">One name for the whole school &mdash; every class below sits this exam.</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="exam-field-label">EXAM TYPE <span style="color:var(--ec-muted);font-weight:600;">(optional)</span></div>
                        <select class="form-select" id="examType">
                            <option value="">Select Type</option>
                            @foreach (var t in examTypes)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 mt-0">
                    <div class="col-12 col-md-4">
                        <div class="exam-field-label">ACADEMIC YEAR</div>
                        <input type="text" class="form-control" id="academicYear"
                               value="@(string.IsNullOrWhiteSpace(yearName) ? "Not set up" : yearName)" readonly
                               style="background:#f8f7f5;cursor:default;">
                    </div>
                    <div class="col-6 col-md-4" id="startDateWrap">
                        <div class="exam-field-label">START DATE <span style="color:var(--ec-danger)">*</span></div>
                        <input type="date" class="form-control" id="startDate">
                        <div class="field-error" id="startDateErr">Required.</div>
                    </div>
                    <div class="col-6 col-md-4" id="endDateWrap">
                        <div class="exam-field-label">END DATE <span style="color:var(--ec-danger)">*</span></div>
                        <input type="date" class="form-control" id="endDate">
                        <div class="field-error" id="endDateErr">Must be on or after start date.</div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ════ SECTION 2 — Classes ════ -->
        <div class="ec-card mb-3">
            <div class="ec-card-body">
                <div class="exam-section-head">
                    <div class="exam-section-num">2</div>
                    <div>
                        <div class="exam-section-title">Classes</div>
                        <div class="exam-section-sub">Which classes sit this exam</div>
                    </div>
                </div>

                @if (classes.Count == 0)
                {
                    <div class="alert alert-warning mb-0" style="border-radius:12px;font-weight:700;">
                        No classes are set up for the current academic year. Add them under
                        School Settings &rarr; Classes &amp; Sections first.
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-ex-ghost btn-sm" id="classSelectAll">Select all</button>
                        <button type="button" class="btn btn-ex-ghost btn-sm" id="classClearAll">Clear</button>
                    </div>

                    <div class="exam-class-grid" id="classGrid">
                        @foreach (var c in classes)
                        {
                            <label class="exam-class-pick @(c.SubjectCount == 0 ? "is-empty" : "")">
                                <input type="checkbox" class="form-check-input class-chk"
                                       value="@c.AcademicClassId"
                                       data-name="@c.ClassName"
                                       data-subjects="@c.SubjectCount"
                                       @(c.SubjectCount == 0 ? "disabled" : "")>
                                <span>
                                    <span class="exam-class-name">@c.ClassName</span>
                                    <span class="exam-class-sub">
                                        @(c.SubjectCount == 0 ? "no subjects mapped" : $"{c.SubjectCount} subjects")
                                    </span>
                                </span>
                            </label>
                        }
                    </div>
                    <div class="field-error" id="classErr">Please select at least one class.</div>
                }

            </div>
        </div>

        <!-- ════ SECTION 3 — Subject Schedule ════ -->
        <div class="ec-card mb-3">
            <div class="ec-card-body">
                <div class="exam-section-head">
                    <div class="exam-section-num">3</div>
                    <div>
                        <div class="exam-section-title">Subject Schedule</div>
                        <div class="exam-section-sub">Set each class&#39;s dates and marks &mdash; untick a subject to leave it out</div>
                    </div>
                </div>

                <!-- Which class's datesheet is on screen -->
                <div class="exam-sheet-bar" id="sheetBar" style="display:none;">
                    <div class="exam-sheet-pick">
                        <span class="exam-field-label mb-0">DATESHEET FOR</span>
                        <select class="form-select" id="sheetClass"></select>
                    </div>
                    <button type="button" class="btn btn-ex-ghost" id="copyToggle">
                        <i class="bx bx-copy me-1"></i>Copy to other classes
                    </button>
                </div>

                <!-- Copy panel -->
                <div class="exam-copy-panel" id="copyPanel" style="display:none;">
                    <div class="exam-copy-title">
                        Copy <strong id="copyFromName">this</strong> datesheet to:
                    </div>
                    <div class="exam-copy-list" id="copyList"></div>
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-ex-primary btn-sm" id="copyApply">Copy datesheet</button>
                        <button type="button" class="btn btn-ex-ghost btn-sm" id="copyCancel">Cancel</button>
                    </div>
                    <div class="exam-hint mt-2">
                        Dates and marks are copied for every subject the target class also studies.
                        Its other subjects keep their own values.
                    </div>
                </div>

                <!-- Every "no rows" state for this step lands here -->
                <div id="subjStatus" class="subj-empty"></div>

                <div id="subjResult" style="display:none;">
                    <div class="subj-table-wrap" id="subjTableWrap">
                        <table class="subj-table">
                            <thead>
                                <tr>
                                    <th style="width:40%">SUBJECT</th>
                                    <th style="width:24%">EXAM DATE</th>
                                    <th style="width:18%">MAX MARKS</th>
                                    <th style="width:18%">PASS MARKS</th>
                                </tr>
                            </thead>
                            <tbody id="subjTableBody"></tbody>
                        </table>
                    </div>
                    <div class="subj-cards" id="subjCards"></div>
                </div>

            </div>
        </div>

        <!-- ════ Sticky Action Bar ════ -->
        <div class="exam-bar">
            <div class="exam-bar-inner">
                <div class="exam-bar-summary">
                    <span id="barSummary">Fill in the details above to create an exam.</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-ex-ghost" id="cancelBtn">Clear</button>
                    <button type="button" class="btn btn-ex-primary" id="saveExamBtn" disabled>
                        <i class="bx bx-save me-1"></i>Save Exam
                    </button>
                </div>
            </div>
        </div>

        <!-- ════ Exams this year ════ -->
        <div class="ec-card mt-3">
            <div class="ec-card-body">
                <div class="exam-section-head">
                    <div class="exam-section-num"><i class="bx bx-list-ul"></i></div>
                    <div>
                        <div class="exam-section-title">Exams this year</div>
                        <div class="exam-section-sub">@(string.IsNullOrWhiteSpace(yearName) ? "Current academic year" : yearName)</div>
                    </div>
                    <a asp-area="ERP" asp-controller="Exam" asp-action="Datesheet"
                       class="btn btn-ex-ghost ms-auto">
                        <i class="bx bx-calendar me-1"></i>View datesheet
                    </a>
                </div>

                <div id="examList"></div>
            </div>
        </div>

    </div>
</div>

@section PageScripts {
<script>
$(document).ready(function () {

    var urls = {
        subjects: '@Url.Action("Subjects", "Exam", new { area = "ERP" })',
        exams:    '@Url.Action("Exams", "Exam", new { area = "ERP" })',
        exam:     '@Url.Action("Exam", "Exam", new { area = "ERP" })',
        save:     '@Url.Action("SaveExam", "Exam", new { area = "ERP" })',
        remove:   '@Url.Action("DeleteExam", "Exam", new { area = "ERP" })'
    };

    // 0 = creating a new exam, otherwise the exam_id being edited.
    var editingId = 0;

    // classId -> [ { subjectId, name, date, max, pass, on } ]
    // Held for every ticked class at once, so switching class just swaps the view
    // and one Save posts the whole exam.
    var sheets = {};
    var sheetClassId = 0;          // whose datesheet is on screen

    var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    function token() {
        return $('input[name="__RequestVerificationToken"]').first().val();
    }

    function fmtDate(iso) {
        if (!iso) return '—';
        var p = String(iso).split('-');
        if (p.length !== 3) return iso;
        return parseInt(p[2], 10) + ' ' + MONTHS[parseInt(p[1], 10) - 1] + ' ' + p[0];
    }

    // The ticked classes, in the order they appear on screen.
    function pickedClasses() {
        return $('.class-chk:checked').map(function () { return EC.num(this.value); }).get();
    }

    function classNameOf(classId) {
        return $('.class-chk[value="' + classId + '"]').data('name') || ('Class ' + classId);
    }

    // ── Step 3: one class's datesheet ─────────────────────────────────────────
    function renderSheet() {
        var rows = sheets[sheetClassId];

        if (!sheetClassId || !rows) {
            $('#subjResult').hide();
            $('#subjStatus').show();
            EC.listEmpty('#subjStatus', 'Tick a class in Step 2 to set its subject schedule.', 'bx-layer');
            updateBar();
            return;
        }

        if (!rows.length) {
            $('#subjResult').hide();
            $('#subjStatus').show();
            EC.listEmpty('#subjStatus',
                'No subjects are mapped to ' + classNameOf(sheetClassId) +
                '. Add them under School Settings → Subject Management.', 'bx-book-add');
            updateBar();
            return;
        }

        var tBody = '', cards = '';
        $.each(rows, function (i, r) {
            var name = EC.esc(r.name);
            var chk  = r.on ? ' checked' : '';

            tBody += '<tr class="subj-row" data-idx="' + i + '">' +
                '<td><div class="d-flex align-items-center gap-2">' +
                    '<input class="form-check-input subj-on" type="checkbox"' + chk + '>' +
                    '<span class="subj-ico"><i class="bx bx-book-bookmark"></i></span>' +
                    '<span class="subj-name">' + name + '</span>' +
                '</div></td>' +
                '<td><input type="date" class="form-control subj-date" value="' + (r.date || '') + '"></td>' +
                '<td><input type="number" class="form-control subj-max" value="' + r.max + '" min="1" max="1000"></td>' +
                '<td><input type="number" class="form-control subj-pass" value="' + r.pass + '" min="0" max="1000"></td>' +
                '</tr>';

            cards += '<div class="subj-card" data-idx="' + i + '">' +
                '<div class="subj-card-head">' +
                    '<input class="form-check-input subj-on" type="checkbox"' + chk + '>' +
                    '<span class="subj-ico"><i class="bx bx-book-bookmark"></i></span>' +
                    '<span class="subj-name">' + name + '</span>' +
                '</div>' +
                '<div class="mb-2"><div class="exam-field-label">EXAM DATE</div>' +
                    '<input type="date" class="form-control subj-date" value="' + (r.date || '') + '"></div>' +
                '<div class="subj-card-row">' +
                    '<div><div class="exam-field-label">MAX MARKS</div>' +
                        '<input type="number" class="form-control subj-max" value="' + r.max + '" min="1" max="1000"></div>' +
                    '<div><div class="exam-field-label">PASS MARKS</div>' +
                        '<input type="number" class="form-control subj-pass" value="' + r.pass + '" min="0" max="1000"></div>' +
                '</div></div>';
        });

        $('#subjTableBody').html(tBody);
        $('#subjCards').html(cards);
        $('#subjStatus').hide();
        $('#subjResult').show();
        updateBar();
    }

    // The container the user is actually typing into (CSS hides the other one).
    function sheetRows() {
        return $('#subjTableWrap').is(':visible')
            ? $('#subjTableBody tr.subj-row')
            : $('#subjCards .subj-card');
    }

    // Copy what is on screen back into `sheets` before switching class or saving.
    function captureSheet() {
        var rows = sheets[sheetClassId];
        if (!rows) return;

        sheetRows().each(function () {
            var $r  = $(this);
            var idx = EC.num($r.data('idx'));
            var row = rows[idx];
            if (!row) return;

            var max  = $r.find('.subj-max').val();
            var pass = $r.find('.subj-pass').val();

            row.on   = $r.find('.subj-on').is(':checked');
            row.date = $r.find('.subj-date').val() || '';
            row.max  = max  === '' ? 100 : EC.numPos(max);
            row.pass = pass === '' ? 35  : EC.numPos(pass);
        });
    }

    // Fetch a class's subject list once, seeded from `saved` when editing.
    function loadClassSheet(classId, saved) {
        return $.get(urls.subjects, { classId: classId })
            .done(function (rows) {
                var start = $('#startDate').val();
                sheets[classId] = $.map(rows || [], function (s) {
                    var prev = saved ? saved[s.id] : null;
                    return {
                        subjectId: s.id,
                        name:      s.name,
                        on:        saved ? !!prev : true,
                        date:      (prev && prev.date) ? prev.date : (start || ''),
                        max:       prev ? EC.num(prev.maxMarks)  : 100,
                        pass:      prev ? EC.num(prev.passMarks) : 35
                    };
                });
            });
    }

    // ── The "datesheet for" dropdown ──────────────────────────────────────────
    function refreshSheetPicker() {
        var picked = pickedClasses();

        if (!picked.length) {
            $('#sheetBar').hide();
            $('#copyPanel').hide();
            sheetClassId = 0;
            renderSheet();
            return;
        }

        var html = '';
        $.each(picked, function (i, id) {
            html += '<option value="' + id + '">' + EC.esc(classNameOf(id)) + '</option>';
        });
        $('#sheetClass').html(html);

        if (picked.indexOf(sheetClassId) === -1) sheetClassId = picked[0];
        $('#sheetClass').val(String(sheetClassId));
        $('#sheetBar').show();
        renderSheet();
    }

    // ── Class ticks ───────────────────────────────────────────────────────────
    $(document).on('change', '.class-chk', function () {
        var id = EC.num(this.value);
        $('#classErr').closest('.ec-card-body').removeClass('has-error');

        if (!this.checked) {
            delete sheets[id];
            refreshSheetPicker();
            updateBar();
            return;
        }

        if (sheets[id]) { refreshSheetPicker(); updateBar(); return; }

        captureSheet();
        EC.showLoader();
        $('#subjStatus').show();
        EC.listLoading('#subjStatus', 'Loading subjects…');

        loadClassSheet(id, null)
            .done(function () { refreshSheetPicker(); })
            .fail(function () {
                delete sheets[id];
                $('.class-chk[value="' + id + '"]').prop('checked', false);
                ecToast('error', 'Could not load subjects for that class.');
                refreshSheetPicker();
            })
            .always(EC.hideLoader);
    });

    $('#classSelectAll').on('click', function () {
        var $boxes = $('.class-chk:not(:disabled):not(:checked)');
        if (!$boxes.length) return;
        captureSheet();
        EC.showLoader();

        var pending = $boxes.map(function () {
            var id = EC.num(this.value);
            $(this).prop('checked', true);
            return sheets[id] ? null : loadClassSheet(id, null);
        }).get();

        $.when.apply($, pending)
            .always(function () {
                refreshSheetPicker();
                updateBar();
                EC.hideLoader();
            });
    });

    $('#classClearAll').on('click', function () {
        $('.class-chk:checked').prop('checked', false);
        sheets = {};
        refreshSheetPicker();
        updateBar();
    });

    // ── Switching which class is on screen ────────────────────────────────────
    $('#sheetClass').on('change', function () {
        captureSheet();
        sheetClassId = EC.num(this.value);
        $('#copyPanel').hide();
        renderSheet();
    });

    // ── Copy this datesheet to other classes ──────────────────────────────────
    $('#copyToggle').on('click', function () {
        if ($('#copyPanel').is(':visible')) { $('#copyPanel').hide(); return; }

        var targets = pickedClasses().filter(function (id) { return id !== sheetClassId; });
        if (!targets.length) {
            ecToast('error', 'Tick another class first — there is nothing to copy to.');
            return;
        }

        $('#copyFromName').text(classNameOf(sheetClassId));
        var html = '';
        $.each(targets, function (i, id) {
            html += '<label class="exam-copy-item">' +
                '<input type="checkbox" class="form-check-input copy-chk" value="' + id + '" checked> ' +
                EC.esc(classNameOf(id)) + '</label>';
        });
        $('#copyList').html(html);
        $('#copyPanel').show();
    });

    $('#copyCancel').on('click', function () { $('#copyPanel').hide(); });

    $('#copyApply').on('click', function () {
        captureSheet();

        var source = sheets[sheetClassId] || [];
        var byId = {};
        $.each(source, function (i, r) { byId[r.subjectId] = r; });

        var targets = $('.copy-chk:checked').map(function () { return EC.num(this.value); }).get();
        if (!targets.length) { ecToast('error', 'Pick at least one class to copy to.'); return; }

        var copied = 0;
        $.each(targets, function (i, id) {
            var rows = sheets[id];
            if (!rows) return;
            $.each(rows, function (j, row) {
                var src = byId[row.subjectId];
                if (!src) return;              // that class does not study this subject
                row.on   = src.on;
                row.date = src.date;
                row.max  = src.max;
                row.pass = src.pass;
                copied++;
            });
        });

        $('#copyPanel').hide();
        renderSheet();
        ecToast('success', 'Copied to ' + targets.length + ' class' + (targets.length === 1 ? '' : 'es') +
                           ' (' + copied + ' subject' + (copied === 1 ? '' : 's') + ').');
    });

    // ── Field events ──────────────────────────────────────────────────────────
    $('#startDate').on('change', function () {
        var v = $(this).val();
        // Keep every class's dates inside the exam window.
        captureSheet();
        $.each(sheets, function (id, rows) {
            $.each(rows, function (i, r) { if (!r.date || r.date < v) r.date = v; });
        });
        if ($('#endDate').val() && $('#endDate').val() < v) $('#endDate').val(v);
        $('#startDateWrap').removeClass('has-error');
        renderSheet();
    });

    $('#endDate').on('change', function () {
        $('#endDateWrap').removeClass('has-error');
        updateBar();
    });

    $('#examName').on('input', function () {
        $('#examNameWrap').removeClass('has-error');
        updateBar();
    });

    $('#examType').on('change', updateBar);
    $(document).on('change', '.subj-on', updateBar);

    // ── Action bar summary ────────────────────────────────────────────────────
    function updateBar() {
        var name    = $('#examName').val().trim();
        var typeTxt = $('#examType').val() ? $('#examType option:selected').text() : '';
        var picked  = pickedClasses();

        var ready = name && picked.length > 0 && $('#startDate').val() && $('#endDate').val();
        $('#saveExamBtn').prop('disabled', !ready);

        if (!name && !picked.length) {
            $('#barSummary').text(editingId
                ? 'Editing an exam — change the details above.'
                : 'Fill in the details above to create an exam.');
            return;
        }

        var parts = [];
        if (name)    parts.push('<span>' + EC.esc(name) + '</span>');
        if (typeTxt) parts.push(EC.esc(typeTxt));
        if (picked.length) parts.push(picked.length + ' class' + (picked.length === 1 ? '' : 'es'));
        $('#barSummary').html(parts.join(' &middot; '));
    }

    // ── Create / edit mode ────────────────────────────────────────────────────
    function setMode() {
        if (editingId) {
            $('#saveExamBtn').html('<i class="bx bx-save me-1"></i>Update Exam');
            $('#cancelBtn').text('Cancel edit');
        } else {
            $('#saveExamBtn').html('<i class="bx bx-save me-1"></i>Save Exam');
            $('#cancelBtn').text('Clear');
        }
    }

    function resetForm() {
        editingId = 0;
        sheets = {};
        sheetClassId = 0;
        $('#examName').val('');
        $('#examType').val('');
        $('#startDate').val('');
        $('#endDate').val('');
        $('.class-chk').prop('checked', false);
        $('.has-error').removeClass('has-error');
        $('#copyPanel').hide();
        refreshSheetPicker();
        setMode();
        updateBar();
    }

    $('#cancelBtn').on('click', function () {
        resetForm();
        loadExams();
    });

    // ── Validate & save ───────────────────────────────────────────────────────
    $('#saveExamBtn').on('click', function () {
        captureSheet();
        var valid = true;

        if (!$('#examName').val().trim())  { $('#examNameWrap').addClass('has-error');  valid = false; }
        if (!$('#startDate').val())        { $('#startDateWrap').addClass('has-error'); valid = false; }
        if (!$('#endDate').val() || $('#endDate').val() < $('#startDate').val()) {
            $('#endDateWrap').addClass('has-error'); valid = false;
        }

        var picked = pickedClasses();
        if (!picked.length) { ecToast('error', 'Tick at least one class for this exam.'); return; }
        if (!valid) { ecToast('error', 'Please complete all required fields.'); return; }

        // Build the payload and refuse to silently drop a class the user ticked.
        var payloadClasses = [];
        var blank = [];
        $.each(picked, function (i, id) {
            var rows = (sheets[id] || []).filter(function (r) { return r.on; });
            if (!rows.length) { blank.push(classNameOf(id)); return; }

            payloadClasses.push({
                classId: id,
                subjects: $.map(rows, function (r) {
                    return { subjectId: r.subjectId, examDate: r.date || '', maxMarks: r.max, passMarks: r.pass };
                })
            });
        });

        if (blank.length) {
            ecToast('error', 'No subjects ticked for ' + blank.join(', ') + '.');
            return;
        }

        var $btn = $(this);
        EC.buttonBusy($btn, 'Saving…');

        $.ajax({
            url: urls.save,
            type: 'POST',
            contentType: 'application/json',
            headers: { 'RequestVerificationToken': token() },
            data: JSON.stringify({
                examId:    editingId,
                examName:  $('#examName').val().trim(),
                examType:  $('#examType').val(),
                startDate: $('#startDate').val(),
                endDate:   $('#endDate').val(),
                classes:   payloadClasses
            })
        })
        .done(function (d) {
            if (!d || !d.success) {
                ecToast('error', (d && d.message) || 'Could not save the exam.');
                return;
            }
            ecToast('success', d.message || 'Exam saved.');
            resetForm();
            loadExams();
        })
        .fail(function () {
            ecToast('error', 'Could not save the exam. Please retry.');
        })
        .always(function () { EC.buttonReset($btn); });
    });

    // ── Exams this year ───────────────────────────────────────────────────────
    function loadExams() {
        EC.listLoading('#examList');

        $.get(urls.exams)
            .done(function (d) {
                var list = (d && d.exams) || [];
                if (!list.length) {
                    EC.listEmpty('#examList', 'No exams created for this year yet.', 'bx-calendar-x');
                    return;
                }

                var html = '';
                $.each(list, function (i, e) {
                    html += '<div class="exam-list-row' + (e.id === editingId ? ' is-editing' : '') + '" data-exam-id="' + e.id + '">' +
                        '<div class="exam-list-main">' +
                            '<div class="exam-list-name">' + EC.esc(e.name) +
                                (e.typeLabel ? ' <span class="exam-list-type">' + EC.esc(e.typeLabel) + '</span>' : '') +
                            '</div>' +
                            '<div class="exam-list-meta">' +
                                fmtDate(e.startDate) + ' – ' + fmtDate(e.endDate) + ' &middot; ' +
                                e.classCount + ' class' + (e.classCount === 1 ? '' : 'es') + ' &middot; ' +
                                e.subjectCount + ' paper' + (e.subjectCount === 1 ? '' : 's') +
                            '</div>' +
                            (e.classNames ? '<div class="exam-list-classes">' + EC.esc(e.classNames) + '</div>' : '') +
                        '</div>' +
                        '<div class="exam-list-actions">' +
                            '<button type="button" class="btn btn-ex-ghost exam-edit"><i class="bx bx-edit"></i> Edit</button>' +
                            '<button type="button" class="btn btn-ex-ghost exam-del"><i class="bx bx-trash"></i></button>' +
                        '</div>' +
                        '</div>';
                });
                $('#examList').html(html);
            })
            .fail(function () {
                EC.listEmpty('#examList', 'Could not load exams. Please retry.', 'bx-error-circle');
            });
    }

    $(document).on('click', '.exam-edit', function () {
        var id = $(this).closest('.exam-list-row').data('exam-id');

        EC.showLoader();
        $.get(urls.exam, { id: id })
            .done(function (d) {
                if (!d || !d.success) {
                    ecToast('error', (d && d.message) || 'Could not load that exam.');
                    EC.hideLoader();
                    return;
                }

                var e = d.exam;
                editingId = e.id;
                sheets = {};
                sheetClassId = 0;

                $('#examName').val(e.name);
                $('#examType').val(e.type || '');
                $('#startDate').val(e.startDate);
                $('#endDate').val(e.endDate);
                $('.class-chk').prop('checked', false);
                $('.has-error').removeClass('has-error');

                // Each class's full subject list, with the saved datesheet ticked on top.
                var waits = $.map(e.classes || [], function (c) {
                    $('.class-chk[value="' + c.classId + '"]').prop('checked', true);
                    var saved = {};
                    $.each(c.subjects || [], function (j, s) { saved[s.id] = s; });
                    return loadClassSheet(c.classId, saved);
                });

                $.when.apply($, waits).always(function () {
                    refreshSheetPicker();
                    setMode();
                    updateBar();
                    loadExams();
                    EC.hideLoader();
                    $('html, body').animate({ scrollTop: 0 }, 200);
                });
            })
            .fail(function () {
                ecToast('error', 'Could not load that exam.');
                EC.hideLoader();
            });
    });

    $(document).on('click', '.exam-del', function () {
        var $row = $(this).closest('.exam-list-row');
        var id   = $row.data('exam-id');
        var name = $row.find('.exam-list-name').text().trim();
        var $btn = $(this);

        EC.confirm({
            title:   'Delete this exam?',
            name:    name,
            message: 'Every class datesheet under it will be removed.',
            okText:  'Delete exam'
        }).then(function (ok) {
            if (!ok) return;

            EC.buttonBusy($btn);
            $.ajax({
                url: urls.remove,
                type: 'POST',
                headers: { 'RequestVerificationToken': token() },
                data: { id: id }
            })
            .done(function (d) {
                if (!d || !d.success) {
                    ecToast('error', (d && d.message) || 'Could not delete the exam.');
                    return;
                }
                ecToast('success', d.message || 'Exam deleted.');
                if (editingId === id) resetForm();
                loadExams();
            })
            .fail(function () {
                ecToast('error', 'Could not delete the exam. Please retry.');
            })
            .always(function () { EC.buttonReset($btn); });
        });
    });

    // ── Init ──────────────────────────────────────────────────────────────────
    setMode();
    renderSheet();
    loadExams();
});
</script>
}
