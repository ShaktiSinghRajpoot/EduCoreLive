@using EduCoreDataAccessLayer.Models.ERP
@{
    ViewData["Title"] = "Marks Entry";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";

    var examGroups = ViewBag.ExamGroups as List<ExamSessionGroup> ?? new List<ExamSessionGroup>();
    var examCount  = examGroups.Sum(g => g.Exams.Count);
    var yearName  = ViewBag.AcademicYearName as string ?? string.Empty;
    var canManage = (bool?)ViewBag.CanManage ?? false;
    var isAdmin   = (bool?)ViewBag.IsAdmin   ?? false;
    var selected  = (int?)ViewBag.SelectedExamId ?? 0;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Exam/MarkEntry.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="ec-page-shell me-page">
  <div class="ec-page-content">

    <!-- ── Page header ── -->
    <div class="ec-page-header">
        <div class="ec-page-header-inner">
            <div class="ec-page-title-wrap">
                <div>
                    <h4 class="ec-page-title mb-1">Marks Entry</h4>
                    <div class="ec-page-subtitle">
                        Pick the sheet, then type the marks@(string.IsNullOrWhiteSpace(yearName) ? "" : " · " + yearName)
                    </div>
                </div>
            </div>
            <a asp-area="ERP" asp-controller="Exam" asp-action="CreateExam"
               class="btn btn-outline-secondary d-flex align-items-center gap-1">
                <i class="bx bx-plus"></i><span class="d-none d-sm-inline">Exam Schedule</span>
            </a>
        </div>
    </div>

    @if (examCount == 0)
    {
        <div class="alert alert-warning" style="border-radius:12px;font-weight:700;">
            No published exams yet. Marks can only be entered once an exam is published on the
            <a asp-area="ERP" asp-controller="Exam" asp-action="CreateExam">Exam Schedule</a> page.
        </div>
    }

    <!-- ── Selectors ── -->
    <div class="me-selector">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-lg-3">
                <span class="me-sel-label">Exam</span>
                @* Grouped by session — an exam already belongs to one, so no picker. *@
                <select class="form-select" id="selExam">
                    <option value="">Select Exam</option>
                    @foreach (var g in examGroups)
                    {
                        <optgroup label="@(g.SessionName + (g.IsCurrent ? "  (current)" : ""))">
                            @foreach (var e in g.Exams)
                            {
                                <option value="@e.ExamId" data-session="@g.SessionName"
                                        selected="@(e.ExamId == selected)">@e.ExamName</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="col-6 col-sm-3 col-lg-2">
                <span class="me-sel-label">Class</span>
                <select class="form-select" id="selClass" disabled>
                    <option value="">Class</option>
                </select>
            </div>
            <div class="col-6 col-sm-3 col-lg-2">
                <span class="me-sel-label">Section</span>
                <select class="form-select" id="selSection" disabled>
                    <option value="">Sec</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <span class="me-sel-label">Subject</span>
                <select class="form-select" id="selSubject" disabled>
                    <option value="">Select Subject</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <button type="button" class="me-load-btn w-100" id="loadBtn" disabled>
                    <i class="bx bx-spreadsheet"></i> Open sheet
                </button>
            </div>
        </div>
    </div>

    <!-- ── The sheet ── -->
    <div class="me-grid-card" id="meGridCard">

        <!-- One line of context: what you are marking, and the scale. -->
        <div class="me-grid-hdr">
            <div>
                <div class="me-ctx-line" id="ctxLine">—</div>
                <div class="me-ctx-scale" id="ctxScale">—</div>
            </div>
            <div class="me-grid-actions">
                <span class="me-lock-chip" id="lockChip" style="display:none;">
                    <i class="bx bx-lock-alt"></i> Finalized
                </span>
                @if (isAdmin)
                {
                    <button type="button" class="me-bulk-btn" id="btnReopen" style="display:none;">
                        <i class="bx bx-lock-open-alt"></i> Unlock
                    </button>
                }
                <button type="button" class="me-bulk-btn" id="btnClearAll">
                    <i class="bx bx-reset"></i> Clear marks
                </button>
            </div>
        </div>

        <!-- Desktop table -->
        <div class="me-tbl-wrap">
            <table class="me-tbl">
                <thead>
                    <tr>
                        <th style="width:56px;">#</th>
                        <th>Student</th>
                        <th style="width:90px; text-align:center;">Absent</th>
                        <th style="width:130px; text-align:center;">Marks <span id="thMax" style="font-weight:600;opacity:.7;"></span></th>
                    </tr>
                </thead>
                <tbody id="markTableBody"></tbody>
            </table>
        </div>

        <!-- Mobile cards -->
        <div class="me-mob-list" id="mobList"></div>

        <!-- Shown before a sheet is opened -->
        <div class="me-empty" id="meEmpty">
            <div class="me-empty-ic"><i class="bx bx-spreadsheet"></i></div>
            <div class="me-empty-title">No sheet open</div>
            <div class="me-empty-sub">Pick an exam, class, section and subject above, then choose Open sheet.</div>
        </div>

    </div>

    <!-- ── Sticky action bar ── -->
    <div class="me-bar" id="meBar">
        <div class="me-bar-inner">
            <div class="me-bar-info">
                <i class="bx bx-info-circle"></i>
                <span id="barInfoText">—</span>
            </div>
            <div class="me-bar-actions">
                <button type="button" class="btn-me-draft" id="btnDraft">
                    <i class="bx bx-save"></i> Save
                </button>
                <button type="button" class="btn-me-finalize" id="btnFinalize">
                    <i class="bx bx-lock-alt"></i> Finalize
                </button>
            </div>
        </div>
    </div>

  </div>
</div>

<!-- ── Finalize confirm ── -->
<div class="modal fade me-modal" id="finalizeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <i class="bx bx-lock-alt me-2" style="color:var(--ec-primary);"></i>Finalize this sheet
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.15rem 1.4rem;">
                <div style="font-weight:900;color:var(--ec-text-dark);" id="modalDesc">—</div>
                <p style="font-size:.83rem;font-weight:650;color:#842029;background:#fde8e8;border-radius:10px;padding:.7rem .9rem;margin:.9rem 0 0;">
                    <i class="bx bx-error-circle me-1"></i>
                    Once finalized, only a school admin can reopen it.
                </p>
                <div id="modalPendingWarn" class="d-none mt-2"
                     style="font-size:.82rem;font-weight:700;color:#856404;background:#fff3cd;border-radius:10px;padding:.7rem .9rem;">
                    <i class="bx bx-error me-1"></i>
                    <span id="modalPendingCount">0</span> student(s) have no marks. They will be recorded Absent.
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--ec-border);padding:.9rem 1.4rem;gap:.5rem;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmFinalizeBtn">
                    <i class="bx bx-lock-alt me-1"></i> Finalize
                </button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
<script>
$(document).ready(function () {
'use strict';

var urls = {
    classes: '@Url.Action("ExamClasses", "Exam", new { area = "ERP" })',
    setup:   '@Url.Action("ClassSetup", "Exam", new { area = "ERP" })',
    sheet:   '@Url.Action("Sheet", "Exam", new { area = "ERP" })',
    save:    '@Url.Action("SaveMarks", "Exam", new { area = "ERP" })',
    reopen:  '@Url.Action("ReopenSheet", "Exam", new { area = "ERP" })'
};

var CAN_MANAGE = @(canManage ? "true" : "false");

var state = {
    examId: 0, classId: 0, subjectId: 0, section: '',
    examName: '', session: '', className: '', subjectName: '',
    maxMarks: 100, passMarks: 35,
    examDate: '', startTime: '', endTime: '',
    rows: [],          // { studentId, roll, name, marks, absent, hadMark }
    finalized: false
};

var selExam    = document.getElementById('selExam');
var selClass   = document.getElementById('selClass');
var selSection = document.getElementById('selSection');
var selSubject = document.getElementById('selSubject');
var loadBtn    = document.getElementById('loadBtn');

function token() {
    return $('input[name="__RequestVerificationToken"]').first().val();
}

// 78.00 -> "78",  78.50 -> "78.5",  null -> ""
function fmtMarks(v) {
    if (v === null || v === undefined || v === '') return '';
    var n = Number(v);
    return isFinite(n) ? String(n) : '';
}

// ── Selector cascade ──────────────────────────────────────────────────────
function closeSheet() {
    state.rows = [];
    state.finalized = false;
    document.getElementById('markTableBody').innerHTML = '';
    document.getElementById('mobList').innerHTML       = '';
    document.getElementById('meEmpty').style.display   = 'flex';
    document.getElementById('meBar').style.display     = 'none';
    document.getElementById('lockChip').style.display  = 'none';
    $('#btnReopen').hide();
    $('#ctxLine').text('—');
    $('#ctxScale').text('—');
}

function resetBelowExam() {
    selClass.innerHTML   = '<option value="">Class</option>';
    selSection.innerHTML = '<option value="">Sec</option>';
    selSubject.innerHTML = '<option value="">Select Subject</option>';
    selClass.disabled = selSection.disabled = selSubject.disabled = true;
    closeSheet();
}

function resetBelowClass() {
    selSection.innerHTML = '<option value="">Sec</option>';
    selSubject.innerHTML = '<option value="">Select Subject</option>';
    selSection.disabled = selSubject.disabled = true;
    closeSheet();
}

$(selExam).on('change', function () {
    var $opt = $(this).find('option:selected');
    state.examId   = EC.num(this.value);
    state.examName = this.value ? $opt.text().trim() : '';
    // Which session this exam belongs to, so the sheet says so out loud.
    state.session  = this.value ? ($opt.data('session') || '') : '';
    state.classId  = 0;
    resetBelowExam();
    updateLoadBtn();
    if (state.examId) loadClasses(state.examId);
});

function loadClasses(examId) {
    EC.showLoader();
    $.get(urls.classes, { examId: examId })
        .done(function (rows) {
            var list = rows || [];
            $.each(list, function (i, c) {
                selClass.innerHTML += '<option value="' + c.id + '">' + EC.esc(c.name) + '</option>';
            });
            selClass.disabled = list.length === 0;

            if (!list.length) {
                ecToast('error', 'This exam has no classes on its datesheet.');
            } else if (list.length === 1) {
                selClass.value = String(list[0].id);
                $(selClass).trigger('change');
            }
            updateLoadBtn();
        })
        .fail(function () { ecToast('error', 'Could not load the classes for this exam.'); })
        .always(EC.hideLoader);
}

$(selClass).on('change', function () {
    state.classId   = EC.num(this.value);
    state.className = this.value ? $(this).find('option:selected').text().trim() : '';
    resetBelowClass();
    updateLoadBtn();
    if (state.classId) loadSetup(state.examId, state.classId);
});

function loadSetup(examId, classId) {
    EC.showLoader();
    $.get(urls.setup, { examId: examId, classId: classId })
        .done(function (d) {
            var sections = (d && d.sections) || [];
            var subjects = (d && d.subjects) || [];

            $.each(sections, function (i, s) {
                var label = (s.name || '(no section)') + ' (' + s.students + ')';
                selSection.innerHTML += '<option value="' + EC.esc(s.name) + '">' + EC.esc(label) + '</option>';
            });
            $.each(subjects, function (i, s) {
                selSubject.innerHTML += '<option value="' + s.id + '">' + EC.esc(s.name) + '</option>';
            });

            selSection.disabled = sections.length === 0;
            selSubject.disabled = subjects.length === 0;

            if (!sections.length) {
                ecToast('error', 'No students are enrolled in this class for the exam\'s academic year.');
            } else if (sections.length === 1) {
                selSection.value = sections[0].name;
            }
            updateLoadBtn();
        })
        .fail(function () { ecToast('error', 'Could not load this class. Please retry.'); })
        .always(EC.hideLoader);
}

$(selSection).on('change', function () { closeSheet(); updateLoadBtn(); });
$(selSubject).on('change', function () { closeSheet(); updateLoadBtn(); });

function updateLoadBtn() {
    loadBtn.disabled = !(selExam.value && selClass.value && selSection.value !== '' && selSubject.value);
}

// ── Open the sheet ────────────────────────────────────────────────────────
$(loadBtn).on('click', function () {
    var $btn = $(this);
    state.examId    = EC.num(selExam.value);
    state.classId   = EC.num(selClass.value);
    state.subjectId = EC.num(selSubject.value);
    state.section   = selSection.value;

    EC.buttonBusy($btn, 'Opening…');
    $.get(urls.sheet, {
        examId: state.examId, classId: state.classId,
        subjectId: state.subjectId, section: state.section
    })
        .done(function (d) {
            if (!d || !d.success) {
                ecToast('error', (d && d.message) || 'Could not open the sheet.');
                return;
            }

            state.maxMarks    = EC.num(d.maxMarks) || 100;
            state.passMarks   = EC.num(d.passMarks);
            state.subjectName = d.subjectName;
            state.examDate    = d.examDate || '';
            state.startTime   = d.startTime || '';
            state.endTime     = d.endTime || '';
            state.finalized   = !!d.isFinalized;

            state.rows = $.map(d.students || [], function (s) {
                return {
                    studentId: s.id,
                    roll:      s.roll || '',
                    name:      s.name,
                    marks:     (s.marks === null || s.marks === undefined) ? null : Number(s.marks),
                    absent:    !!s.absent,
                    hadMark:   !!s.hasMark
                };
            });

            if (!state.rows.length) {
                closeSheet();
                $('#meEmpty .me-empty-title').text('Nobody in this section');
                $('#meEmpty .me-empty-sub').text('No students are enrolled in this class and section for the exam\'s academic year.');
                return;
            }

            renderGrid();
            document.getElementById('meBar').style.display = 'block';
        })
        .fail(function () { ecToast('error', 'Could not open the sheet. Please retry.'); })
        .always(function () { EC.buttonReset($btn); });
});

// ── Context line ──────────────────────────────────────────────────────────
function renderContext() {
    var where = state.className + (state.section ? '-' + state.section : '');
    $('#ctxLine').html(
        '<strong>' + EC.esc(state.examName) + '</strong>' +
        (state.session ? ' <span class="me-ctx-session">' + EC.esc(state.session) + '</span>' : '') +
        ' &middot; ' + EC.esc(where) + ' &middot; ' + EC.esc(state.subjectName));

    var when = state.startTime && state.endTime
        ? state.startTime + '–' + state.endTime
        : (state.startTime || state.endTime || '');

    $('#ctxScale').text(
        (when ? when + ' · ' : '') +
        'Max ' + fmtMarks(state.maxMarks) + ' · Pass ' + fmtMarks(state.passMarks) +
        ' · ' + entered() + ' of ' + state.rows.length + ' entered');

    $('#thMax').text('/ ' + fmtMarks(state.maxMarks));

    $('#lockChip').toggle(state.finalized);
    $('#btnReopen').toggle(state.finalized);

    $('#modalDesc').text(state.examName + (state.session ? ' (' + state.session + ')' : '') +
                        ' · ' + where + ' · ' + state.subjectName);
    $('#barInfoText').html(EC.esc(where + ' · ' + state.subjectName) +
        ' &middot; ' + entered() + '/' + state.rows.length + ' entered');
}

function entered() {
    return state.rows.filter(function (r) { return r.absent || r.marks !== null; }).length;
}

// Marks and the absent toggle are locked once finalized, and for anyone
// without exams.manage.
function locked() { return state.finalized || !CAN_MANAGE; }

// Pass/fail shows as a row tint, so it needs no column of its own.
function rowClass(row) {
    if (row.absent) return 'me-row-abs';
    if (row.marks === null) return '';
    return row.marks >= state.passMarks ? 'me-row-pass' : 'me-row-fail';
}

// ── Grid ──────────────────────────────────────────────────────────────────
function buildTableRow(row, idx) {
    var ro  = (locked() || row.absent) ? 'readonly' : '';
    var dis = locked() ? 'disabled' : '';

    return '<tr class="' + rowClass(row) + '" data-idx="' + idx + '">' +
        '<td><span class="me-roll">' + EC.esc(row.roll) + '</span></td>' +
        '<td><span class="me-nm">' + EC.esc(row.name) + '</span></td>' +
        '<td style="text-align:center;">' +
            '<label class="me-abs-toggle">' +
                '<input type="checkbox" class="abs-chk" data-idx="' + idx + '" ' + (row.absent ? 'checked' : '') + ' ' + dis + '>' +
                '<span class="me-abs-slider"></span>' +
            '</label>' +
        '</td>' +
        '<td style="text-align:center;">' +
            '<input type="number" class="me-marks-inp marks-inp" data-idx="' + idx + '" ' +
                   'min="0" max="' + state.maxMarks + '" step="0.5" placeholder="—" ' +
                   'value="' + (row.absent ? '' : fmtMarks(row.marks)) + '" ' + ro + '>' +
        '</td>' +
        '</tr>';
}

function buildMobCard(row, idx) {
    var ro  = (locked() || row.absent) ? 'readonly' : '';
    var dis = locked() ? 'disabled' : '';

    return '<div class="me-mob-card ' + rowClass(row) + '" data-idx="' + idx + '">' +
        '<div class="me-mob-top">' +
            '<div class="flex-grow-1">' +
                '<div class="me-nm">' + EC.esc(row.name) + '</div>' +
                '<div class="me-rl">Roll: ' + EC.esc(row.roll) + '</div>' +
            '</div>' +
        '</div>' +
        '<div class="me-mob-inp-row">' +
            '<div>' +
                '<span class="me-mob-inp-lbl">Absent</span>' +
                '<label class="me-abs-toggle">' +
                    '<input type="checkbox" class="abs-chk" data-idx="' + idx + '" ' + (row.absent ? 'checked' : '') + ' ' + dis + '>' +
                    '<span class="me-abs-slider"></span>' +
                '</label>' +
            '</div>' +
            '<div>' +
                '<span class="me-mob-inp-lbl">Marks / ' + fmtMarks(state.maxMarks) + '</span>' +
                '<input type="number" class="me-marks-inp marks-inp" data-idx="' + idx + '" ' +
                       'min="0" max="' + state.maxMarks + '" step="0.5" placeholder="—" style="width:90px;" ' +
                       'value="' + (row.absent ? '' : fmtMarks(row.marks)) + '" ' + ro + '>' +
            '</div>' +
        '</div>' +
        '</div>';
}

function renderGrid() {
    if (!state.rows.length) { closeSheet(); return; }

    document.getElementById('meEmpty').style.display = 'none';
    document.getElementById('markTableBody').innerHTML = state.rows.map(buildTableRow).join('');
    document.getElementById('mobList').innerHTML       = state.rows.map(buildMobCard).join('');

    var lock = locked();
    document.getElementById('btnDraft').disabled    = lock;
    document.getElementById('btnFinalize').disabled = lock;
    document.getElementById('btnClearAll').disabled = lock;

    attachRowEvents();
    renderContext();
}

function attachRowEvents() {
    $('.abs-chk').on('change', function () {
        var idx = parseInt(this.dataset.idx, 10);
        state.rows[idx].absent = this.checked;
        if (this.checked) state.rows[idx].marks = null;
        renderGrid();
    });

    $('.marks-inp').on('input', function () {
        var idx = parseInt(this.dataset.idx, 10);
        var raw = this.value.trim();
        var val = raw === '' ? null : Number(raw);

        if (val !== null && (!isFinite(val) || val < 0)) { val = 0; this.value = 0; }
        if (val !== null && val > state.maxMarks) { val = state.maxMarks; this.value = state.maxMarks; }

        state.rows[idx].marks = val;
        refreshRow(idx);
        renderContext();
    });

    // Enter / Tab moves to the next box
    $('.marks-inp').on('keydown', function (e) {
        if (e.key === 'Enter' || e.key === 'Tab') {
            e.preventDefault();
            var all  = $('.marks-inp:not([readonly]):visible').toArray();
            var next = all[all.indexOf(this) + 1];
            if (next) next.focus();
        }
    });
}

// Only the row tint changes as marks are typed — no cells to rewrite.
function refreshRow(idx) {
    var cls = rowClass(state.rows[idx]);
    var tr = document.querySelector('#markTableBody tr[data-idx="' + idx + '"]');
    if (tr) tr.className = cls;
    var mc = document.querySelector('#mobList .me-mob-card[data-idx="' + idx + '"]');
    if (mc) mc.className = 'me-mob-card ' + cls;
}

$('#btnClearAll').on('click', function () {
    EC.confirm({
        title:   'Clear all marks on this sheet?',
        message: 'You still have to Save for it to take effect.',
        okText:  'Clear marks'
    }).then(function (ok) {
        if (!ok) return;
        state.rows.forEach(function (r) { r.marks = null; r.absent = false; });
        renderGrid();
    });
});

// ── Save ──────────────────────────────────────────────────────────────────
// Send a row when it carries something, or when it already had a saved row —
// otherwise clearing a mark could never be persisted.
function collectItems() {
    var out = [];
    state.rows.forEach(function (r) {
        if (!r.absent && r.marks === null && !r.hadMark) return;
        out.push({ studentId: r.studentId, marks: r.absent ? null : r.marks, absent: r.absent });
    });
    return out;
}

function postSheet($btn, finalize) {
    EC.buttonBusy($btn, finalize ? 'Finalizing…' : 'Saving…');

    return $.ajax({
        url: urls.save,
        type: 'POST',
        contentType: 'application/json',
        headers: { 'RequestVerificationToken': token() },
        data: JSON.stringify({
            examId:          state.examId,
            academicClassId: state.classId,
            subjectId:       state.subjectId,
            section:         state.section,
            finalize:        finalize,
            items:           collectItems()
        })
    })
    .done(function (d) {
        if (!d || !d.success) {
            ecToast('error', (d && d.message) || 'Could not save the marks.');
            return;
        }
        ecToast('success', d.message || 'Marks saved.');
        // Reload so the sheet shows exactly what was stored (finalize turns
        // blanks into Absent server-side).
        loadBtn.click();
    })
    .fail(function () { ecToast('error', 'Could not save the marks. Please retry.'); })
    .always(function () { EC.buttonReset($btn); });
}

$('#btnDraft').on('click', function () { postSheet($(this), false); });

$('#btnFinalize').on('click', function () {
    var pending = state.rows.filter(function (r) { return !r.absent && r.marks === null; }).length;
    var warn = document.getElementById('modalPendingWarn');

    if (pending > 0) {
        warn.classList.remove('d-none');
        document.getElementById('modalPendingCount').textContent = pending;
    } else {
        warn.classList.add('d-none');
    }
    new bootstrap.Modal(document.getElementById('finalizeModal')).show();
});

$('#confirmFinalizeBtn').on('click', function () {
    bootstrap.Modal.getInstance(document.getElementById('finalizeModal')).hide();
    postSheet($('#btnFinalize'), true);
});

// ── Unlock (school admin only; the server checks too) ──────────────────────
$('#btnReopen').on('click', function () {
    var $btn = $(this);

    EC.confirm({
        title:   'Unlock this sheet?',
        name:    state.className + (state.section ? '-' + state.section : '') + ' · ' + state.subjectName,
        message: 'The teacher will be able to edit these marks again.',
        okText:  'Unlock',
        danger:  false
    }).then(function (ok) {
        if (!ok) return;

        EC.buttonBusy($btn);
        $.ajax({
            url: urls.reopen,
            type: 'POST',
            headers: { 'RequestVerificationToken': token() },
            data: {
                examId: state.examId, classId: state.classId,
                subjectId: state.subjectId, section: state.section
            }
        })
        .done(function (d) {
            if (!d || !d.success) {
                ecToast('error', (d && d.message) || 'Could not unlock the sheet.');
                return;
            }
            ecToast('success', d.message || 'Sheet reopened.');
            loadBtn.click();
        })
        .fail(function () { ecToast('error', 'Could not unlock the sheet. Please retry.'); })
        .always(function () { EC.buttonReset($btn); });
    });
});

// ── Init ──────────────────────────────────────────────────────────────────
if (selExam.value) $(selExam).trigger('change');
updateLoadBtn();

}); // end $(document).ready
</script>
}
