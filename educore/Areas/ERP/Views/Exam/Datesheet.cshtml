@using EduCoreDataAccessLayer.Models.ERP
@{
    ViewData["Title"] = "Exam Datesheet";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";

    var classes  = ViewBag.Classes as List<SubjectClassItem> ?? new List<SubjectClassItem>();
    var exams    = ViewBag.Exams   as List<ExamListItem>     ?? new List<ExamListItem>();
    var yearName = ViewBag.AcademicYearName as string ?? string.Empty;
    var sessions  = ViewBag.Sessions as List<SelectListItem> ?? new List<SelectListItem>();
    var sessionId = (int?)ViewBag.SessionId ?? 0;
    var currentSessionId = 0;
    var cur = sessions.FirstOrDefault(x => x.Selected);
    if (cur != null) { int.TryParse(cur.Value, out currentSessionId); }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Exam/Datesheet.css" asp-append-version="true" />
}

<div class="ec-page-shell ds-page">
    <div class="ec-page-content">

        <!-- ── Page header ── -->
        <div class="ec-page-header">
            <div class="ec-page-header-inner">
                <div class="ec-page-title-wrap d-flex align-items-start gap-3">
                    <div class="ec-page-icon"><i class="bx bx-calendar"></i></div>
                    <div>
                        <h4 class="ec-page-title mb-1">Exam Datesheet</h4>
                        <div class="ec-page-subtitle">
                            Which class sits what, and on which date@(string.IsNullOrWhiteSpace(yearName) ? "" : " · " + yearName)
                        </div>
                    </div>
                </div>
                <a asp-area="ERP" asp-controller="Exam" asp-action="CreateExam"
                   class="btn btn-outline-secondary d-flex align-items-center gap-1">
                    <i class="bx bx-plus"></i><span class="d-none d-sm-inline">Exam Schedule</span>
                </a>
            </div>
        </div>

        @if (exams.Count == 0)
        {
            <div class="alert alert-warning" style="border-radius:12px;font-weight:700;">
                No exams have been published for @(string.IsNullOrWhiteSpace(yearName) ? "this session" : yearName) yet.
                <a asp-area="ERP" asp-controller="Exam" asp-action="CreateExam">Create an exam schedule</a> first.
            </div>
        }

        <!-- ── Filters ── -->
        <div class="ec-card mb-3 ds-no-print">
            <div class="ec-card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="ds-label">SESSION</div>
                        <div class="exam-session-pick">
                            <select class="form-select" id="sessionSel">
                                @foreach (var sn in sessions)
                                {
                                    <option value="@sn.Value" selected="@(sn.Value == sessionId.ToString())">@sn.Text</option>
                                }
                            </select>
                            @if (sessionId == currentSessionId)
                            {
                                <span class="exam-session-badge is-current">CURRENT</span>
                            }
                            else
                            {
                                <span class="exam-session-badge is-other">NOT CURRENT</span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="ds-label">CLASS</div>
                        <select class="form-select" id="dsClass">
                            <option value="0">All classes</option>
                            @foreach (var c in classes)
                            {
                                <option value="@c.AcademicClassId">@c.ClassName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="ds-label">EXAM</div>
                        <select class="form-select" id="dsExam">
                            <option value="0">All exams</option>
                            @foreach (var e in exams)
                            {
                                <option value="@e.ExamId">
                                    @e.ExamName@(string.IsNullOrWhiteSpace(e.TypeLabel) ? "" : " (" + e.TypeLabel + ")")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-lg-3 d-flex gap-2">
                        <button type="button" class="btn btn-ds-primary flex-grow-1" id="dsLoad">
                            <i class="bx bx-search me-1"></i>Show datesheet
                        </button>
                        <button type="button" class="btn btn-ds-ghost" id="dsPrint" title="Print">
                            <i class="bx bx-printer"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Result ── -->
        <div class="ec-card">
            <div class="ec-card-body">
                <div class="ds-result-head">
                    <div>
                        <div class="ds-result-title" id="dsTitle">Datesheet</div>
                        <div class="ds-result-sub" id="dsSub">@(string.IsNullOrWhiteSpace(yearName) ? "" : yearName)</div>
                    </div>
                    <div class="ds-count" id="dsCount"></div>
                </div>

                <div class="ds-warn" id="dsWarn" style="display:none;">
                    <i class="bx bx-error-circle"></i><span></span>
                </div>

                <div id="dsBody"></div>
            </div>
        </div>

    </div>
</div>

@section PageScripts {
<script>
$(document).ready(function () {

    var urlRows    = '@Url.Action("DatesheetRows", "Exam", new { area = "ERP" })';
    var SESSION_ID = @sessionId;

    // A session change reloads: the class and exam pickers belong to one session.
    $('#sessionSel').on('change', function () {
        window.location.href = '@Url.Action("Datesheet", "Exam", new { area = "ERP" })' + '?sessionId=' + EC.num(this.value);
    });

    var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var DAYS   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

    // 2026-08-24 -> { day: 'Mon', text: '24 Aug 2026' }
    function fmtDate(iso) {
        if (!iso) return { day: '', text: 'Date not set' };
        var p = String(iso).split('-');
        if (p.length !== 3) return { day: '', text: iso };
        // Build in local time from parts — `new Date('2026-08-24')` parses as UTC
        // and can shift the weekday by a day for anyone behind GMT.
        var d = new Date(EC.num(p[0]), EC.num(p[1]) - 1, EC.num(p[2]));
        return {
            day:  DAYS[d.getDay()],
            text: EC.num(p[2]) + ' ' + MONTHS[EC.num(p[1]) - 1] + ' ' + p[0]
        };
    }

    // 10:00 + 13:00 -> "10:00 – 13:00";  one side only still reads sensibly.
    function fmtTime(from, to) {
        if (!from && !to) return '';
        if (from && to) return from + ' – ' + to;
        return from || to;
    }

    function fmtMarks(v) {
        var n = Number(v);
        return isFinite(n) ? String(n) : '';
    }

    function load() {
        var classId = EC.num($('#dsClass').val());
        var examId  = EC.num($('#dsExam').val());

        $('#dsTitle').text($('#dsClass option:selected').text().trim());
        $('#dsSub').text($('#dsExam option:selected').text().trim());
        $('#dsCount').text('');

        EC.showLoader();
        EC.listLoading('#dsBody', 'Loading datesheet…');

        $.get(urlRows, { classId: classId, examId: examId, sessionId: SESSION_ID })
            .done(function (d) {
                var rows = (d && d.rows) || [];
                if (!rows.length) {
                    EC.listEmpty('#dsBody', 'No papers scheduled for this selection.', 'bx-calendar-x');
                    return;
                }
                render(rows);

                var clashes = rows.filter(function (r) { return r.clash; }).length;
                $('#dsCount').text(rows.length + ' paper' + (rows.length === 1 ? '' : 's'));
                if (clashes) {
                    $('#dsWarn').show().find('span').text(
                        clashes + ' paper' + (clashes === 1 ? ' is' : 's are') +
                        ' scheduled on top of another for the same class. Fix them on the Exam Schedule page.');
                } else {
                    $('#dsWarn').hide();
                }
            })
            .fail(function () {
                EC.listEmpty('#dsBody', 'Could not load the datesheet. Please retry.', 'bx-error-circle');
            })
            .always(EC.hideLoader);
    }

    // Grouped by date, because that is how a datesheet is read.
    function render(rows) {
        var groups = [];
        var byDate = {};

        $.each(rows, function (i, r) {
            var key = r.date || '';
            if (!byDate[key]) { byDate[key] = []; groups.push(key); }
            byDate[key].push(r);
        });

        var showClass = EC.num($('#dsClass').val()) === 0;
        var showExam  = EC.num($('#dsExam').val()) === 0;

        var html = '';
        $.each(groups, function (i, key) {
            var f = fmtDate(key);
            html += '<div class="ds-day">' +
                '<div class="ds-day-head">' +
                    '<span class="ds-day-date">' + EC.esc(f.text) + '</span>' +
                    (f.day ? '<span class="ds-day-name">' + f.day + '</span>' : '') +
                '</div>' +
                '<div class="ds-day-rows">';

            $.each(byDate[key], function (j, r) {
                var time = fmtTime(r.startTime, r.endTime);
                var warn = r.clash
                    ? '<span class="ds-clash" title="This class sits another paper in the same slot">' +
                      '<i class="bx bx-error"></i> clash</span>'
                    : '';
                var cls   = EC.esc(r.className) + (r.sections ? ' (' + EC.esc(r.sections) + ')' : '');

                html += '<div class="ds-row' + (r.clash ? ' is-clash' : '') + '">' +
                    '<div class="ds-row-main">' +
                        '<span class="ds-subject">' + EC.esc(r.subject) + '</span>' +
                        (time ? '<span class="ds-time"><i class="bx bx-time-five"></i> ' + EC.esc(time) + '</span>' : '') +
                        warn +
                        (showClass ? '<span class="ds-chip ds-chip-class">' + cls + '</span>' : '') +
                        (showExam  ? '<span class="ds-chip">' + EC.esc(r.examName) + '</span>' : '') +
                    '</div>' +
                    '<div class="ds-row-marks">' +
                        '<span>Max <strong>' + fmtMarks(r.maxMarks) + '</strong></span>' +
                        '<span>Pass <strong>' + fmtMarks(r.passMarks) + '</strong></span>' +
                    '</div>' +
                    '</div>';
            });

            html += '</div></div>';
        });

        $('#dsBody').html(html);
    }

    $('#dsLoad').on('click', load);
    $('#dsClass, #dsExam').on('change', load);
    $('#dsPrint').on('click', function () { window.print(); });

    load();
});
</script>
}
