@{
    ViewData["Title"] = "Transport Routes";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var routes = ViewBag.Routes as List<EduCoreDataAccessLayer.Models.ERP.TransportRoute>
                 ?? new List<EduCoreDataAccessLayer.Models.ERP.TransportRoute>();
    // route id -> when its parent tracking link was made
    var shares = ViewBag.Shares as Dictionary<int, string> ?? new Dictionary<int, string>();
    bool canManage = ViewBag.CanManage == true;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Transport/Routes.css" asp-append-version="true" />
}

<div class="ec-page-shell tr-page">
  <div class="ec-page-content">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center" style="background:var(--soft);color:var(--p);width:46px;height:46px"><i class="bx bx-map fs-4"></i></div>
        <div>
          <h4 class="mb-0" style="color:var(--heading);font-weight:900">Transport Routes</h4>
          <div class="tr-meta">Configure routes and the monthly fare for each stop</div>
        </div>
      </div>
      <button class="btn btn-primary px-3" id="addRouteBtn"><i class="bx bx-plus me-1"></i>Add Route</button>
    </div>

    <div class="row g-3" id="routeList">
      @if (!routes.Any())
      {
        <div class="col-12"><div class="tr-card p-4 text-center tr-meta">No routes yet. Click <strong>Add Route</strong> to create one with its stops and fares.</div></div>
      }
      @foreach (var r in routes)
      {
        <div class="col-12 col-lg-6">
          <div class="tr-card p-3 d-flex align-items-center gap-3">
            <div class="flex-grow-1">
              <div class="tr-name">@r.RouteName @(r.IsActive ? "" : Html.Raw("<span class='badge-off ms-1'>inactive</span>"))</div>
              <div class="tr-meta">@r.StopCount stop(s)@(string.IsNullOrWhiteSpace(r.Description) ? "" : " · " + r.Description)</div>
              @* Riders now / seats on the route's active vehicles. No vehicle with
                 a capacity = no limit; a full route takes no new riders. *@
              <div class="tr-meta">
                @if (r.Seats.HasValue)
                {
                    <span class="@(r.Riders >= r.Seats ? "text-danger fw-bold" : "")">@r.Riders / @r.Seats seats@(r.Riders >= r.Seats ? " — full" : "")</span>
                }
                else
                {
                    <span>@r.Riders rider(s) · no vehicle capacity set</span>
                }
              </div>
              <div class="tr-fare mt-1">
                @if (r.StopCount > 0) { @($"₹{r.MinFare:0} – ₹{r.MaxFare:0} / month") } else { <span class="tr-meta">No stops</span> }
              </div>
              @* Parent tracking link (live bus tracking). Only its hash is stored, so the
                 link itself is shown once, when it is made; "New link" makes another. *@
              <div class="tr-meta mt-1">
                @if (shares.TryGetValue(r.RouteId, out var sharedAt))
                {
                    <span class="text-success fw-bold"><i class="bx bx-link"></i> Parent link on</span><span> · since @EduCoreDataAccessLayer.Helpers.Dates.Show(sharedAt)</span>
                    @if (canManage)
                    {
                        <button class="btn btn-link btn-sm p-0 ms-2 shareRoute" data-id="@r.RouteId" data-name="@r.RouteName" data-regen="1">New link</button>
                        <button class="btn btn-link btn-sm p-0 ms-2 text-danger revokeShare" data-id="@r.RouteId" data-name="@r.RouteName">Turn off</button>
                    }
                }
                else if (canManage && r.IsActive)
                {
                    <button class="btn btn-link btn-sm p-0 shareRoute" data-id="@r.RouteId" data-name="@r.RouteName"><i class="bx bx-share-alt"></i> Create parent tracking link</button>
                }
              </div>
            </div>
            <div class="d-flex gap-1">
              <button class="btn btn-sm btn-outline-secondary rounded-circle editRoute" data-id="@r.RouteId" data-name="@r.RouteName" data-desc="@r.Description" title="Edit"><i class="bx bx-edit"></i></button>
              <button class="btn btn-sm btn-outline-secondary rounded-circle toggleRoute" data-id="@r.RouteId" title="Toggle active"><i class="bx bx-power-off"></i></button>
              <button class="btn btn-sm btn-outline-danger rounded-circle delRoute" data-id="@r.RouteId" data-name="@r.RouteName" title="Delete"><i class="bx bx-trash"></i></button>
            </div>
          </div>
        </div>
      }
    </div>
  </div>
</div>

<!-- Route modal -->
<div class="modal fade" id="routeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius:18px">
      <div class="modal-header"><h5 class="modal-title" id="routeModalTitle">Add Route</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" id="rRouteId" value="0">
        <div class="row g-3 mb-3">
          <div class="col-md-6"><label class="form-label fw-bold">Route Name</label><input id="rName" class="form-control" placeholder="e.g. North Zone"></div>
          <div class="col-md-6"><label class="form-label fw-bold">Description</label><input id="rDesc" class="form-control" placeholder="Optional"></div>
        </div>
        <label class="form-label fw-bold">Stops &amp; Monthly Fare</label>
        <div class="text-muted small mb-2">A new fare applies to students assigned from now on; students already on a stop keep the fare they were assigned at. A stop that students board at cannot be removed.</div>
        <table class="table table-sm align-middle">
          <thead><tr><th style="width:55%">Stop Name</th><th style="width:30%">Monthly Fare (₹)</th><th></th></tr></thead>
          <tbody id="stopsBody"></tbody>
        </table>
        <button class="btn btn-sm btn-outline-secondary rounded-pill" id="addStopBtn"><i class="bx bx-plus"></i> Add Stop</button>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" id="saveRouteBtn">Save Route</button>
      </div>
    </div>
  </div>
</div>

<!-- Parent link modal: shows a freshly made link once -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:18px">
      <div class="modal-header"><h5 class="modal-title">Parent tracking link</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="alert alert-warning small py-2"><i class="bx bx-info-circle me-1"></i>Copy it now: for safety the link is shown only once. You can always make a new one (the old one then stops working).</div>
        <label class="form-label fw-bold">Link</label>
        <div class="input-group mb-3">
          <input id="shareLink" class="form-control" readonly>
          <button class="btn btn-outline-primary" id="copyLinkBtn" type="button"><i class="bx bx-copy"></i> Copy link</button>
        </div>
        <label class="form-label fw-bold">Message for parents</label>
        <textarea id="shareText" class="form-control mb-2" rows="4" readonly></textarea>
        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-outline-secondary btn-sm" id="copyTextBtn" type="button"><i class="bx bx-copy"></i> Copy message</button>
          <a class="btn btn-success btn-sm" id="waBtn" target="_blank" rel="noopener"><i class="bx bxl-whatsapp"></i> WhatsApp</a>
          <a class="btn btn-outline-secondary btn-sm" id="smsBtn"><i class="bx bx-message"></i> SMS</a>
        </div>
        <div class="text-muted small mt-2">Parents see only this route's bus number and position, and only while a trip is running.</div>
      </div>
      <div class="modal-footer"><button class="btn btn-primary" data-bs-dismiss="modal" id="shareDoneBtn">Done</button></div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
$(function(){
  'use strict';
  var CSRF=$('input[name="__RequestVerificationToken"]').val();
  var URL={ stops:'@Url.Action("GetStops")', save:'@Url.Action("SaveRoute")', del:'@Url.Action("DeleteRoute")', toggle:'@Url.Action("ToggleRouteStatus")',
             share:'@Url.Action("CreateShareLink")', revoke:'@Url.Action("RevokeShareLink")' };
  function post(url,data){ return $.ajax({url:url,type:'POST',contentType:'application/json',headers:{'RequestVerificationToken':CSRF},data:JSON.stringify(data)}); }
  function postForm(url,data){ data.__RequestVerificationToken=CSRF; return $.post(url,data); }

  function stopRow(s){ s=s||{}; return '<tr class="stop-row">'+
      '<td><input class="s-name" value="'+(s.stopName||'').replace(/"/g,"&quot;")+'" placeholder="Stop name"></td>'+
      '<td><input type="number" class="s-fare" min="0" step="1" value="'+(s.monthlyFare||0)+'"></td>'+
      '<td><input type="hidden" class="s-id" value="'+(s.stopId||0)+'"><button class="btn btn-sm btn-outline-danger rounded-circle rmStop"><i class="bx bx-x"></i></button></td></tr>'; }

  $('#addRouteBtn').on('click',function(){
    $('#routeModalTitle').text('Add Route'); $('#rRouteId').val(0); $('#rName').val(''); $('#rDesc').val('');
    $('#stopsBody').html(stopRow()); new bootstrap.Modal('#routeModal').show();
  });
  $('#addStopBtn').on('click',function(){ $('#stopsBody').append(stopRow()); });
  $('#stopsBody').on('click','.rmStop',function(){ $(this).closest('tr').remove(); });

  $('.editRoute').on('click',function(){
    var id=$(this).data('id');
    $('#routeModalTitle').text('Edit Route'); $('#rRouteId').val(id);
    $('#rName').val($(this).data('name')); $('#rDesc').val($(this).data('desc')||'');
    $('#stopsBody').html('<tr><td colspan="3" class="text-muted small">Loading stops…</td></tr>');
    new bootstrap.Modal('#routeModal').show();
    $.getJSON(URL.stops,{routeId:id},function(rows){
      $('#stopsBody').html((rows&&rows.length)? rows.map(function(s){return stopRow({stopId:s.stopId,stopName:s.stopName,monthlyFare:s.monthlyFare});}).join('') : stopRow());
    });
  });

  $('#saveRouteBtn').on('click',function(){
    var name=$('#rName').val().trim();
    if(!name){ ecToast('warning','Enter a route name.'); return; }
    var stops=[]; $('#stopsBody tr').each(function(i){
      var nm=$(this).find('.s-name').val().trim(); if(!nm) return;
      stops.push({ stopId:Number($(this).find('.s-id').val())||0, stopName:nm, monthlyFare:Number($(this).find('.s-fare').val())||0, displayOrder:i+1 });
    });
    var bad=stops.filter(function(s){ return s.monthlyFare<0; });
    if(bad.length){ ecToast('warning','A stop fare cannot be negative.'); return; }
    // Busy while saving: a double click used to create the route twice.
    var $btn=$(this); EC.buttonBusy($btn,'Saving…');
    post(URL.save,{ routeId:Number($('#rRouteId').val())||0, routeName:name, description:$('#rDesc').val().trim(), stops:stops })
      .done(function(res){ if(res.success){ ecToast('success',res.message); setTimeout(function(){location.reload();},600);} else { ecToast('error',res.message); EC.buttonReset($btn); } })
      .fail(function(){ ecToast('error','Could not save the route.'); EC.buttonReset($btn); });
  });

  $('.toggleRoute').on('click',function(){ postForm(URL.toggle,{id:$(this).data('id')}).done(function(res){ ecToast(res.success?'success':'error',res.message); if(res.success) setTimeout(function(){location.reload();},500); }).fail(function(){ ecToast('error','Could not update the route.'); }); });
  $('.delRoute').on('click',function(){
    var id=$(this).data('id');
    EC.confirm({ title:'Delete this route?', name:$(this).data('name'),
                 message:'Stops on it will be removed.', okText:'Delete route' }).then(function(ok){
      if(!ok) return;
      postForm(URL.del,{id:id}).done(function(res){ ecToast(res.success?'success':'error',res.message); if(res.success) setTimeout(function(){location.reload();},500); })
        .fail(function(){ ecToast('error','Could not delete the route.'); });
    });
  });

// ── Parent tracking link ──
  function copyText(text){
    if(navigator.clipboard && window.isSecureContext){
      navigator.clipboard.writeText(text).then(function(){ ecToast('success','Copied.'); },function(){ ecToast('warning','Select the text and copy it.'); });
    } else { ecToast('warning','Select the text and copy it.'); }
  }
  function showShare(name,link){
    var msg='Track the school bus ('+name+') live: '+link+'\nThe position shows while the bus is on a trip.';
    $('#shareLink').val(link); $('#shareText').val(msg);
    $('#waBtn').attr('href','https://wa.me/?text='+encodeURIComponent(msg));
    $('#smsBtn').attr('href','sms:?body='+encodeURIComponent(msg));
    new bootstrap.Modal('#shareModal').show();
  }
  $('.shareRoute').on('click',function(){
    var $btn=$(this), id=$btn.data('id'), name=String($btn.data('name'));
    var make=function(){
      EC.buttonBusy($btn,'Creating…');
      postForm(URL.share,{routeId:id}).done(function(res){
        if(!res.success){ ecToast('error',res.message); EC.buttonReset($btn); return; }
        showShare(name,res.link);
      }).fail(function(){ ecToast('error','Could not create the link.'); EC.buttonReset($btn); });
    };
    if(!$btn.data('regen')){ make(); return; }
    EC.confirm({ title:'Make a new parent link?', name:name, message:'The link parents have now stops working at once.', okText:'Make new link', danger:false })
      .then(function(ok){ if(ok) make(); });
  });
  $('#copyLinkBtn').on('click',function(){ copyText($('#shareLink').val()); });
  $('#copyTextBtn').on('click',function(){ copyText($('#shareText').val()); });
  // The page shows "Parent link on" after a reload; the raw link is never shown again.
  $('#shareModal').on('hidden.bs.modal',function(){ location.reload(); });
  $('.revokeShare').on('click',function(){
    var id=$(this).data('id');
    EC.confirm({ title:'Turn off the parent link?', name:$(this).data('name'), message:'Parents who have the link can no longer see the bus.', okText:'Turn off' })
      .then(function(ok){
        if(!ok) return;
        postForm(URL.revoke,{routeId:id}).done(function(res){ ecToast(res.success?'success':'error',res.message); if(res.success) setTimeout(function(){location.reload();},500); })
          .fail(function(){ ecToast('error','Could not turn off the link.'); });
      });
  });

});
</script>
}
