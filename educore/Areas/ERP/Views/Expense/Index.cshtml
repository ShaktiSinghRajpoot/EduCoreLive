@{
    ViewData["Title"] = "Expenses";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    bool canManage = ViewBag.CanManage == true;
    string today = ViewBag.Today as string ?? "";
}

@section PageStyles {
<style>
  .xp-kpi { border:1px solid var(--bs-border-color); border-radius:12px; padding:.75rem; background:var(--bs-body-bg); }
  .xp-kpi .v { font-size:1.35rem; font-weight:900; line-height:1.1; }
  .xp-kpi .l { font-size:.72rem; font-weight:700; text-transform:uppercase; color:var(--bs-secondary-color); letter-spacing:.03em; }
  tr.xp-cancelled td { text-decoration:line-through; color:var(--bs-secondary-color); }
  tr.xp-cancelled td.xp-keep { text-decoration:none; }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
          <div class="ec-page-title-wrap">
            <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-receipt fs-4"></i></div>
            <div>
              <h4 class="ec-page-title mb-1">Expenses</h4>
              <div class="ec-page-subtitle">What the school spends — electricity, diesel, rent, repairs, events. Salary, store purchases and fee refunds reach the Cash Book on their own: do not enter them here.</div>
            </div>
          </div>
          <div class="d-flex gap-2 ms-lg-auto">
            @if (canManage)
            {
                <button type="button" class="btn btn-outline-primary text-nowrap" id="btnCats"><i class="bx bx-category me-1"></i>Categories</button>
            }
            <a class="btn btn-outline-secondary text-nowrap" href="@Url.Action("CashBook", "Expense", new { area = "ERP" })"><i class="bx bx-book-open me-1"></i>Cash Book</a>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-2 mb-3" id="xpKpis"></div>

    <div class="row g-3">
      @if (canManage)
      {
      <div class="col-12 col-lg-4">
        <div class="ec-card mb-0"><div class="ec-card-body">
          <div class="fw-semibold mb-2">Add expense</div>
          <div class="row g-2">
            <div class="col-6"><label class="form-label mb-1">Date</label><input type="date" id="xDate" class="form-control form-control-sm" value="@today" max="@today"></div>
            <div class="col-6"><label class="form-label mb-1">Amount (₹)</label><input type="number" id="xAmount" class="form-control form-control-sm" min="0" step="0.01"></div>
            <div class="col-12"><label class="form-label mb-1">Category</label><select id="xCat" class="form-select form-select-sm"></select></div>
            <div class="col-6"><label class="form-label mb-1">Paid by</label>
              <select id="xMode" class="form-select form-select-sm">
                <option>Cash</option><option>UPI</option><option>Bank Transfer</option><option>Cheque</option><option>Card</option>
              </select></div>
            <div class="col-6"><label class="form-label mb-1">Bill / ref no. <span class="text-muted">(optional)</span></label><input id="xRef" class="form-control form-control-sm" maxlength="60"></div>
            <div class="col-12"><label class="form-label mb-1">Paid to <span class="text-muted">(optional)</span></label><input id="xPaidTo" class="form-control form-control-sm" maxlength="150" placeholder="e.g. UPPCL / Sharma Electricals"></div>
            <div class="col-12"><label class="form-label mb-1">Remarks <span class="text-muted">(optional)</span></label><input id="xRemarks" class="form-control form-control-sm" maxlength="300"></div>
          </div>
          <button type="button" class="btn btn-primary w-100 mt-3" id="xSave"><i class="bx bx-check me-1"></i>Save expense</button>
        </div></div>
      </div>
      }

      <div class="col-12 @(canManage ? "col-lg-8" : "")">
        <div class="ec-card mb-0"><div class="ec-card-body">
          <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
            <div class="btn-group btn-group-sm flex-wrap" role="group">
              <button type="button" class="btn btn-outline-primary active" data-range="month">This month</button>
              <button type="button" class="btn btn-outline-primary" data-range="last">Last month</button>
              <button type="button" class="btn btn-outline-primary" data-range="last3">Last 3 months</button>
            </div>
            <div><label class="form-label mb-1">From</label><input type="date" id="fFrom" class="form-control form-control-sm"></div>
            <div><label class="form-label mb-1">To</label><input type="date" id="fTo" class="form-control form-control-sm"></div>
            <div><label class="form-label mb-1">Category</label><select id="fCat" class="form-select form-select-sm"><option value="">All</option></select></div>
            <button type="button" class="btn btn-sm btn-primary" id="fShow"><i class="bx bx-search me-1"></i>Show</button>
          </div>
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead><tr><th>Date</th><th>Category</th><th class="d-none d-md-table-cell">Paid to</th><th class="d-none d-sm-table-cell">Mode</th><th class="text-end">Amount</th><th class="d-none d-lg-table-cell">Entered by</th><th></th></tr></thead>
              <tbody id="xList"><tr><td colspan="7" class="text-muted small p-3">Loading…</td></tr></tbody>
            </table>
          </div>
        </div></div>
      </div>
    </div>

    @Html.AntiForgeryToken()
  </div>
</div>

<!-- Categories -->
<div class="modal fade" id="catModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content" style="border:0;border-radius:20px;overflow:hidden;">
      <div class="ec-card-header d-flex align-items-center justify-content-between p-3 p-lg-4">
        <div>
          <div class="ec-section-title">Expense categories</div>
          <div class="ec-section-subtitle">A category is never deleted (old expenses keep its name). Hide it to stop using it.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="ec-card-body p-3 p-lg-4">
        <div class="input-group input-group-sm mb-3">
          <input id="catNew" class="form-control" maxlength="60" placeholder="New category, e.g. Security Guard">
          <button class="btn btn-primary" type="button" id="catAdd">Add</button>
        </div>
        <div id="catList"></div>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
$(function () {
    var URL = {
        cats:   '@Url.Action("Categories", "Expense", new { area = "ERP" })',
        catSave:'@Url.Action("SaveCategory", "Expense", new { area = "ERP" })',
        catAct: '@Url.Action("SetCategoryActive", "Expense", new { area = "ERP" })',
        list:   '@Url.Action("List", "Expense", new { area = "ERP" })',
        save:   '@Url.Action("Save", "Expense", new { area = "ERP" })',
        cancel: '@Url.Action("Cancel", "Expense", new { area = "ERP" })'
    };
    var CAN_MANAGE = @(canManage ? "true" : "false");
    var cats = [];

    function token() { return $('input[name="__RequestVerificationToken"]').val(); }
    function post(url, data) {
        return $.ajax({ url: url, type: 'POST', contentType: 'application/json',
                        headers: { 'RequestVerificationToken': token() }, data: JSON.stringify(data) });
    }

    /* ── categories ── */
    function loadCats() {
        return $.getJSON(URL.cats).done(function (list) {
            cats = list || [];
            var active = cats.filter(function (c) { return c.active; });
            var keep = $('#xCat').val();
            $('#xCat').html('<option value="">Choose…</option>' + active.map(function (c) {
                return '<option value="' + c.id + '">' + EC.esc(c.name) + '</option>';
            }).join('')).val(keep || '');
            var keepF = $('#fCat').val();
            $('#fCat').html('<option value="">All</option>' + cats.map(function (c) {
                return '<option value="' + c.id + '">' + EC.esc(c.name) + (c.active ? '' : ' (hidden)') + '</option>';
            }).join('')).val(keepF || '');
            renderCats();
        });
    }

    function renderCats() {
        $('#catList').html(cats.map(function (c) {
            return '<div class="d-flex align-items-center gap-2 py-1 border-bottom">'
                 + '<input class="form-control form-control-sm cat-name" data-id="' + c.id + '" value="' + EC.esc(c.name) + '" maxlength="60">'
                 + '<span class="small text-muted text-nowrap">' + c.used + ' used</span>'
                 + '<button type="button" class="btn btn-sm ' + (c.active ? 'btn-outline-secondary' : 'btn-outline-success') + ' cat-act text-nowrap" data-id="' + c.id + '" data-active="' + (c.active ? '0' : '1') + '">'
                 + (c.active ? 'Hide' : 'Show') + '</button></div>';
        }).join(''));
    }

    $('#btnCats').on('click', function () { renderCats(); new bootstrap.Modal(document.getElementById('catModal')).show(); });
    $('#catAdd').on('click', function () {
        var n = $('#catNew').val().trim();
        if (!n) return;
        post(URL.catSave, { name: n }).done(function (r) {
            if (r && r.success) { $('#catNew').val(''); ecToast('success', r.message); loadCats(); }
            else ecToast('error', (r && r.message) || 'Could not save.');
        });
    });
    // rename when the box loses focus with a changed name
    $('#catList').on('change', '.cat-name', function () {
        var id = +$(this).data('id'), n = this.value.trim();
        post(URL.catSave, { id: id, name: n }).done(function (r) {
            if (r && r.success) { ecToast('success', r.message); loadCats(); }
            else { ecToast('error', (r && r.message) || 'Could not rename.'); loadCats(); }
        });
    });
    $('#catList').on('click', '.cat-act', function () {
        post(URL.catAct, { id: +$(this).data('id'), active: $(this).data('active') === 1 }).done(function (r) {
            if (r && r.success) { ecToast('success', r.message); loadCats(); }
            else ecToast('error', (r && r.message) || 'Could not change.');
        });
    });

    /* ── list ── */
    var first = EC.dateRange('month');
    $('#fFrom').val(first.from); $('#fTo').val(first.to);
    $('[data-range]').on('click', function () {
        var r = EC.dateRange($(this).data('range'));
        $('[data-range]').removeClass('active'); $(this).addClass('active');
        $('#fFrom').val(r.from); $('#fTo').val(r.to);
        loadList();
    });
    $('#fFrom, #fTo').on('change', function () { $('[data-range]').removeClass('active'); });
    $('#fShow').on('click', loadList);
    $('#fCat').on('change', loadList);

    function loadList() {
        $.getJSON(URL.list, { from: $('#fFrom').val(), to: $('#fTo').val(), categoryId: $('#fCat').val() || null }).done(function (rows) {
            rows = rows || [];
            var live = rows.filter(function (x) { return !x.cancelled; });
            var total = live.reduce(function (t, x) { return t + x.amount; }, 0);
            var today = EC.today();
            var todayTotal = live.filter(function (x) { return x.date === today; }).reduce(function (t, x) { return t + x.amount; }, 0);
            var byCat = {};
            live.forEach(function (x) { byCat[x.category] = (byCat[x.category] || 0) + x.amount; });
            var top = Object.keys(byCat).sort(function (a, b) { return byCat[b] - byCat[a]; })[0];
            var kpi = function (label, val, color) {
                return '<div class="col-6 col-md-3"><div class="xp-kpi"><div class="v" style="color:' + color + '">' + val + '</div><div class="l">' + label + '</div></div></div>';
            };
            $('#xpKpis').html(kpi('Spent in these dates', EC.money(total), '#dc2626') + kpi('Spent today', EC.money(todayTotal), '#b45309')
                + kpi('Expenses', live.length, '#334155') + kpi('Biggest head', top ? EC.esc(top) + ' · ' + EC.money(byCat[top]) : '—', '#0f766e'));

            if (!rows.length) { $('#xList').html('<tr><td colspan="7" class="text-muted small p-3">No expenses in these dates.</td></tr>'); return; }
            $('#xList').html(rows.map(function (x) {
                return '<tr class="' + (x.cancelled ? 'xp-cancelled' : '') + '">'
                     + '<td class="text-nowrap small">' + EC.esc(EC.date(x.date)) + '<div class="text-muted">EXP-' + x.id + '</div></td>'
                     + '<td>' + EC.esc(x.category) + (x.remarks ? '<div class="small text-muted">' + EC.esc(x.remarks) + '</div>' : '') + '</td>'
                     + '<td class="d-none d-md-table-cell">' + EC.esc(x.paidTo || '—') + (x.reference ? '<div class="small text-muted">' + EC.esc(x.reference) + '</div>' : '') + '</td>'
                     + '<td class="d-none d-sm-table-cell">' + EC.esc(x.mode) + '</td>'
                     + '<td class="text-end fw-semibold">' + EC.money(x.amount) + '</td>'
                     + '<td class="d-none d-lg-table-cell small">' + EC.esc(x.by) + '</td>'
                     + '<td class="text-end xp-keep">' + (x.cancelled
                          ? '<span class="badge bg-label-secondary" title="' + EC.esc(x.cancelReason + ' · ' + x.cancelledBy + ' ' + x.cancelledAt) + '">Cancelled</span>'
                          : (CAN_MANAGE ? '<button type="button" class="btn btn-sm btn-outline-danger xp-cancel" data-id="' + x.id + '" data-name="' + EC.esc(x.category + ' · ' + EC.money(x.amount)) + '">Cancel</button>' : '')) + '</td></tr>';
            }).join('') + '<tr><td colspan="4" class="text-end fw-bold">Total (not cancelled)</td><td class="text-end fw-bold">' + EC.money(total) + '</td><td colspan="2"></td></tr>');
        }).fail(function () { $('#xList').html('<tr><td colspan="7" class="text-muted small p-3">Could not load the expenses.</td></tr>'); });
    }

    $('#xList').on('click', '.xp-cancel', function () {
        var id = +$(this).data('id');
        EC.prompt({ title: 'Cancel this expense?', name: $(this).data('name'), label: 'Reason', required: true,
                    placeholder: 'Entered twice / wrong amount', okText: 'Cancel expense' }).then(function (reason) {
            if (reason === null) return;
            post(URL.cancel, { id: id, reason: reason }).done(function (r) {
                if (r && r.success) { ecToast('success', r.message); loadList(); loadCats(); }
                else ecToast('error', (r && r.message) || 'Could not cancel.');
            }).fail(function (xhr) { ecToast('error', EC.ajaxError(xhr, 'Could not cancel')); });
        });
    });

    /* ── add ── */
    $('#xSave').on('click', function () {
        var amt = EC.numPos($('#xAmount').val());
        if (!$('#xCat').val()) { ecToast('warning', 'Choose a category.'); return; }
        if (amt <= 0) { ecToast('warning', 'Enter the amount paid.'); return; }
        var $btn = $(this);
        EC.buttonBusy($btn, 'Saving…');
        post(URL.save, { expenseDate: $('#xDate').val(), categoryId: +$('#xCat').val(), amount: amt, paymentMode: $('#xMode').val(),
                         paidTo: $('#xPaidTo').val().trim() || null, referenceNo: $('#xRef').val().trim() || null, remarks: $('#xRemarks').val().trim() || null })
            .done(function (r) {
                if (r && r.success) {
                    ecToast('success', r.message);
                    $('#xAmount, #xPaidTo, #xRef, #xRemarks').val('');
                    loadList(); loadCats();
                } else ecToast('error', (r && r.message) || 'Could not save.');
            })
            .fail(function (xhr) { ecToast('error', EC.ajaxError(xhr, 'Could not save')); })
            .always(function () { EC.buttonReset($btn); });
    });

    loadCats().always(loadList);
});
</script>
}
