@{
    ViewData["Title"] = "Cash Book";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    bool canManage = ViewBag.CanManage == true;
    string today = ViewBag.Today as string ?? "";
    string? sessionStart = ViewBag.SessionStart as string;
}

@section PageStyles {
<style>
  .cb-kpi { border:1px solid var(--bs-border-color); border-radius:12px; padding:.75rem; background:var(--bs-body-bg); }
  .cb-kpi .v { font-size:1.35rem; font-weight:900; line-height:1.1; }
  .cb-kpi .l { font-size:.72rem; font-weight:700; text-transform:uppercase; color:var(--bs-secondary-color); letter-spacing:.03em; }
  .cb-in  { color:#16a34a; } .cb-out { color:#dc2626; }
  @@media print {
    .layout-menu, .layout-navbar, .cb-filters, .content-footer, .footer, .cb-noprint { display:none !important; }
    .layout-page { padding:0 !important; }
  }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
          <div class="ec-page-title-wrap">
            <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-book-open fs-4"></i></div>
            <div>
              <h4 class="ec-page-title mb-1">Cash Book</h4>
              <div class="ec-page-subtitle" id="cbSubtitle">Every rupee in and out: fees, refunds, salaries, store purchases and expenses</div>
            </div>
          </div>
          <div class="d-flex gap-2 cb-noprint ms-lg-auto">
            <a class="btn btn-outline-secondary text-nowrap" href="@Url.Action("Index", "Expense", new { area = "ERP" })"><i class="bx bx-receipt me-1"></i>Expenses</a>
            <button type="button" class="btn btn-outline-secondary text-nowrap" onclick="window.print()"><i class="bx bx-printer me-1"></i>Print</button>
          </div>
        </div>
      </div>
    </div>

    <div class="ec-card mb-3 cb-filters"><div class="ec-card-body d-flex flex-wrap gap-2 align-items-end">
      <div class="btn-group btn-group-sm flex-wrap" role="group">
        <button type="button" class="btn btn-outline-primary" data-range="today">Today</button>
        <button type="button" class="btn btn-outline-primary active" data-range="month">This month</button>
        <button type="button" class="btn btn-outline-primary" data-range="last">Last month</button>
        @if (!string.IsNullOrEmpty(sessionStart))
        {
            <button type="button" class="btn btn-outline-primary" data-range="session">This session</button>
        }
      </div>
      <div><label class="form-label mb-1">From</label><input type="date" id="cFrom" class="form-control form-control-sm" max="@today"></div>
      <div><label class="form-label mb-1">To</label><input type="date" id="cTo" class="form-control form-control-sm" max="@today"></div>
      <div><label class="form-label mb-1">Book</label>
        <select id="cBook" class="form-select form-select-sm">
          <option value="All">Cash + Bank</option>
          <option value="Cash">Cash in hand</option>
          <option value="Bank">Bank (UPI, card, cheque, transfer)</option>
        </select></div>
      <button type="button" class="btn btn-sm btn-primary" id="cShow"><i class="bx bx-search me-1"></i>Show</button>
    </div></div>

    <div class="row g-2 mb-2" id="cbKpis"></div>
    <div class="small text-muted mb-3 d-flex flex-wrap align-items-center gap-2" id="cbOpening"></div>

    <div class="row g-3 mb-3">
      <div class="col-12 col-lg-6">
        <div class="ec-card mb-0 h-100"><div class="ec-card-body">
          <div class="fw-semibold mb-2">Where it came from, where it went</div>
          <div class="table-responsive"><table class="table table-sm mb-0">
            <thead><tr><th>Head</th><th class="text-end">In</th><th class="text-end">Out</th></tr></thead>
            <tbody id="cbHeads"></tbody>
          </table></div>
        </div></div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="ec-card mb-0 h-100"><div class="ec-card-body">
          <div class="fw-semibold mb-2">Month by month</div>
          <div class="table-responsive"><table class="table table-sm mb-0">
            <thead><tr><th>Month</th><th class="text-end">In</th><th class="text-end">Out</th><th class="text-end">Saved</th></tr></thead>
            <tbody id="cbMonths"></tbody>
          </table></div>
        </div></div>
      </div>
    </div>

    <div class="ec-card mb-0"><div class="ec-card-body p-0">
      <div class="px-3 pt-3 fw-semibold">Entries</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead><tr><th>Date</th><th>Entry</th><th class="d-none d-md-table-cell">Details</th><th class="d-none d-sm-table-cell">Mode</th><th class="text-end">In</th><th class="text-end">Out</th><th class="text-end">Balance</th></tr></thead>
          <tbody id="cbLines"><tr><td colspan="7" class="text-muted small p-3">Loading…</td></tr></tbody>
        </table>
      </div>
    </div></div>

    @Html.AntiForgeryToken()
  </div>
</div>

<!-- Opening balance -->
<div class="modal fade" id="openModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:0;border-radius:20px;overflow:hidden;">
      <div class="ec-card-header d-flex align-items-center justify-content-between p-3 p-lg-4">
        <div>
          <div class="ec-section-title">Opening balance</div>
          <div class="ec-section-subtitle">What the school had on the morning of this date. The Cash Book starts here.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="ec-card-body p-3 p-lg-4">
        <div class="row g-2">
          <div class="col-12"><label class="form-label mb-1">As on</label><input type="date" id="oAsOn" class="form-control" max="@today"></div>
          <div class="col-6"><label class="form-label mb-1">Cash in hand (₹)</label><input type="number" id="oCash" class="form-control" min="0" step="0.01"></div>
          <div class="col-6"><label class="form-label mb-1">In the bank (₹)</label><input type="number" id="oBank" class="form-control" min="0" step="0.01"></div>
        </div>
      </div>
      <div class="ec-card-body pt-0 p-3 p-lg-4 d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary px-4" id="oSave"><i class="bx bx-check me-1"></i>Save</button>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
$(function () {
    var DATA_URL = '@Url.Action("CashBookData", "Expense", new { area = "ERP" })';
    var OPEN_URL = '@Url.Action("SetOpening", "Expense", new { area = "ERP" })';
    var CAN_MANAGE = @(canManage ? "true" : "false");
    var SESSION_START = '@(sessionStart ?? "")';
    var opening = null;      // the saved opening balance, if any

    function token() { return $('input[name="__RequestVerificationToken"]').val(); }
    function range(kind) {
        if (kind === 'today') { var t = EC.today(); return { from: t, to: t }; }
        return EC.dateRange(kind, SESSION_START);
    }
    function monthName(ym) {
        var p = ym.split('-'), names = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        return names[Number(p[1]) - 1] + ' ' + p[0];
    }

    var first = range('month');
    $('#cFrom').val(first.from); $('#cTo').val(first.to);
    $('[data-range]').on('click', function () {
        var r = range($(this).data('range'));
        $('[data-range]').removeClass('active'); $(this).addClass('active');
        $('#cFrom').val(r.from); $('#cTo').val(r.to);
        load();
    });
    $('#cFrom, #cTo').on('change', function () { $('[data-range]').removeClass('active'); });
    $('#cShow').on('click', load);
    $('#cBook').on('change', load);

    function load() {
        $('#cbLines').html('<tr><td colspan="7" class="text-muted small p-3">Loading…</td></tr>');
        $.getJSON(DATA_URL, { from: $('#cFrom').val(), to: $('#cTo').val(), book: $('#cBook').val() }).done(function (r) {
            if (!r || !r.success) { ecToast('error', (r && r.message) || 'Could not load the Cash Book.'); return; }
            opening = r.openingSet;
            var bookName = $('#cBook option:selected').text();
            $('#cbSubtitle').text(bookName + ' · ' + EC.date(r.bookFrom || $('#cFrom').val()) + ' to ' + EC.date($('#cTo').val()));

            var kpi = function (label, val, cls) {
                return '<div class="col-6 col-md-3"><div class="cb-kpi"><div class="v ' + cls + '">' + EC.money(val) + '</div><div class="l">' + label + '</div></div></div>';
            };
            $('#cbKpis').html(kpi('Opening', r.opening, '') + kpi('Money in', r.moneyIn, 'cb-in') + kpi('Money out', r.moneyOut, 'cb-out')
                            + kpi('Closing balance', r.closing, r.closing < 0 ? 'cb-out' : ''));

            var o = r.openingSet;
            $('#cbOpening').html((o
                ? 'Opening balance set as on <b>' + EC.esc(EC.date(o.asOn)) + '</b>: cash ' + EC.money(o.cash) + ' · bank ' + EC.money(o.bank)
                  + (o.by ? ' (by ' + EC.esc(o.by) + ')' : '') + '. Days before it are not in the book.'
                : 'No opening balance set yet, so the book starts from 0 at the first entry ever.')
                + (CAN_MANAGE ? ' <button type="button" class="btn btn-sm btn-outline-primary cb-noprint" id="btnOpening">' + (o ? 'Change' : 'Set opening balance') + '</button>' : ''));

            $('#cbHeads').html(r.heads.length ? r.heads.map(function (h) {
                return '<tr><td>' + EC.esc(h.category) + ' <span class="text-muted small">(' + h.entries + ')</span></td>'
                     + '<td class="text-end cb-in">' + (h.moneyIn ? EC.money(h.moneyIn) : '—') + '</td>'
                     + '<td class="text-end cb-out">' + (h.moneyOut ? EC.money(h.moneyOut) : '—') + '</td></tr>';
            }).join('') : '<tr><td colspan="3" class="text-muted small">Nothing in these dates.</td></tr>');

            $('#cbMonths').html(r.months.length ? r.months.map(function (m) {
                return '<tr><td>' + monthName(m.month) + '</td><td class="text-end cb-in">' + EC.money(m.moneyIn) + '</td>'
                     + '<td class="text-end cb-out">' + EC.money(m.moneyOut) + '</td>'
                     + '<td class="text-end fw-semibold ' + (m.net < 0 ? 'cb-out' : 'cb-in') + '">' + EC.money(m.net) + '</td></tr>';
            }).join('') : '<tr><td colspan="4" class="text-muted small">Nothing in these dates.</td></tr>');

            $('#cbLines').html(
                '<tr class="table-light"><td colspan="6" class="fw-semibold">Opening balance</td><td class="text-end fw-bold">' + EC.money(r.opening) + '</td></tr>'
                + r.lines.map(function (l) {
                    return '<tr><td class="text-nowrap small">' + EC.esc(EC.date(l.date)) + '</td>'
                         + '<td>' + EC.esc(l.kind) + '<div class="small text-muted">' + EC.esc(l.reference) + (l.category !== 'Fees' ? ' · ' + EC.esc(l.category) : '') + '</div></td>'
                         + '<td class="d-none d-md-table-cell small">' + EC.esc(l.detail || '—') + '</td>'
                         + '<td class="d-none d-sm-table-cell small">' + EC.esc(l.mode) + '</td>'
                         + '<td class="text-end cb-in">' + (l.moneyIn ? EC.money(l.moneyIn) : '') + '</td>'
                         + '<td class="text-end cb-out">' + (l.moneyOut ? EC.money(l.moneyOut) : '') + '</td>'
                         + '<td class="text-end fw-semibold">' + EC.money(l.balance) + '</td></tr>';
                }).join('')
                + '<tr class="table-light"><td colspan="4" class="fw-semibold text-end">Total</td><td class="text-end fw-bold cb-in">' + EC.money(r.moneyIn) + '</td>'
                + '<td class="text-end fw-bold cb-out">' + EC.money(r.moneyOut) + '</td><td class="text-end fw-bold">' + EC.money(r.closing) + '</td></tr>');
        }).fail(function () { ecToast('error', 'Could not load the Cash Book.'); });
    }

    $('#cbOpening').on('click', '#btnOpening', function () {
        $('#oAsOn').val(opening ? opening.asOn : EC.dateRange('month').from);
        $('#oCash').val(opening ? opening.cash : '');
        $('#oBank').val(opening ? opening.bank : '');
        new bootstrap.Modal(document.getElementById('openModal')).show();
    });
    $('#oSave').on('click', function () {
        var $btn = $(this);
        EC.buttonBusy($btn, 'Saving…');
        $.ajax({ url: OPEN_URL, type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': token() },
                 data: JSON.stringify({ asOn: $('#oAsOn').val(), cash: EC.numPos($('#oCash').val()), bank: EC.numPos($('#oBank').val()) }) })
            .done(function (r) {
                if (r && r.success) { bootstrap.Modal.getInstance(document.getElementById('openModal')).hide(); ecToast('success', r.message); load(); }
                else ecToast('error', (r && r.message) || 'Could not save.');
            })
            .fail(function (xhr) { ecToast('error', EC.ajaxError(xhr, 'Could not save')); })
            .always(function () { EC.buttonReset($btn); });
    });

    load();
});
</script>
}
