@{
    ViewData["Title"] = "My Timetable";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var me = ViewBag.Me as EduCoreDataAccessLayer.Models.ERP.MyStaffInfo;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/SchoolSettings/Timetable.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-time-five fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">My Timetable</h4>
            <div class="ec-page-subtitle">Your week. Click a free period to request a class — it goes live once an admin approves it.</div>
          </div>
        </div>
      </div>
    </div>

    @if (me == null)
    {
        <div class="alert alert-info">My Timetable is for staff. Your login is not linked to a staff record.</div>
    }
    else
    {
    <div class="ec-card mb-4">
      <div class="ec-card-header">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-calendar-week"></i></span>
          <div>
            <div class="ec-section-title">My week</div>
            <div class="ec-section-subtitle">
              Coloured = your live periods · <span class="text-warning fw-bold">dashed orange</span> = waiting for approval · “+ Request” on a free period.
            </div>
          </div>
        </div>
      </div>
      <div class="ec-card-body p-0">
        <div class="table-responsive tt-wrap">
          <table class="sv-grid" style="min-width:640px;">
            <thead id="mtHead"></thead>
            <tbody id="mtBody"><tr><td class="text-muted py-4">Loading…</td></tr></tbody>
          </table>
        </div>
        <!-- phone: one day at a time -->
        <div class="tt-mob p-3">
          <div class="tt-days" id="mtDays"></div>
          <div id="mtMobList"></div>
        </div>
      </div>
    </div>

    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-list-check"></i></span>
          <div>
            <div class="ec-section-title">My requests</div>
            <div class="ec-section-subtitle">The last 60 days. A rejected request shows the admin's reason.</div>
          </div>
        </div>
      </div>
      <div class="ec-card-body p-0">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Period</th><th>Class</th><th>Subject</th><th>Status</th><th></th></tr></thead>
            <tbody id="mtReqBody"></tbody>
          </table>
        </div>
      </div>
    </div>
    }

  </div>
</div>

@* Request a period *@
<div class="modal fade" id="mtModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Request a period</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3 fw-semibold" id="mtSlot"></div>
        <div class="mb-3">
          <label class="form-label">Class</label>
          <select class="form-select" id="mtSection"></select>
        </div>
        <div class="mb-1">
          <label class="form-label">Subject</label>
          <select class="form-select" id="mtSubject"><option value="">Pick a class first</option></select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="mtSend"><i class="bx bx-send me-1"></i>Send request</button>
      </div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
$(function () {
    'use strict';

    var URL = {
        data:     '@Url.Action("Data", "MyTimetable", new { area = "ERP" })',
        subjects: '@Url.Action("Subjects", "MyTimetable", new { area = "ERP" })',
        request:  '@Url.Action("SendRequest", "MyTimetable", new { area = "ERP" })',
        cancel:   '@Url.Action("Cancel", "MyTimetable", new { area = "ERP" })'
    };
    var CSRF = $('input[name="__RequestVerificationToken"]').val();
    var D = null;          // the page data from URL.data
    var slot = null;       // the period being requested: {day, seq, label}
    var MOB_DAY = null;    // the day shown on a phone

    function post(url, body) {
        return $.ajax({ url: url, type: 'POST', contentType: 'application/json',
                        headers: { 'RequestVerificationToken': CSRF }, data: JSON.stringify(body) });
    }

    function load() {
        $.getJSON(URL.data).done(function (d) {
            if (!d || !d.success) { ecToast('error', (d && d.message) || 'Could not load your timetable.'); return; }
            D = d;
            $('#mtSection').html('<option value="">Pick a class</option>' + d.sections.map(function (s) {
                return '<option value="' + s.id + '">' + EC.esc(s.label) + '</option>';
            }).join(''));
            drawWeek();
            drawMobile();
            drawRequests();
        }).fail(function () { ecToast('error', 'Could not load your timetable.'); });
    }

    // Rows = period numbers (from the first day that has them); columns = days.
    function periodRows() {
        var rows = [];
        D.periods.forEach(function (p) {
            if (!rows.some(function (r) { return r.seq === p.seq; })) rows.push({ seq: p.seq, label: p.label, time: p.time, type: p.type });
        });
        return rows.sort(function (a, b) { return a.seq - b.seq; });
    }

    function drawWeek() {
        var rows = periodRows();

        $('#mtHead').html('<tr><th>Period</th>' + D.days.map(function (d) { return '<th>' + EC.esc(d.label) + '</th>'; }).join('') + '</tr>');

        $('#mtBody').html(rows.map(function (r) {
            if (r.type !== 'class') {
                return '<tr class="tt-break"><td colspan="' + (D.days.length + 1) + '">' + EC.esc(r.label) + ' · ' + EC.esc(r.time) + '</td></tr>';
            }
            return '<tr><td><div class="tt-pcell"><div class="tt-pname">' + EC.esc(r.label) + '</div><div class="tt-ptime">' + EC.esc(r.time) + '</div></div></td>'
                 + D.days.map(function (d) { return '<td>' + cell(d, r) + '</td>'; }).join('') + '</tr>';
        }).join(''));
    }

    // Phone: day pills (today first picked) and that day's periods stacked.
    function drawMobile() {
        if (MOB_DAY === null) {
            var today = new Date().getDay();
            MOB_DAY = D.days.some(function (d) { return d.day === today; }) ? today : (D.days[0] || { day: 1 }).day;
        }
        $('#mtDays').html(D.days.map(function (d) {
            return '<button type="button" class="tt-day' + (d.day === MOB_DAY ? ' on' : '') + '" data-day="' + d.day + '">' + EC.esc(d.label.slice(0, 3)) + '</button>';
        }).join(''));

        var day = D.days.filter(function (d) { return d.day === MOB_DAY; })[0];
        $('#mtMobList').html(periodRows().map(function (r) {
            if (r.type !== 'class') return '<div class="tt-mbreak">' + EC.esc(r.label) + '</div>';
            return '<div class="tt-mrow"><div class="tt-mp"><div class="tt-mp-name">' + EC.esc(r.label) + '</div><div class="tt-mp-time">' + EC.esc(r.time) + '</div></div>'
                 + '<div>' + cell(day, r) + '</div></div>';
        }).join(''));
    }

    // One period's content, shared by the week grid and the phone list.
    function cell(d, r) {
        var isPeriod = D.periods.some(function (p) { return p.day === d.day && p.seq === r.seq && p.type === 'class'; });
        if (!isPeriod) return '<div class="sv-empty" style="opacity:.5">—</div>';

        var live = D.live.filter(function (e) { return e.day === d.day && e.seq === r.seq; })[0];
        var req  = D.requests.filter(function (q) { return q.day === d.day && q.seq === r.seq && q.status === 'Pending'; })[0];

        var html = '';
        var ask = ' data-day="' + d.day + '" data-seq="' + r.seq + '" data-label="' + EC.esc(d.label + ', ' + r.label) + '"';
        if (live) {
            // Same tinted card as the School view; clicking it asks for a change.
            var n = ((Math.abs(live.subjectId) - 1) % 8) + 1;
            html += '<div class="sv-cell t' + n + (req ? '' : ' mt-ask') + '"' + ask + ' title="' + (req ? '' : 'Click to request a change') + '">'
                  + '<span class="sv-ini s' + n + '">' + EC.esc(live.subject.slice(0, 2).toUpperCase()) + '</span>'
                  + '<div><div class="sv-sub">' + EC.esc(live.subject) + '</div><div class="sv-tch">' + EC.esc(live.section) + '</div></div></div>';
        } else if (!req) {
            html += '<div class="sv-empty mt-ask" style="cursor:pointer"' + ask + '>+ Request</div>';
        }
        if (req) html += '<div class="sv-req"><div>Waiting: ' + EC.esc(req.subject) + '<br>' + EC.esc(req.section) + '</div></div>';
        return html;
    }

    function drawRequests() {
        if (!D.requests.length) { $('#mtReqBody').html('<tr><td colspan="5" class="text-muted text-center py-3">No requests yet.</td></tr>'); return; }
        var badge = { Pending: 'bg-label-warning', Approved: 'bg-label-success', Rejected: 'bg-label-danger' };
        $('#mtReqBody').html(D.requests.map(function (q) {
            var day = (D.days.filter(function (d) { return d.day === q.day; })[0] || { label: '?' }).label;
            return '<tr><td class="text-nowrap">' + EC.esc(day) + ', ' + EC.esc(q.period || ('period ' + q.seq)) + '</td>'
                 + '<td>' + EC.esc(q.section) + '</td><td>' + EC.esc(q.subject) + '</td>'
                 + '<td><span class="badge ' + (badge[q.status] || 'bg-label-secondary') + '">' + EC.esc(q.status) + '</span>'
                 + (q.note ? '<div class="small text-muted mt-1">' + EC.esc(q.note) + '</div>' : '') + '</td>'
                 + '<td class="text-end">' + (q.status === 'Pending'
                     ? '<button type="button" class="btn btn-sm btn-outline-danger mt-cancel" data-id="' + q.id + '">Cancel</button>' : '') + '</td></tr>';
        }).join(''));
    }

    // Open the request pop-up for a free (or own) period.
    $('#mtDays').on('click', '.tt-day', function () { MOB_DAY = Number($(this).attr('data-day')); drawMobile(); });

    $('#mtBody, #mtMobList').on('click', '.mt-ask', function () {
        slot = { day: Number($(this).attr('data-day')), seq: Number($(this).attr('data-seq')) };
        $('#mtSlot').text($(this).attr('data-label'));
        $('#mtSection').val('');
        $('#mtSubject').html('<option value="">Pick a class first</option>');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mtModal')).show();
    });

    $('#mtSection').on('change', function () {
        var id = $(this).val();
        if (!id) { $('#mtSubject').html('<option value="">Pick a class first</option>'); return; }
        $.getJSON(URL.subjects, { sectionId: id }).done(function (list) {
            $('#mtSubject').html('<option value="">Pick a subject</option>' + (list || []).map(function (s) {
                return '<option value="' + s.id + '">' + EC.esc(s.name) + '</option>';
            }).join(''));
        });
    });

    $('#mtSend').on('click', function () {
        if (!$('#mtSection').val() || !$('#mtSubject').val()) { ecToast('warning', 'Pick a class and a subject.'); return; }
        var $btn = $(this); EC.buttonBusy($btn, 'Sending…');
        post(URL.request, { sectionId: Number($('#mtSection').val()), subjectId: Number($('#mtSubject').val()), day: slot.day, periodSeq: slot.seq })
            .done(function (res) {
                ecToast(res && res.success ? 'success' : 'error', (res && res.message) || 'Could not send the request.');
                if (res && res.success) { bootstrap.Modal.getInstance(document.getElementById('mtModal')).hide(); load(); }
            })
            .fail(function () { ecToast('error', 'Could not send the request.'); })
            .always(function () { EC.buttonReset($btn); });
    });

    $('#mtReqBody').on('click', '.mt-cancel', function () {
        var id = Number($(this).attr('data-id'));
        EC.confirm({ title: 'Cancel this request?', okText: 'Cancel request' }).then(function (ok) {
            if (!ok) return;
            post(URL.cancel, { requestId: id }).done(function (res) {
                ecToast(res && res.success ? 'success' : 'error', (res && res.message) || 'Could not cancel.');
                if (res && res.success) load();
            });
        });
    });

    load();
});
</script>
}
