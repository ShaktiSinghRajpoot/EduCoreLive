@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model EduCoreDataAccessLayer.Models.ERP.RegistrationPageModel
@{
    ViewData["Title"] = "Registrations";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var stats = Model.Stats;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Registration/Index.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <!-- Header -->
    <div class="ec-page-header">
      <div class="ec-page-header-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div class="ec-page-title-wrap d-flex align-items-start gap-3">
          <div class="ec-page-icon"><i class="bx bx-clipboard"></i></div>
          <div>
            <h3 class="ec-page-title mb-1">Registrations</h3>
            <p class="ec-page-subtitle mb-0">All registered students with their registration numbers &amp; details.</p>
          </div>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-secondary" id="btnExport"><i class="bx bx-export me-1"></i> Export</button>
          <button type="button" class="btn btn-primary" id="btnRegisterWalkin"><i class="bx bx-user-plus me-1"></i> Register Walk-in</button>
        </div>
      </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-3">
      <div class="col-6 col-xl-3">
        <div class="reg-kpi"><div class="ic bg-label-primary"><i class="bx bx-clipboard text-primary"></i></div>
          <div><div class="val text-primary" id="kpiTotal">@stats.TotalRegistered</div><div class="lbl">Registered</div></div></div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="reg-kpi"><div class="ic bg-label-success"><i class="bx bx-check-circle text-success"></i></div>
          <div><div class="val text-success" id="kpiPaid">@stats.FeeCollected</div><div class="lbl">Fee Collected</div></div></div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="reg-kpi"><div class="ic bg-label-danger"><i class="bx bx-error-circle text-danger"></i></div>
          <div><div class="val text-danger" id="kpiPending">@stats.FeePending</div><div class="lbl">Fee Pending</div></div></div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="reg-kpi"><div class="ic bg-label-info"><i class="bx bx-user-check text-info"></i></div>
          <div><div class="val text-info" id="kpiConverted">@stats.Converted</div><div class="lbl">Admitted</div></div></div>
      </div>
    </div>

    <!-- Filters -->
    <div class="ec-card mb-3">
      <div class="ec-card-body">
        <div class="row g-2 align-items-end">
          <div class="col-12 col-lg-4">
            <div class="input-group">
              <span class="input-group-text bg-transparent border-end-0 pe-1"><i class="bx bx-search text-muted"></i></span>
              <input type="search" class="form-control border-start-0 ps-0" id="regSearch" placeholder="Search name, reg no or mobile..." />
            </div>
          </div>
          <div class="col-6 col-lg-2">
            <select class="form-select" id="fSession"><option value="">All Sessions</option>
              @foreach (var s in Model.AvailableSessions) { <option value="@s.Text">@s.Text</option> }
            </select>
          </div>
          <div class="col-6 col-lg-2">
            <select class="form-select" id="fClass"><option value="">All Classes</option>
              @foreach (var c in Model.AvailableClasses) { <option value="@c.Text">@c.Text</option> }
            </select>
          </div>
          @if (Model.RegistrationFeeEnabled)
          {
          <div class="col-6 col-lg-2">
            <select class="form-select" id="fFee"><option value="">All Fees</option>
              <option value="paid">Fee Collected</option><option value="unpaid">Fee Pending</option>
            </select>
          </div>
          }
          <div class="col-6 col-lg-2">
            <button class="btn btn-outline-secondary w-100" id="btnClear"><i class="bx bx-x"></i> Clear</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="ec-card">
      <div class="table-responsive">
        <table class="table reg-tbl align-middle mb-0">
          <thead>
            <tr>
              <th>Reg No</th><th>Student</th><th>Class / Session</th>
              <th>Parent &amp; Contact</th><th>Reg Date</th>
              @if (Model.RegistrationFeeEnabled) { <th>Fee</th> }
              <th>Status</th><th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody id="regBody">
            <tr><td colspan="8" class="text-center py-5 text-muted">
              <div class="spinner-border spinner-border-sm text-primary me-2"></div>Loading…</td></tr>
          </tbody>
        </table>
      </div>
      <div class="text-center py-5 d-none" id="regEmpty">
        <div class="avatar avatar-lg mx-auto mb-3"><span class="avatar-initial rounded bg-label-secondary"><i class="bx bx-clipboard"></i></span></div>
        <h6 class="mb-1">No registrations found</h6>
        <p class="text-muted mb-0">Registered students will appear here.</p>
      </div>
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 border-top" id="pgBar">
        <div class="d-flex align-items-center gap-2">
          <label class="text-muted" style="font-size:.77rem">Per page:</label>
          <select class="form-select form-select-sm" id="pageSize" style="width:auto"><option>10</option><option>25</option><option>50</option></select>
          <span class="text-muted" id="pgInfo" style="font-size:.77rem"></span>
        </div>
        <nav><ul class="pagination pagination-sm mb-0" id="pgControls"></ul></nav>
      </div>
    </div>

  </div>
</div>

<!-- ── Print Slip Modal ── -->
<div class="modal fade" id="slipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <div id="regSlipPrintArea" class="reg-slip">
          <div class="text-center mb-3">
            <h4>Registration Slip</h4>
            <div class="text-muted" style="font-size:.85rem">Admission Registration Confirmation</div>
          </div>
          <div class="slip-row"><span>Registration No</span><span id="slipNo">—</span></div>
          <div class="slip-row"><span>Student Name</span><span id="slipName">—</span></div>
          <div class="slip-row"><span>Class</span><span id="slipClass">—</span></div>
          <div class="slip-row"><span>Session</span><span id="slipSession">—</span></div>
          <div class="slip-row"><span>Parent / Guardian</span><span id="slipParent">—</span></div>
          <div class="slip-row"><span>Contact</span><span id="slipMobile">—</span></div>
          <div class="slip-row"><span>Registration Date</span><span id="slipDate">—</span></div>
          <div class="slip-row" id="slipFeeRow"><span>Registration Fee</span><span id="slipFee">—</span></div>
          <div class="mt-5 d-flex justify-content-between" style="font-size:.85rem;">
            <div>____________________<br/>Parent Signature</div>
            <div class="text-end">____________________<br/>Authorised Signatory</div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="btnPrintSlip"><i class="bx bx-printer me-1"></i> Print</button>
      </div>
    </div>
  </div>
</div>

<!-- ── Cancel Registration Modal ── -->
<div class="modal fade" id="cancelRegModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header d-flex align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2"><i class="bx bx-x-circle text-danger fs-5"></i><h6 class="modal-title mb-0">Cancel Registration</h6></div>
        <button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="cancelEnquiryId" />
        <p class="mb-2">Cancel registration for <strong id="cancelName"></strong>? The lead will be marked <strong>Not Interested</strong> (withdrawn).</p>
        <label class="form-label">Reason <span class="text-danger">*</span></label>
        <select class="form-select" id="cancelReason">
          <option value="" disabled selected>Select reason</option>
          <option>Fees Too High</option>
          <option>Admitted to Another School</option>
          <option>Distance / Transport Issue</option>
          <option>Changed Mind</option>
          <option>Not Responding</option>
          <option>Other</option>
        </select>
        <div class="alert alert-warning mt-3 mb-0 py-2" id="cancelFeeNote" style="font-size:.82rem">
          <i class="bx bx-info-circle me-1"></i>The registration fee already collected is <strong>non-refundable</strong> and stays on record. The registration number is kept for audit.
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Keep</button>
        <button type="button" class="btn btn-danger btn-sm" id="confirmCancelReg"><i class="bx bx-x me-1"></i> Mark Withdrawn</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══ REGISTER WALK-IN (1-step: create intake + register) ═══ -->
<div class="modal fade" id="registerWalkinModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title mb-0">Register Walk-in</h5>
          <small class="text-muted">Register a student directly — admission can be done later.</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="fw-bold text-muted text-uppercase mb-2" style="font-size:.72rem;letter-spacing:.05em">Student</div>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Student Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="rwName" maxlength="80" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Gender</label>
            <select class="form-select" id="rwGender">
              <option value="">Select</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Class <span class="text-danger">*</span></label>
            <select class="form-select" id="rwClass">
              <option value="">Select class</option>
              @foreach (var c in Model.AvailableClasses) { <option value="@c.Text">@c.Text</option> }
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Session <span class="text-danger">*</span></label>
            <select class="form-select" id="rwSession">
              <option value="">Select session</option>
              @foreach (var s in Model.AvailableSessions) { <option value="@s.Text">@s.Text</option> }
            </select>
          </div>
        </div>

        <div class="fw-bold text-muted text-uppercase mb-2" style="font-size:.72rem;letter-spacing:.05em">Parent / Guardian</div>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Father Name</label>
            <input type="text" class="form-control" id="rwFatherName" maxlength="80" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Mobile <span class="text-danger">*</span></label>
            <input type="tel" class="form-control" id="rwMobile" maxlength="10" placeholder="10-digit mobile" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Mother Name</label>
            <input type="text" class="form-control" id="rwMotherName" maxlength="80" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Parent Email</label>
            <input type="email" class="form-control" id="rwEmail" maxlength="120" />
          </div>
        </div>

        <div class="fw-bold text-muted text-uppercase mb-2" style="font-size:.72rem;letter-spacing:.05em">Registration</div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Registration Number</label>
            <input type="text" class="form-control" id="rwRegNumber" maxlength="40" />
            <small class="text-muted" id="rwRegNumberHint">Leave blank to auto-generate.</small>
          </div>
          <div class="col-md-6">
            <label class="form-label">Registration Date</label>
            <input type="date" class="form-control" id="rwRegDate" />
          </div>
        </div>

        @if (Model.RegistrationFeeEnabled)
        {
          <div class="border rounded-3 p-3 mt-3" style="background:#fafaf8">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <div class="fw-bold" style="font-size:.88rem">Registration Fee</div>
                <div class="text-muted" id="rwFeeAmountLabel" style="font-size:.8rem">Select class &amp; session</div>
              </div>
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="rwFeePaid" />
                <label class="form-check-label" for="rwFeePaid">Collected now</label>
              </div>
            </div>
            <div class="row g-3 mt-1 d-none" id="rwPaymentRow">
              <div class="col-md-4">
                <label class="form-label">Discount</label>
                <select class="form-select" id="rwDiscountType">
                  <option value="">No discount</option>
                  <option value="Percentage">% Percentage</option>
                  <option value="Fixed">₹ Fixed amount</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Value</label>
                <input type="number" min="0" step="0.01" class="form-control" id="rwDiscountValue" placeholder="0" />
              </div>
              <div class="col-md-4">
                <label class="form-label">Reason</label>
                <input type="text" class="form-control" id="rwDiscountReason" maxlength="200" placeholder="Required if discount given" />
              </div>
              <div class="col-12">
                <div class="alert alert-light border mb-0 py-2" id="rwNetLine" style="font-size:.85rem">Select class &amp; session to see the fee.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Payment Mode</label>
                <select class="form-select" id="rwPaymentMode">
                  <option value="Cash">Cash</option>
                  <option value="UPI">UPI</option>
                  <option value="Card">Card</option>
                  <option value="Cheque">Cheque</option>
                  <option value="Bank Transfer">Bank Transfer</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Reference</label>
                <input type="text" class="form-control" id="rwPaymentReference" maxlength="60" placeholder="Txn / cheque no (optional)" />
              </div>
            </div>
          </div>
        }
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="rwSubmit"><i class="bx bx-check me-1"></i> Register</button>
      </div>
    </div>
  </div>
</div>

@await Html.PartialAsync("_FeeReceiptModal")

@section PageScripts {
<script src="~/js/fee-receipt.js" asp-append-version="true"></script>
<script>
$(function () {
    'use strict';

    var FEE_ENABLED = @(Model.RegistrationFeeEnabled ? "true" : "false");
    var csrf = $('input[name="__RequestVerificationToken"]').first().val() || $('[name="__RequestVerificationToken"]').val() || '';
    var ADMISSION_URL = '@Url.Action("Create", "Admission", new { area = "ERP" })';
    var ENQUIRY_EDIT_URL = '@Url.Action("EnquiryCRM", "Enquiry", new { area = "ERP" })';

    var F = { page:1, pageSize:10, search:'', session:'', className:'', feeStatus:'' };
    var lastRows = [];


    function feeBadge(paid){ return paid ? '<span class="reg-bdg b-paid">Paid</span>' : '<span class="reg-bdg b-unpaid">Pending</span>'; }
    function statusBadge(r){
        if (r.isAdmitted) return '<span class="reg-bdg b-admitted">Admitted</span>';
        if (r.status === 'Not Interested') return '<span class="reg-bdg b-unpaid">Withdrawn</span>';
        return '<span class="reg-bdg b-regdone">Registered</span>';
    }

    function rowHtml(r) {
        var withdrawn = (r.status === 'Not Interested');   // cancelled — fee retained, lead lost
        var active    = !r.isAdmitted && !withdrawn;
        var actions = '<div class="d-inline-flex gap-1 align-items-center justify-content-end flex-nowrap">';
        // Edit (correct details) — opens the enquiry form in the CRM; hidden once admitted
        if (!r.isAdmitted)
            actions += '<a href="'+ENQUIRY_EDIT_URL+'?editId='+r.enquiryId+'" class="btn btn-sm btn-icon btn-outline-primary reg-act-btn" title="Edit details"><i class="bx bx-edit"></i></a>';
        // Registration SLIP — "you are registered, here is your number". Always available.
        actions += '<button class="btn btn-sm btn-icon btn-outline-secondary reg-act-btn btn-slip" title="Print registration slip" data-id="'+r.enquiryId+'"><i class="bx bx-receipt"></i></button>';
        // Fee RECEIPT — "we received your money". A different document, and this list is
        // the only place it can be re-printed (it is filed against the enquiry, not a student).
        if (r.receiptNo)
            actions += '<button class="btn btn-sm btn-icon btn-outline-secondary reg-act-btn btn-receipt" title="Print fee receipt" data-rcp="'+EC.esc(r.receiptNo)+'"><i class="bx bx-printer"></i></button>';
        // Mark fee paid
        if (FEE_ENABLED && !r.registrationFeePaid && active)
            actions += '<button class="btn btn-sm btn-icon btn-outline-success reg-act-btn btn-fee" title="Mark fee collected" data-id="'+r.enquiryId+'"><i class="bx bx-rupee"></i></button>';
        // Convert to admission
        if (active)
            actions += '<a href="'+ADMISSION_URL+'?enquiryId='+r.enquiryId+'" class="btn btn-sm btn-icon btn-success reg-act-btn" title="Convert to Admission"><i class="bx bx-user-check"></i></a>';
        // Cancel (mark withdrawn / Not Interested — fee retained)
        if (active)
            actions += '<button class="btn btn-sm btn-icon btn-outline-danger reg-act-btn btn-cancel" title="Cancel registration" data-id="'+r.enquiryId+'" data-name="'+EC.esc(r.studentName)+'"><i class="bx bx-x"></i></button>';
        actions += '</div>';

        var feeCol = FEE_ENABLED ? '<td>'+feeBadge(r.registrationFeePaid)+'</td>' : '';
        return '<tr>'
            + '<td><span class="reg-no">'+EC.esc(r.registrationNumber)+'</span></td>'
            + '<td class="fw-bold">'+EC.esc(r.studentName)+'</td>'
            + '<td>'+EC.esc(r.className||'—')+' <span class="text-muted">· '+EC.esc(r.session||'—')+'</span></td>'
            + '<td>'+EC.esc(r.parentName||'—')+'<div class="text-muted" style="font-size:.76rem">'+EC.esc(r.mobile||'')+'</div></td>'
            + '<td>'+EC.esc(r.registrationDate)+'</td>'
            + feeCol
            + '<td>'+statusBadge(r)+'</td>'
            + '<td class="text-end">'+actions+'</td>'
            + '</tr>';
    }

    function load() {
        EC.showLoader();
        EC.listLoading('#regBody');
        $.get('/ERP/Registration/GetRegistrationsData', {
            page:F.page, pageSize:F.pageSize, search:F.search,
            session:F.session, className:F.className, feeStatus:F.feeStatus
        }).done(function (d) {
            if (!d.success) {
                // This used to return straight away, leaving the spinner row
                // turning forever.
                $('#regEmpty').addClass('d-none');
                EC.listEmpty('#regBody', d.message || 'Could not load registrations.', 'bx-error-circle');
                return;
            }
            lastRows = d.rows || [];
            if (lastRows.length === 0) {
                $('#regBody').html('');
                $('#regEmpty').removeClass('d-none');
            } else {
                $('#regEmpty').addClass('d-none');
                $('#regBody').html(lastRows.map(rowHtml).join(''));
            }
            if (d.stats) {
                $('#kpiTotal').text(d.stats.totalRegistered);
                $('#kpiPaid').text(d.stats.feeCollected);
                $('#kpiPending').text(d.stats.feePending);
                $('#kpiConverted').text(d.stats.converted);
            }
            renderPaging(d);
        }).fail(function () {
            ecToast('error', 'Failed to load registrations.');
            // The toast disappears after 3.5s, so the list needs the message
            // too — otherwise all that is left is a spinning spinner.
            $('#regEmpty').addClass('d-none');
            EC.listEmpty('#regBody', 'Could not load registrations. Please retry.', 'bx-error-circle');
        }).always(EC.hideLoader);
    }

    function renderPaging(d) {
        var from = d.totalCount === 0 ? 0 : (d.page-1)*d.pageSize + 1;
        var to = Math.min(d.page*d.pageSize, d.totalCount);
        $('#pgInfo').text(d.totalCount ? ('Showing '+from+'–'+to+' of '+d.totalCount) : '0 results');
        var html = '';
        if (d.totalPages > 1) {
            html += pgItem(d.page-1, '«', d.page<=1, false);
            for (var p=1; p<=d.totalPages; p++) html += pgItem(p, p, false, p===d.page);
            html += pgItem(d.page+1, '»', d.page>=d.totalPages, false);
        }
        $('#pgControls').html(html);
    }
    function pgItem(p,label,disabled,active){
        return '<li class="page-item'+(disabled?' disabled':'')+(active?' active':'')+'"><a class="page-link" href="#" data-p="'+p+'">'+label+'</a></li>';
    }

    /* ── events ── */
    var searchTimer;
    $('#regSearch').on('input', function(){ clearTimeout(searchTimer); var v=this.value; searchTimer=setTimeout(function(){ F.search=v; F.page=1; load(); },300); });
    $('#fSession,#fClass,#fFee').on('change', function(){ F.session=$('#fSession').val(); F.className=$('#fClass').val(); F.feeStatus=$('#fFee').val()||''; F.page=1; load(); });
    $('#pageSize').on('change', function(){ F.pageSize=parseInt(this.value); F.page=1; load(); });
    $('#btnClear').on('click', function(){ $('#regSearch').val(''); $('#fSession,#fClass,#fFee').val(''); F.search=F.session=F.className=F.feeStatus=''; F.page=1; load(); });
    $('#pgControls').on('click', '.page-link', function(e){ e.preventDefault(); var p=parseInt($(this).data('p')); if(p>=1){ F.page=p; load(); } });

    /* ── print slip ── */
    $('#regBody').on('click', '.btn-slip', function(){
        var id = $(this).data('id');
        var r = lastRows.find(function(x){ return x.enquiryId === id; });
        if (!r) return;
        $('#slipNo').text(r.registrationNumber||'—');
        $('#slipName').text(r.studentName||'—');
        $('#slipClass').text(r.className||'—');
        $('#slipSession').text(r.session||'—');
        $('#slipParent').text(r.parentName||'—');
        $('#slipMobile').text(r.mobile||'—');
        $('#slipDate').text(r.registrationDate||'—');
        if (FEE_ENABLED) { $('#slipFeeRow').show(); $('#slipFee').text(r.registrationFeePaid ? 'Paid' : 'Pending'); }
        else $('#slipFeeRow').hide();
        new bootstrap.Modal(document.getElementById('slipModal')).show();
    });
    $('#btnPrintSlip').on('click', function(){ window.print(); });

    /* ── print the registration fee receipt ── */
    $('#regBody').on('click', '.btn-receipt', function(){
        EcReceipt.show($(this).data('rcp'));
    });

    /* ── mark fee paid ── */
    $('#regBody').on('click', '.btn-fee', function(){
        var id = $(this).data('id');
        $.ajax({ url:'/ERP/Registration/MarkFeePaid', type:'POST', contentType:'application/json',
            headers:{ 'RequestVerificationToken':csrf }, data: JSON.stringify({ enquiryId:id }) })
        .done(function(res){
            if(res.success){
                ecToast('success', res.message + (res.receiptNo ? ' Receipt ' + res.receiptNo + '.' : ''));
                // Not auto-opened — print from the list when needed.
                load();
            } else ecToast('error', res.message||'Failed.');
        })
        .fail(function(){ ecToast('error', 'Something went wrong.'); });
    });

    /* ── cancel registration (mark withdrawn / Not Interested) ── */
    $('#regBody').on('click', '.btn-cancel', function(){
        var id = $(this).data('id');
        var r = lastRows.find(function(x){ return x.enquiryId === id; });
        $('#cancelEnquiryId').val(id);
        $('#cancelName').text($(this).data('name'));
        $('#cancelReason').val('');
        // Non-refundable note only when this lead actually paid the registration fee.
        $('#cancelFeeNote').toggle(!!(FEE_ENABLED && r && r.registrationFeePaid));
        new bootstrap.Modal(document.getElementById('cancelRegModal')).show();
    });
    $('#confirmCancelReg').on('click', function(){
        var id = parseInt($('#cancelEnquiryId').val());
        var reason = $('#cancelReason').val();
        if (!reason) { ecToast('error', 'Please select a reason.'); return; }
        var $btn = $(this);
        EC.buttonBusy($btn);
        $.ajax({ url:'/ERP/Registration/Cancel', type:'POST', contentType:'application/json',
            headers:{ 'RequestVerificationToken':csrf }, data: JSON.stringify({ enquiryId:id, reason:reason }) })
        .done(function(res){
            if(res.success){ bootstrap.Modal.getInstance(document.getElementById('cancelRegModal')).hide(); ecToast('success', res.message); load(); }
            else ecToast('error', res.message||'Failed.');
        })
        .fail(function(){ ecToast('error', 'Something went wrong.'); })
        .always(function () { EC.buttonReset($btn); });
    });

    /* ── export current view to CSV ── */
    $('#btnExport').on('click', function(){
        if (!lastRows.length) { ecToast('info', 'Nothing to export.'); return; }
        var head = ['Reg No','Student','Class','Session','Parent','Mobile','Reg Date','Fee','Status'];
        var lines = lastRows.map(function(r){
            return [r.registrationNumber, r.studentName, r.className, r.session, r.parentName, r.mobile,
                    r.registrationDate, (FEE_ENABLED ? (r.registrationFeePaid?'Paid':'Pending') : ''), (r.isAdmitted?'Admitted':'Registered')];
        });
        var csv = '﻿' + [head].concat(lines).map(function(row){
            return row.map(function(c){ return '"'+String(c==null?'':c).replace(/"/g,'""')+'"'; }).join(',');
        }).join('\r\n');
        var a = $('<a>').attr({ href:'data:text/csv;charset=utf-8,'+encodeURIComponent(csv), download:'registrations_'+new Date().toISOString().slice(0,10)+'.csv' }).appendTo('body');
        a[0].click(); a.remove();
    });

    /* ── Register Walk-in: create intake + register in one step ── */
    var RW_FEE_AMOUNT = 0;
    function inr(n){ return '₹' + (Number(n)||0).toLocaleString('en-IN'); }
    // Live "Fee − Discount = Collect" line (client preview only; server recomputes).
    function rwUpdateNet() {
        var fee = RW_FEE_AMOUNT || 0;
        var type = $('#rwDiscountType').val();
        var val  = parseFloat($('#rwDiscountValue').val()) || 0;
        var disc = 0;
        if (type && val > 0) { disc = (type === 'Percentage') ? (fee * val / 100) : val; if (disc > fee) disc = fee; }
        disc = Math.round(disc * 100) / 100;
        var net = fee - disc;
        $('#rwNetLine').html('Fee ' + inr(fee) + (disc > 0 ? ' − Discount ' + inr(disc) : '') +
            ' = <strong>Collect ' + inr(net) + '</strong>');
    }
    function rwLoadFee() {
        if (!FEE_ENABLED) return;
        var cls = $('#rwClass').val(), ses = $('#rwSession').val();
        if (!cls || !ses) { $('#rwFeeAmountLabel').text('Select class & session'); RW_FEE_AMOUNT = 0; rwUpdateNet(); return; }
        $('#rwFeeAmountLabel').text('Loading…');
        $.getJSON('/ERP/Enquiry/GetRegistrationFee', { className: cls, academicYear: ses })
            .done(function (res) {
                RW_FEE_AMOUNT = (res && res.amount) ? Number(res.amount) : 0;
                $('#rwFeeAmountLabel').text('₹' + RW_FEE_AMOUNT.toLocaleString('en-IN') +
                    (RW_FEE_AMOUNT === 0 ? ' — configure a Registration-point Fee Head' : ''));
                rwUpdateNet();
            })
            .fail(function () { $('#rwFeeAmountLabel').text('₹0.00'); RW_FEE_AMOUNT = 0; rwUpdateNet(); });
    }
    $('#rwDiscountType, #rwDiscountValue').on('input change', rwUpdateNet);

    $('#btnRegisterWalkin').on('click', function () {
        $('#rwName,#rwFatherName,#rwMotherName,#rwEmail,#rwMobile,#rwRegNumber,#rwPaymentReference').val('');
        $('#rwGender,#rwClass,#rwSession').val('');
        $('#rwPaymentMode').val('Cash');
        $('#rwFeePaid').prop('checked', false);
        $('#rwPaymentRow').addClass('d-none');
        $('#rwDiscountType').val(''); $('#rwDiscountValue').val(''); $('#rwDiscountReason').val('');
        $('#rwFeeAmountLabel').text('Select class & session');
        RW_FEE_AMOUNT = 0; rwUpdateNet();
        $('#rwRegDate').val(new Date().toISOString().slice(0, 10));
        new bootstrap.Modal(document.getElementById('registerWalkinModal')).show();
    });

    $('#rwClass, #rwSession').on('change', rwLoadFee);
    $('#rwFeePaid').on('change', function () { $('#rwPaymentRow').toggleClass('d-none', !$(this).is(':checked')); });

    $('#rwSubmit').on('click', function () {
        var name = $.trim($('#rwName').val());
        var cls  = $('#rwClass').val(), ses = $('#rwSession').val();
        var mob  = $.trim($('#rwMobile').val());
        if (!name) { ecToast('error', 'Student name is required.'); return; }
        if (!cls)  { ecToast('error', 'Please select a class.'); return; }
        if (!ses)  { ecToast('error', 'Please select a session.'); return; }
        if (!/^\d{10}$/.test(mob)) { ecToast('error', 'Enter a valid 10-digit mobile.'); return; }

        var $btn = $(this);
        EC.buttonBusy($btn, 'Registering…');
        $.ajax({
            url: '/ERP/Enquiry/RegisterWalkin', type: 'POST', contentType: 'application/json',
            headers: { 'RequestVerificationToken': csrf },
            data: JSON.stringify({
                studentName:  name,
                gender:       $('#rwGender').val(),
                className:    cls,
                session:      ses,
                fatherName:   $.trim($('#rwFatherName').val()),
                fatherMobile: mob,
                mobile:       mob,
                motherName:   $.trim($('#rwMotherName').val()),
                parentEmail:  $.trim($('#rwEmail').val()),
                registrationNumber:  $.trim($('#rwRegNumber').val()),
                registrationDate:    $('#rwRegDate').val(),
                registrationFeePaid: FEE_ENABLED && $('#rwFeePaid').is(':checked'),
                paymentMode:         $('#rwPaymentMode').val(),
                paymentReference:    $.trim($('#rwPaymentReference').val()),
                discountType:        $('#rwDiscountType').val(),
                discountValue:       parseFloat($('#rwDiscountValue').val()) || 0,
                discountReason:      $.trim($('#rwDiscountReason').val())
            })
        })
        .done(function (res) {
            if (res && res.success) {
                bootstrap.Modal.getInstance(document.getElementById('registerWalkinModal')).hide();
                ecToast('success', (res.message || 'Walk-in registered.') +
                               (res.registrationNumber ? ' (' + res.registrationNumber + ')' : ''));
                load();
            } else {
                ecToast('error', (res && res.message) || 'Unable to register.');
            }
        })
        .fail(function () { ecToast('error', 'Something went wrong.'); })
        .always(function () { EC.buttonReset($btn); });
    });

    load();
});
</script>
}
