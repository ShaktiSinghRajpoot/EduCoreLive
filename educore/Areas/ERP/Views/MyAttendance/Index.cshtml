@{
    ViewData["Title"] = "My Attendance";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var me = ViewBag.Me as EduCoreDataAccessLayer.Models.ERP.MyStaffInfo;
    string? sessionStart = ViewBag.SessionStart as string;   // for "This session"
}

@section PageStyles {
<link rel="stylesheet" href="~/css/ERP/Staff/StaffAttendance.css" asp-append-version="true" />
<style>
  .ma-wrap { max-width: 860px; margin: 0 auto; }
</style>
}

<div class="ec-page-shell sa-page">
  <div class="ec-page-content ma-wrap">
    <div class="d-flex align-items-center gap-2 mb-3">
      <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center" style="background:var(--soft);color:var(--p);width:46px;height:46px"><i class="bx bx-user-check fs-4"></i></div>
      <div>
        <h4 class="mb-0" style="color:var(--heading);font-weight:900">My Attendance</h4>
        <div class="text-muted" style="font-size:.8rem">Your attendance for any month or date range</div>
      </div>
    </div>

    @if (me == null)
    {
        <div class="ec-card"><div class="ec-card-body text-muted">No staff record is linked to your login, so there is no attendance to show.</div></div>
    }
    else
    {
        <div class="ec-card mb-3"><div class="ec-card-body d-flex flex-wrap gap-2 align-items-end">
          <div class="btn-group btn-group-sm flex-wrap" role="group">
            <button type="button" class="btn btn-outline-primary active" data-range="month">This month</button>
            <button type="button" class="btn btn-outline-primary" data-range="last">Last month</button>
            <button type="button" class="btn btn-outline-primary" data-range="last3">Last 3 months</button>
            @if (!string.IsNullOrEmpty(sessionStart))
            {
                <button type="button" class="btn btn-outline-primary" data-range="session">This session</button>
            }
          </div>
          <div class="text-muted small align-self-center">or any dates:</div>
          <div><label class="form-label mb-1">From</label><input type="date" id="maFrom" class="form-control form-control-sm"></div>
          <div><label class="form-label mb-1">To</label><input type="date" id="maTo" class="form-control form-control-sm"></div>
          <button id="maShow" class="btn btn-sm btn-primary"><i class="bx bx-search me-1"></i>Show</button>
        </div></div>
        <div id="maResult" class="text-muted small">Loading…</div>
    }
  </div>
</div>

@section PageScripts {
<script>
$(function () {
    if (!document.getElementById('maShow')) return;   // no staff record

    var DATA_URL = '@Url.Action("Data", "MyAttendance", new { area = "ERP" })';
    var MARK = { Present: ['P', 's-P'], Absent: ['A', 's-A'], HalfDay: ['H', 's-H'], Late: ['L', 's-L'], Leave: ['LV', 's-V'] };
    var today = EC.today();

    var SESSION_START = '@(sessionStart ?? "")';
    var first = EC.dateRange('month');
    $('#maFrom').val(first.from).attr('max', today);
    $('#maTo').val(first.to).attr('max', today);

    // a quick button fills From / To and loads; typing dates and Show still works
    $('[data-range]').on('click', function () {
        var r = EC.dateRange($(this).data('range'), SESSION_START);
        $('[data-range]').removeClass('active'); $(this).addClass('active');
        $('#maFrom').val(r.from); $('#maTo').val(r.to);
        load();
    });
    $('#maFrom, #maTo').on('change', function () { $('[data-range]').removeClass('active'); });
    $('#maShow').on('click', load);

    function load() {
        $('#maResult').html('<div class="text-muted small p-2">Loading…</div>');
        $.getJSON(DATA_URL, { from: $('#maFrom').val(), to: $('#maTo').val() }).done(function (r) {
            if (!r || !r.success) { $('#maResult').html(''); ecToast('error', (r && r.message) || 'Could not load your attendance.'); return; }
            var m = r.summary;
            var kpi = function (label, val, color) {
                return '<div class="col-6 col-md-3"><div class="p-2 rounded border text-center"><div class="fw-bold fs-5" style="color:' + color + '">' + val + '</div><div class="small text-muted">' + label + '</div></div></div>';
            };
            var head = '<div class="ec-card mb-3"><div class="ec-card-body">'
                + '<div class="fw-semibold mb-2">' + EC.esc(r.from) + ' to ' + EC.esc(r.to) + '</div>'
                + '<div class="row g-2">'
                + kpi('Attendance', (m.present + m.absent + m.halfDay) ? m.percent + '%' : '—', '#0f766e') + kpi('Present', m.present, '#16a34a') + kpi('Absent', m.absent, '#dc2626') + kpi('Half day', m.halfDay, '#b45309')
                + kpi('Late', m.late, '#b45309') + kpi('On leave', m.onLeave, '#4338ca') + kpi('Not marked', m.notMarked, '#64748b') + kpi('Working days', m.working, '#334155')
                + '</div><div class="text-muted small mt-2">Attendance % is over the days marked present, absent or half day; leave never counts against it, and a day nobody marked is shown as "not marked".</div>'
                + '</div></div>';
            var rows = (r.days || []).map(function (d) {
                var what;
                if (!d.employed) what = '<span class="text-muted">Not on staff</span>';
                else if (d.s) what = '<b class="' + MARK[d.s][1] + '">' + MARK[d.s][0] + '</b> ' + EC.esc(d.s === 'HalfDay' ? 'Half day' : d.s);
                else if (d.leave) what = '<span style="color:#4338ca">On ' + EC.esc(d.leave) + ' leave</span>';
                else if (d.type === 'holiday') what = '<span class="text-muted">Holiday</span>';
                else if (d.type === 'weekly_off') what = '<span class="text-muted">Weekly off</span>';
                else what = '<span class="text-muted">Not marked</span>';
                return '<tr><td class="text-nowrap">' + EC.esc(d.day) + '</td><td>' + EC.esc(d.wd) + '</td><td>' + what + '</td><td class="text-muted small">' + EC.esc(d.remark || '') + '</td></tr>';
            }).join('');
            $('#maResult').html(head + '<div class="ec-card"><div class="ec-card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0">'
                + '<thead><tr><th>Date</th><th>Day</th><th>Attendance</th><th>Remark</th></tr></thead><tbody>' + rows + '</tbody></table></div></div></div>');
        }).fail(function () { $('#maResult').html(''); ecToast('error', 'Could not load your attendance.'); });
    }

    load();
});
</script>
}
