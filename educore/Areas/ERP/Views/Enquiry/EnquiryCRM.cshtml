@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Linq
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model EduCoreDataAccessLayer.Models.ERP.EnquiryCrmPageModel
@{
    ViewData["Title"] = "Enquiry CRM";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var stats        = Model.Stats;
    var sessions     = Model.AvailableSessions;
    var classes      = Model.AvailableClasses;
    var counsellors  = Model.AvailableCounsellors;
    var showRegistration = Model.Workflow.EnableRegistration;
    // Read by _EnquiryRowActions to show/hide the Register button.
    ViewData["ShowRegistration"] = showRegistration;

    // Sort header link: preserves filters, drops Page (back to page 1), toggles
    // direction when the same column is clicked again. Server-side + whitelisted.
    // Same helper as StudentList so both pages behave identically.
    string SortUrl(string col)
    {
        var q = Context.Request.Query
            .Where(k => !new[] { "SortColumn", "SortDir", "Page" }.Contains(k.Key, StringComparer.OrdinalIgnoreCase))
            .ToDictionary(k => k.Key, k => k.Value.ToString());
        q["SortColumn"] = col;
        q["SortDir"] = (string.Equals(Model.SortColumn, col, StringComparison.OrdinalIgnoreCase) && !Model.Desc) ? "desc" : "asc";
        return Context.Request.Path + QueryString.Create(q);
    }
    string SortIcon(string col)
    {
        if (!string.Equals(Model.SortColumn, col, StringComparison.OrdinalIgnoreCase)) return "bx bx-sort ec-si";
        return "bx " + (Model.Desc ? "bx-sort-down" : "bx-sort-up") + " ec-si ec-si-on";
    }

    bool Sel(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    // Pipeline tab link: swaps FilterPipeline and drops Page, keeping the search
    // and dropdown filters. The quick filters are cleared because a pipeline stage
    // and "overdue only" answer two different questions.
    string PipelineUrl(string key)
    {
        var q = Context.Request.Query
            .Where(k => !new[] { "FilterPipeline", "FilterOverdue", "FilterToday", "Page" }.Contains(k.Key, StringComparer.OrdinalIgnoreCase))
            .ToDictionary(k => k.Key, k => k.Value.ToString());
        if (!string.IsNullOrEmpty(key)) { q["FilterPipeline"] = key; }
        return Context.Request.Path + QueryString.Create(q);
    }
    string PipelineCss(string key)
        => string.Equals(Model.FilterPipeline ?? "", key, StringComparison.OrdinalIgnoreCase) ? "pipeline-tab active" : "pipeline-tab";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Enquiry/EnquiryCRM.css" asp-append-version="true" />
}

@* Standalone CSRF token for all AJAX POST calls on this page *@
@Html.AntiForgeryToken()

<div class="ec-page-shell enquiry-crm-page">
    <div class="ec-page-content">

    <!-- ── Page Header ─── -->
    <div class="ec-page-header">
        <div class="ec-page-header-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div class="ec-page-title-wrap d-flex align-items-start gap-3">
                <div class="ec-page-icon"><i class="bx bx-message-square-detail"></i></div>
                <div>
                    <h3 class="ec-page-title mb-1">Enquiry CRM</h3>
                    <p class="ec-page-subtitle mb-0">Track admission enquiries, follow-ups &amp; conversion pipeline.</p>
                </div>
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <button type="button" class="btn btn-outline-secondary">
                    <i class="bx bx-export me-1"></i> Export
                </button>
                <button type="button" class="btn btn-primary" id="btnAddEnquiry"
                        data-bs-toggle="modal" data-bs-target="#addEnquiryModal">
                    <i class="bx bx-user-plus me-1"></i> Add Enquiry
                </button>
            </div>
        </div>
    </div>

    @* The KPI card row used to sit here. It was removed because it repeated the
       pipeline tabs (Total/All, Campus Visits, Admitted) and the quick-filter
       buttons (Due Today, Overdue) — the same number in two or three places.
       The stage counts live on the tabs below, Due Today / Overdue are counts on
       the quick-filter buttons, and Conversion Rate — the only figure that was
       unique to the row — is the chip in this card's header. *@

    <!-- ── Pipeline Tabs ─── -->
    <div class="ec-card mb-3">
        <div class="ec-card-header">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div class="ec-section-title-wrap">
                    <span class="ec-section-icon"><i class="bx bx-git-branch"></i></span>
                    <div><h5 class="ec-section-title mb-1">Admission Pipeline</h5><p class="ec-section-subtitle mb-0">Click a stage to filter.</p></div>
                </div>
                <div class="crm-conv-chip" title="Admitted as a share of total enquiries">
                    <i class="bx bx-trending-up"></i>
                    <span class="crm-conv-val">@stats.ConversionRate%</span>
                    <span class="crm-conv-lbl">Conversion</span>
                </div>
            </div>
        </div>
        <div class="ec-card-body py-3">
            @* Plain links carrying FilterPipeline in the query string — no JavaScript.
               The active tab is decided by the model, so a refresh or a shared URL
               lands on the same stage. *@
            <div class="crm-pipeline" id="pipelineTabs">
                <a class="@PipelineCss("")"             href="@PipelineUrl("")"><span class="ptab-count">@stats.TotalLeads</span><span class="ptab-label">All</span></a>
                <a class="@PipelineCss("new")"          href="@PipelineUrl("new")"><span class="ptab-count">@stats.CntNew</span><span class="ptab-label">New</span></a>
                <a class="@PipelineCss("followup")"     href="@PipelineUrl("followup")"><span class="ptab-count">@stats.CntFollowup</span><span class="ptab-label">Follow-up</span></a>
                <a class="@PipelineCss("interested")"   href="@PipelineUrl("interested")"><span class="ptab-count">@stats.CntInterested</span><span class="ptab-label">Interested</span></a>
                <a class="@PipelineCss("campusvisit")"  href="@PipelineUrl("campusvisit")"><span class="ptab-count">@stats.CntCampusVisit</span><span class="ptab-label">Campus Visit</span></a>
                @if (showRegistration)
                {
                <a class="@PipelineCss("registered")"   href="@PipelineUrl("registered")"><span class="ptab-count">@stats.CntRegistered</span><span class="ptab-label">Registered</span></a>
                }
                <a class="@PipelineCss("admitted")"     href="@PipelineUrl("admitted")"><span class="ptab-count">@stats.Admitted</span><span class="ptab-label">Admitted</span></a>
                <a class="@PipelineCss("notinterested")" href="@PipelineUrl("notinterested")"><span class="ptab-count text-danger">@stats.CntNotInterested</span><span class="ptab-label">Not Interested</span></a>
            </div>
        </div>
    </div>

    <!-- ── Filters ─── -->
    <div class="ec-card mb-3">
        <div class="ec-card-header">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div class="ec-section-title-wrap">
                    <span class="ec-section-icon"><i class="bx bx-filter-alt"></i></span>
                    <div><h5 class="ec-section-title mb-0">Search &amp; Filter</h5></div>
                </div>
            </div>
        </div>
        <div class="ec-card-body">
            @* All filtering/sorting/paging is server-side: this GET form round-trips
               the query string. Omitting Page here means any filter change resets to
               page 1. Sort is carried in hidden fields so it survives a filter change. *@
            <form id="enqFilterForm" method="get" asp-area="ERP" asp-controller="Enquiry" asp-action="EnquiryCRM">
                <input type="hidden" name="SortColumn" value="@Model.SortColumn" />
                <input type="hidden" name="SortDir" value="@Model.SortDirection" />

                <div class="row g-2 align-items-end">
                    <div class="col-12 col-lg-4">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0 pe-1">
                                <i class="bx bx-search text-muted"></i>
                            </span>
                            <input type="search" class="form-control border-start-0 ps-0" name="Search"
                                   value="@Model.Search" placeholder="Search student, parent or mobile..."
                                   onchange="this.form.submit()" />
                        </div>
                    </div>
                    <div class="col-6 col-sm-3 col-lg-2">
                        <select class="form-select" name="FilterSession" onchange="this.form.submit()">
                            <option value="">All Sessions</option>
                            @foreach (var s in sessions){<option value="@s.Text" selected="@Sel(s.Text, Model.FilterSession)">@s.Text</option>}
                        </select>
                    </div>
                    <div class="col-6 col-sm-3 col-lg-2">
                        <select class="form-select" name="FilterClass" onchange="this.form.submit()">
                            <option value="">All Classes</option>
                            @foreach (var c in classes){<option value="@c.Text" selected="@Sel(c.Text, Model.FilterClass)">@c.Text</option>}
                        </select>
                    </div>
                    <div class="col-6 col-sm-3 col-lg-2">
                        <select class="form-select" name="FilterSource" onchange="this.form.submit()">
                            <option value="">All Sources</option>
                            @foreach (var src in new[] { "Walk-in", "QR Code", "Referral", "Website", "Phone Call", "Social Media" })
                            {
                                <option value="@src" selected="@Sel(src, Model.FilterSource)">@src</option>
                            }
                        </select>
                    </div>
                    @if (counsellors.Any())
                    {
                        <div class="col-6 col-sm-3 col-lg-2">
                            <select class="form-select" name="FilterAssignedTo" onchange="this.form.submit()">
                                <option value="">All Counsellors</option>
                                @foreach (var c in counsellors)
                                {
                                    <option value="@c.Value" selected="@Sel(c.Value, Model.FilterAssignedTo?.ToString())">@c.Text</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                @* The two quick filters are booleans carried in the same form. Each
                   button flips its hidden field and resubmits, so they combine with
                   the dropdowns above instead of replacing them. *@
                <input type="hidden" name="FilterToday"   id="fToday"   value="@Model.FilterToday.ToString().ToLower()" />
                <input type="hidden" name="FilterOverdue" id="fOverdue" value="@Model.FilterOverdue.ToString().ToLower()" />

                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
                    <span class="text-muted" style="font-size:.76rem">Quick:</span>
                    @* The counts used to be KPI cards of their own. They belong here,
                       on the button that actually filters by them. *@
                    <button type="button" class="qf-btn @(Model.FilterToday ? "active-warning" : "")" data-toggle-filter="fToday">
                        <i class="bx bx-time"></i> Today's Follow-ups
                        <span class="qf-count">@stats.DueToday</span>
                    </button>
                    <button type="button" class="qf-btn @(Model.FilterOverdue ? "active-danger" : "")" data-toggle-filter="fOverdue">
                        <i class="bx bx-error-circle"></i> Overdue Only
                        <span class="qf-count @(stats.OverdueCount > 0 ? "qf-count-danger" : "")">@stats.OverdueCount</span>
                    </button>
                    @if (Model.HasFilters)
                    {
                        <a asp-area="ERP" asp-controller="Enquiry" asp-action="EnquiryCRM" class="qf-btn ms-auto">
                            <i class="bx bx-x"></i> Clear All
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- ── Desktop Table ─── -->
    <div class="ec-card crm-table-wrap">
        <div class="ec-card-header">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div class="ec-section-title-wrap">
                    <span class="ec-section-icon"><i class="bx bx-list-ul"></i></span>
                    <div>
                        <h5 class="ec-section-title mb-1">Enquiries</h5>
                        <p class="ec-section-subtitle mb-0">
                            @if (Model.TotalCount > 0)
                            {
                                <text>Showing @Model.FirstRow–@Model.LastRow of @Model.TotalCount enquiries</text>
                            }
                            else
                            {
                                <text>No enquiries found</text>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="ec-list-tbl-wrap">
            <table class="table ec-list-tbl align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:56px">S.No</th>
                        <th style="min-width:185px"><a class="ec-sortable text-reset text-decoration-none" href="@SortUrl("name")">Student <i class="@SortIcon("name")"></i></a></th>
                        <th style="min-width:165px">Parent &amp; Contact</th>
                        <th style="min-width:110px"><a class="ec-sortable text-reset text-decoration-none" href="@SortUrl("class")">Class / Session <i class="@SortIcon("class")"></i></a></th>
                        <th style="min-width:100px"><a class="ec-sortable text-reset text-decoration-none" href="@SortUrl("source")">Source <i class="@SortIcon("source")"></i></a></th>
                        <th style="min-width:130px"><a class="ec-sortable text-reset text-decoration-none" href="@SortUrl("status")">Status <i class="@SortIcon("status")"></i></a></th>
                        <th style="min-width:130px"><a class="ec-sortable text-reset text-decoration-none" href="@SortUrl("nextfu")">Next Follow-up <i class="@SortIcon("nextfu")"></i></a></th>
                        <th style="min-width:80px"><a class="ec-sortable text-reset text-decoration-none" href="@SortUrl("age")">Age <i class="@SortIcon("age")"></i></a></th>
                        <th class="text-end" style="min-width:185px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowNo = Model.FirstRow; }
                    @foreach (var e in Model.Items)
                    {
                        <tr class="lead-row @(e.IsOverdue ? "overdue-row" : "")" data-id="@e.EnquiryId">
                            <td class="text-center lead-meta">@rowNo</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="student-avatar @e.AvatarColorClass">@e.StudentInitials</div>
                                    <div>
                                        <div class="lead-name">@e.StudentName</div>
                                        <div class="lead-meta">@e.ClassName &middot; @e.Session</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark" style="font-size:.83rem">@e.PrimaryParentDisplay</div>
                                <a href="@e.CallUrl" class="lead-meta text-decoration-none" onclick="event.stopPropagation()">
                                    <i class="bx bx-phone me-1"></i>@e.Mobile
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-label-primary">@e.ClassName</span>
                                <div class="lead-meta mt-1">@e.Session</div>
                            </td>
                            <td><span class="source-pill"><i class="bx @e.SourceIcon"></i> @e.LeadSource</span></td>
                            <td>@await Html.PartialAsync("_EnquiryStatusCell", e)</td>
                            <td>
                                <div class="@e.FollowupCssClass">
                                    @if (!string.IsNullOrEmpty(e.FollowupIcon))
                                    {
                                        <i class="bx @e.FollowupIcon me-1"></i>
                                    }
                                    @e.FollowupDisplay
                                    @if (e.FollowupCount > 0)
                                    {
                                        <span class="followup-count-badge"><i class="bx bx-chat"></i>@e.FollowupCount</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(e.FollowupSubtext))
                                {
                                    <div class="lead-meta">@e.FollowupSubtext</div>
                                }
                            </td>
                            <td><span class="lead-meta">@e.DaysSinceLabel</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 align-items-center flex-nowrap">
                                    @await Html.PartialAsync("_EnquiryRowActions", e)
                                </div>
                            </td>
                        </tr>
                        rowNo++;
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="text-center py-5">
                <div class="avatar avatar-lg mx-auto mb-3">
                    <span class="avatar-initial rounded bg-label-secondary"><i class="bx bx-search"></i></span>
                </div>
                <h6 class="mb-1">No enquiries match your filters</h6>
                <p class="text-muted mb-0">Try adjusting search, filters, or pipeline stage.</p>
            </div>
        }

    </div>

    <!-- ── Mobile Card List ─── -->
    @* Same rows as the table above, stacked as cards below 768px. Server-rendered
       from the same Model.Items, so the two views can never disagree. *@
    <div class="crm-card-list">
        @{ var cardNo = Model.FirstRow; }
        @foreach (var e in Model.Items)
        {
            <div class="crm-card lead-row @(e.IsOverdue ? "overdue-card" : "")" data-id="@e.EnquiryId">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="lead-meta crm-card-sno">@cardNo</span>
                        <div class="student-avatar @e.AvatarColorClass">@e.StudentInitials</div>
                        <div>
                            <div class="lead-name">@e.StudentName</div>
                            <div class="lead-meta">@e.PrimaryParentDisplay</div>
                        </div>
                    </div>
                    @await Html.PartialAsync("_EnquiryStatusCell", e)
                </div>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge bg-label-primary">@e.ClassName</span>
                    <span class="source-pill"><i class="bx @e.SourceIcon"></i> @e.LeadSource</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="@e.FollowupCssClass" style="font-size:.76rem">
                            @if (!string.IsNullOrEmpty(e.FollowupIcon))
                            {
                                <i class="bx @e.FollowupIcon me-1"></i>
                            }
                            @e.FollowupDisplay
                        </div>
                        @if (!string.IsNullOrEmpty(e.FollowupSubtext))
                        {
                            <div class="lead-meta">@e.FollowupSubtext</div>
                        }
                    </div>
                    <div class="d-flex gap-1 flex-wrap align-items-center">
                        @await Html.PartialAsync("_EnquiryRowActions", e)
                    </div>
                </div>
            </div>
            cardNo++;
        }
        @if (Model.Items.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bx bx-search fs-1 d-block mb-2 opacity-25"></i>No results.
            </div>
        }
    </div>
    @* ONE pagination bar for both the table and the cards. Rendering _PageSize
       twice would put two name="PageSize" selects in the same form, and the pair
       would post as "10,25" — the value would fail to bind and silently do nothing. *@
    <div class="ec-card mt-2">
        <div class="crm-pg-bar">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <partial name="_PageSize" model="Model" view-data='@(new ViewDataDictionary(ViewData) { { "FormId", "enqFilterForm" }, { "Label", "Per page" } })' />
                @if (Model.TotalCount > 0)
                {
                    <span class="text-muted" style="font-size:.77rem">Showing @Model.FirstRow–@Model.LastRow of @Model.TotalCount</span>
                }
            </div>
            <partial name="_Pager" model="Model" />
        </div>
    </div>

    </div><!-- ec-page-content -->
</div><!-- ec-page-shell -->

<!-- ════════════════════════════════════════════════════════
     ADD ENQUIRY MODAL
═════════════════════════════════════════════════════════ -->
<div class="modal fade" id="addEnquiryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="SaveEnquiry" asp-controller="Enquiry" asp-area="ERP" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EnquiryId" id="enquiryFormId" value="0" />

                <div class="modal-header">
                    <div class="d-flex justify-content-between align-items-center w-100 me-3">
                        <div class="ec-section-title-wrap">
                            <div class="ec-section-icon"><i class="bx bx-user-plus"></i></div>
                            <div><h5 class="modal-title mb-0" id="enquiryModalTitle">Add Enquiry</h5><small class="text-muted" id="enquiryModalSubtitle">Capture student &amp; parent details.</small></div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <!-- Student -->
                    <div class="ec-section-title-wrap mb-3">
                        <div class="ec-section-icon"><i class="bx bx-child"></i></div>
                        <div><h6 class="mb-0">Student Information</h6></div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Student Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="StudentName" placeholder="e.g. Anmol Kumar" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Gender</label>
                            <select class="form-select" name="Gender">
                                <option value="" disabled selected>Select</option>
                                <option>Male</option><option>Female</option><option>Other</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Date of Birth</label>
                            <input type="date" class="form-control" name="Dob" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Class Interested In <span class="text-danger">*</span></label>
                            <select class="form-select" name="ClassName" id="addClassName" required>
                                <option value="" disabled selected>Select class</option>
                                @foreach (var c in classes){<option value="@c.Text">@c.Text</option>}
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Academic Session <span class="text-danger">*</span></label>
                            <select class="form-select" name="Session" required>
                                <option value="" disabled>Select session</option>
                                @foreach (var s in sessions){<option value="@s.Text" selected="@s.Selected">@s.Text</option>}
                            </select>
                        </div>
                        <!-- Current school + class -->
                        <div class="col-12 col-md-6">
                            <label class="form-label">Current School</label>
                            <input type="text" class="form-control" name="CurrentSchool"
                                   placeholder="e.g. Delhi Public School" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Currently Studying in Class</label>
                            <select class="form-select" name="CurrentClass">
                                <option value="" selected>Select current class</option>
                                <option>Nursery</option><option>LKG</option><option>UKG</option>
                                <option>1st</option><option>2nd</option><option>3rd</option>
                                <option>4th</option><option>5th</option><option>6th</option>
                                <option>7th</option><option>8th</option><option>9th</option>
                                <option>10th</option><option>11th</option><option>12th</option>
                                <option>Not Currently Enrolled</option>
                            </select>
                        </div>
                        <!-- Interested Stream — shown only for classes 11 and 12 -->
                        <div class="col-12 col-md-6 d-none" id="streamRow">
                            <label class="form-label">Interested Stream</label>
                            <select class="form-select" name="InterestedStream">
                                <option value="" selected>Select stream</option>
                                <option>Science (PCM)</option>
                                <option>Science (PCB)</option>
                                <option>Commerce</option>
                                <option>Arts / Humanities</option>
                                <option>Vocational</option>
                            </select>
                        </div>
                    </div>

                    <hr class="mb-4">

                    <!-- Parent / Guardian -->
                    <div class="ec-section-title-wrap mb-3">
                        <div class="ec-section-icon"><i class="bx bx-user"></i></div>
                        <div><h6 class="mb-0">Parent / Guardian</h6></div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Father's Name</label>
                            <input type="text" class="form-control" name="FatherName" placeholder="e.g. Rajaram Sharma" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Father's Mobile <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">+91</span>
                                <input type="tel" class="form-control" name="FatherMobile" id="addFatherMobile"
                                       placeholder="9876543210" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Mother's Name</label>
                            <input type="text" class="form-control" name="MotherName" placeholder="e.g. Sunita Sharma" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Mother's Mobile</label>
                            <div class="input-group">
                                <span class="input-group-text">+91</span>
                                <input type="tel" class="form-control" name="MotherMobile" placeholder="Optional" />
                            </div>
                        </div>
                        <!-- Hidden primary mobile — auto-filled from father mobile -->
                        <input type="hidden" name="Mobile" id="addPrimaryMobile" value="" />
                        <div class="col-12 col-md-6">
                            <label class="form-label">Parent Email</label>
                            <input type="email" class="form-control" name="ParentEmail" id="addParentEmail"
                                   placeholder="e.g. rajaram@gmail.com" />
