        ps('Personal Details',[
            ['Full Name',s.name],['Roll No',s.roll],['Class / Section',s.cls+' – '+s.sec],
            ['DOB',d.dob],['Age',d.age],['Gender',s.gender],
            ['Blood Group',d.blood],['Mother Tongue',d.motherTongue],
            ['Religion',d.religion],['Category',d.category],
            ['Nationality',d.nationality],['Aadhaar',d.aadhaar],
            ['APAAR ID',d.apaar],['UDISE+ PEN',d.udise],
            ['Address',s.address||'—']
        ])
       +ps('Parent / Guardian',[
            ['Father / Guardian',d.fatherName],['Mother Name',d.motherName],
            ['Father Occupation',d.fatherOcc],['Father Qualification',d.fatherQual],
            ['Mother Occupation',d.motherOcc],['Mother Qualification',d.motherQual],
            ['Father Email',d.fatherEmail],['Mother Email',d.motherEmail],
