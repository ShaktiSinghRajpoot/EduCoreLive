@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    Guid studentPublicId = ViewBag.StudentPublicId ?? Guid.Empty;
    bool canManage   = ViewBag.CanManage == true;     // students.manage: Edit
    bool canViewFees = ViewBag.CanViewFees == true;   // fees.view: Fee tab, fee figures
    bool canCollect  = ViewBag.CanCollect == true;    // fees.collect: Collect Fee button
}

@section VendorScripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Student/Dashboard.css" asp-append-version="true" />
}

<div class="sd-shell" style="position:relative;">

    <div class="sd-hdr" id="sdHdr">
                <div class="sd-hdr-av bg-label-primary text-primary" id="sdAv">AV</div>
                <div>
                    <div class="sd-hdr-nm" id="sdName">Loading…</div>
                    <div class="sd-hdr-sub" id="sdMeta">—</div>
                    <div class="d-flex gap-1 flex-wrap mt-1" id="sdBadges"></div>
                    @* Shown for a student who has left: the record is read-only. *@
                    <div class="text-danger small fw-bold mt-1 d-none" id="sdLeft"></div>
                </div>
                <div class="ms-auto d-flex gap-2 flex-wrap justify-content-end">
                    @if (canCollect)
                    {
                        @* Filled in by the script once the admission no is known. *@
                        <a id="sdCollectBtn" href="#" class="btn btn-sm btn-primary d-none">
                            <i class="bx bx-wallet me-1"></i><span class="d-none d-sm-inline">Collect Fee</span>
                        </a>
                    }
                    @if (canManage)
                    {
                        <a id="sdEditBtn" asp-area="ERP" asp-controller="Student" asp-action="EditStudent"
                           asp-route-id="@studentPublicId" class="btn btn-sm btn-outline-primary">
                            <i class="bx bx-edit me-1"></i><span class="d-none d-sm-inline">Edit</span>
                        </a>
                    }
                    <a asp-area="ERP" asp-controller="Student" asp-action="StudentList" class="sd-back-btn">
                        <i class="bx bx-arrow-back"></i><span class="d-none d-sm-inline">Back to List</span>
                    </a>
                </div>
            </div>

            <nav class="sd-tab-nav" id="sdTabNav">
                <button class="sd-tab-btn active" data-tab="overview">Overview</button>
                <button class="sd-tab-btn" data-tab="academic">Academic</button>
                <button class="sd-tab-btn" data-tab="attendance">Attendance</button>
                <button class="sd-tab-btn" data-tab="timetable">Timetable</button>
                <button class="sd-tab-btn" data-tab="exams">Exam Results</button>
                @if (canViewFees)
                {
                    <button class="sd-tab-btn" data-tab="fee">Fee Details</button>
                }
                <button class="sd-tab-btn" data-tab="profile">Profile</button>
            </nav>

            <div class="sd-tc" id="sdTC">

                <div class="sd-pane active" id="tab-overview">
                    <div class="row g-2 mb-4" id="ov-metrics"></div>
                    <div class="row g-4">
                        <div class="col-12 col-lg-6">
                            <div class="ec-detail-box mb-0">
                                <div class="ec-detail-title">Subject Performance</div>
                                <div id="ov-bars" class="mt-2"></div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="ec-detail-box mb-3">
                                <div class="ec-detail-title">Recent Activity</div>
                                <div id="ov-activity"></div>
                            </div>
                            <div class="ec-detail-box mb-0">
                                <div class="ec-detail-title">Quick Info</div>
                                <div class="sd-info-grid mt-2" id="ov-qinfo"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sd-pane" id="tab-academic">
                    @* This tab used to chart Term 1 / Term 2 / Annual marks against a
                       "class average", with letter grades, all generated. The exam module
                       records marks per EXAM, not per term. Exam Results shows the real marks,
                       grade (from the school's Grade Scale) and class rank, exam by exam. *@
                    <div class="ec-detail-box mb-4">
                        <div class="ec-detail-title">Exam performance</div>
                        <div id="ac-exams" class="mt-2"></div>
                    </div>
                    <div class="ec-detail-box mb-0">
                        <div class="ec-detail-title">Current placement</div>
                        <div id="ac-placement" class="mt-2"></div>
                    </div>
                </div>

                <div class="sd-pane" id="tab-attendance">
                    <div id="att-warn" class="sd-warn d-none mb-3">
                        <i class="bx bx-error me-2"></i>
                        Attendance is below 75%. Student may not be eligible for exams.
                    </div>
                    <div class="row g-2 mb-4" id="att-metrics"></div>
                    <div class="ec-detail-box mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div class="ec-detail-title mb-0">Monthly Calendar</div>
                            <select class="form-select form-select-sm" id="attMonSel" style="width:auto;">
                                <option value="4">May 2026</option>
                                <option value="3">April 2026</option>
                                <option value="2">March 2026</option>
                            </select>
                        </div>
                        <div class="d-flex gap-3 mb-3 flex-wrap" style="font-size:.75rem;">
                            <span><span style="display:inline-block;width:10px;height:10px;background:#d4edda;border-radius:3px;"></span> Present (P)</span>
                            <span><span style="display:inline-block;width:10px;height:10px;background:#fde8e8;border-radius:3px;"></span> Absent (A)</span>
                            <span><span style="display:inline-block;width:10px;height:10px;background:#fff3cd;border-radius:3px;"></span> Half-day (H)</span>
                            <span><span style="display:inline-block;width:10px;height:10px;background:#e2e3e5;border-radius:3px;"></span> Holiday</span>
                        </div>
                        <div class="sd-cal" id="attCal"></div>
                    </div>
                    @* Subject-wise attendance is not possible today: core.student_attendance
                       records ONE row per student per day, not per period, so there is no
                       subject to group by. The table used to be filled with invented
                       numbers. It comes back when attendance is taken per period. *@
                </div>

                <div class="sd-pane" id="tab-timetable">
                    <div class="ec-detail-box mb-0">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="ec-detail-title mb-0">Weekly Timetable</div>
                            <small class="text-muted fw-bold">Today highlighted in orange</small>
                        </div>
                        <div class="sd-tt-wrap">
                            <table class="sd-tt" id="ttTable">
                                <thead id="ttHead"></thead>
                                <tbody id="ttBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="sd-pane" id="tab-exams">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                        <div class="ec-detail-title mb-0">Exam Results</div>
                        @* Filled from the student's own PUBLISHED exams — see the script. *@
                        <select class="form-select form-select-sm" id="examSel" style="width:auto;"></select>
                    </div>
                    <div class="row g-2 mb-4" id="exam-summary"></div>
                    <div class="ec-detail-box mb-4">
                        <div class="ec-detail-title">Subject-wise Results</div>
                        <div class="table-responsive">
                            <table class="table sd-tbl align-middle mb-0">
                                <thead><tr><th>Subject</th><th>Max Marks</th><th>Obtained</th><th>%</th><th>Grade</th><th>Result</th></tr></thead>
                                <tbody id="examBody"></tbody>
                            </table>
                        </div>
                    </div>
                    @* "Previous Exam Comparison" needs two exams' marks side by side and was
                       being filled with invented deltas. The exam picker above already lets
                       the office look at either one. *@
                </div>

                <div class="sd-pane" id="tab-fee">
                    <div class="row g-2 mb-4" id="fee-metrics"></div>
                    @* Only instalments still owing come back from the ledger, so this is
                       labelled Pending Dues, not the full fee structure. *@
                    <div class="ec-detail-box mb-4">
                        <div class="ec-detail-title">Pending Dues</div>
                        <div class="table-responsive">
                            <table class="table sd-tbl align-middle mb-0">
                                <thead><tr><th>Fee Head</th><th>Instalment</th><th>Due Date</th><th>Amount</th><th>Paid</th><th>Balance</th></tr></thead>
                                <tbody id="feeStructBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="ec-detail-box mb-4">
                        <div class="ec-detail-title">Payment History</div>
                        <div class="table-responsive">
                            <table class="table sd-tbl align-middle mb-0">
                                <thead><tr><th>Date</th><th>Fee Head</th><th>Amount</th><th>Mode</th><th>Receipt No</th><th>Collected By</th><th></th></tr></thead>
                                <tbody id="feeHistBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div id="concessionBox" class="d-none">
                        <div class="ec-detail-box mb-0" style="border-color:rgba(255,193,7,.4);background:#fffde7;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="ec-detail-title">Concession / Scholarship</div>
                                    <div class="text-muted small mt-1" id="concessionDesc">Total discounts / concessions given on this student's fees</div>
                                </div>
                                <div class="text-success fw-bold fs-6" id="concessionAmt">—</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sd-pane" id="tab-profile">
                    @if (canManage)
                    {
                        <div class="mb-3 text-end" id="sdEditWrap">
                            <a asp-area="ERP" asp-controller="Student" asp-action="EditStudent"
                               asp-route-id="@studentPublicId"
                               class="btn btn-primary btn-sm">
                                <i class="bx bx-edit me-1"></i>Edit Profile
                            </a>
                        </div>
                    }
                    <div id="profileContent"></div>

                    <!-- Session history — real data from core.student_enrolment.
                         The student row only holds the current session, so this
                         is the only record of the classes they passed through. -->
                    <div class="ec-card mt-3">
                      <div class="ec-card-header">
                        <div class="ec-section-title-wrap">
                          <span class="ec-section-icon"><i class="bx bx-history"></i></span>
                          <div>
                            <div class="ec-section-title">Session History</div>
                            <div class="ec-section-subtitle">Class and section in each academic session</div>
                          </div>
                        </div>
                      </div>
                      <div class="ec-card-body pt-2">
                        <div class="table-responsive">
                          <table class="table table-sm align-middle mb-0">
                            <thead>
                              <tr>
                                <th>Session</th><th>Class</th><th>Section</th>
                                <th>Roll No</th><th>Outcome</th>
                              </tr>
                            </thead>
                            <tbody id="enrolHistoryBody">
                              <tr><td colspan="5" class="text-muted small">Loading…</td></tr>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>

                    <!-- Activity & money history — everything that changed the
                         student's place or money outside a receipt (Student/History). -->
                    <div class="ec-card mt-3">
                      <div class="ec-card-header">
                        <div class="ec-section-title-wrap">
                          <span class="ec-section-icon"><i class="bx bx-list-ul"></i></span>
                          <div>
                            <div class="ec-section-title">Activity &amp; Money History</div>
                            <div class="ec-section-subtitle">Admission, exit, promotion, class changes, bus, closed dues and refunds</div>
                          </div>
                        </div>
                      </div>
                      <div class="ec-card-body pt-2">
                        <div class="table-responsive">
                          <table class="table table-sm align-middle mb-0">
                            <thead>
                              <tr><th>When</th><th>What</th><th>Detail</th><th class="text-end">Amount</th><th>By</th></tr>
                            </thead>
                            <tbody id="studentHistoryBody">
                              <tr><td colspan="5" class="text-muted small">Loading…</td></tr>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                </div>

            </div>

            <div class="sd-loader d-none" id="sdLoader">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-2" style="width:2.5rem;height:2.5rem;"></div>
                    <div class="text-muted small fw-bold">Loading student dashboard…</div>
                </div>
            </div>

</div>

@* Payment History rows open the real receipt, so the shared receipt modal and
   renderer are needed (only for users who can see fees). *@
@if (canViewFees)
{
    @await Html.PartialAsync("_FeeReceiptModal")
}

@section PageScripts {
@if (canViewFees)
{
    <script src="~/js/fee-receipt.js" asp-append-version="true"></script>
}
<script>
(function(){
'use strict';

var STUDENT_ID = '@studentPublicId';   // uuid, so quoted
var ENROL_HISTORY_URL = '@Url.Action("EnrolmentHistory","Student",new{area="ERP"})';
var STUDENT_HISTORY_URL = '@Url.Action("History","Student",new{area="ERP"})';
var DATA_URL          = '@Url.Action("DashboardData","Student",new{area="ERP"})';
var COLLECT_URL       = '@Url.Action("ManageFee","Fee",new{area="ERP"})';
var CAN_FEES          = @(canViewFees ? "true" : "false");   // fees.view
var charts = {};

/* ── Helpers ─────────────────────────────────── */
var MO=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function fmtDate(d){var x=new Date(d);return String(x.getDate()).padStart(2,'0')+' '+MO[x.getMonth()]+' '+x.getFullYear();}
function ini(n){return n.split(' ').slice(0,2).map(function(w){return w[0];}).join('').toUpperCase();}
function inr(n){return n===0?'₹ 0':'₹ '+n.toLocaleString('en-IN');}
function feeB(f){var m={Paid:'b-paid',Partial:'b-partial',Pending:'b-pending'};return '<span class="sd-bdg '+(m[f]||'b-pending')+'">'+EC.esc(f)+'</span>';}
function statB(s){var m={Active:'b-active',Inactive:'b-inactive',Transfer:'b-transfer'};return '<span class="sd-bdg '+(m[s]||'b-inactive')+'">'+EC.esc(s)+'</span>';}
function pct(a,b){return b===0?0:Math.round(a/b*100);}
function attHtml(p){
  var c=p>=75?'#28c76f':p>=50?'#ff9f43':'#ea5455';
  var tc=p>=75?'#155724':p>=50?'#856404':'#842029';
  return '<div style="display:flex;align-items:center;gap:.4rem;">'
    +'<div style="width:55px;height:5px;background:#ede8e3;border-radius:999px;overflow:hidden;">'
    +'<div style="height:100%;width:'+p+'%;background:'+c+';border-radius:inherit;"></div></div>'
    +'<span style="font-weight:800;font-size:.8rem;color:'+tc+'">'+p+'%</span></div>';
}
function badge(txt,cls){return '<span class="sd-bdg '+cls+'">'+txt+'</span>';}
function hide(id){ var el=document.getElementById(id); if(el) el.classList.add('d-none'); }

/* ── Tabs ─────────────────────────────────────── */
// Shows one pane and marks its button. An unknown name (or #fee for a user who
// has no Fee tab) falls back to Overview.
function activateTab(name){
    var btn=document.querySelector('.sd-tab-btn[data-tab="'+name+'"]');
    if(!btn){ name='overview'; btn=document.querySelector('.sd-tab-btn[data-tab="overview"]'); }
    document.querySelectorAll('.sd-tab-btn').forEach(function(b){ b.classList.remove('active'); });
    document.querySelectorAll('.sd-pane').forEach(function(p){ p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('tab-'+name).classList.add('active');
}
document.querySelectorAll('.sd-tab-btn').forEach(function(b){
    b.addEventListener('click', function(){
        var name=this.getAttribute('data-tab');
        activateTab(name);
        // Keep the tab in the URL without adding a history entry per click.
        history.replaceState(null, '', '#'+name);
    });
});

/* ── Shape the API payload for the render functions ──
   Same keys the mock used, so nothing below this line changed. Anything the
   backend cannot answer yet is left EMPTY rather than invented — the old page
   filled attendance, exam marks and the timetable with Math.random(), which
   looked like real data and was not. */
function buildDetail(api){
    var st = api.student;
    // fee is null for a user without fees.view (the server leaves it out).
    var fee = api.fee || { rows:[], totalDue:0, totalPaid:0, concession:0, outstanding:0 };

    return {
        dob:st.dob, age:(st.age!=null ? st.age+' yrs' : '—'), blood:st.blood,
        religion:st.religion, category:st.category, nationality:st.nation,
        aadhaar:st.idProof, motherTongue:st.motherTongue, apaar:st.apaar, udise:st.udise,
        fatherName:st.guardian, motherName:st.mother, guardianName:st.guardian,
        fatherOcc:st.fatherOcc, fatherQual:st.fatherQual, fatherEmail:st.fatherEmail,
        motherOcc:st.motherOcc, motherQual:st.motherQual, motherEmail:st.motherEmail,
        income:(st.income!=null ? inr(st.income) : '—'),
        prevSchool:st.prevSchool, prevBoard:st.prevBoard, prevClass:st.prevClass, tcNo:st.prevTc,

        /* attendance, timetable and exams are attached from the API in loadDashboard */

        // One row per instalment still owing (the ledger's dues list).
        pendingDues: fee.rows || [],
        feeHistory: (api.receipts || []).map(function(r){
            return {date:r.date, amt:r.amount, mode:r.mode, receipt:r.receiptNo,
                    cancelled:r.cancelled, by:r.cancelled ? 'CANCELLED' : (r.collectedBy || '—')};
        }),
        totalFee: fee.totalDue, totalPaid: fee.totalPaid,
        hasConcession: fee.concession > 0, concessionAmt: fee.concession
    };
}

/* ── Load dashboard ──────────────────────────── */
var DETAIL=null, STUDENT=null;

function loadDashboard(){
    document.getElementById('sdLoader').classList.remove('d-none');

    $.getJSON(DATA_URL, { id: STUDENT_ID })
    .done(function(api){
        if(!api || !api.found){
            document.getElementById('sdLoader').classList.add('d-none');
            document.getElementById('sdName').textContent='Student not found';
            return;
        }

        var st=api.student;
        // The shape the render functions expect, from real values.
        var s={
            id:STUDENT_ID, name:st.name, roll:st.roll, cls:st.cls, sec:st.sec,
            gender:st.gender, guardian:st.guardian, status:st.status || 'Active', admDate:st.admDate,
            phone:st.mobile, address:st.address,
            feeDue:api.fee ? api.fee.outstanding : null,
            feeSt:!api.fee ? null : api.fee.outstanding<=0 ? 'Paid' : (api.fee.totalPaid>0 ? 'Partial' : 'Pending'),
            attend:null, color:'primary', subjects:st.subjects
        };

        STUDENT=s; DETAIL=buildDetail(api);
        DETAIL.attendance = api.attendance;
        DETAIL.timetable  = api.timetable;
        DETAIL.exams      = api.exams;

        // Open on the most recent month that has a register.
        var ms=(api.attendance && api.attendance.months) || [];
        if(ms.length){ ATT_MONTH=ms[0].month; ATT_YEAR=ms[0].year; }

        var av=document.getElementById('sdAv');
        av.textContent=ini(s.name);
        av.className='sd-hdr-av bg-label-'+s.color+' text-'+s.color;
        if(st.photo){
            var img=document.createElement('img');
            img.src=st.photo; img.alt='';
            img.style.cssText='width:100%;height:100%;object-fit:cover;border-radius:inherit;';
            av.textContent=''; av.appendChild(img);
        }

        // A student who has left: read-only. Say when and why, and hide Edit.
        // (The Edit buttons only exist for users with students.manage.)
        if(st.isActive===false){
            var left=document.getElementById('sdLeft');
            left.textContent='Left the school'+(st.leftOn?' on '+st.leftOn:'')+(st.leftWhy?' — '+st.leftWhy:'')+'. This record is read-only.';
            left.classList.remove('d-none');
            hide('sdEditWrap'); hide('sdEditBtn');
        }

        // Collect Fee opens the fee counter with this student already picked.
        var collect=document.getElementById('sdCollectBtn');
        if(collect && st.isActive!==false && st.admNo && st.admNo!=='—'){
            collect.href=COLLECT_URL+'?adm='+encodeURIComponent(st.admNo)+'&session='+encodeURIComponent(st.year||'');
            collect.classList.remove('d-none');
        }

        document.getElementById('sdName').textContent=s.name;
        document.getElementById('sdMeta').textContent='Roll '+s.roll+' · '+s.cls+' – '+s.sec+' · '+st.admNo;
        document.getElementById('sdBadges').innerHTML=statB(s.status)+(s.feeSt ? ' '+feeB(s.feeSt) : '');

        document.getElementById('sdLoader').classList.add('d-none');
        renderOverview(s,DETAIL);
        renderAcademic(s,DETAIL);
        renderFee(s,DETAIL);
        renderProfile(s,DETAIL);
        renderAttendance(s,DETAIL);
        renderTimetable(DETAIL);
        renderExams(s,DETAIL);
        // Open the tab named in the URL (#fee, #profile ...) so a tab can be linked
        // to and survives a reload; otherwise Overview.
        activateTab(location.hash ? location.hash.substring(1) : 'overview');
    })
    .fail(function(){
        document.getElementById('sdLoader').classList.add('d-none');
        document.getElementById('sdName').textContent='Could not load this student';
    });
}

/* ── Tab 1: Overview ─────────────────────────── */
function renderOverview(s,d){
    var att=d.attendance, ex=d.exams;

    // Class rank lives on the Exam Results tab: it comes from the published
    // result (core.sp_exam_result_student). It used to show rand(1,40) here.
    document.getElementById('ov-metrics').innerHTML=
        mc('Attendance', (att&&att.schoolDays) ? att.percent+'%' : '—',
           (att&&att.schoolDays&&att.percent>=75?'bg-label-success text-success':'bg-label-warning text-warning'),'bx-user-check')
       +mc('Last Exam',  (ex&&ex.options.length) ? ex.percent+'%' : '—','bg-label-info text-info','bx-book-open')
       // The class's subjects (Subject Management); else the last exam's count.
       +mc('Subjects',   s.subjects!=null ? String(s.subjects) : (ex&&ex.options.length) ? String(ex.subjectCount) : '—','bg-label-primary text-primary','bx-list-check')
       +(CAN_FEES
           ? mc('Fee Due', inr(s.feeDue),(s.feeDue>0?'bg-label-danger text-danger':'bg-label-success text-success'),'bx-wallet')
           : mc('Admitted', EC.esc(s.admDate||'—'),'bg-label-info text-info','bx-calendar'));

    // Subject bars come from the latest published exam's real marks; absent
    // subjects have no percentage, so they are not drawn as a zero-length bar.
    var bars=(ex&&ex.subjects||[]).filter(function(m){ return m.percent!=null; });
    document.getElementById('ov-bars').innerHTML = bars.length
      ? bars.map(function(m){
            var col=m.percent>=85?'#28c76f':m.percent>=70?'#2196f3':m.percent>=55?'#ff9f43':'#ea5455';
            return '<div class="sd-subj-row">'
                +'<div class="sd-subj-hd"><span>'+EC.esc(m.subject)+'</span><span>'+m.percent+'%</span></div>'
                +'<div class="sd-bar-wrap"><div class="sd-bar-fill" style="width:'+m.percent+'%;background:'+col+'"></div></div>'
                +'</div>';
        }).join('')
      : '<div class="text-muted small">No published exam marks yet.</div>';

    // Only facts we actually hold. The old version listed a made-up last payment
    // and a made-up absence date.
    var acts='';
    if(ex&&ex.options.length) acts+=ai('bx-file','bg-label-info text-info',
        'Last exam: '+EC.esc(ex.options[0].name), ex.percent+'%'+(ex.options[0].date?' · '+EC.esc(ex.options[0].date):''));
    if(d.feeHistory.length)   acts+=ai('bx-wallet','bg-label-success text-success',
        'Last fee payment', inr(d.feeHistory[0].amt)+' · '+EC.esc(d.feeHistory[0].date));
    if(att&&att.schoolDays)   acts+=ai('bx-user-check','bg-label-primary text-primary',
        'Attendance this session', att.present+' of '+att.schoolDays+' days');
    acts+=ai('bx-user-plus','bg-label-primary text-primary','Admission', EC.esc(s.admDate||'—'));
    document.getElementById('ov-activity').innerHTML = acts;

    document.getElementById('ov-qinfo').innerHTML=
        ic('DOB',d.dob)+ic('Blood Group',d.blood)+ic('Religion',d.religion)
       +ic('Category',d.category)+ic('Nationality',d.nationality)
       +ic('ID Proof',d.aadhaar)+ic('Guardian',d.guardianName);
}
function mc(lbl,val,cls,icon){
    return '<div class="col-6 col-sm-3"><div class="sd-metric">'
        +'<div class="d-flex justify-content-center mb-1">'
        +'<span class="'+cls+'" style="width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;">'
        +'<i class="bx '+icon+'"></i></span></div>'
        +'<div class="sd-metric-val">'+val+'</div>'
        +'<div class="sd-metric-lbl">'+lbl+'</div>'
        +'</div></div>';
}
function ai(icon,cls,title,time){
    return '<div class="sd-act-item"><div class="sd-act-ic '+cls+'"><i class="bx '+icon+'"></i></div>'
        +'<div><div class="sd-act-title">'+title+'</div><div class="sd-act-time">'+time+'</div></div></div>';
}
// val is data (names, DOB, guardian...) so it is escaped; lbl is our own text.
function ic(lbl,val){
    return '<div class="sd-ic"><div class="sd-ic-lbl">'+lbl+'</div><div class="sd-ic-val">'+EC.esc(val==null?'—':val)+'</div></div>';
}

/* ── Tab 2: Academic ─────────────────────────── */
function renderAcademic(s,d){
    // Every published exam this student has marks in — the list the Exam Results
    // picker is built from, so the two tabs can never disagree.
    var ex=d.exams;
    document.getElementById('ac-exams').innerHTML =
        (ex && ex.options.length)
          ? '<ul class="mb-0 small" style="padding-left:1.1rem;">'
            + ex.options.map(function(o){
                return '<li>'+EC.esc(o.name)+(o.type?' <span class="text-muted">('+EC.esc(o.type)+')</span>':'')
                     + (o.date?' — '+EC.esc(o.date):'')+'</li>'; }).join('')
            + '</ul><div class="text-muted small mt-2">Open the Exam Results tab for subject-wise marks.</div>'
          : '<div class="text-muted small">No published exam results yet.</div>';

    document.getElementById('ac-placement').innerHTML =
        ic('Class', s.cls) + ic('Section', s.sec) + ic('Roll No', s.roll);
}

/* ── Tab 3: Attendance ───────────────────────── */
function renderAttendance(s,d){
    var a=d.attendance;

    // No register taken yet is not 0% attendance — say so instead of scaring
    // the office with a red zero.
    if(!a || !a.schoolDays){
        document.getElementById('att-warn').classList.add('d-none');
        document.getElementById('att-metrics').innerHTML=
            '<div class="text-muted small p-3">No attendance has been marked for this class yet.</div>';
        document.getElementById('attCal').innerHTML='';
        fillMonthSelector([]);
        return;
    }

    // The class may have held registers this student was never marked on (e.g.
    // admitted the same week). Warn only once the student has marked days.
    var marked=(a.present||0)+(a.absent||0)+(a.leave||0);
    if(marked>0 && a.percent<75) document.getElementById('att-warn').classList.remove('d-none');
    else             document.getElementById('att-warn').classList.add('d-none');

    document.getElementById('att-metrics').innerHTML=
        mc('Attendance',a.percent+'%',(a.percent>=75?'bg-label-success text-success':'bg-label-danger text-danger'),'bx-user-check')
       +mc('Present',a.present+' of '+a.schoolDays,'bg-label-success text-success','bx-check-circle')
       +mc('Absent', a.absent+' days','bg-label-danger text-danger','bx-x-circle')
       +mc('Leave',  a.leave+' days','bg-label-warning text-warning','bx-time');

    fillMonthSelector(a.months||[]);
    buildCalendar(a.days||{}, ATT_MONTH, ATT_YEAR);
}

var MONTH_NAMES=['January','February','March','April','May','June',
                 'July','August','September','October','November','December'];
var ATT_MONTH=null, ATT_YEAR=null;

// Only months that actually have a register — an empty month in the list would
// open a calendar with nothing in it and no way to tell why.
function fillMonthSelector(months){
    var sel=document.getElementById('attMonSel');
    if(!months.length){ sel.innerHTML='<option>No attendance yet</option>'; return; }

    sel.innerHTML=months.map(function(m){
        return '<option value="'+m.year+'-'+m.month+'"'+(m.month===ATT_MONTH&&m.year===ATT_YEAR?' selected':'')+'>'
             + MONTH_NAMES[m.month-1]+' '+m.year+'</option>';
    }).join('');
}

document.getElementById('attMonSel').addEventListener('change',function(){
    var parts=String(this.value).split('-');
    if(parts.length!==2) return;
    // Re-ask the server for that month's day grid rather than caching every month.
    $.getJSON(DATA_URL,{ id:STUDENT_ID, year:parts[0], month:parts[1] })
     .done(function(api){
        if(!api||!api.found||!api.attendance) return;
        ATT_YEAR=parseInt(parts[0],10); ATT_MONTH=parseInt(parts[1],10);
        buildCalendar(api.attendance.days||{}, ATT_MONTH, ATT_YEAR);
     });
});

/* Real month grid. A day with no mark is a day no register was taken — drawn as
   a blank, never as an absence. */
function buildCalendar(marks, month, year){
    var cal=document.getElementById('attCal');
    var names=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var html=names.map(function(d){return '<div class="sd-day aW">'+d+'</div>';}).join('');

    if(!month||!year){ cal.innerHTML=html; return; }

    var first=new Date(year, month-1, 1).getDay();
    var total=new Date(year, month, 0).getDate();

    for(var i=0;i<first;i++) html+='<div class="sd-day aW"></div>';

    for(var day=1;day<=total;day++){
        var mk=marks[day]||marks[String(day)];
        var cls = mk==='P' ? 'aP' : mk==='A' ? 'aA' : mk==='L' ? 'aL' : 'aH';
        html+='<div class="sd-day '+cls+'" title="'+
              (mk==='P'?'Present':mk==='A'?'Absent':mk==='L'?'Leave':'No register')+'">'+day+'</div>';
    }
    cal.innerHTML=html;
}

/* ── Tab 4: Timetable ───────────────────────── */
function renderTimetable(d){
    var tt=d.timetable, head=document.getElementById('ttHead'), body=document.getElementById('ttBody');

    // Two different nothings, and the office needs to tell them apart: the class
    // has no timetable setup at all, vs it has one and no periods are filled.
    if(!tt || !tt.hasSection){
        head.innerHTML='';
        body.innerHTML='<tr><td class="text-muted small p-3">'
            +'This class and section do not appear in the timetable setup, so there is no week to show.</td></tr>';
        return;
    }
    if(!tt.periods.length || !tt.days.length){
        head.innerHTML='';
        body.innerHTML='<tr><td class="text-muted small p-3">'
            +'No periods have been set up yet (Settings → Period Structure).</td></tr>';
        return;
    }

    // JS getDay(): 0 = Sunday, matching TimetableDay.DayOfWeek.
    var todayDow=new Date().getDay();

    head.innerHTML='<tr><th>Period</th>'+tt.days.map(function(dy){
        var isToday=dy.dow===todayDow;
        return '<th'+(isToday?' style="color:var(--ec-primary);background:var(--ec-primary-light);"':'')+'>'
             + EC.esc(dy.label)+(isToday?' ★':'')+'</th>';
    }).join('')+'</tr>';

    // Index the week once — the grid is days × periods and a linear scan per cell
    // would be O(n²) on a full timetable.
    var byCell={};
    (tt.entries||[]).forEach(function(e){ byCell[e.dow+':'+e.seq]=e; });

    body.innerHTML=tt.periods.map(function(pd){
        var time=(pd.start&&pd.end) ? pd.start+'–'+pd.end : pd.label;

        // A break or lunch is not a subject — span it instead of drawing dashes.
        // Left-aligned: centred across six days put the label off-screen on a phone.
        if(pd.type && pd.type.toLowerCase()!=='class'){
            return '<tr><td class="fw-bold text-muted" style="font-size:.75rem;white-space:nowrap;">'+EC.esc(time)+'</td>'
                 + '<td colspan="'+tt.days.length+'" class="text-start text-muted" style="font-size:.75rem;">'
                 + EC.esc(pd.label)+'</td></tr>';
        }

        return '<tr>'
            +'<td class="fw-bold text-muted" style="font-size:.75rem;white-space:nowrap;">'+EC.esc(time)+'</td>'
            +tt.days.map(function(dy){
                var cell=byCell[dy.dow+':'+pd.seq];
                var todayCls=dy.dow===todayDow?'border-left:2px solid var(--ec-primary);':'';
                if(!cell) return '<td style="'+todayCls+'"><span class="text-muted" style="font-size:.75rem;">—</span></td>';
                return '<td style="'+todayCls+'">'
                    +'<span class="sd-subj-cell" style="background:#f5f5f5;">'+EC.esc(cell.subject)+'</span>'
                    +(cell.teacher ? '<div class="text-muted mt-1" style="font-size:.68rem;">'+EC.esc(cell.teacher)+'</div>' : '')
                    +'</td>';
            }).join('')
            +'</tr>';
    }).join('');
}

/* ── Tab 5: Exam Results ─────────────────────── */
function renderExams(s,d){
    var ex=d.exams, sel=document.getElementById('examSel');

    if(!ex || !ex.options.length){
        sel.innerHTML='<option>No published results</option>';
        document.getElementById('exam-summary').innerHTML=
            '<div class="text-muted small p-3">No published exam results for this student yet. '
           +'Results appear here once the school publishes the results of an exam.</div>';
        document.getElementById('examBody').innerHTML='';
        return;
    }

    if(!sel.options.length || sel.dataset.filled!=='1'){
        sel.innerHTML=ex.options.map(function(o){
            return '<option value="'+o.id+'">'+EC.esc(o.name)+(o.date?' · '+EC.esc(o.date):'')+'</option>';
        }).join('');
        sel.dataset.filled='1';
    }

    // Absences are out of the totals, so say how many there were — otherwise
    // "2 subjects" on a 3-subject exam looks like missing data.
    document.getElementById('exam-summary').innerHTML=
        mc('Percentage', ex.percent+'%'+(ex.grade?' · '+EC.esc(ex.grade):''),(ex.percent>=33?'bg-label-success text-success':'bg-label-danger text-danger'),'bx-bar-chart-alt-2')
       +mc('Marks', ex.obtained+' / '+ex.total,'bg-label-primary text-primary','bx-calculator')
       // Rank by overall % within the class; ties share a rank. None when absent from every paper.
       +mc('Class Rank', ex.classRank!=null ? ex.classRank+' / '+ex.classSize : '—','bg-label-warning text-warning','bx-trophy')
       +mc('Subjects', ex.subjectCount+(ex.absentCount?' (+'+ex.absentCount+' absent)':''),'bg-label-info text-info','bx-book')
       +mc('Failed', ex.failedCount+(ex.failedCount===1?' subject':' subjects'),
           (ex.failedCount?'bg-label-danger text-danger':'bg-label-success text-success'),'bx-error-circle');

    document.getElementById('examBody').innerHTML=ex.subjects.map(function(r){
        // Absent is not zero and not a fail — it is its own outcome.
        if(r.absent){
            return '<tr>'
                +'<td class="fw-bold">'+EC.esc(r.subject)+'</td>'
                +'<td>'+(r.max!=null?r.max:'—')+'</td>'
                +'<td class="text-muted">—</td>'
                +'<td class="text-muted">—</td>'
                +'<td class="text-muted">—</td>'
                +'<td><span class="sd-bdg b-inactive">Absent</span></td>'
                +'</tr>';
        }
        var res = r.passed===true  ? '<span class="sd-bdg b-active">Pass</span>'
                : r.passed===false ? '<span class="sd-bdg b-inactive" style="background:#fde8e8;color:#842029;">Fail</span>'
                : '<span class="text-muted small" title="No pass mark set for this subject">—</span>';
        return '<tr>'
            +'<td class="fw-bold">'+EC.esc(r.subject)+'</td>'
            +'<td>'+(r.max!=null?r.max:'—')+'</td>'
            +'<td class="fw-bold">'+(r.obtained!=null?r.obtained:'—')+'</td>'
            +'<td>'+(r.percent!=null?r.percent+'%':'—')+'</td>'
            +'<td class="fw-bold">'+(r.grade?EC.esc(r.grade):'—')+'</td>'
            +'<td>'+res+'</td>'
            +'</tr>';
    }).join('');
}

// Switching exam re-asks the server rather than caching every exam's marks.
document.getElementById('examSel').addEventListener('change',function(){
    var id=this.value;
    if(!id||isNaN(id)) return;
    $.getJSON(DATA_URL,{ id:STUDENT_ID, examId:id })
     .done(function(api){
        if(!api||!api.found||!api.exams) return;
        DETAIL.exams=api.exams;
        renderExams(STUDENT,DETAIL);
     });
});

function renderFee(s,d){
    if(!CAN_FEES) return;   // no Fee tab for this user
    document.getElementById('fee-metrics').innerHTML=
        mc('Total Fee', inr(d.totalFee),'bg-label-primary text-primary','bx-calculator')
       +mc('Paid',      inr(d.totalPaid),'bg-label-success text-success','bx-check-shield')
       +mc('Balance',   inr(s.feeDue),(s.feeDue>0?'bg-label-danger text-danger':'bg-label-success text-success'),'bx-error-circle')
       +mc('Receipts',  d.feeHistory.length+' txn','bg-label-info text-info','bx-receipt');

    document.getElementById('feeStructBody').innerHTML = d.pendingDues.length
      ? d.pendingDues.map(function(f){
            return '<tr>'
                +'<td class="fw-bold">'+EC.esc(f.head)+'</td>'
                +'<td>'+EC.esc(f.installment)+'</td>'
                +'<td>'+EC.esc(f.dueDate)+'</td>'
                +'<td>'+inr(f.due)+'</td>'
                +'<td class="text-success fw-bold">'+inr(f.paid)+'</td>'
                +'<td class="text-danger fw-bold">'+inr(f.outstanding)+'</td>'
                +'</tr>';
        }).join('')
      : '<tr><td colspan="6" class="text-muted small">Nothing is pending. All dues are paid.</td></tr>';

    // The printer button opens the real receipt (shared receipt modal), which
    // has its own Print button.
    document.getElementById('feeHistBody').innerHTML = d.feeHistory.length
      ? d.feeHistory.map(function(f){
            return '<tr'+(f.cancelled?' class="text-muted" style="text-decoration:line-through;"':'')+'>'
                +'<td>'+EC.esc(f.date)+'</td>'
                +'<td class="fw-bold">Fee payment</td>'
                +'<td class="text-success fw-bold">'+inr(f.amt)+'</td>'
                +'<td>'+EC.esc(f.mode)+'</td>'
                +'<td>'+EC.esc(f.receipt)+'</td>'
                +'<td>'+EC.esc(f.by)+'</td>'
                +'<td><button type="button" class="btn btn-sm btn-outline-secondary btn-receipt" data-rcp="'+EC.esc(f.receipt)+'" title="View / print receipt"><i class="bx bx-printer"></i></button></td>'
                +'</tr>';
        }).join('')
      : '<tr><td colspan="7" class="text-muted small">No payments yet.</td></tr>';

    if(s.feeDue>0){
        document.getElementById('feeHistBody').innerHTML+=
            '<tr style="background:#fde8e8;">'
            +'<td colspan="2" class="fw-bold text-danger">Outstanding Balance</td>'
            +'<td colspan="5" class="text-danger fw-bold fs-6">'+inr(s.feeDue)+'</td>'
            +'</tr>';
    }

    if(d.hasConcession&&d.concessionAmt>0){
        document.getElementById('concessionBox').classList.remove('d-none');
        document.getElementById('concessionAmt').textContent='- '+inr(d.concessionAmt);
    }
}

// Receipt buttons are drawn by renderFee, so the click is caught on the table.
$('#feeHistBody').on('click', '.btn-receipt', function(){
    if(window.EcReceipt) EcReceipt.show($(this).data('rcp'));
});

/* ── Tab 7: Profile ──────────────────────────── */
