// switch between. Left in place for when the exam module exposes one.

/* ── Session history (real data) ──────────────
   Everything else on this page is still mock; this card reads
   core.student_enrolment through the server. */
function loadEnrolmentHistory(){
  var body=document.getElementById('enrolHistoryBody');
  if(!body) return;

  if(!STUDENT_ID){
    body.innerHTML='<tr><td colspan="5" class="text-muted small">No student selected.</td></tr>';
    return;
  }

  $.getJSON(ENROL_HISTORY_URL, { id:STUDENT_ID })
    .done(function(rows){
      if(!rows || !rows.length){
        body.innerHTML='<tr><td colspan="5" class="text-muted small">No session history yet.</td></tr>';
        return;
      }
      body.innerHTML=rows.map(function(r){
        var badge={Active:'success',Promoted:'primary',Retained:'warning',
                   PassedOut:'info',Left:'secondary'}[r.status]||'secondary';
        return '<tr>'
          +'<td class="fw-bold">'+EC.esc(r.year)+(r.isCurrent?' <span class="badge bg-label-success">current</span>':'')+'</td>'
          +'<td>'+EC.esc(r.cls)+'</td>'
          +'<td>'+EC.esc(r.sec||'—')+'</td>'
          +'<td>'+EC.esc(r.roll||'—')+'</td>'
          +'<td><span class="badge bg-label-'+badge+'">'+EC.esc(r.status)+'</span></td>'
          +'</tr>';
      }).join('');
    })
    .fail(function(){
      body.innerHTML='<tr><td colspan="5" class="text-danger small">Could not load session history.</td></tr>';
    });
}

/* ── Init ────────────────────────────────────── */
loadDashboard();
loadEnrolmentHistory();

})();
