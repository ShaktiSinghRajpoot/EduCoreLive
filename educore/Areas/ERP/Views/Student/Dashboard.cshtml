function ps(title,rows){
    return '<div class="mb-4">'
        +'<div class="ec-detail-title mb-2">'+title+'</div>'
        +'<div class="sd-prof-grid">'
        +rows.map(function(r){return '<div class="sd-pf"><label>'+r[0]+'</label><span>'+EC.esc(r[1]==null?'—':r[1])+'</span></div>';}).join('')
        +'</div></div>';
}
/* ── Session history ──────────────────────────
   Loaded separately from the rest of the page: the dashboard payload is per
   student, this is their whole timeline out of core.student_enrolment. */
function loadEnrolmentHistory(){
  var body=document.getElementById('enrolHistoryBody');
  if(!body) return;

  if(!STUDENT_ID){
    body.innerHTML='<tr><td colspan="5" class="text-muted small">No student selected.</td></tr>';
    return;
  }

  $.getJSON(ENROL_HISTORY_URL, { id:STUDENT_ID })
    .done(function(rows){
      if(!rows || !rows.length){
        body.innerHTML='<tr><td colspan="5" class="text-muted small">No session history yet.</td></tr>';
        return;
      }
      body.innerHTML=rows.map(function(r){
        var badge={Active:'success',Promoted:'primary',Retained:'warning',
                   PassedOut:'info',Left:'secondary'}[r.status]||'secondary';
        return '<tr>'
          +'<td class="fw-bold">'+EC.esc(r.year)+(r.isCurrent?' <span class="badge bg-label-success">current</span>':'')+'</td>'
          +'<td>'+EC.esc(r.cls)+'</td>'
          +'<td>'+EC.esc(r.sec||'—')+'</td>'
          +'<td>'+EC.esc(r.roll||'—')+'</td>'
          +'<td><span class="badge bg-label-'+badge+'">'+EC.esc(r.status)+'</span></td>'
          +'</tr>';
      }).join('');
    })
    .fail(function(){
      body.innerHTML='<tr><td colspan="5" class="text-danger small">Could not load session history.</td></tr>';
    });
}

/* ── Activity & money history ─────────────────
   Every non-receipt event that touched the student's place or money. */
function loadStudentHistory(){
  var body=document.getElementById('studentHistoryBody');
  if(!body) return;
  if(!STUDENT_ID){ EC.listEmpty('#studentHistoryBody','No student selected.'); return; }

  EC.listLoading('#studentHistoryBody');
  $.getJSON(STUDENT_HISTORY_URL, { id:STUDENT_ID })
    .done(function(rows){
      if(!rows || !rows.length){ EC.listEmpty('#studentHistoryBody','No history yet.'); return; }
      body.innerHTML=rows.map(function(r){
        return '<tr>'
          +'<td class="text-nowrap small">'+EC.esc(r.when||'—')+'</td>'
          +'<td class="fw-bold">'+EC.esc(r.action)+'</td>'
          +'<td class="small">'+EC.esc(r.detail||'')+'</td>'
          +'<td class="text-end">'+(r.amount==null?'—':EC.money(r.amount))+'</td>'
          +'<td class="small">'+EC.esc(r.by||'—')+'</td>'
          +'</tr>';
      }).join('');
    })
    .fail(function(){
      EC.listEmpty('#studentHistoryBody','Could not load history. Please retry.','bx-error-circle');
    });
}

/* ── Init ────────────────────────────────────── */
loadDashboard();
loadEnrolmentHistory();
loadStudentHistory();

})();
