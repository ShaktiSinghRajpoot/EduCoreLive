@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Linq
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model EduCoreDataAccessLayer.Models.ERP.StudentExitListModel
@{
    ViewData["Title"] = "Inactive / Left Students";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";

    // Same server-side sort pattern as StudentList: preserve filters, drop Page,
    // toggle direction on a repeat click. The proc whitelists the column names.
    string SortUrl(string col)
    {
        var q = Context.Request.Query
            .Where(k => !new[] { "SortColumn", "SortDir", "Page" }.Contains(k.Key, StringComparer.OrdinalIgnoreCase))
            .ToDictionary(k => k.Key, k => k.Value.ToString());
        q["SortColumn"] = col;
        q["SortDir"] = (string.Equals(Model.SortColumn, col, StringComparison.OrdinalIgnoreCase) && !Model.Desc) ? "desc" : "asc";
        return Context.Request.Path + QueryString.Create(q);
    }
    string SortIcon(string col)
    {
        if (!string.Equals(Model.SortColumn, col, StringComparison.OrdinalIgnoreCase)) return "bx bx-sort sl-si";
        return "bx " + (Model.Desc ? "bx-sort-down" : "bx-sort-up") + " sl-si sl-si-on";
    }

    string StatusBadge(string s) => s switch
    {
        "Transfer"   => "bg-label-info text-info",
        "Passout"    => "bg-label-success text-success",
        "Struck Off" => "bg-label-danger text-danger",
        _            => "bg-label-secondary text-secondary"
    };

    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search)
                 || !string.IsNullOrWhiteSpace(Model.FilterStatus)
                 || !string.IsNullOrWhiteSpace(Model.FilterDues);
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Student/Inactive.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <!-- Header -->
    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-user-x fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Inactive / Left Students</h4>
            <div class="ec-page-subtitle">Students who have left — re-admit, follow up on dues, or issue a certificate</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Counts are window aggregates over the WHOLE filtered set, so they stay
         accurate as you page through. -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="in-card">
          <div class="in-card-ic bg-label-secondary" style="color:#6c757d;"><i class="bx bx-archive"></i></div>
          <div><div class="in-card-val">@Model.TotalCount</div><div class="in-card-lbl">Total Left</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="in-card">
          <div class="in-card-ic bg-label-info text-info"><i class="bx bx-transfer"></i></div>
          <div><div class="in-card-val">@Model.TransferCount</div><div class="in-card-lbl">Transferred</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="in-card">
          <div class="in-card-ic bg-label-success text-success"><i class="bx bx-graduation"></i></div>
          <div><div class="in-card-val">@Model.PassoutCount</div><div class="in-card-lbl">Passed Out</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="in-card">
          <div class="in-card-ic bg-label-danger text-danger"><i class="bx bx-wallet"></i></div>
          <div><div class="in-card-val">@Model.DuesCount</div><div class="in-card-lbl">With Pending Dues</div></div>
        </div>
      </div>
    </div>

    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
          <div class="ec-section-title-wrap">
            <span class="ec-section-icon"><i class="bx bx-archive-in"></i></span>
            <div>
              <div class="ec-section-title">Left Students</div>
              <div class="ec-section-subtitle">
                @if (Model.TotalCount > 0)
                {
                    <text>Showing @Model.FirstRow–@Model.LastRow of @Model.TotalCount</text>
                }
                else
                {
                    <text>No records</text>
                }
              </div>
            </div>
          </div>
        </div>

        <form id="inFilterForm" method="get" asp-area="ERP" asp-controller="Student" asp-action="Inactive" class="in-fbar">
          <input type="hidden" name="SortColumn" value="@Model.SortColumn" />
          <input type="hidden" name="SortDir" value="@Model.SortDir" />

          <div class="in-srch-wrap">
            <i class="bx bx-search in-srch-ic"></i>
            <input type="search" class="in-srch-inp" name="Search" value="@Model.Search"
                   placeholder="Search name, admission no, mobile…" />
          </div>

          <select class="in-chip" name="FilterStatus" onchange="this.form.submit()">
            <option value="">All Reasons</option>
            <option value="Transfer"   selected="@(Model.FilterStatus == "Transfer")">Transferred</option>
            <option value="Passout"    selected="@(Model.FilterStatus == "Passout")">Passed Out</option>
            <option value="Struck Off" selected="@(Model.FilterStatus == "Struck Off")">Struck Off</option>
            <option value="Withdrawn"  selected="@(Model.FilterStatus == "Withdrawn")">Withdrawn</option>
          </select>

          <select class="in-chip" name="FilterDues" onchange="this.form.submit()">
            <option value="">Dues: Any</option>
            <option value="pending" selected="@(Model.FilterDues == "pending")">With Dues</option>
            <option value="clear"   selected="@(Model.FilterDues == "clear")">Cleared</option>
          </select>

          <button type="submit" class="btn btn-sm btn-primary"><i class="bx bx-search me-1"></i>Search</button>

          @if (hasFilter)
          {
              <a asp-area="ERP" asp-controller="Student" asp-action="Inactive" class="in-clear-btn"><i class="bx bx-x"></i>Clear</a>
          }
        </form>
      </div>

      <div class="ec-card-body pt-2">

        <div class="in-tbl-wrap">
          <table class="table in-tbl align-middle mb-0">
            <thead>
              <tr>
                <th><a href="@SortUrl("name")" class="text-decoration-none text-reset">Student <i class="@SortIcon("name")"></i></a></th>
                <th>Last Class</th>
                <th>Reason</th>
                <th><a href="@SortUrl("left")" class="text-decoration-none text-reset">Date Left <i class="@SortIcon("left")"></i></a></th>
                <th><a href="@SortUrl("dues")" class="text-decoration-none text-reset">Pending Dues <i class="@SortIcon("dues")"></i></a></th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var s in Model.Items)
              {
                  <tr>
                    <td>
                      <div class="fw-bold">@s.StudentName</div>
                      <div class="text-muted" style="font-size:.76rem">@s.AdmissionNo</div>
                    </td>
                    <td>@s.ClassDisplay<div class="text-muted" style="font-size:.76rem">@s.AcademicYear</div></td>
                    <td>
                      <span class="ec-badge @StatusBadge(s.Status)">@s.Status</span>
                      @if (!string.IsNullOrWhiteSpace(s.LeavingReason))
                      {
                          <div class="text-muted" style="font-size:.76rem">@s.LeavingReason</div>
                      }
                    </td>
                    <td>@s.DateOfLeavingDisplay</td>
                    <td>
                      @if (s.DuesPending)
                      {
                          <span class="fw-bold text-danger">@s.Outstanding.ToString("N2")</span>
                      }
                      else
                      {
                          <span class="text-success">Cleared</span>
                      }
                    </td>
                    <td class="text-end">
                      @* A TC is only for a transfer / passout / struck-off exit — a plain
                         withdrawal does not get one. Reprint lives in the TC Register. *@
                      @if (s.Status is "Transfer" or "Passout" or "Struck Off")
                      {
                          <button type="button" class="btn btn-sm btn-outline-success btn-tc"
                                  data-id="@s.StudentId" data-name="@s.StudentName" data-dues="@s.Outstanding.ToString("0.##")">
                            <i class="bx bx-award me-1"></i>Issue TC
                          </button>
                      }
                      <button type="button" class="btn btn-sm btn-outline-primary btn-readmit"
                              data-id="@s.StudentId" data-name="@s.StudentName">
                        <i class="bx bx-user-check me-1"></i>Re-admit
                      </button>
                    </td>
                  </tr>
              }
            </tbody>
          </table>
        </div>

        @if (Model.TotalCount == 0)
        {
            <div class="in-empty">
              <div class="in-empty-ic"><i class="bx bx-search-alt"></i></div>
              <h6 class="fw-bold mb-1" style="color:var(--ec-text-dark);">No records found</h6>
              <p class="text-muted small mb-0">Students appear here once they are marked as left.</p>
            </div>
        }

        <div class="in-pg-wrap">
          <div class="in-pg-info d-flex align-items-center gap-2">
            <partial name="_PageSize" model="Model" view-data='@(new ViewDataDictionary(ViewData) { { "FormId", "inFilterForm" } })' />
          </div>
          <partial name="_Pager" model="Model" />
        </div>

      </div>
    </div>

  </div>
</div>

@Html.AntiForgeryToken()

<!-- Issue Transfer Certificate -->
<div class="modal fade" id="tcModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Issue Transfer Certificate</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3">Certificate for <b id="tcStudentName"></b>. Its details are frozen once issued.</p>
        <input type="hidden" id="tcStudentId" />

        <div id="tcDuesWarn" class="alert alert-warning d-none">
          This student has pending dues. Clear them before the certificate can be issued.
        </div>

        <div class="mb-3">
          <label class="form-label">Format</label>
          <select class="form-select" id="tcFormat">
            <option value="Basic">Basic TC (Default)</option>
            <option value="Board">Board Format (CBSE / ICSE / State)</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Conduct</label>
          <select class="form-select" id="tcConduct">
            <option value="Good">Good</option>
            <option value="Satisfactory">Satisfactory</option>
            <option value="Excellent">Excellent</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Result / Promotion</label>
          <input type="text" class="form-control" id="tcResult" placeholder="e.g. Qualified for promotion to Class VI" />
        </div>
        <div class="mb-3">
          <label class="form-label">Reason for leaving</label>
          <input type="text" class="form-control" id="tcReason" placeholder="Defaults to the recorded exit reason" />
        </div>
        <div class="mb-3">
          <label class="form-label">Remarks <span class="text-muted">(optional)</span></label>
          <input type="text" class="form-control" id="tcRemarks" />
        </div>

        @* Board-only fields — shown when the Board format is chosen. All optional. *@
        <div id="tcBoardFields" class="d-none">
          <hr />
          <div class="text-muted mb-2" style="font-size:.85rem"><i class="bx bx-buildings me-1"></i>Board-required details</div>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label">Last exam &amp; result</label>
              <input type="text" class="form-control" id="tcExamResult" placeholder="e.g. Annual 2025-26 — Passed" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Whether failed before</label>
              <select class="form-select" id="tcFailed">
                <option value="No">No</option>
                <option value="Once">Once</option>
                <option value="Twice">Twice</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Subjects studied</label>
              <input type="text" class="form-control" id="tcSubjects" placeholder="English, Hindi, Mathematics…" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Fees paid up to</label>
              <input type="text" class="form-control" id="tcFeesUpto" placeholder="e.g. March 2026" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Date of application</label>
              <input type="date" class="form-control" id="tcAppDate" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Total working days</label>
              <input type="number" min="0" class="form-control" id="tcWorkingDays" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Days present</label>
              <input type="number" min="0" class="form-control" id="tcDaysPresent" />
            </div>
            <div class="col-12">
              <label class="form-label">Games / co-curricular (NCC, Scouts, Guides)</label>
              <input type="text" class="form-control" id="tcActivities" />
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" id="tcIssueBtn"><i class="bx bx-award me-1"></i>Issue &amp; Print</button>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
    $(function () {

        $('.btn-readmit').on('click', function () {
            var name = $(this).data('name');
            var id = $(this).data('id');
            EC.confirm({ danger: false, icon: 'bx-user-plus',
                         title: 'Re-admit this student?', name: name,
                         message: 'They will move back to the active roll.',
                         okText: 'Re-admit' }).then(function (ok) {
            if (!ok) return;
            $.ajax({
                url: '@Url.Action("Reactivate", "Student", new { area = "ERP" })',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
                data: JSON.stringify({ studentId: id })
            })
            .done(function (res) {
                if (res && res.success) {
                    ecToast('success', res.message);
                    location.reload();
                } else {
                    ecToast('error', (res && res.message) || 'Could not re-admit.');
                }
            })
            .fail(function () { ecToast('error', 'Something went wrong.'); });
            });
        });

        // ── Issue TC ──
        var tcModal = new bootstrap.Modal(document.getElementById('tcModal'));

        // Board format needs the extra fields — reveal them, hide for Basic.
        $('#tcFormat').on('change', function () {
            $('#tcBoardFields').toggleClass('d-none', $(this).val() !== 'Board');
        });

        $('.btn-tc').on('click', function () {
            $('#tcStudentId').val($(this).data('id'));
            $('#tcStudentName').text($(this).data('name'));
            // Warn (but do not block) if dues are pending — the server blocks for real.
            var dues = parseFloat($(this).data('dues')) || 0;
            $('#tcDuesWarn').toggleClass('d-none', dues <= 0);
            $('#tcResult, #tcReason, #tcRemarks').val('');
            $('#tcFormat').val('Basic').trigger('change');
            tcModal.show();
        });

        $('#tcIssueBtn').on('click', function () {
            var $btn = $(this);
            EC.buttonBusy($btn, 'Issuing…');
            $.ajax({
                url: '@Url.Action("Issue", "Tc", new { area = "ERP" })',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
                data: JSON.stringify({
                    studentId: $('#tcStudentId').val(),
                    format:    $('#tcFormat').val(),
                    conduct:   $('#tcConduct').val(),
                    result:    $('#tcResult').val(),
                    reason:    $('#tcReason').val(),
                    remarks:   $('#tcRemarks').val(),
                    examResult:      $('#tcExamResult').val(),
                    failedStatus:    $('#tcFailed').val(),
                    subjectsStudied: $('#tcSubjects').val(),
                    feesPaidUpto:    $('#tcFeesUpto').val(),
                    workingDays:     $('#tcWorkingDays').val() || null,
                    daysPresent:     $('#tcDaysPresent').val() || null,
                    activities:      $('#tcActivities').val(),
                    applicationDate: $('#tcAppDate').val() || null
                })
            })
            .done(function (res) {
                if (res && res.success) {
                    ecToast('success', res.message);
                    tcModal.hide();
                    // Open the freshly issued certificate to print.
                    window.open('@Url.Action("Print", "Tc", new { area = "ERP" })?id=' + res.tcId, '_blank');
                } else {
                    ecToast('error', (res && res.message) || 'Could not issue the certificate.');
                }
            })
            .fail(function () { ecToast('error', 'Something went wrong.'); })
            .always(function () { EC.buttonReset($btn); });
        });

    });
</script>
}
