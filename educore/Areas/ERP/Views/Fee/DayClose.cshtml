@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Day Close";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@*
   Day Close / shift reconciliation — the logged-in cashier totals their day's
   collection mode-wise, sees expected cash (cash collected − cash refunded),
   enters the counted cash, and records the difference. core.sp_fee_day_*.

   Modes are the real tenders (a Cash+UPI receipt puts its cash in the Cash
   line). A cancellation counts on the day it is made, so a closed day never
   changes. A closed day is locked; "Re-open day" (reason required) unlocks it
   and every close / re-open stays in the history below.
*@

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Fee/DayClose.css" asp-append-version="true" />
}

<div class="ec-page-shell fee-day-page">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="d-flex align-items-center gap-2">
          <div class="ec-page-icon"><i class="bx bx-lock-open-alt"></i></div>
          <div><h4 class="ec-page-title mb-1">Day Close</h4>
            <p class="ec-page-subtitle">Your own counter: reconcile the day's collection and record the cash count</p></div>
        </div>
        <div class="d-flex gap-2 align-items-end no-print">
          <div><label class="form-label mb-1">Date</label><input type="date" id="dDate" class="form-control form-control-sm"></div>
          <a href="@Url.Action("ManageFee","Fee",new{area="ERP"})" class="btn btn-sm btn-outline-secondary"><i class="bx bx-wallet me-1"></i>Counter</a>
          <button id="btnPrint" class="btn btn-sm ec-btn-soft"><i class="bx bx-printer me-1"></i>Print</button>
        </div>
      </div>
    </div>

    <div id="closedNote" class="alert alert-success py-2 d-none"><i class="bx bx-check-circle me-1"></i><span id="closedText"></span></div>

    <!-- Why the figures can read zero. See load(). -->
    <div id="scopeNote" class="alert alert-info py-2 d-none"><i class="bx bx-info-circle me-1"></i><span id="scopeText"></span></div>

    <!-- KPIs -->
    <div class="kpis">
      <div class="kpi"><div class="l"><span class="ic" style="background:var(--suc-soft);color:#1f9254"><i class="bx bx-rupee"></i></span>Collected</div><div class="v" id="kCollected">₹0.00</div></div>
      <div class="kpi"><div class="l"><span class="ic" style="background:#eef0f2;color:#6b7280"><i class="bx bx-receipt"></i></span>Receipts</div><div class="v" id="kReceipts">0</div></div>
      <div class="kpi"><div class="l"><span class="ic" style="background:var(--dng-soft);color:#c4332f"><i class="bx bx-money-withdraw"></i></span>Refunds out</div><div class="v" id="kRefunds">₹0.00</div></div>
      <div class="kpi cash"><div class="l"><span class="ic" style="background:#fff;color:var(--ec-primary)"><i class="bx bx-wallet"></i></span>Expected cash</div><div class="v" id="kExpected">₹0.00</div></div>
    </div>

    <div class="row g-4">
      <!-- mode-wise -->
      <div class="col-12 col-lg-6">
        <div class="ec-card"><div class="ec-card-header"><div class="ec-section-title-wrap">
          <div class="ec-section-icon"><i class="bx bx-credit-card"></i></div>
          <div><h6 class="ec-section-title">Collection by mode</h6><div class="ec-section-subtitle">Your receipts only. A cancellation counts on the day it is made.</div></div>
        </div></div>
          <div class="ec-card-body p-0">
            <div class="table-responsive"><table class="table ec-table mb-0">
              <thead><tr><th>Mode</th><th class="text-end">Receipts</th><th class="text-end">Amount</th></tr></thead>
              <tbody id="modeRows"></tbody>
            </table></div>
          </div>
        </div>
      </div>

      <!-- reconciliation -->
      <div class="col-12 col-lg-6">
        <div class="ec-card"><div class="ec-card-header"><div class="ec-section-title-wrap">
          <div class="ec-section-icon"><i class="bx bx-calculator"></i></div>
          <div class="d-flex align-items-center gap-2"><h6 class="ec-section-title mb-0">Cash reconciliation</h6><span id="closedBadge" class="closed-badge d-none">Closed</span></div>
        </div></div>
          <div class="ec-card-body">
            <div class="recon-line muted"><span>Cash collected</span><span class="v" id="rCashIn">₹0.00</span></div>
            <div class="recon-line muted"><span>Cash refunded</span><span class="v" id="rCashOut">−₹0.00</span></div>
            <div class="recon-line" style="border-top:1px dashed var(--ec-border)"><span>Expected in drawer</span><span class="v" id="rExpected">₹0.00</span></div>

            <div class="mt-3"><label class="form-label">Counted cash <span class="text-danger">*</span></label>
              <input type="number" min="0" id="counted" class="form-control" placeholder="Enter cash counted in drawer"></div>

            <div class="diff ok" id="diffBox"><span id="diffLabel">Difference</span><span id="diffVal">₹0.00</span></div>

            <div class="mt-3"><label class="form-label">Remarks</label><input type="text" id="remarks" class="form-control" placeholder="Optional note"></div>

            <button id="btnClose" class="btn btn-primary w-100 mt-3 no-print"><i class="bx bx-lock-alt me-1"></i>Close day</button>
            <button id="btnReopen" class="btn btn-outline-secondary w-100 mt-2 no-print d-none"><i class="bx bx-lock-open-alt me-1"></i>Re-open day</button>
          </div>
        </div>
      </div>

      <!-- every close and re-open, newest first (never overwritten) -->
      <div class="col-12" id="historyWrap" style="display:none">
        <div class="ec-card"><div class="ec-card-header"><div class="ec-section-title-wrap">
          <div class="ec-section-icon"><i class="bx bx-history"></i></div>
          <div><h6 class="ec-section-title">Close history</h6><div class="ec-section-subtitle">Every close and re-open of this day</div></div>
        </div></div>
          <div class="ec-card-body p-0">
            <div class="table-responsive"><table class="table ec-table mb-0">
              <thead><tr><th>When</th><th>Action</th><th>By</th><th class="text-end">Expected</th><th class="text-end">Counted</th><th class="text-end">Difference</th><th>Note</th></tr></thead>
              <tbody id="historyRows"></tbody>
            </table></div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
$(function () {
    'use strict';

    var CSRF=$('input[name="__RequestVerificationToken"]').val();
    var URL={ get:'@Url.Action("GetDayCollection","Fee",new{area="ERP"})', close:'@Url.Action("CloseDay","Fee",new{area="ERP"})', reopen:'@Url.Action("ReopenDay","Fee",new{area="ERP"})' };
    var expected=0;

    function todayStr(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
    $('#dDate').val(todayStr());

    function load(){
        $.getJSON(URL.get,{date:$('#dDate').val()}).done(function(d){
            expected=EC.num(d.expectedCash);
            $('#kCollected').text(EC.money(d.totalCollected));
            $('#kReceipts').text(d.receiptCount + (d.cancelledCount>0?' ('+d.cancelledCount+' cancelled today, −'+EC.money(d.cancelledAmount)+')':''));
            $('#kRefunds').text(EC.money(d.totalRefunded));
            $('#kExpected').text(EC.money(d.expectedCash));
            $('#rCashIn').text(EC.money(d.cashCollected));
            $('#rCashOut').text('−'+EC.money(d.cashRefunded));
            $('#rExpected').text(EC.money(d.expectedCash));

            var rows=(d.modes||[]);
            $('#modeRows').html(rows.length? rows.map(function(m){
                return '<tr><td class="fw-semibold">'+EC.esc(m.mode)+'</td><td class="text-end text-muted">'+m.count+'</td><td class="text-end mode-amt">'+EC.money(m.amount)+'</td></tr>';
            }).join('') : '<tr><td colspan="3" class="text-muted text-center py-4">You collected nothing on this date.</td></tr>');

            /* A zero on this page nearly always means "not my counter" or "not
               this date" -- day close is deliberately per cashier, so a fee
               taken at another counter never appears here. Left as a bare 0 it
               reads like the money went missing, so say which it is. */
            if(EC.num(d.totalCollected)===0 && EC.num(d.schoolCollected)>0){
                $('#scopeText').text('You collected nothing on this date. The school took '+EC.money(d.schoolCollected)+
                                     ' across '+d.schoolReceipts+' receipt(s) at other counters. This page closes your drawer only — for the school total use Fee › Reports.');
                $('#scopeNote').removeClass('d-none');
            } else $('#scopeNote').addClass('d-none');

            // closed state: locked until re-opened. No money can be collected or
            // cancelled into a closed day, so the figures above stay as closed.
            if(d.isClosed){
                $('#counted').val(d.countedCash).prop('disabled', true);
                $('#remarks').val(d.closeRemarks||'').prop('disabled', true);
                $('#closedBadge').removeClass('d-none');
                $('#closedNote').removeClass('d-none');
                $('#closedText').text('This day was closed'+(d.closedAt?' on '+d.closedAt:'')+'. Counted '+EC.money(d.countedCash)+', difference '+EC.money(d.difference)+'. Re-open it (with a reason) to record a new count.');
                $('#btnClose').addClass('d-none'); $('#btnReopen').removeClass('d-none');
            } else {
                $('#counted').val('').prop('disabled', false); $('#remarks').val('').prop('disabled', false);
                $('#closedBadge').addClass('d-none');
                if(d.reopenedAt){
                    $('#closedNote').removeClass('d-none');
                    $('#closedText').text('Re-opened on '+d.reopenedAt+(d.reopenReason?' ('+d.reopenReason+')':'')+'. Close it again when the correction is done.');
                } else $('#closedNote').addClass('d-none');
                $('#btnClose').removeClass('d-none'); $('#btnReopen').addClass('d-none');
            }

            var hist=(d.history||[]);
            $('#historyWrap').toggle(hist.length>0);
            $('#historyRows').html(hist.map(function(h){
                return '<tr><td class="text-muted">'+EC.esc(h.at||'')+'</td><td class="fw-semibold">'+EC.esc(h.action==='Reopen'?'Re-opened':'Closed')+'</td><td>'+EC.esc(h.by||'')+'</td>'
                     + '<td class="text-end">'+EC.money(h.expected)+'</td><td class="text-end">'+EC.money(h.counted)+'</td><td class="text-end">'+EC.money(h.diff)+'</td>'
                     + '<td class="text-muted">'+EC.esc(h.note||'')+'</td></tr>';
            }).join(''));
            diff();
        }).fail(function(){ ecToast('error','Could not load the day collection.'); });
    }
    function diff(){
        var counted=EC.num($('#counted').val()), d=counted-expected;
        $('#diffVal').text((d>0?'+':'')+EC.money(d));
        var $b=$('#diffBox').removeClass('ok short over');
        $('#diffLabel').text(d===0?'Tallies' : (d<0?'Short by':'Excess'));
        $b.addClass(d===0?'ok':(d<0?'short':'over'));
    }
    $('#counted').on('input', diff);
    $('#dDate').on('change', load);
    $('#btnPrint').on('click', function(){ window.print(); });

    $('#btnReopen').on('click', function(){
        var $btn=$(this);
        EC.prompt({ title:'Re-open this day?', name:$('#dDate').val(), label:'Reason', required:true,
                    message:'The current count stays in the history. Close the day again after the correction.',
                    okText:'Re-open day', danger:false })
        .then(function(reason){
            if(reason===null) return;
            EC.buttonBusy($btn);
            $.ajax({url:URL.reopen,type:'POST',contentType:'application/json',headers:{'RequestVerificationToken':CSRF},
                    data:JSON.stringify({ date:$('#dDate').val(), reason:reason })})
            .done(function(res){
                EC.buttonReset($btn);
                if(!res||!res.success){ ecToast('error',(res&&res.message)||'Could not re-open.'); return; }
                ecToast('success',res.message||'Day re-opened.'); load();
            }).fail(function(){ EC.buttonReset($btn); ecToast('error','Could not re-open the day.'); });
        });
    });

    $('#btnClose').on('click', function(){
        var counted=$('#counted').val();
        if(counted===''||isNaN(Number(counted))){ ecToast('warning','Enter the counted cash.'); return; }
        if(Number(counted)<0){ ecToast('warning','Counted cash can not be negative.'); return; }
        var $btn=$(this); EC.buttonBusy($btn);
        $.ajax({url:URL.close,type:'POST',contentType:'application/json',headers:{'RequestVerificationToken':CSRF},
                data:JSON.stringify({ date:$('#dDate').val(), countedCash:Number(counted), remarks:$('#remarks').val() })})
        .done(function(res){
            EC.buttonReset($btn);
            if(!res||!res.success){ ecToast('error',(res&&res.message)||'Could not close.'); return; }
            ecToast('success',res.message||'Day closed.'); load();
        }).fail(function(){ EC.buttonReset($btn); ecToast('error','Could not close the day.'); });
    });

    load();
});
</script>
}
