@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Fee Collection";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@*
   ─────────────────────────────────────────────────────────────────────────
   FEE COLLECTION — single-student counter (settlement-based, educore theme).
   Search stays the SAME cascade: Session → Admission No → Class → Section →
   Student. Pick a PERIOD (1/3/6/12) → dues auto-select → one Settlement panel
   does the maths: Dues − Discount (modal: flat/%/reason) + Extra charges
   (modal) = Payable, paid via split tender (each mode with its cheque no / UPI
   ref) and/or the advance wallet. Collect → receipt. History lists receipts AND
   refund vouchers, re-prints either, and cancels / refunds with an authoriser.
   Each settlement carries a client ref, so a retried Collect never takes the
   money twice. See docs/FeeModule.md.
   ─────────────────────────────────────────────────────────────────────────
*@

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Fee/ManageFee.css" asp-append-version="true" />
}

<div class="ec-page-shell fee-collect-page">
  <div class="ec-page-content">

    <!-- command bar -->
    <div class="cmd">
      <div class="ec-page-icon"><i class="bx bx-wallet"></i></div>
      <div><div class="title">Fee Collection</div><div class="sub">Find a student, choose how many months to collect, then take payment</div></div>
      <div class="today"><div class="dot"><i class="bx bx-rupee"></i></div><div><div class="n" id="todayN">₹0.00</div><div class="l" title="Everything you collected today, admission and registration receipts included -- the same figure as Day close">Your collection today · <span id="todayC">0</span> receipts</div></div></div>
      <a href="@Url.Action("Index","DayClose",new{area="ERP"})" class="btn btn-sm ec-btn-soft"><i class="bx bx-lock-open-alt me-1"></i>Day close</a>
      <a href="@Url.Action("Reports","Fee",new{area="ERP"})" class="btn btn-sm ec-btn-soft"><i class="bx bx-bar-chart-alt-2 me-1"></i>Reports</a>
    </div>

    <!-- Filters — SAME cascade: Session → Admission No → Class → Section → Student -->
    <div class="filter-bar p-3 p-lg-4 mb-4">
      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6 col-lg">
          <label class="form-label">Academic Session</label>
          <select id="fSession" class="form-select"></select>
        </div>
        <div class="col-12 col-md-6 col-lg">
          <label class="form-label">Find Student</label>
          <div class="adm-search">
            <input type="text" id="fAdm" class="form-control" placeholder="Name, father's name, mobile or adm. no">
            <button type="button" id="admGo" title="Find student"><i class="bx bx-search"></i></button>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
          <label class="form-label">Class</label>
          <select id="fClass" class="form-select"><option value="">Select Class</option></select>
        </div>
        <div class="col-6 col-md-4 col-lg">
          <label class="form-label">Section</label>
          <select id="fSection" class="form-select" disabled><option value="">Select class first</option></select>
        </div>
        <div class="col-12 col-md-4 col-lg">
          <label class="form-label">Student</label>
          <select id="fStudent" class="form-select" disabled><option value="">Select section first</option></select>
        </div>
      </div>

      <!-- Find Student matches: shown when a search finds more than one student -->
      <div id="admResults" class="mt-3 d-none">
        <div class="small text-muted mb-2" id="admResultsTitle"></div>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Student</th><th class="d-none d-md-table-cell">Class</th><th class="d-none d-md-table-cell">Father / Guardian</th><th class="d-none d-md-table-cell">Mobile</th><th class="d-none d-md-table-cell">Adm No</th></tr></thead>
            <tbody id="admResultsBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- empty state -->
    <div id="duesEmpty" class="ec-card"><div class="ec-card-body">
      <div class="empty-pane">
        <i class="bx bx-user-circle"></i>
        <h6>No student selected</h6>
        <p class="mb-0">Search by name, father's name, mobile or admission number above, or choose Class → Section → Student.</p>
      </div>
    </div></div>

    <div id="duesPane" class="d-none">
      <!-- student strip -->
      <div class="ec-card"><div class="ec-card-body">
        <div class="stu-strip">
          <div class="stu-av" id="dAvatar">—</div>
          <div>
            <div class="stu-name" id="dName">—</div>
            <div class="stu-sub" id="dSub">—</div>
          </div>
          <div class="stu-out"><div class="amt" id="dOutstanding">₹0.00</div><div class="lbl">Due now</div><div class="lbl" id="dSession"></div></div>
        </div>
        <div class="view-tabs mt-3">
          <button type="button" class="view-tab active" data-view="dues">Dues &amp; Collect</button>
          <button type="button" class="view-tab" data-view="history">Payment History</button>
        </div>
      </div></div>

      <!-- DUES VIEW: two pane -->
      <div id="viewDues">
        <div class="row g-4">
          <!-- LEFT: dues -->
          <div class="col-12 col-lg-7">
            <div class="ec-card">
              <div class="ec-card-header"><div class="ec-section-title-wrap">
                <div class="ec-section-icon"><i class="bx bx-calendar-check"></i></div>
                <div><h6 class="ec-section-title">What are you collecting?</h6><div class="ec-section-subtitle">Pick a period — the matching months load automatically</div></div>
              </div></div>
              <div class="ec-card-body">
                <div class="period"><span class="l">Pay for:</span>
                  <button type="button" class="chip" data-n="1">1 Month</button>
                  <button type="button" class="chip" data-n="3">3 Months</button>
                  <button type="button" class="chip" data-n="6">6 Months</button>
                  <button type="button" class="chip" data-n="12">Full Year</button>
                  <button type="button" class="period-clear" id="clearSel">Clear</button>
                </div>
                <div id="duesList"></div>
                <div class="grp"><i class="bx bx-plus-circle"></i>Extra charges</div>
                <div id="extraList"></div>
                <button type="button" class="btn btn-sm ec-btn-soft rounded-pill" id="openExtra"><i class="bx bx-plus"></i> Add extra charge</button>
              </div>
            </div>
          </div>

          <!-- RIGHT: settlement -->
          <div class="col-12 col-lg-5">
            <div class="ec-card settle">
              <div class="ec-card-header"><div class="ec-section-title-wrap">
                <div class="ec-section-icon"><i class="bx bx-calculator"></i></div>
                <div><h6 class="ec-section-title">Settlement</h6><div class="ec-section-subtitle">Everything adds up here</div></div>
              </div></div>
              <div class="ec-card-body">
                <div class="s-scope-lbl">Collecting</div>
                <div class="s-scope" id="scope">—</div>

                <div class="s-line muted"><span>Dues selected (<span id="selCount">0</span>)</span><span class="v" id="duesSel">₹0.00</span></div>
                <div class="s-line suc"><span>Discount <small class="text-muted" id="discReason"></small></span><span class="v" id="discCell"><button type="button" class="add-link" id="openDisc">+ Add</button></span></div>
                <div class="s-line muted"><span>Extra charges</span><span class="v" id="extraSum">₹0.00</span></div>

                <div class="s-pay"><span class="k">Payable</span><span class="v" id="payable">₹0.00</span></div>

                <div class="s-line suc" id="advUseRow" style="display:none;"><span><i class="bx bx-wallet"></i> Use advance <small class="text-muted" id="advAvail"></small></span><span><input type="number" min="0" id="advUse" class="form-control s-disc" value="0"></span></div>

                <div class="tender-head"><span>Payment</span><span id="tenderSum">₹0.00 of ₹0.00</span></div>
                <div id="tenders"></div>
                <button type="button" class="add-tender" id="addTender"><i class="bx bx-plus"></i> Split payment (add mode)</button>

                <div class="mt-2"><label class="form-label">Remarks</label><input type="text" id="pRemarks" class="form-control" placeholder="Optional note"></div>

                <div class="s-foot">
                  <div class="row1"><span>Paid</span><span id="paidV">₹0.00</span></div>
                  <div class="row1 muted"><span id="balLbl">Balance</span><span id="balV">₹0.00</span></div>
                  <div class="s-adv" id="advRow"><i class="bx bx-wallet"></i> <span id="advV">₹0.00</span> will be saved as advance</div>
                </div>

                <button type="button" class="btn btn-primary collect-cta" id="collectBtn" disabled><i class="bx bx-check-circle me-1"></i>Collect &amp; Receipt</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- HISTORY VIEW -->
      <div id="viewHistory" class="d-none">
        <div class="ec-card"><div class="ec-card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="fw-bold" style="color:var(--ec-text-dark)">Receipts</div>
            <button type="button" id="openRefund" class="btn btn-sm btn-outline-warning"><i class="bx bx-money-withdraw me-1"></i>Refund deposit / payment</button>
          </div>
          <div id="histList"></div>
        </div></div>
      </div>
    </div>

  </div>
</div>

<!-- discount modal -->
<div class="modal fade" id="discModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered" style="max-width:380px"><div class="modal-content">
  <div class="modal-header py-2"><h6 class="modal-title fw-bold"><i class="bx bx-purchase-tag me-1 text-warning"></i>Add discount</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <label class="form-label">Discount type</label>
    <div class="fc-seg-toggle mb-3">
      <button type="button" class="fc-seg active" data-t="flat">Flat ₹</button>
      <button type="button" class="fc-seg" data-t="pct">Percentage %</button>
    </div>
    <label class="form-label" id="discValLbl">Amount (₹)</label>
    <input type="number" min="0" class="form-control mb-3" id="discVal" placeholder="0">
    <label class="form-label">Reason <span class="text-danger">*</span></label>
    <input class="form-control mb-3" id="discReasonIn" placeholder="e.g. sibling / merit / staff ward">
    @* Recorded as the signed-in user, who must hold the concession permission (QA BUG-063). *@
    <div class="small text-muted">Approved by: <b>@ViewBag.UserName</b> (you)</div>
    <div class="form-text mt-2" id="discPreview"></div>
  </div>
  <div class="modal-footer py-2">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-primary" id="applyDisc">Apply discount</button>
  </div>
</div></div></div>

<!-- cancel receipt modal -->
<div class="modal fade" id="cancelModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered" style="max-width:430px"><div class="modal-content">
  <div class="modal-header py-2"><h6 class="modal-title fw-bold text-danger"><i class="bx bx-x-circle me-1"></i>Cancel receipt <span id="cmNo"></span></h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <div class="alert alert-warning py-2 small mb-3"><i class="bx bx-error me-1"></i>This reverses the <b id="cmAmt">₹0.00</b> payment and <b>re-opens the dues</b>. The receipt stays on record marked <b>Cancelled</b> (never deleted).</div>
    <label class="form-label">Reason for cancellation <span class="text-danger">*</span></label>
    <input class="form-control mb-3" id="cmReason" placeholder="e.g. Wrong student / duplicate / mode change">
    <div class="small text-muted"><i class="bx bx-user-check me-1"></i>Recorded as authorised by you (only staff allowed to cancel receipts can do this).</div>
  </div>
  <div class="modal-footer py-2">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep receipt</button>
    <button type="button" class="btn btn-danger" id="cmConfirm"><i class="bx bx-x-circle me-1"></i>Cancel receipt</button>
  </div>
</div></div></div>

<!-- refund modal -->
<div class="modal fade" id="refundModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered" style="max-width:430px"><div class="modal-content">
  <div class="modal-header py-2"><h6 class="modal-title fw-bold"><i class="bx bx-money-withdraw me-1 text-warning"></i>Refund</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <label class="form-label">Refund from <span class="text-danger">*</span></label>
    <select class="form-select mb-1" id="rfItem"></select>
    <div class="form-text mb-3" id="rfAvail">—</div>
    <label class="form-label">Amount to refund <span class="text-danger">*</span></label>
    <input type="number" min="0" class="form-control mb-3" id="rfAmt" placeholder="0">
    <div class="row g-2 mb-3">
      <div class="col-6"><label class="form-label">Refund via</label>
        <select class="form-select" id="rfMode"><option>Cash</option><option>Bank Transfer</option><option>Cheque</option><option>UPI</option></select></div>
      <div class="col-6 small text-muted d-flex align-items-end"><span><i class="bx bx-user-check me-1"></i>Recorded as authorised by you.</span></div>
    </div>
    <label class="form-label">Reason <span class="text-danger">*</span></label>
    <input class="form-control" id="rfReason" placeholder="e.g. TC issued / deposit returned / overpayment">
  </div>
  <div class="modal-footer py-2">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-primary" id="rfConfirm"><i class="bx bx-check me-1"></i>Refund</button>
  </div>
</div></div></div>

<!-- extra charge modal -->
<div class="modal fade" id="extraModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered" style="max-width:380px"><div class="modal-content">
  <div class="modal-header py-2"><h6 class="modal-title fw-bold"><i class="bx bx-plus-circle me-1 text-warning"></i>Add extra charge</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <label class="form-label">Charge for <span class="text-danger">*</span></label>
    <input class="form-control mb-3" id="extraLabel" placeholder="e.g. Late fine, Lost book, ID card">
    <label class="form-label">Amount (₹) <span class="text-danger">*</span></label>
    <input type="number" min="0" class="form-control mb-3" id="extraAmt" placeholder="0">
    <label class="form-label">Note (optional)</label>
    <input class="form-control" id="extraNote" placeholder="Optional remark">
  </div>
  <div class="modal-footer py-2">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-primary" id="applyExtra">Add charge</button>
  </div>
</div></div></div>

@await Html.PartialAsync("_FeeReceiptModal")
@Html.AntiForgeryToken()

@section PageScripts {
<script src="~/js/fee-receipt.js" asp-append-version="true"></script>
<script>
$(function () {
    'use strict';

    function initials(name){ return (name||'?').trim().split(/\s+/).map(function(w){return w[0];}).slice(0,2).join('').toUpperCase(); }

    var CSRF = $('input[name="__RequestVerificationToken"]').val();
    var URL = {
        sessions:  '@Url.Action("GetSessions","Fee",new{area="ERP"})',
        classes:   '@Url.Action("GetClasses","Fee",new{area="ERP"})',
        sections:  '@Url.Action("GetSections","Fee",new{area="ERP"})',
        students:  '@Url.Action("GetStudents","Fee",new{area="ERP"})',
        findByAdm: '@Url.Action("FindByAdmission","Fee",new{area="ERP"})',
        search:    '@Url.Action("SearchStudents","Fee",new{area="ERP"})',
        dues:     '@Url.Action("GetStudentDues","Fee",new{area="ERP"})',
        collect:   '@Url.Action("Collect","Fee",new{area="ERP"})',
        history:    '@Url.Action("GetHistory","Fee",new{area="ERP"})',
        cancel:     '@Url.Action("CancelReceipt","Fee",new{area="ERP"})',
        refundable: '@Url.Action("GetRefundables","Fee",new{area="ERP"})',
        refund:     '@Url.Action("Refund","Fee",new{area="ERP"})',
        advance:    '@Url.Action("GetAdvance","Fee",new{area="ERP"})',
        day:        '@Url.Action("GetDayCollection","DayClose",new{area="ERP"})'
    };
    var api = {
        sessions:  function(){ return $.getJSON(URL.sessions); },
        classes:   function(s){ return $.getJSON(URL.classes,{session:s}); },
        sections:  function(s,c){ return $.getJSON(URL.sections,{session:s,className:c}); },
        students:  function(s,c,sec){ return $.getJSON(URL.students,{session:s,className:c,section:sec}); },
        findByAdm: function(s,a){ return $.getJSON(URL.findByAdm,{session:s,admissionNo:a}); },
        search:    function(s,q){ return $.getJSON(URL.search,{session:s,q:q}); },
        dues:      function(id){ return $.getJSON(URL.dues,{studentId:id}); },
        history:   function(id){ return $.getJSON(URL.history,{studentId:id}); },
        collect:   function(p){ return $.ajax({url:URL.collect,type:'POST',contentType:'application/json',headers:{'RequestVerificationToken':CSRF},data:JSON.stringify(p)}); },
        cancel:     function(p){ return $.ajax({url:URL.cancel,type:'POST',contentType:'application/json',headers:{'RequestVerificationToken':CSRF},data:JSON.stringify(p)}); },
        refundable: function(id){ return $.getJSON(URL.refundable,{studentId:id}); },
        refund:     function(p){ return $.ajax({url:URL.refund,type:'POST',contentType:'application/json',headers:{'RequestVerificationToken':CSRF},data:JSON.stringify(p)}); },
        advance:    function(id){ return $.getJSON(URL.advance,{studentId:id}); },
        day:        function(){ return $.getJSON(URL.day); }
    };

    var $session=$('#fSession'), $class=$('#fClass'), $section=$('#fSection'), $student=$('#fStudent'), $adm=$('#fAdm');
    var $duesEmpty=$('#duesEmpty'), $duesPane=$('#duesPane');
    var students=[], currentStudent=null;
    var months=[];        // [{key,title,dues:[...]}] ascending
    var otherDues=[];
    var sel={};           // ledgerId -> {label, outstanding, dueDate}
    var extras=[];        // {label, amount, note}
    var discount=null;    // {type:'flat'|'pct', value, reason} -- approved by the signed-in user
    var discType='flat';
    var tenders=[{mode:'Cash',amt:0,ref:''}];   // ref = cheque no / UPI ref / txn id
    var amtTouched=false, advanceAvail=0;

    // One id per settlement. Sent with Collect so a retry (double click, a
    // timeout after the server already saved) returns the same receipt instead
    // of taking the money twice. A new one is made after each success and
    // whenever a student is opened.
    var collectKey='';
    function newCollectKey(){ collectKey = 'c' + Date.now() + '-' + Math.floor(Math.random()*1e9); }
    newCollectKey();

    function fillSelect($el, items, ph){
        var h = ph ? '<option value="">'+ph+'</option>' : '';
        items.forEach(function(x){ h += '<option value="'+EC.esc(x)+'">'+EC.esc(x)+'</option>'; });
        $el.html(h);
    }

    // Header total = this cashier's Day close figure for today, so receipts taken
    // on the Admission / Registration pages are counted too, not just this page's.
    function loadToday(){
        api.day().done(function(d){ $('#todayN').text(EC.money(d.totalCollected)); $('#todayC').text(d.receiptCount); });
    }
    loadToday();

    /* ── cascade (unchanged: Session → Adm → Class → Section → Student) ── */
    // ?adm=...&session=... (the Student Dashboard's "Collect Fee" button) opens
    // that student straight away instead of making the cashier search again.
    var linkAdm = new URLSearchParams(location.search).get('adm');
    var linkSession = new URLSearchParams(location.search).get('session');
    api.sessions().done(function(s){
        fillSelect($session,s,null);
        $session.val(linkSession && s.indexOf(linkSession)>=0 ? linkSession : s[0]);
        // Open the linked student only once the class list is in: filled later, the list
        // wiped the class doAdmSearch had picked and the header read " - A".
        loadClasses().always(function(){
            if(linkAdm){ $adm.val(linkAdm); doAdmSearch(); }
        });
    });
    function loadClasses(){
        clearStudentView(); students=[];
        $section.prop('disabled',true).html('<option value="">Select class first</option>');
        $student.prop('disabled',true).html('<option value="">Select section first</option>');
        return api.classes($session.val()).done(function(c){ fillSelect($class,c,'Select Class'); });
    }
    function loadSections(){
        clearStudentView(); students=[];
        $student.prop('disabled',true).html('<option value="">Select section first</option>');
        if(!$class.val()){ $section.prop('disabled',true).html('<option value="">Select class first</option>'); return; }
        api.sections($session.val(),$class.val()).done(function(sec){ fillSelect($section,sec,'Select Section'); $section.prop('disabled',sec.length===0); });
    }
    function loadStudentSelect(){
        clearStudentView();
        if(!$section.val()){ $student.prop('disabled',true).html('<option value="">Select section first</option>'); return; }
        api.students($session.val(),$class.val(),$section.val()).done(function(list){ students=list||[]; fillStudentSelect(); });
    }
    function fillStudentSelect(){
        var h='<option value="">'+(students.length?'Select Student':'No students')+'</option>';
        students.forEach(function(s){ h+='<option value="'+s.id+'">Roll '+EC.esc(s.roll||'—')+' — '+EC.esc(s.name)+' ('+EC.esc(s.admNo)+')</option>'; });
        $student.html(h).prop('disabled',students.length===0);
    }
    $session.on('change',loadClasses);
    $class.on('change',loadSections);
    $section.on('change',loadStudentSelect);
    $student.on('change',function(){ var id=Number($(this).val()); if(!id){ clearStudentView(); return; } loadStudentById(id); });
    function loadStudentById(id){
        currentStudent = students.find(function(s){ return s.id===id; }) || null;
        if(currentStudent) api.dues(currentStudent.id).done(openStudent).fail(function(){ ecToast('error','Could not load dues.'); });
    }

    /* ── admission search ── */
    function doAdmSearch(){
        var adm=$adm.val().trim(); if(!adm){ ecToast('warning','Enter an admission number.'); return; }
        api.findByAdm($session.val(),adm).done(function(r){
            if(!r){ ecToast('error','No student found for "'+adm+'".'); return; }
            $class.val(r.className);
            api.sections($session.val(),r.className).done(function(sec){
                fillSelect($section,sec,'Select Section'); $section.val(r.section).prop('disabled',false);
                api.students($session.val(),r.className,r.section).done(function(list){
                    students=list||[]; fillStudentSelect(); $student.val(r.student.id); loadStudentById(r.student.id);
                });
            });
        });
    }
    /* ── find student by name / father's name / mobile / adm no ──
       A parent often does not know the class or section. One match (or an exact
       admission number) opens the student straight away through doAdmSearch();
       several matches are listed so the cashier picks the right child. */
    function findStudent(){
        var q=$adm.val().trim();
        if(q.length<2){ ecToast('warning','Type at least 2 letters of the name, father\'s name, mobile or admission number.'); return; }
        $('#admResults').addClass('d-none');
        api.search($session.val(),q).done(function(list){
            list=list||[];
            var exact=list.filter(function(s){ return (s.admNo||'').toLowerCase()===q.toLowerCase(); })[0];
            if(exact || list.length===1){ openPick(exact||list[0]); return; }
            if(!list.length){ ecToast('error','No student found for "'+q+'" in '+$session.val()+'.'); return; }

            $('#admResultsTitle').text(list.length+' students match "'+q+'". Pick the right one:');
            $('#admResultsBody').html(list.map(function(s){
                return '<tr class="adm-pick" style="cursor:pointer" data-i="'+list.indexOf(s)+'">'
                     // On a phone the other columns are hidden and the same facts sit
                     // under the name, so two children with one name can be told apart.
                     + '<td><div class="fw-semibold">'+EC.esc(s.name)+(s.left?' <span class="badge bg-label-secondary">Left</span>':'')+'</div>'
                     + '<div class="small text-muted d-md-none">'+EC.esc(s.cls)+(s.sec?' – '+EC.esc(s.sec):'')
                     + ' · '+EC.esc(s.guardian||'—')+' · '+EC.esc(s.mobile||'—')+'</div></td>'
                     + '<td class="d-none d-md-table-cell">'+EC.esc(s.cls)+(s.sec?' – '+EC.esc(s.sec):'')+'</td>'
                     + '<td class="d-none d-md-table-cell">'+EC.esc(s.guardian||'—')+'</td>'
                     + '<td class="d-none d-md-table-cell">'+EC.esc(s.mobile||'—')+'</td>'
                     + '<td class="d-none d-md-table-cell">'+EC.esc(s.admNo)+'</td></tr>';
            }).join(''));
            $('#admResults').removeClass('d-none').data('list', list);
        }).fail(function(){ ecToast('error','Could not search students.'); });
    }
    // A current student opens through their class and section; one who has LEFT is not
    // on any class list any more, so their dues open directly (QA BUG-082).
    function openPick(s){
        if(!s.left){ openByAdm(s.admNo); return; }
        $('#admResults').addClass('d-none');
        currentStudent = { id:s.id, name:s.name, admNo:s.admNo, roll:'', cls:s.cls, sec:s.sec, left:true };
        api.dues(s.id).done(openStudent).fail(function(){ ecToast('error','Could not load dues.'); });
    }
    function openByAdm(admNo){
        $('#admResults').addClass('d-none');
        $adm.val(admNo);
        doAdmSearch();
    }
    $('#admResultsBody').on('click','.adm-pick',function(){ openPick($('#admResults').data('list')[$(this).attr('data-i')]); });
    $('#admGo').on('click',findStudent);
    $adm.on('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); findStudent(); } });

    /* ── open student ── */
    function bucket(dues,c){ return (dues && (dues[c] || dues[c.toLowerCase()])) || []; }
    function clearStudentView(){ currentStudent=null; sel={}; extras=[]; discount=null; tenders=[{mode:'Cash',amt:0,ref:''}]; amtTouched=false; $duesPane.addClass('d-none'); $duesEmpty.removeClass('d-none'); }
    function monthTitle(key){ var p=key.split('-'), names=['January','February','March','April','May','June','July','August','September','October','November','December']; return names[Number(p[1])-1]+' '+p[0]; }

    function openStudent(dues){
        sel={}; extras=[]; discount=null; tenders=[{mode:'Cash',amt:0,ref:''}]; amtTouched=false; newCollectKey();
        var monthly = bucket(dues,'Monthly').slice().sort(function(a,b){ return (a.dueDate||'').localeCompare(b.dueDate||''); });
        var map={}; months=[];
        monthly.forEach(function(d){
            var key=(d.dueDate||'').slice(0,7) || 'na';
            if(!map[key]){ map[key]={key:key,title:key==='na'?'Undated':monthTitle(key),dues:[]}; months.push(map[key]); }
            map[key].dues.push(d);
        });
        otherDues = bucket(dues,'Quarterly').concat(bucket(dues,'Yearly'));

        // "Due now" is what has fallen due (overdue + today); the whole session's balance
        // includes months still ahead. One "Total outstanding" mixed the two (QA BUG-108).
        var total=0, dueNow=0;
        allDues().forEach(function(d){ total+=d.amount; if(d.overdue || !d.dueDate || d.dueDate<=todayIso()) dueNow+=d.amount; });
        $('#dAvatar').text(initials(currentStudent.name));
        $('#dName').text(currentStudent.name);
        $('#dSub').text(currentStudent.left
            ? currentStudent.admNo + ' · ' + (currentStudent.cls||'') + (currentStudent.sec ? ' - ' + currentStudent.sec : '') + ' · LEFT the school'
            : currentStudent.admNo + ' · ' + $class.val() + ' - ' + $section.val() + ' · Roll ' + (currentStudent.roll||'—'));
        $('#dOutstanding').text(EC.money(dueNow));
        $('#dSession').text(total>dueNow ? 'Whole session '+EC.money(total) : '');
        $duesEmpty.addClass('d-none'); $duesPane.removeClass('d-none');
        switchView('dues');
        $('.chip').removeClass('active'); $('#scope').text('—');
        advanceAvail=0; $('#advUse').val(0); $('#advUseRow').hide();
        renderDues(); renderExtras(); renderTenders(); settle();
        api.advance(currentStudent.id).done(function(a){
            advanceAvail=Number((a&&a.balance)||0);
            if(advanceAvail>0){ $('#advAvail').text('(of '+EC.money(advanceAvail)+' available)'); $('#advUseRow').show(); }
            else { $('#advUse').val(0); $('#advUseRow').hide(); }
            settle();
        });
    }

    /* ── view tabs ── */
    function switchView(view){
        $('.view-tab').removeClass('active').filter('[data-view="'+view+'"]').addClass('active');
        $('#viewDues').toggleClass('d-none', view!=='dues');
        $('#viewHistory').toggleClass('d-none', view!=='history');
        if(view==='history') loadHistory();
    }
    $('.view-tab').on('click', function(){ switchView($(this).data('view')); });

    /* ── dues ── */
    function allDues(){ return months.flatMap(function(m){return m.dues;}).concat(otherDues); }
    function todayIso(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
    function dueRow(d,deposit){
        var s=!!sel[d.id];
        return '<div class="due'+(s?' sel':'')+'" data-id="'+d.id+'">'+
            '<label class="due-main"><input type="checkbox" class="form-check-input due-chk"'+(s?' checked':'')+'>'+
              '<div class="due-info"><div class="due-label">'+EC.esc(d.label)+((deposit||d.refundable)?'<span class="deposit-tag">refundable</span>':'')+'</div>'+
              '<div class="due-meta">'+(d.overdue?'<span class="overdue">Overdue</span> · ':'')+'Due '+EC.esc(d.dueDate ? EC.date(d.dueDate) : '—')+'</div></div>'+
              '<div class="due-amt">'+EC.money(d.amount)+'</div></label></div>';
    }
    function renderDues(){
        var html='';
        if(!months.length && !otherDues.length){
            html='<div class="empty-pane"><i class="bx bx-check-circle" style="color:var(--ec-suc)"></i><h6>All clear</h6><p class="mb-0">This student has no outstanding dues.</p></div>';
            $('#duesList').html(html); return;
        }
        months.forEach(function(m){
            html+='<div class="grp"><i class="bx bx-calendar"></i>'+EC.esc(m.title)+'</div>';
            m.dues.forEach(function(d){ html+=dueRow(d,false); });
        });
        if(otherDues.length){
            html+='<div class="grp"><i class="bx bx-receipt"></i>Other dues (one-time / annual)</div>';
            otherDues.forEach(function(d){ html+=dueRow(d,false); });
        }
        $('#duesList').html(html);
    }
    $('#duesList').on('change','.due-chk', function(){
        var $row=$(this).closest('.due'), id=$row.data('id');
        if(this.checked){ var d=allDues().find(function(x){return x.id===id;}); sel[id]={label:d.label,outstanding:d.amount,dueDate:d.dueDate||'',refundable:!!d.refundable}; }
        else delete sel[id];
        $row.toggleClass('sel',this.checked); settle();
    });
    $('.chip').on('click', function(){
        $('.chip').removeClass('active'); $(this).addClass('active');
        var n=Number($(this).data('n')); sel={};
        function pick(d){ sel[d.id]={label:d.label,outstanding:d.amount,dueDate:d.dueDate||'',refundable:!!d.refundable}; }
        months.forEach(function(m,i){ if(i<n) m.dues.forEach(pick); });
        // one-time / annual fees that have already fallen due go with any month choice (QA BUG-108)
        var extraDue=otherDues.filter(function(d){ return d.overdue || (d.dueDate && d.dueDate<=todayIso()); });
        extraDue.forEach(pick);
        var names=months.slice(0,n).map(function(m){return m.title;});
        $('#scope').text(names.length? (n+' month'+(n>1?'s':'')+' · '+names[0]+(n>1?' – '+names[names.length-1]:'')+(extraDue.length?' + '+extraDue.length+' fee(s) already due':'')) : 'Nothing to select');
        renderDues(); settle();
    });
    $('#clearSel').on('click', function(){ sel={}; $('.chip').removeClass('active'); $('#scope').text('—'); renderDues(); settle(); });

    /* ── extras (modal) ── */
    function renderExtras(){
        if(!extras.length){ $('#extraList').html('<div class="empty-line">No extra charges. Use “Add extra charge” for late fine, lost book, etc.</div>'); return; }
        var h=extras.map(function(e,i){
            return '<div class="li" data-i="'+i+'"><div class="li-info"><div class="li-label">'+EC.esc(e.label)+'</div>'+(e.note?'<div class="li-sub">'+EC.esc(e.note)+'</div>':'')+'</div>'+
                '<div class="li-amt">'+EC.money(e.amount)+'</div><button type="button" class="li-rm"><i class="bx bx-x"></i></button></div>';
        }).join('');
        $('#extraList').html(h);
    }
    $('#extraList').on('click','.li-rm', function(){ extras.splice($(this).closest('.li').data('i'),1); renderExtras(); settle(); });
    var extraModal=new bootstrap.Modal(document.getElementById('extraModal'));
    $('#openExtra').on('click', function(){ $('#extraLabel').val(''); $('#extraAmt').val(''); $('#extraNote').val(''); extraModal.show(); });
    $('#applyExtra').on('click', function(){
        var label=$('#extraLabel').val().trim(), amt=EC.numPos($('#extraAmt').val()), note=$('#extraNote').val().trim();
        if(!label || amt<=0){ ecToast('warning','Enter a charge name and amount.'); return; }
        extras.push({label:label,amount:amt,note:note}); extraModal.hide(); renderExtras(); settle();
    });

    /* ── discount (modal: flat/% + reason) ── */
    var discModal=new bootstrap.Modal(document.getElementById('discModal'));
    function setSeg(t){ discType=t;
        $('#discModal .fc-seg').each(function(){ $(this).toggleClass('active',$(this).data('t')===t); });
        $('#discValLbl').text(t==='pct'?'Percentage (%)':'Amount (₹)'); discPreview();
    }
    function discPreview(){
        var v=EC.numPos($('#discVal').val()), base=discBase(), amt=discType==='pct'?Math.round(base*v/100):v;
        if(v>0 && amt>base){ $('#discPreview').html('<span class="text-danger">Discount cannot exceed the payable amount ('+EC.money(base)+').</span>'); return; }
        $('#discPreview').text(v>0 ? (discType==='pct'? v+'% of '+EC.money(base)+' = ':'Flat ')+'discount '+EC.money(amt) : '');
    }
    $('#discModal .fc-seg').on('click', function(){ setSeg($(this).data('t')); });
    $('#discVal').on('input', discPreview);
    function openDiscountModal(){
        if(discount){ setSeg(discount.type); $('#discVal').val(discount.value); $('#discReasonIn').val(discount.reason||''); }
        else { setSeg('flat'); $('#discVal').val(''); $('#discReasonIn').val(''); }
        discPreview(); discModal.show();
    }
    $('#openDisc').on('click', openDiscountModal);
    $('#applyDisc').on('click', function(){
        var v=EC.numPos($('#discVal').val()), reason=$('#discReasonIn').val().trim();
        if(v<=0){ ecToast('warning','Enter a discount value.'); return; }
        if(!reason){ ecToast('warning','A reason is required for a discount.'); return; }
        var base=discBase(), amt=discType==='pct'?Math.round(base*v/100):v;
        if(amt>base){ ecToast('warning','Discount cannot exceed the payable amount ('+EC.money(base)+').'); return; }
        discount={type:discType,value:v,reason:reason}; discModal.hide(); settle();
    });
    function renderDiscount(){
        var $cell=$('#discCell'), $rsn=$('#discReason');
        if(!discount){ $cell.html('<button type="button" class="add-link">+ Add</button>'); $rsn.text('');
            $cell.find('.add-link').on('click',openDiscountModal); return; }
        var amt=calc().disc;
        $rsn.text('· '+discount.reason + (discount.type==='pct'?' ('+discount.value+'%)':''));
        $cell.html('<span class="disc-set">−'+EC.money(amt)+' <i class="bx bx-pencil e" title="Edit"></i> <i class="bx bx-x x" title="Remove"></i></span>');
        $cell.find('.e').on('click',openDiscountModal);
        $cell.find('.x').on('click',function(){ discount=null; settle(); });
    }

    /* ── tenders (split payment) ── */
    // What reference each mode carries. A cheque / DD number is required (a
    // bounced cheque must be traceable to its receipt); the others are optional.
    function refHint(mode){
        if(mode==='Cheque') return 'Cheque no. (required)';
        if(mode==='Demand Draft') return 'DD no. (required)';
        if(mode==='UPI') return 'UPI ref / UTR (optional)';
        if(mode==='Card') return 'Card txn ref (optional)';
        if(mode==='Bank Transfer') return 'Bank ref / UTR (optional)';
        return '';
    }
    function refRequired(mode){ return mode==='Cheque' || mode==='Demand Draft'; }
    function renderTenders(){
        var modes=['Cash','UPI','Card','Cheque','Demand Draft','Bank Transfer'];
        var h=tenders.map(function(t,i){
            var hint=refHint(t.mode);
            return '<div class="tender-wrap" data-i="'+i+'"><div class="tender-row"><select class="form-select form-select-sm">'+
                modes.map(function(m){return '<option'+(m===t.mode?' selected':'')+'>'+m+'</option>';}).join('')+'</select>'+
                '<input class="form-control form-control-sm t-amt" type="number" min="0" placeholder="₹" value="'+(t.amt||'')+'">'+
                (tenders.length>1?'<button type="button" class="btn btn-sm btn-outline-danger rounded-circle rm"><i class="bx bx-x"></i></button>':'')+'</div>'+
                (hint?'<input class="form-control form-control-sm t-ref mb-2" maxlength="60" placeholder="'+EC.esc(hint)+'" value="'+EC.esc(t.ref||'')+'">':'')+
                '</div>';
        }).join('');
        $('#tenders').html(h);
    }
    function tenderIndex(el){ return $(el).closest('.tender-wrap').data('i'); }
    $('#tenders').on('change','select', function(){ tenders[tenderIndex(this)].mode=$(this).val(); renderTenders(); });
    $('#tenders').on('input','.t-amt', function(){ amtTouched=true; tenders[tenderIndex(this)].amt=EC.numPos($(this).val()); settle(); });
    $('#tenders').on('input','.t-ref', function(){ tenders[tenderIndex(this)].ref=$(this).val(); });
    $('#tenders').on('click','.rm', function(){ tenders.splice(tenderIndex(this),1); renderTenders(); settle(); });
    $('#addTender').on('click', function(){ tenders.push({mode:'UPI',amt:0,ref:''}); renderTenders(); settle(); });

    /* ── settlement maths ── */
    function selectedArr(){ return Object.keys(sel).map(function(k){ return sel[k]; }); }
    // A discount is worked out on the dues that can take one -- never a refundable deposit.
    function discBase(){ return selectedArr().reduce(function(t,x){return t+(x.refundable?0:x.outstanding);},0); }
    // The discount as entered, before any cap; more than discBase() is refused.
    function discRaw(){ return discount ? (discount.type==='pct'?Math.round(discBase()*discount.value/100):discount.value) : 0; }
    function calc(){
        var dues=selectedArr().reduce(function(t,x){return t+x.outstanding;},0), n=selectedArr().length;
        var ext=extras.filter(function(e){return e.amount>0&&(e.label||'').trim();}).reduce(function(t,e){return t+e.amount;},0);
        // Capped for display only; Collect refuses a discount above discBase().
        var disc=Math.min(discRaw(), discBase());
        var payable=Math.max(0, dues-disc+ext);
        return {dues:dues,ext:ext,disc:disc,payable:payable,n:n};
    }
    function tendersTotal(){ return tenders.reduce(function(t,x){return t+EC.numPos(x.amt);},0); }
    function advUseVal(c){ return Math.min(EC.numPos($('#advUse').val()), advanceAvail, c.payable); }
    function settle(){
        var c=calc(); renderDiscount();
        var advUse=advUseVal(c);
        if(EC.numPos($('#advUse').val())>advUse) $('#advUse').val(advUse);
        var net=Math.max(0, c.payable-advUse);
        $('#selCount').text(c.n); $('#duesSel').text(EC.money(c.dues)); $('#extraSum').text(EC.money(c.ext)); $('#payable').text(EC.money(c.payable));
        if(!amtTouched && tenders.length===1){ tenders[0].amt=net; renderTenders(); }
        var paid=tendersTotal(), funded=paid+advUse;
        $('#tenderSum').text(EC.money(paid)+' of '+EC.money(net));
        $('#paidV').text(EC.money(funded));
        var bal=c.payable-funded;
        $('#balLbl').text(bal>0?'Balance due':'Balance'); $('#balV').text(EC.money(Math.max(0,bal)));
        var adv=Math.max(0,funded-c.payable);
        $('#advRow').toggle(adv>0); $('#advV').text(EC.money(adv));
        $('#collectBtn').prop('disabled', c.payable<=0 && c.disc<=0);
    }
    $('#advUse').on('input', settle);

    /* Build per-ledger items for the existing endpoint: discount spread oldest-first
       as concession, then the paid cash spread oldest-first. */
    function buildItems(){
        var arr=selectedArr().slice().sort(function(a,b){ return (a.dueDate||'').localeCompare(b.dueDate||''); });
        var c=calc(), remD=c.disc;
        // A discount never lands on a refundable deposit: it is handed back later in full.
        arr.forEach(function(s){ var cc=s.refundable?0:Math.min(remD,s.outstanding); s._conc=cc; remD-=cc; s._net=s.outstanding-cc; });
        var cashForDues=Math.max(0, Math.min((tendersTotal()+advUseVal(c))-c.ext, c.dues-c.disc)), remC=cashForDues;
        arr.forEach(function(s){ var p=Math.min(remC,s._net); s._pay=p; remC-=p; });
        // map back to ledger ids
        var ids=Object.keys(sel);
        return arr.map(function(s,idx){ return s; })
                  .filter(function(s){ return s._pay>0 || s._conc>0; })
                  .map(function(s){ var id=ids.find(function(k){return sel[k]===s;}); return { ledgerId:Number(id), amount:s._pay, concession:s._conc }; });
    }

    /* ── collect ── */
    $('#collectBtn').on('click', function(){
        var items=buildItems();
        var exs=extras.filter(function(e){return e.amount>0&&(e.label||'').trim();}).map(function(e){return {label:e.label,amount:e.amount,note:e.note||''};});
        if(!items.length && !exs.length){ ecToast('warning','Pick a due or add an extra charge.'); return; }
        // Dues may have been unticked after the discount was applied.
        if(discRaw()>discBase()){ ecToast('warning','Discount cannot exceed the payable amount ('+EC.money(discBase())+').'); return; }
        var advUse=advUseVal(calc());
        var paidTenders = tenders.filter(function(t){ return EC.numPos(t.amt)>0; })
                                 .map(function(t){ return { mode:t.mode, amount:EC.numPos(t.amt), reference:(t.ref||'').trim() }; });
        var missingRef = paidTenders.filter(function(t){ return refRequired(t.mode) && !t.reference; })[0];
        if(missingRef){ ecToast('warning','Enter the '+(missingRef.mode==='Cheque'?'cheque':'DD')+' number.'); return; }
        var primaryMode = tenders.length>1 ? 'Mixed' : (tenders[0]&&tenders[0].mode) || 'Cash';
        var $btn=$(this); EC.buttonBusy($btn,'Collecting…');
        api.collect({ studentId:currentStudent.id, mode:primaryMode, reference:'', remarks:$('#pRemarks').val(),
                      session:$session.val(), items:items, extras:exs,
                      discountType: discount ? (discount.type==='pct'?'Percent':'Flat') : null,
                      discountValue: discount ? discount.value : 0,
                      discountReason: discount ? discount.reason : null,
                      tenders: paidTenders, advanceUsed: advUse, clientRef: collectKey })
        .done(function(res){
            EC.buttonReset($btn);
            if(!res || !res.success){ ecToast('error',(res&&res.message)||'Could not record payment.'); return; }
            ecToast('success','Collected '+EC.money(res.amount)+'. Receipt '+res.receiptNo+'.');
            loadToday();
            $('#pRemarks').val('');
            // Receipt is NOT force-opened — the cashier may be mid-queue. It is
            // available from the payment history list ("Print") whenever needed.
            api.dues(currentStudent.id).done(openStudent);
        })
        .fail(function(){
            // The server may have saved it before the connection dropped. The
            // same settlement id goes with a retry, so collecting again is safe:
            // it returns the receipt already issued instead of a second one.
            EC.buttonReset($btn);
            ecToast('error','Could not reach the server. Collect again to retry — the same payment is never taken twice.');
        });
    });

    /* ── history: receipts (money in) and refund vouchers (money out) ── */
    var historyRefunds=[];
    function receiptRow(r){
        var x=r.isCancelled;
        var meta=[EC.esc(r.date ? EC.date(r.date) : '—'), EC.esc(r.mode)];
        if(r.reference) meta.push(EC.esc(r.reference));
        if(r.concession>0) meta.push(EC.money(r.concession)+' off');
        if(r.advanceUsed>0) meta.push(EC.money(r.advanceUsed)+' from advance');
        if(r.advanceCredit>0) meta.push(EC.money(r.advanceCredit)+' to advance');
        if(r.collectedBy) meta.push('by '+EC.esc(r.collectedBy));
        var voided = x ? '<div class="hist-meta text-danger">Cancelled'+(r.cancelledAt?' '+EC.esc(r.cancelledAt):'')+
                         (r.authorisedBy ? ' · authorised by '+EC.esc(r.authorisedBy)+(r.cancelledBy?' (entered by '+EC.esc(r.cancelledBy)+')':'')
                                         : (r.cancelledBy?' by '+EC.esc(r.cancelledBy):''))+
                         (r.cancelReason?' · '+EC.esc(r.cancelReason):'')+'</div>' : '';
        return '<div class="hist-row'+(x?' cancelled':'')+'"><div class="hist-info">'+
               '<div class="hist-rcp'+(x?' strike':'')+'">'+EC.esc(r.receiptNo)+(x?' <span class="ec-badge ec-badge-default">Cancelled</span>':'')+'</div>'+
               '<div class="hist-meta">'+meta.join(' · ')+'</div>'+voided+'</div>'+
               '<div class="hist-amt'+(x?' strike':'')+'">'+EC.money(r.amount)+'</div>'+
               '<button type="button" class="btn btn-outline-secondary btn-sm hist-print" data-rcp="'+EC.esc(r.receiptNo)+'" title="Re-print"><i class="bx bx-printer"></i></button>'+
               (x?'':'<button type="button" class="btn btn-outline-danger btn-sm hist-cancel" data-rcp="'+EC.esc(r.receiptNo)+'" data-amt="'+r.amount+'" title="Cancel receipt"><i class="bx bx-x-circle"></i></button>')+
               '</div>';
    }
    function refundRow(f,i){
        var meta=[EC.esc(f.date ? EC.date(f.date) : '—'), EC.esc(f.mode), 'against '+EC.esc(f.against||'—')];
        if(f.refundedBy) meta.push('by '+EC.esc(f.refundedBy));
        if(f.authorised) meta.push('authorised: '+EC.esc(f.authorised));
        return '<div class="hist-row"><div class="hist-info">'+
               '<div class="hist-rcp">'+EC.esc(f.refundNo)+' <span class="ec-badge ec-badge-default">Refund</span></div>'+
               '<div class="hist-meta">'+meta.join(' · ')+'</div>'+
               (f.reason?'<div class="hist-meta">'+EC.esc(f.reason)+'</div>':'')+'</div>'+
               '<div class="hist-amt text-danger">−'+EC.money(f.amount)+'</div>'+
               '<button type="button" class="btn btn-outline-secondary btn-sm hist-voucher" data-i="'+i+'" title="Print refund voucher"><i class="bx bx-printer"></i></button>'+
               '</div>';
    }
    function loadHistory(){
        if(!currentStudent) return;
        $('#histList').html('<div class="text-muted small">Loading…</div>');
        api.history(currentStudent.id).done(function(res){
            var rows=(res&&res.receipts)||[];
            historyRefunds=(res&&res.refunds)||[];
            if(!rows.length && !historyRefunds.length){ $('#histList').html('<div class="empty-pane"><i class="bx bx-receipt"></i><h6>No payments yet</h6><p class="mb-0">Collected receipts will appear here.</p></div>'); return; }
            var h=rows.map(receiptRow).join('');
            if(historyRefunds.length){
                h+='<div class="grp mt-3"><i class="bx bx-money-withdraw"></i>Refunds</div>'+historyRefunds.map(refundRow).join('');
            }
            $('#histList').html(h);
        })
        .fail(function(){
            // Without this, "Loading…" stayed on screen forever.
            EC.listEmpty('#histList', 'Could not load payment history.', 'bx-error-circle');
        });
    }
    $('#histList').on('click', '.hist-print', function () {
        EcReceipt.show($(this).data('rcp'));
    });
    $('#histList').on('click', '.hist-voucher', function () {
        var f=historyRefunds[Number($(this).data('i'))]; if(!f || !currentStudent) return;
        EcReceipt.showRefund(f, { name:currentStudent.name, admNo:currentStudent.admNo,
                                  className:$class.val(), section:$section.val(), roll:currentStudent.roll });
    });

    /* ── cancel receipt ── */
    var cancelModal=new bootstrap.Modal(document.getElementById('cancelModal'));
    $('#histList').on('click','.hist-cancel', function(){
        $('#cmNo').text($(this).data('rcp')); $('#cmAmt').text(EC.money($(this).data('amt')));
        $('#cmReason').val('');
        cancelModal.show();
    });
    $('#cmConfirm').on('click', function(){
        var rcp=$('#cmNo').text(), reason=$('#cmReason').val().trim();
        if(!reason){ ecToast('warning','A reason is required.'); return; }
        var $btn=$(this); EC.buttonBusy($btn);
        api.cancel({ receiptNo:rcp, reason:reason })
        .done(function(res){
            EC.buttonReset($btn);
            if(!res||!res.success){ ecToast('error',(res&&res.message)||'Could not cancel.'); return; }
            cancelModal.hide(); ecToast('success',res.message||'Receipt cancelled.'); loadToday();
            if(currentStudent) api.dues(currentStudent.id).done(function(d){ openStudent(d); switchView('history'); });
            else loadHistory();
        })
        .fail(function(){ EC.buttonReset($btn); ecToast('error','Could not cancel the receipt.'); });
    });

    /* ── refund (deposit / overpayment) ── */
    var refundModal=new bootstrap.Modal(document.getElementById('refundModal'));
    var refundables=[];
    $('#openRefund').on('click', function(){
        if(!currentStudent){ ecToast('warning','Select a student first.'); return; }
        api.refundable(currentStudent.id).done(function(rows){
            refundables=rows||[];
            if(!refundables.length){ ecToast('info','Nothing to refund: no refundable deposit or advance is held for this student. A wrong payment is corrected by cancelling its receipt.'); return; }
            $('#rfItem').html(refundables.map(function(r,i){ return '<option value="'+i+'">'+EC.esc(r.label)+' — '+EC.money(r.refundable)+' refundable</option>'; }).join(''));
            $('#rfReason').val(''); $('#rfMode').val('Cash');
            refundItemChanged(); refundModal.show();
        }).fail(function(){ ecToast('error','Could not load refundable amounts.'); });
    });
    // ledgerId 0 is the student's advance (wallet) balance, refunded at exit.
    function refundItemChanged(){
        var r=refundables[Number($('#rfItem').val())]; if(!r) return;
        if(r.ledgerId===0){
            $('#rfAvail').html('Advance held for this student · <b>'+EC.money(r.refundable)+' refundable</b>');
        } else {
            $('#rfAvail').html('Paid '+EC.money(r.paid)+(r.refunded>0?' · already refunded '+EC.money(r.refunded):'')+' · <b>'+EC.money(r.refundable)+' refundable</b>');
        }
        $('#rfAmt').val(r.refundable);
    }
    $('#rfItem').on('change', refundItemChanged);
    $('#rfConfirm').on('click', function(){
        var r=refundables[Number($('#rfItem').val())]; if(!r){ ecToast('warning','Pick a charge to refund.'); return; }
        var amt=EC.numPos($('#rfAmt').val()), reason=$('#rfReason').val().trim();
        if(amt<=0){ ecToast('warning','Enter a refund amount.'); return; }
        if(Math.abs(Math.round(amt*100)-amt*100)>1e-6){ ecToast('warning','Use at most two decimal places.'); return; }
        if(amt>r.refundable+0.001){ ecToast('warning','Amount exceeds the refundable balance ('+EC.money(r.refundable)+').'); return; }
        if(!reason){ ecToast('warning','A reason is required.'); return; }
        var $btn=$(this); EC.buttonBusy($btn);
        api.refund({ studentId:currentStudent.id, ledgerId:r.ledgerId, amount:amt, mode:$('#rfMode').val(), reason:reason })
        .done(function(res){
            EC.buttonReset($btn);
            if(!res||!res.success){ ecToast('error',(res&&res.message)||'Could not refund.'); return; }
            refundModal.hide(); ecToast('success',res.message||'Refund recorded.');
            if(currentStudent) api.dues(currentStudent.id).done(function(d){ openStudent(d); switchView('history'); });
        })
        .fail(function(){ EC.buttonReset($btn); ecToast('error','Could not record the refund.'); });
    });

});
</script>
}
