@{
    ViewData["Title"] = "Timetable";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/SchoolSettings/Timetable.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <!-- Header -->
    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-time-five fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Timetable</h4>
            <div class="ec-page-subtitle">Build weekly schedules — clashes flagged the moment they happen</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main -->
    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <!-- title + inline stats on one row -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
          <div class="ec-section-title-wrap">
            <span class="ec-section-icon"><i class="bx bx-grid-alt"></i></span>
            <div>
              <div class="ec-section-title" id="gridTitle">Weekly Timetable</div>
              <div class="ec-section-subtitle">Periods read from the selected shift’s bell schedule</div>
            </div>
          </div>
          <div class="tt-stats" id="statBar"></div>
        </div>

        <!-- toolbar -->
        <div class="tt-fbar">
          <div class="tt-seg" id="viewSeg">
            <button data-v="class" class="on"><i class="bx bx-group"></i>Class</button>
            <button data-v="teacher"><i class="bx bx-user-voice"></i>Teacher</button>
          </div>
          <select class="tt-select" id="shiftSel" title="Bell schedule from Period Structure"></select>
          <select class="tt-select" id="pickClass"></select>
          <select class="tt-select d-none" id="pickTeacher"></select>
          <button class="tt-btn" id="btnCopy"><i class="bx bx-copy-alt"></i>Copy Mon → Week</button>
          <span class="tt-hint ms-auto" id="modeHint"><i class="bx bx-info-circle"></i> Click a cell to assign</span>
        </div>
      </div>

      <div class="ec-card-body pt-2">
        <!-- desktop -->
        <div class="tt-wrap">
          <table class="tt-grid" id="ttGrid"></table>
        </div>
        <!-- mobile -->
        <div class="tt-mob">
          <div class="tt-days" id="dayTabs"></div>
          <div id="mobList"></div>
        </div>
      </div>
    </div>

    @Html.AntiForgeryToken()

  </div>
</div>

<!-- Cell editor modal (class view only) -->
<div class="modal fade" id="cellModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:0;border-radius:20px;overflow:hidden;">
      <div class="ec-card-header d-flex align-items-center justify-content-between p-3 p-lg-4">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-edit"></i></span>
          <div>
            <div class="ec-section-title">Assign Period</div>
            <div class="ec-section-subtitle" id="cellSlot">—</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="ec-card-body p-3 p-lg-4">
        <div class="row g-3">
          <div class="col-12 col-sm-6">
            <label class="form-label tt-modal-lbl">Subject</label>
            <select class="form-select" id="mSubject"></select>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label tt-modal-lbl">Teacher</label>
            <select class="form-select" id="mTeacher"></select>
          </div>
          <div class="col-12">
            <label class="form-label tt-modal-lbl">Room</label>
            <input type="text" class="form-control" id="mRoom" placeholder="e.g. 204">
          </div>
        </div>
        <div class="tt-mwarn mt-3" id="cellWarn"><i class="bx bx-error fs-5"></i><span id="cellWarnTxt"></span></div>
      </div>
      <div class="ec-card-body pt-0 p-3 p-lg-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
        <button type="button" class="btn btn-outline-danger px-3" id="cellClear"><i class="bx bx-trash me-1"></i>Clear</button>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary px-4" id="cellSave"><i class="bx bx-check me-1"></i>Save</button>
        </div>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
(function(){
'use strict';

/* Everything below is loaded from the server: periods come from Period Structure,
   day columns from the School Calendar's weekly offs, sections/subjects/teachers
   from their own masters. The page stores nothing of its own. */
var SETUP_URL  ='@Url.Action("TimetableSetup","SchoolSettings",new{area="ERP"})';
var GRID_URL   ='@Url.Action("TimetableGrid","SchoolSettings",new{area="ERP"})';
var TEACHER_URL='@Url.Action("TimetableTeacherGrid","SchoolSettings",new{area="ERP"})';
var SAVE_URL   ='@Url.Action("SaveTimetableCell","SchoolSettings",new{area="ERP"})';
var CLEAR_URL  ='@Url.Action("ClearTimetableCell","SchoolSettings",new{area="ERP"})';
var COPY_URL   ='@Url.Action("CopyTimetableDay","SchoolSettings",new{area="ERP"})';

var PERIOD_LIST=[];     /* {id:period_seq, name, time, type} */
var DAYS=[], DAY_VALUES=[];   /* labels for the UI, real 0-6 day numbers for the server */
var SECTIONS=[], TEACHERS=[], SUBJECTS=[];

/* TT[dayIdx+'_'+periodSeq] = {subjectId, subjectName, teacherId, teacherName, room}
   — only the section on screen. BUSY holds every OTHER section's teacher booking. */
var TT={}, BUSY={}, TEACH={};

var view='class', curSection=0, curTeacher=0, curDay=0, ctx=null;
function PERIODS(){ return PERIOD_LIST; }

function teacherName(id){ var t=TEACHERS.find(function(x){return x.id===id;}); return t?t.name:''; }
function sectionLabel(id){ var s=SECTIONS.find(function(x){return x.id===id;}); return s?s.label:''; }
function dotClass(id){ return 's'+(((Math.abs(id)-1)%8)+1); }   /* reuse the 8-colour palette */
function token(){ var t=document.querySelector('input[name="__RequestVerificationToken"]'); return t?t.value:''; }
function post(url,payload){
  return $.ajax({ url:url, type:'POST', contentType:'application/json',
    headers:{ 'RequestVerificationToken':token(), 'X-Requested-With':'XMLHttpRequest' },
    data:JSON.stringify(payload) });
}

/* A clash is the same teacher, same day+period, in another section. */
function clashSection(dayIdx,periodId,teacherId){
  if(!teacherId) return null;
  var label=BUSY[DAY_VALUES[dayIdx]+'_'+periodId+'_'+teacherId];
  return label ? {label:label} : null;
}

/* ---- load ---- */
function loadSetup(){
  $.getJSON(SETUP_URL)
    .done(function(s){
      PERIOD_LIST=(s.periods||[]).map(function(p){
        return {id:p.periodSeq, name:p.label, time:p.startTime+'–'+p.endTime, type:p.periodType};
      });
      SECTIONS=(s.sections||[]).map(function(x){ return {id:x.sectionId, label:x.label, room:x.roomNo}; });
      TEACHERS=(s.teachers||[]).map(function(x){ return {id:x.staffId, name:x.fullName}; });
      DAYS      =(s.days||[]).map(function(d){ return d.dayLabel; });
      DAY_VALUES=(s.days||[]).map(function(d){ return d.dayOfWeek; });

      fillSelectors();

      if(!PERIOD_LIST.length){ ecToast('info','Set the daily periods in Period Structure first.'); render(); return; }
      if(!SECTIONS.length){ ecToast('info','Add classes & sections first.'); render(); return; }

      curSection=SECTIONS[0].id;
      curTeacher=TEACHERS.length?TEACHERS[0].id:0;
      loadGrid();
    })
    .fail(function(){ ecToast('error','Could not load the timetable.'); });
}

function loadGrid(){
  if(!curSection){ render(); return; }
  $.getJSON(GRID_URL,{sectionId:curSection})
    .done(function(g){
      TT={};
      (g.entries||[]).forEach(function(e){
        var di=DAY_VALUES.indexOf(e.dayOfWeek);
        if(di<0) return;                       /* that day is a weekly off now */
        TT[di+'_'+e.periodSeq]={subjectId:e.subjectId, subjectName:e.subjectName,
                                teacherId:e.staffId||0, teacherName:e.staffName, room:e.roomNo};
      });
      BUSY={};
      (g.busy||[]).forEach(function(b){ BUSY[b.dayOfWeek+'_'+b.periodSeq+'_'+b.staffId]=b.sectionLabel; });
      SUBJECTS=(g.subjects||[]).map(function(s){ return {id:s.subjectId, name:s.subjectName}; });
      fillSubjectSelect();
      render();
    })
    .fail(function(){ ecToast('error','Could not load this class\'s timetable.'); });
}

function loadTeacherGrid(){
  if(!curTeacher){ TEACH={}; render(); return; }
  $.getJSON(TEACHER_URL,{staffId:curTeacher})
    .done(function(rows){
      TEACH={};
      (rows||[]).forEach(function(e){
        var di=DAY_VALUES.indexOf(e.dayOfWeek);
        if(di<0) return;
        TEACH[di+'_'+e.periodSeq]={subjectId:e.subjectId, subjectName:e.subjectName,
                                   sectionLabel:e.sectionLabel, room:e.roomNo};
      });
      render();
    })
    .fail(function(){ ecToast('error','Could not load the teacher schedule.'); });
}

/* selectors */
function fillSelectors(){
  /* one bell schedule per school — the selector stays, it just has one entry */
  var sh=document.getElementById('shiftSel');
  sh.innerHTML='';
  var o=document.createElement('option');
  o.value='school';
  o.textContent=PERIOD_LIST.length
    ? 'Bell Schedule · '+PERIOD_LIST[0].time.split('–')[0]+'–'+PERIOD_LIST[PERIOD_LIST.length-1].time.split('–')[1]
    : 'No bell schedule';
  sh.appendChild(o);

  var pc=document.getElementById('pickClass'); pc.innerHTML='';
  SECTIONS.forEach(function(s){ var x=document.createElement('option'); x.value=s.id; x.textContent=s.label; pc.appendChild(x); });
  if(SECTIONS.length) pc.value=SECTIONS[0].id;

  var pt=document.getElementById('pickTeacher'); pt.innerHTML='';
  TEACHERS.forEach(function(t){ var x=document.createElement('option'); x.value=t.id; x.textContent=t.name; pt.appendChild(x); });
  if(TEACHERS.length) pt.value=TEACHERS[0].id;

  var mt=document.getElementById('mTeacher'); mt.innerHTML='<option value="0">— Select —</option>';
  TEACHERS.forEach(function(t){ var x=document.createElement('option'); x.value=t.id; x.textContent=t.name; mt.appendChild(x); });

  var dt=document.getElementById('dayTabs'); dt.innerHTML='';
  DAYS.forEach(function(d,i){ var b=document.createElement('button'); b.className='tt-day'+(i===0?' on':''); b.textContent=d; b.dataset.d=i; dt.appendChild(b); });
}

/* the modal only offers subjects the selected class actually studies */
function fillSubjectSelect(){
  var ms=document.getElementById('mSubject');
  ms.innerHTML='<option value="0">— Select —</option>';
  SUBJECTS.forEach(function(s){ var o=document.createElement('option'); o.value=s.id; o.textContent=s.name; ms.appendChild(o); });
}

/* stats */
function renderStats(){
  var classPeriods=PERIODS().filter(function(p){return p.type==='class';}).length * DAYS.length;
  var bar=document.getElementById('statBar');
  if(view==='class'){
    var filled=0, clashes=0;
    PERIODS().filter(function(p){return p.type==='class';}).forEach(function(p){
      DAYS.forEach(function(d,di){ var e=TT[di+'_'+p.id]; if(e){ filled++; if(clashSection(di,p.id,e.teacherId)) clashes++; } });
    });
    bar.innerHTML='<span class="tt-stat"><b>'+filled+'</b><i>/ '+classPeriods+' set</i></span>'
      +'<span class="tt-stat"><b>'+(classPeriods-filled)+'</b><i>free</i></span>'
      +'<span class="tt-stat clash'+(clashes?'':' zero')+'"><i class="bx bx-error-circle"></i><b>'+clashes+'</b><i>clash'+(clashes===1?'':'es')+'</i></span>';
  } else {
    var taught=0, secSet={};
    PERIODS().filter(function(p){return p.type==='class';}).forEach(function(p){
      DAYS.forEach(function(d,di){ var e=TEACH[di+'_'+p.id]; if(e){ taught++; secSet[e.sectionLabel]=1; } });
    });
    bar.innerHTML='<span class="tt-stat"><b>'+taught+'</b><i>periods/wk</i></span>'
      +'<span class="tt-stat"><b>'+(classPeriods-taught)+'</b><i>free</i></span>'
      +'<span class="tt-stat"><b>'+Object.keys(secSet).length+'</b><i>classes</i></span>';
  }
}

/* desktop grid */
function renderGrid(){
  var g=document.getElementById('ttGrid');
  var head='<thead><tr><th class="tt-pcol">Period</th>'+DAYS.map(function(d){return '<th>'+d+'</th>';}).join('')+'</tr></thead>';
  var body='<tbody>';
  PERIODS().forEach(function(p){
    if(p.type!=='class'){          /* break and lunch are not bookable */
      body+='<tr class="tt-break"><td class="tt-pcell"><div class="tt-pname">'+EC.esc(p.name)+'</div><div class="tt-ptime">'+p.time+'</div></td><td colspan="'+DAYS.length+'">'+EC.esc(p.name)+' · '+p.time+'</td></tr>';
      return;
    }
    body+='<tr><td><div class="tt-pcell"><div class="tt-pname">'+EC.esc(p.name)+'</div><div class="tt-ptime">'+p.time+'</div></div></td>';
    DAYS.forEach(function(d,di){ body+='<td>'+cellHtml(di,p.id,false)+'</td>'; });
    body+='</tr>';
  });
  g.innerHTML=head+body+'</tbody>';
}

/* mobile day list */
function renderMob(){
  var box=document.getElementById('mobList');
  document.querySelectorAll('.tt-day').forEach(function(b){ b.classList.toggle('on', parseInt(b.dataset.d,10)===curDay); });
  box.innerHTML=PERIODS().map(function(p){
    if(p.type!=='class') return '<div class="tt-mbreak">'+EC.esc(p.name)+' · '+p.time+'</div>';
    return '<div class="tt-mrow"><div class="tt-mp"><div class="tt-mp-name">'+EC.esc(p.name)+'</div><div class="tt-mp-time">'+p.time+'</div></div>'+cellHtml(curDay,p.id,true)+'</div>';
  }).join('');
}

function cellHtml(dayIdx,periodId,mob){
  var base=mob?'tt-mcell':'tt-cell';
  if(view==='class'){
    var e=TT[dayIdx+'_'+periodId];
    if(!e){ return '<'+(mob?'div':'button')+' class="'+base+' empty js-cell" data-d="'+dayIdx+'" data-p="'+periodId+'"><i class="bx bx-plus"></i>'+(mob?'Add':'')+'</'+(mob?'div':'button')+'>'; }
    var c=clashSection(dayIdx,periodId,e.teacherId);
    return '<'+(mob?'div':'button')+' class="'+base+' js-cell'+(c?' clash':'')+'" data-d="'+dayIdx+'" data-p="'+periodId+'">'
      +'<div class="tt-subj"><span class="dot '+dotClass(e.subjectId)+'"></span>'+EC.esc(e.subjectName)+(c?' <i class="bx bx-error tt-clash-ic" title="Clash with '+EC.esc(c.label)+'"></i>':'')+'</div>'
      +'<div class="tt-teacher">'+EC.esc(e.teacherName||'Unassigned')+'</div>'
      +'<div class="tt-room">Room '+EC.esc(e.room||'—')+'</div></'+(mob?'div':'button')+'>';
  } else {
    var e2=TEACH[dayIdx+'_'+periodId];
    if(e2){
      return '<div class="'+base+' ro"><div class="tt-subj"><span class="dot '+dotClass(e2.subjectId)+'"></span>'+EC.esc(e2.subjectName)+'</div>'
        +'<div class="tt-teacher">'+EC.esc(e2.sectionLabel)+'</div><div class="tt-room">Room '+EC.esc(e2.room||'—')+'</div></div>';
    }
    return '<div class="'+base+' ro empty"><span style="font-size:.7rem;font-weight:700;">Free</span></div>';
  }
}

function render(){
  renderGrid(); renderMob(); renderStats(); bindCells();
  document.getElementById('gridTitle').textContent = view==='class' ? sectionLabel(curSection)+' — Timetable' : teacherName(curTeacher)+' — Schedule';
  document.getElementById('btnCopy').style.display = view==='class' ? '' : 'none';
}

function bindCells(){
  if(view!=='class') return;
  document.querySelectorAll('.js-cell').forEach(function(b){
    b.addEventListener('click',function(){ openCell(parseInt(this.dataset.d,10), this.dataset.p); });
  });
}

/* cell editor */
function openCell(dayIdx,periodId){
  if(!SUBJECTS.length){ ecToast('error','This class has no subjects yet — set them in Subject Management.'); return; }
  ctx={dayIdx:dayIdx,periodId:periodId};
  var e=TT[dayIdx+'_'+periodId]||{subjectId:0,teacherId:0,room:''};
  var p=PERIODS().find(function(x){return x.id===periodId;});
  document.getElementById('cellSlot').textContent=sectionLabel(curSection)+' · '+DAYS[dayIdx]+' · '+(p?p.name:'');
  document.getElementById('mSubject').value=e.subjectId||0;
  document.getElementById('mTeacher').value=e.teacherId||0;
  var sec=SECTIONS.find(function(s){return s.id===curSection;});
  document.getElementById('mRoom').value=e.room || (sec?sec.room:'') || '';
  document.getElementById('cellClear').style.display = e.subjectId ? '' : 'none';
  checkModalClash();
  new bootstrap.Modal(document.getElementById('cellModal')).show();
}
function checkModalClash(){
  if(!ctx) return;
  var tid=parseInt(document.getElementById('mTeacher').value,10);
  var c=clashSection(ctx.dayIdx,ctx.periodId,tid), w=document.getElementById('cellWarn');
  if(c){ document.getElementById('cellWarnTxt').textContent=teacherName(tid)+' is already teaching '+c.label+' at this slot.'; w.classList.add('show'); }
  else w.classList.remove('show');
}
document.getElementById('mTeacher').addEventListener('change',checkModalClash);

document.getElementById('cellSave').addEventListener('click',function(){
  var sid=parseInt(document.getElementById('mSubject').value,10), tid=parseInt(document.getElementById('mTeacher').value,10);
  if(!sid){ ecToast('error','Pick a subject.'); return; }
  var btn=this; btn.disabled=true;

  /* The proc has the final say on clashes — it rejects a double-booked teacher. */
  post(SAVE_URL,{ sectionId:curSection, day:DAY_VALUES[ctx.dayIdx], periodSeq:ctx.periodId,
                  subjectId:sid, staffId:tid||null, room:document.getElementById('mRoom').value.trim() })
    .done(function(res){
      if(res && res.success){
        bootstrap.Modal.getInstance(document.getElementById('cellModal')).hide();
        ecToast('success',res.message||'Period updated.');
        loadGrid();
      } else ecToast('error',(res&&res.message)||'Could not save this period.');
    })
    .fail(function(){ ecToast('error','Save failed. Check your connection.'); })
    .always(function(){ btn.disabled=false; });
});

document.getElementById('cellClear').addEventListener('click',function(){
  post(CLEAR_URL,{ sectionId:curSection, day:DAY_VALUES[ctx.dayIdx], periodSeq:ctx.periodId })
    .done(function(res){
      bootstrap.Modal.getInstance(document.getElementById('cellModal')).hide();
      if(res && res.success){ ecToast('info',res.message||'Period cleared.'); loadGrid(); }
      else ecToast('error',(res&&res.message)||'Could not clear this period.');
    })
    .fail(function(){ ecToast('error','Could not clear this period.'); });
});

/* copy the first working day → whole week */
document.getElementById('btnCopy').addEventListener('click',function(){
  if(!DAYS.length) return;
  var classP=PERIODS().filter(function(p){return p.type==='class';});
  var srcCount=classP.filter(function(p){return TT['0_'+p.id];}).length;
  if(!srcCount){ ecToast('error',DAYS[0]+' is empty — fill it first, then copy.'); return; }
  EC.confirm({ title:'Copy '+DAYS[0]+' across the week?',
               name:sectionLabel(curSection),
               message:'This overwrites the other days with '+DAYS[0]+'’s '+srcCount+' period(s).',
               icon:'bx-copy', okText:'Copy & overwrite' }).then(function(ok){
    if(!ok) return;
    post(COPY_URL,{ sectionId:curSection, day:DAY_VALUES[0] })
      .done(function(res){
        if(res && res.success){ ecToast('success',res.message||'Copied across the week.'); loadGrid(); }
        else ecToast('error',(res&&res.message)||'Copy failed.');
      })
      .fail(function(){ ecToast('error','Copy failed. Check your connection.'); });
  });
});

/* toolbar */
document.querySelectorAll('#viewSeg button').forEach(function(b){
  b.addEventListener('click',function(){
    view=this.dataset.v;
    document.querySelectorAll('#viewSeg button').forEach(function(x){ x.classList.toggle('on',x===b); });
    document.getElementById('pickClass').classList.toggle('d-none',view!=='class');
    document.getElementById('pickTeacher').classList.toggle('d-none',view!=='teacher');
    document.getElementById('modeHint').innerHTML = view==='class'
      ? '<i class="bx bx-info-circle"></i> Click a cell to assign'
      : '<i class="bx bx-lock-alt"></i> Read-only — from class timetables';
    if(view==='teacher') loadTeacherGrid(); else loadGrid();
  });
});
document.getElementById('pickClass').addEventListener('change',function(){ curSection=parseInt(this.value,10); loadGrid(); });
document.getElementById('pickTeacher').addEventListener('change',function(){ curTeacher=parseInt(this.value,10); loadTeacherGrid(); });
document.getElementById('dayTabs').addEventListener('click',function(e){ var b=e.target.closest('.tt-day'); if(!b) return; curDay=parseInt(b.dataset.d,10); renderMob(); });

loadSetup();

})();
</script>
}
