@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model EduCoreDataAccessLayer.Models.ERP.FeeHead
@{
    ViewData["Title"] = "Fee Head Master";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    // ONE model does everything: the grid rows come from Model.Items (server-side
    // paged + sorted + filtered), the add-form binds Model's own fields, and the
    // filter/pager use Model.Search / Model.Page / Model.SortColumn.
    var feeHeads = Model.Items;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/SchoolSettings/FeeHead.css" asp-append-version="true" />
}

<div class="ec-page-shell fee-head-page">
    <div class="ec-page-content">

        <div class="ec-page-header">
            <div class="ec-page-header-inner d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div class="ec-page-title-wrap d-flex align-items-start gap-3">
                    <div class="ec-page-icon">
                        <i class="bx bx-rupee"></i>
                    </div>

                    <div>
                        <h3 class="ec-page-title mb-1">Fee Head Master</h3>
                        <p class="ec-page-subtitle mb-0">
                            Create reusable billing heads used later in class-wise Fee Structure.
                        </p>
                    </div>
                </div>

                <a asp-controller="SchoolSettings" asp-action="FeeStructure" class="btn btn-outline-secondary fee-action-btn">
                    <i class="bx bx-wallet me-1"></i>
                    Fee Structure
                </a>
            </div>
        </div>

        <div class="ec-card mb-4">
            <div class="ec-card-body">
                <div class="row g-3">

                    <div class="col-12 col-md-4">
                        <div class="ec-detail-box h-100">
                            <div class="ec-detail-item">
                                <span class="ec-detail-icon">
                                    <i class="bx bx-category"></i>
                                </span>

                                <div>
                                    <div class="ec-detail-label">Total Fee Heads</div>
                                    <div class="ec-detail-value">@Model.TotalCount</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="ec-detail-box h-100">
                            <div class="ec-detail-item">
                                <span class="ec-detail-icon">
                                    <i class="bx bx-check-shield"></i>
                                </span>

                                <div>
                                    <div class="ec-detail-label">Mandatory Heads</div>
                                    <div class="ec-detail-value">@Model.MandatoryCount</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="ec-detail-box h-100">
                            <div class="ec-detail-item">
                                <span class="ec-detail-icon">
                                    <i class="bx bx-slider"></i>
                                </span>

                                <div>
                                    <div class="ec-detail-label">Optional Heads</div>
                                    <div class="ec-detail-value">@Model.OptionalCount</div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="ec-detail-box mt-3">
                    <div class="ec-detail-item">
                        <span class="ec-detail-icon">
                            <i class="bx bx-info-circle"></i>
                        </span>

                        <div>
                            <div class="ec-detail-title">Simple Fee Head Setup</div>
                            <div class="ec-detail-value fw-normal text-muted">
                                Keep this page only for reusable fee heads. Class-wise selection is managed manually in Fee Structure.
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="row g-4">

            <div class="col-12 col-xl-4">
                <div class="ec-card h-100">
                    <div class="ec-card-header">
                        <div class="ec-section-title-wrap d-flex align-items-center gap-3">
                            <span class="ec-section-icon">
                                <i class="bx bx-plus-circle"></i>
                            </span>

                            <div>
                                <h5 class="ec-section-title mb-1" id="feeHeadFormTitle">Create Fee Head</h5>
                                <p class="ec-section-subtitle mb-0">
                                    Add a reusable charge for billing.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="ec-card-body">
                        <form asp-action="SaveFeeHead"
                              asp-controller="SchoolSettings"
                              method="post"
                              id="feeHeadForm">

                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="FeeHeadId" id="FeeHeadId" />

                            <div class="mb-3">
                                <label class="form-label">
                                    Fee Head Name <span class="text-danger">*</span>
                                </label>

                                <input asp-for="FeeHeadName"
                                       class="form-control"
                                       id="FeeHeadName"
                                       maxlength="80"
                                       placeholder="Example: Tuition Fee" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Billing Cycle <span class="text-danger">*</span>
                                </label>

                                <select asp-for="Frequency" class="form-select" id="Frequency">
                                    <option value="">Select cycle</option>
                                    <option value="One Time">One Time</option>
                                    <option value="Monthly">Monthly</option>
                                    <option value="Quarterly">Quarterly</option>
                                    <option value="Yearly">Yearly</option>
                                </select>

                                <small class="text-muted">
                                    Example: Tuition = Monthly, Admission = One Time.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Default Amount</label>

                                <div class="input-group">
                                    <span class="input-group-text">₹</span>

                                    <input asp-for="DefaultAmount"
                                           type="number"
                                           class="form-control"
                                           id="DefaultAmount"
                                           min="0"
                                           step="0.01"
                                           placeholder="0" />
                                </div>

                                <small class="text-muted">
                                    This amount can be changed later in Fee Structure.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Fee Type <span class="text-danger">*</span>
                                </label>

                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="fee-head-type-card d-flex align-items-start gap-3">
                                            <input asp-for="FeeType"
                                                   class="form-check-input mt-1"
                                                   type="radio"
                                                   value="Mandatory" />

                                            <div class="fee-choice-content">
                                                <span class="fee-choice-title d-block">
                                                    Mandatory
                                                </span>

                                                <small class="text-muted">
                                                    Usually selected by default in Fee Structure.
                                                </small>
                                            </div>
                                        </label>
                                    </div>

                                    <div class="col-12">
                                        <label class="fee-head-type-card d-flex align-items-start gap-3">
                                            <input asp-for="FeeType"
                                                   class="form-check-input mt-1"
                                                   type="radio"
                                                   value="Optional" />

                                            <div class="fee-choice-content">
                                                <span class="fee-choice-title d-block">
                                                    Optional
                                                </span>

                                                <small class="text-muted">
                                                    Can be selected manually in Fee Structure.
                                                </small>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Fee Group</label>

                                <select asp-for="FeeGroup" class="form-select" id="FeeGroup">
                                    <option value="Academic">Academic</option>
                                    <option value="Transport">Transport</option>
                                    <option value="Hostel">Hostel</option>
                                    <option value="Optional Services">Optional Services</option>
                                    <option value="Fine / Penalty">Fine / Penalty</option>
                                </select>

                                <small class="text-muted">
                                    Used for reporting and filtering only.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Collection Point <span class="text-danger">*</span>
                                </label>

                                <select asp-for="CollectionPoint" class="form-select" id="CollectionPoint">
                                    <option value="Registration">Registration (before admission)</option>
                                    <option value="Admission">Admission (one-time, on joining)</option>
                                    <option value="Recurring">Recurring (collected ongoing in Fee module)</option>
                                </select>

                                <small class="text-muted">
                                    When this charge is first due. Example: Registration Fee = Registration,
                                    Admission Fee / Security Deposit = Admission, Tuition = Recurring.
                                </small>
                            </div>

                            <div class="mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsRefundable"
                                           class="form-check-input"
                                           type="checkbox"
                                           id="IsRefundable" />
                                    <label class="form-check-label" for="IsRefundable">
                                        Refundable
                                    </label>
                                </div>

                                <small class="text-muted">
                                    Turn on for deposits returned when the student leaves (e.g. Security Deposit).
                                </small>
                            </div>

                            <div class="ec-sticky-actions">
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary fee-action-btn">
                                        <i class="bx bx-save me-1"></i>
                                        Save Fee Head
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary fee-action-btn d-none"
                                            id="cancelEditButton">
                                        Cancel Edit
                                    </button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="ec-card">
                    <div class="ec-card-header">
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                            <div class="ec-section-title-wrap d-flex align-items-center gap-3">
                                <span class="ec-section-icon">
                                    <i class="bx bx-list-ul"></i>
                                </span>

                                <div>
                                    <h5 class="ec-section-title mb-1">Existing Fee Heads</h5>
                                    <p class="ec-section-subtitle mb-0">
                                        Manage reusable billing heads.
                                    </p>
                                </div>
                            </div>

                            @* Server-side filter + sort. Submits back to the FeeHead GET action;
                               the bound model carries Search / FilterFrequency / SortColumn / SortDir. *@
                            <form id="feeHeadFilterForm" method="get" asp-action="FeeHead" class="fee-filter-bar d-flex flex-column flex-sm-row gap-2">
                                <input type="search" name="Search" value="@Model.Search"
                                       class="form-control form-control-sm"
                                       placeholder="Search fee head..." />

                                <select name="FilterFrequency" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="">All Cycles</option>
                                    <option value="One Time"  selected="@(Model.FilterFrequency == "One Time")">One Time</option>
                                    <option value="Monthly"   selected="@(Model.FilterFrequency == "Monthly")">Monthly</option>
                                    <option value="Quarterly" selected="@(Model.FilterFrequency == "Quarterly")">Quarterly</option>
                                    <option value="Yearly"    selected="@(Model.FilterFrequency == "Yearly")">Yearly</option>
                                </select>

                                <select name="SortColumn" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="">Sort: Default</option>
                                    <option value="name"   selected="@(Model.SortColumn == "name")">Name</option>
                                    <option value="amount" selected="@(Model.SortColumn == "amount")">Amount</option>
                                    <option value="cycle"  selected="@(Model.SortColumn == "cycle")">Cycle</option>
                                </select>

                                <select name="SortDir" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="asc"  selected="@(!Model.Desc)">Asc</option>
                                    <option value="desc" selected="@(Model.Desc)">Desc</option>
                                </select>

                                <button type="submit" class="btn btn-sm btn-primary"><i class="bx bx-search"></i></button>
                            </form>
                        </div>
                    </div>

                    <div class="ec-card-body">

                        <div class="text-center py-5 @(feeHeads.Count > 0 ? "d-none" : "")" id="feeHeadEmptyState">
                            <div class="ec-avatar mx-auto mb-3">
                                <i class="bx bx-search"></i>
                            </div>

                            <h6 class="ec-profile-title mb-1">
                                No fee heads found
                            </h6>

                            <p class="ec-profile-subtitle mb-0">
                                Try changing search or filter.
                            </p>
                        </div>

                        @foreach (var item in feeHeads)
                        {
                            <div class="fee-head-row">

                                <div class="row align-items-center g-3">
                                    <div class="col-12 col-md-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="fee-head-icon">
                                                <i class="bx bx-rupee"></i>
                                            </span>

                                            <div>
                                                <div class="fee-head-name">
                                                    @item.FeeHeadName
                                                </div>

                                                <small class="text-muted">
                                                    @item.FeeGroup
                                                    <span class="badge bg-label-secondary ms-1">@item.CollectionPoint</span>
                                                    @if (item.IsRefundable)
                                                    {
                                                        <span class="badge bg-label-info ms-1">Refundable</span>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-2">
                                        <span class="ec-detail-label">Cycle</span>
                                        <span class="ec-detail-value">@item.Frequency</span>
                                    </div>

                                    <div class="col-6 col-md-2">
                                        <span class="ec-detail-label">Amount</span>
                                        <span class="ec-detail-value">₹@item.DefaultAmount.ToString("N2")</span>
                                    </div>

                                    <div class="col-6 col-md-2">
                                        <span class="ec-detail-label">Type</span>

                                        <div class="ec-pill-wrap">
                                            <span class="ec-pill">@item.FeeType</span>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-2 text-md-end">
                                        <div class="fee-row-actions">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary fee-action-btn edit-fee-head"
                                                    data-id="@item.FeeHeadId">
                                                <i class="bx bx-edit"></i>
                                            </button>

                                            <form asp-action="DeleteFeeHead"
                                                  asp-controller="SchoolSettings"
                                                  method="post"
                                                  class="d-inline"
                                                  data-ec-confirm="Delete this fee head?"
                                                  data-ec-confirm-name="@item.FeeHeadName"
                                                  data-ec-confirm-ok="Delete fee head">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@item.FeeHeadId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger fee-action-btn">
                                                    <i class="bx bx-trash"></i>
                                                </button>

                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>

                    <div class="ec-card-header border-top">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                            <div class="d-flex align-items-center gap-2 text-muted" style="font-size:.81rem">
                                <partial name="_PageSize" model="Model" view-data='@(new ViewDataDictionary(ViewData) { { "FormId", "feeHeadFilterForm" } })' />
                                @if (Model.TotalCount > 0)
                                {
                                    <span class="ms-1">Showing @Model.FirstRow–@Model.LastRow of @Model.TotalCount fee heads</span>
                                }
                                else
                                {
                                    <span class="ms-1">No fee heads</span>
                                }
                            </div>

                            <partial name="_Pager" model="Model" />
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

@section PageScripts {
    <script>
        $(document).ready(function () {

            // Search / cycle filter / sort are now SERVER-SIDE (the filter <form>
            // above submits back to the FeeHead action) — no client-side row filtering.

            function resetFeeHeadForm() {
                $('#FeeHeadId').val('0');
                $('#FeeHeadName').val('');
                $('#Frequency').val('');
                $('#DefaultAmount').val('');
                $('#FeeGroup').val('Academic');
                $('#CollectionPoint').val('Recurring');
                $('#IsRefundable').prop('checked', false);
                $('input[name="FeeType"]').prop('checked', false);
                $('#feeHeadFormTitle').text('Create Fee Head');
                $('#cancelEditButton').addClass('d-none');
            }

            $('#feeHeadForm').on('submit', function (e) {
                let feeHeadName = $('#FeeHeadName').val().trim();
                let frequency = $('#Frequency').val();
                let feeType = $('input[name="FeeType"]:checked').val();

                if (!feeHeadName) {
                    e.preventDefault();
                    ecToast('error', 'Please enter fee head name.');
                    $('#FeeHeadName').focus();
                    return false;
                }

                if (!frequency) {
                    e.preventDefault();
                    ecToast('error', 'Please select billing cycle.');
                    $('#Frequency').focus();
                    return false;
                }

                if (!feeType) {
                    e.preventDefault();
                    ecToast('error', 'Please select fee type.');
                    return false;
                }
            });

            $(document).on('click', '.edit-fee-head', function () {
                let id = $(this).data('id');

                $.get('/ERP/SchoolSettings/GetFeeHeadById?id=' + id, function (response) {
                    if (response.success) {
                        $('#FeeHeadId').val(response.data.feeHeadId);
                        $('#FeeHeadName').val(response.data.feeHeadName);
                        $('#Frequency').val(response.data.frequency);
                        $('#DefaultAmount').val(response.data.defaultAmount);
                        $('#FeeGroup').val(response.data.feeGroup);
                        $('#CollectionPoint').val(response.data.collectionPoint || 'Recurring');
                        $('#IsRefundable').prop('checked', !!response.data.isRefundable);

                        $('input[name="FeeType"][value="' + response.data.feeType + '"]').prop('checked', true);

                        $('#feeHeadFormTitle').text('Edit Fee Head');
                        $('#cancelEditButton').removeClass('d-none');

                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                    } else {
                        ecToast('error', response.message);
                    }
                });
            });

            $('#cancelEditButton').on('click', function () {
                resetFeeHeadForm();
            });
        });
    </script>
}