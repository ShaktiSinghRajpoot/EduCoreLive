@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model EduCoreDataAccessLayer.Models.StaffMasters
@{
    ViewData["Title"] = "Departments & Designations";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var deptNames = Model.Departments.Where(d => d.IsActive).Select(d => d.Name).ToList();
    var designations = Model.Designations
        .OrderBy(d => d.DefaultDepartment)
        .ThenBy(d => d.Name)
        .ToList();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/SchoolSettings/StaffMasters.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content sm-page">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-cog fs-4"></i></div>
          <div>
            <h4 class="ec-page-title mb-0">Departments &amp; Designations</h4>
            <div class="text-muted" style="font-size:.8rem">Reference lists used when adding staff</div>
          </div>
        </div>
        <a class="btn btn-outline-secondary d-flex align-items-center gap-1" asp-area="ERP" asp-controller="Staff" asp-action="StaffList">
          <i class="bx bx-group"></i><span>Staff Directory</span>
        </a>
      </div>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
      <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabDesig" type="button">Designations</button></li>
      <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDept" type="button">Departments</button></li>
    </ul>

    <div class="tab-content">

      <!-- Designations -->
      <div class="tab-pane fade show active" id="tabDesig">
        <div class="d-flex justify-content-end mb-2">
          <button class="btn btn-primary px-3" id="addDesigBtn"><i class="bx bx-plus me-1"></i>Add Designation</button>
        </div>
        <div class="sm-card p-2 p-lg-3">
          <table class="table align-middle mb-0">
            <thead><tr><th>Designation</th><th>Department</th><th>Staff Type</th><th></th></tr></thead>
            <tbody>
            @if (!designations.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">No designations yet.</td></tr> }
            @foreach (var d in designations)
            {
              <tr>
                <td class="fw-bold">@d.Name @(d.IsActive ? "" : Html.Raw("<span class='sm-off ms-1'>inactive</span>"))</td>
                <td>@(string.IsNullOrWhiteSpace(d.DefaultDepartment) ? "—" : d.DefaultDepartment)</td>
                <td><span class="sm-type">@d.StaffType</span></td>
                <td class="text-end">
                  <button class="btn btn-sm btn-outline-secondary rounded-circle editDesig"
                          data-id="@d.DesignationId" data-name="@d.Name" data-dept="@d.DefaultDepartment"><i class="bx bx-edit"></i></button>
                  <button class="btn btn-sm btn-outline-secondary rounded-circle toggleM" data-kind="Designation" data-id="@d.DesignationId"><i class="bx bx-power-off"></i></button>
                  <button class="btn btn-sm btn-outline-danger rounded-circle delM" data-kind="Designation" data-id="@d.DesignationId" data-name="@d.Name"><i class="bx bx-trash"></i></button>
                </td>
              </tr>
            }
            </tbody>
          </table>
        </div>
      </div>

      <!-- Departments -->
      <div class="tab-pane fade" id="tabDept">
        <div class="d-flex justify-content-end mb-2">
          <button class="btn btn-primary px-3" id="addDeptBtn"><i class="bx bx-plus me-1"></i>Add Department</button>
        </div>
        <div class="sm-card p-2 p-lg-3">
          <table class="table align-middle mb-0">
            <thead><tr><th>Department</th><th></th></tr></thead>
            <tbody>
            @if (!Model.Departments.Any()) { <tr><td colspan="2" class="text-center text-muted py-4">No departments yet.</td></tr> }
            @foreach (var d in Model.Departments)
            {
              <tr>
                <td class="fw-bold">@d.Name @(d.IsActive ? "" : Html.Raw("<span class='sm-off ms-1'>inactive</span>"))</td>
                <td class="text-end">
                  <button class="btn btn-sm btn-outline-secondary rounded-circle editDept"
                          data-id="@d.DepartmentId" data-name="@d.Name"><i class="bx bx-edit"></i></button>
                  <button class="btn btn-sm btn-outline-secondary rounded-circle toggleM" data-kind="Department" data-id="@d.DepartmentId"><i class="bx bx-power-off"></i></button>
                  <button class="btn btn-sm btn-outline-danger rounded-circle delM" data-kind="Department" data-id="@d.DepartmentId" data-name="@d.Name"><i class="bx bx-trash"></i></button>
                </td>
              </tr>
            }
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Designation modal -->
<div class="modal fade" id="desigModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:18px">
      <div class="modal-header"><h5 class="modal-title" id="desigTitle">Add Designation</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" id="dgId" value="0">
        <div class="row g-3">
          <div class="col-12"><label class="form-label fw-bold">1. Department</label>
            <select id="dgDept" class="form-select"><option value="">— Any department —</option>
              @foreach (var n in deptNames) { <option value="@n">@n</option> }
            </select>
            <div class="text-muted small mt-1">Staff type is set automatically from the department.</div>
          </div>
          <div class="col-12"><label class="form-label fw-bold">2. Designation Name</label>
            <input id="dgName" class="form-control" placeholder="e.g. Hostel Warden">
          </div>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveDesigBtn">Save</button></div>
    </div>
  </div>
</div>

<!-- Department modal -->
<div class="modal fade" id="deptModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:18px">
      <div class="modal-header"><h5 class="modal-title" id="deptTitle">Add Department</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" id="dpId" value="0">
        <label class="form-label fw-bold">Name</label>
        <input id="dpName" class="form-control" placeholder="e.g. Examination Cell">
      </div>
      <div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveDeptBtn">Save</button></div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
$(function(){
  'use strict';
  var CSRF = $('input[name="__RequestVerificationToken"]').val();
  var URL = { saveDept:'@Url.Action("SaveDepartment")', saveDesig:'@Url.Action("SaveDesignation")',
              del:'@Url.Action("DeleteMaster")', toggle:'@Url.Action("ToggleMaster")' };
  function notify(t,m){ if(typeof toastr!=='undefined') toastr[t](m); }
  function postJson(url,data){ return $.ajax({url:url,type:'POST',contentType:'application/json',headers:{'RequestVerificationToken':CSRF},data:JSON.stringify(data)}); }
  function postForm(url,data){ data.__RequestVerificationToken=CSRF; return $.post(url,data); }
  function reload(){ setTimeout(function(){ location.reload(); }, 600); }

  // Staff Type is derived silently from the department (no manual field).
  function deptToType(dept){
    var d = (dept||'').toLowerCase();
    if (/academic|teaching|sport/.test(d)) return 'Teaching';
    if (/transport/.test(d)) return 'Transport';
    if (/housekeep|security|maintenance|cleaning|support/.test(d)) return 'Support';
    return 'Non-Teaching';
  }

  // ── Designation add / edit / save ──
  $('#addDesigBtn').on('click', function(){
    $('#desigTitle').text('Add Designation');
    $('#dgId').val(0); $('#dgName').val(''); $('#dgDept').val('');
    new bootstrap.Modal('#desigModal').show();
  });
  $('.editDesig').on('click', function(){
    var d = $(this);
    $('#desigTitle').text('Edit Designation');
    $('#dgId').val(d.data('id')); $('#dgName').val(d.data('name')); $('#dgDept').val(d.data('dept')||'');
    new bootstrap.Modal('#desigModal').show();
  });
  $('#saveDesigBtn').on('click', function(){
    var name = $('#dgName').val().trim(); if(!name){ notify('warning','Enter a designation name.'); return; }
    var dept = $('#dgDept').val();
    postJson(URL.saveDesig, { designationId:Number($('#dgId').val())||0, name:name, staffType:deptToType(dept),
        defaultDepartment:dept||null })
      .done(function(res){ notify(res.success?'success':'error', res.message); if(res.success) reload(); });
  });

  // ── Department add / edit / save ──
  $('#addDeptBtn').on('click', function(){
    $('#deptTitle').text('Add Department'); $('#dpId').val(0); $('#dpName').val('');
    new bootstrap.Modal('#deptModal').show();
  });
  $('.editDept').on('click', function(){
    var d = $(this);
    $('#deptTitle').text('Edit Department'); $('#dpId').val(d.data('id')); $('#dpName').val(d.data('name'));
    new bootstrap.Modal('#deptModal').show();
  });
  $('#saveDeptBtn').on('click', function(){
    var name = $('#dpName').val().trim(); if(!name){ notify('warning','Enter a department name.'); return; }
    postJson(URL.saveDept, { departmentId:Number($('#dpId').val())||0, name:name })
      .done(function(res){ notify(res.success?'success':'error', res.message); if(res.success) reload(); });
  });

  // ── Toggle active / delete (shared) ──
  $('.toggleM').on('click', function(){
    postForm(URL.toggle, { kind:$(this).data('kind'), id:$(this).data('id') })
      .done(function(res){ notify(res.success?'success':'error', res.message); if(res.success) reload(); });
  });
  $('.delM').on('click', function(){
    var d = $(this); if(!confirm('Delete "'+d.data('name')+'"?')) return;
    postForm(URL.del, { kind:d.data('kind'), id:d.data('id') })
      .done(function(res){ notify(res.success?'success':'error', res.message); if(res.success) reload(); });
  });

  if(typeof toastr!=='undefined') toastr.options={closeButton:true,progressBar:true,positionClass:'toast-top-right',timeOut:3500};
});
</script>
}
