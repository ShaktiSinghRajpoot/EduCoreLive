@{
    ViewData["Title"] = "Smart Bell";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/SchoolSettings/SmartBell.css" asp-append-version="true" />
}

<div class="ec-page-shell sb-shell" id="sbShell">
  <div class="ec-page-content">

    <!-- Header -->
    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
          <div class="ec-page-title-wrap d-flex align-items-center gap-2">
            <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
              <i class="bx bx-bell fs-4"></i>
            </div>
            <div>
              <h4 class="ec-page-title mb-1">Smart Bell</h4>
              <div class="ec-page-subtitle">Live period display — auto-rings the bell at every transition</div>
            </div>
          </div>
          <div class="sb-topbar">
            <div class="sb-clock" id="sbClock">--:--:--<small id="sbDate"></small></div>
            <button class="sb-btn" id="sbBellBtn"><i class="bx bx-bell-off"></i><span>Enable Bell</span></button>
            <button class="sb-btn" id="sbFsBtn" title="Fullscreen"><i class="bx bx-fullscreen"></i></button>
          </div>
        </div>
      </div>
    </div>

    <!-- Live state -->
    <div id="sbLive">
      <div class="row g-3 mb-3">
        <!-- NOW -->
        <div class="col-12 col-lg-8">
          <div class="sb-hero is-off" id="sbHero">
            <div class="row align-items-center g-3">
              <div class="col-12 col-md-7">
                <div class="sb-eyebrow" id="sbNowEyebrow">Now</div>
                <div class="sb-now-name" id="sbNowName">—</div>
                <div class="d-flex align-items-center gap-2 mt-1">
                  <span class="sb-type class d-none" id="sbNowType">Class</span>
                  <span class="sb-now-range" id="sbNowRange"></span>
                </div>
                <div class="sb-prog"><div class="sb-prog-fill" id="sbProg" style="width:0%"></div></div>
              </div>
              <div class="col-12 col-md-5">
                <div class="sb-count" id="sbCount">
                  <div class="sb-count-num" id="sbCountNum">--:--</div>
                  <div class="sb-count-lbl" id="sbCountLbl">to next bell</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- NEXT -->
        <div class="col-12 col-lg-4">
          <div class="sb-next">
            <div class="sb-next-ic"><i class="bx bx-chevrons-right"></i></div>
            <div class="flex-grow-1">
              <div class="sb-eyebrow">Up next</div>
              <div class="sb-next-name" id="sbNextName">—</div>
              <div class="sb-next-meta" id="sbNextMeta">—</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Day at a glance -->
      <div class="ec-card mb-0">
        <div class="ec-card-header">
          <div class="ec-section-title-wrap">
            <span class="ec-section-icon"><i class="bx bx-time"></i></span>
            <div>
              <div class="ec-section-title">Today's Schedule</div>
              <div class="ec-section-subtitle" id="sbSummary">—</div>
            </div>
          </div>
        </div>
        <div class="ec-card-body pt-2">
          <div class="sb-strip mb-2" id="sbStrip"></div>
          <div class="sb-legend">
            <span><span class="sb-l-dot sb-l-class"></span>Class</span>
            <span><span class="sb-l-dot sb-l-break"></span>Break</span>
            <span><span class="sb-l-dot sb-l-lunch"></span>Lunch</span>
            <span class="ms-auto" id="sbNote"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Off / empty state -->
    <div class="ec-card mb-0 d-none" id="sbOffCard">
      <div class="ec-card-body">
        <div class="sb-off">
          <div class="sb-off-ic"><i class="bx bx-bell-off" id="sbOffIcon"></i></div>
          <div class="sb-off-title" id="sbOffTitle">No schedule</div>
          <p class="sb-off-sub mb-0" id="sbOffSub"></p>
        </div>
      </div>
    </div>

  </div>
</div>

@section PageScripts {
<script>
(function(){
'use strict';

var seed=@Html.Raw(ViewBag.PeriodJson ?? "[]");
var PERIOD_URL='@Url.Action("PeriodStructure","SchoolSettings",new{area="ERP"})';

function toMin(t){ if(!t) return 0; var p=String(t).split(':'); return parseInt(p[0],10)*60+parseInt(p[1],10); }
function two(n){ return (n<10?'0':'')+n; }
function fmt12(t){ if(!t) return '—'; var p=String(t).split(':'),h=parseInt(p[0],10),m=p[1]; var ap=h>=12?'PM':'AM'; var hh=h%12||12; return hh+':'+m+' '+ap; }
function typeIcon(t){ return {'class':'bx-book','break':'bx-coffee','lunch':'bx-restaurant'}[t]||'bx-book'; }
function typeLabel(t){ return {'class':'Class','break':'Break','lunch':'Lunch'}[t]||'Class'; }
function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
function toast(t,m){ if(typeof toastr!=='undefined') toastr[t](m); }
function el(id){ return document.getElementById(id); }

/* Periods sorted chronologically; each carries start/end in minutes. */
var PERIODS=(seed||[]).map(function(p){
  return {name:p.name, type:(p.type||'class'), start:p.start, end:p.end, s:toMin(p.start), e:toMin(p.end)};
}).sort(function(a,b){ return a.s-b.s; });

/* Boundaries (seconds since midnight) where a bell should ring: every start and
   end. Each boundary knows the period that STARTS there (for the ring pattern). */
var BOUNDARIES=(function(){
  var map={};
  PERIODS.forEach(function(p){
    map[p.s]=map[p.s]||{sec:p.s*60, starts:null, ends:null};
    map[p.e]=map[p.e]||{sec:p.e*60, starts:null, ends:null};
    map[p.s].starts=p;
    map[p.e].ends=p;
  });
  return Object.keys(map).map(function(k){ return map[k]; }).sort(function(a,b){ return a.sec-b.sec; });
})();

/* ---------------- bell audio (Web Audio, no asset needed) ---------------- */
var audioCtx=null, armed=false, prevSec=null;

function ensureAudio(){
  if(!audioCtx){
    var AC=window.AudioContext||window.webkitAudioContext;
    if(AC) audioCtx=new AC();
  }
  if(audioCtx && audioCtx.state==='suspended') audioCtx.resume();
  return audioCtx;
}
function ding(at,dur){
  var o=audioCtx.createOscillator(), g=audioCtx.createGain();
  o.type='sine'; o.frequency.setValueAtTime(880,at); o.frequency.setValueAtTime(660,at+0.06);
  o.connect(g); g.connect(audioCtx.destination);
  g.gain.setValueAtTime(0.0001,at);
  g.gain.exponentialRampToValueAtTime(0.45,at+0.02);
  g.gain.exponentialRampToValueAtTime(0.0001,at+dur);
  o.start(at); o.stop(at+dur+0.03);
}
/* pattern: class=1, break=2, lunch=3, day-end=long single */
function ring(boundary){
  if(!armed || !ensureAudio()) return;
  var count=1, longEnd=false;
  if(boundary.starts){ count={'class':1,'break':2,'lunch':3}[boundary.starts.type]||1; }
  else { longEnd=true; }                 // nothing starts here → end of day
  var t=audioCtx.currentTime+0.02;
  if(longEnd){ ding(t,1.1); }
  else { for(var i=0;i<count;i++){ ding(t,0.35); t+=0.5; } }
  flash();
}
function flash(){
  var h=el('sbHero'); h.classList.remove('sb-flash'); void h.offsetWidth; h.classList.add('sb-flash');
}

/* ---------------- render ---------------- */
function setOff(icon,title,sub){
  el('sbLive').classList.add('d-none');
  el('sbOffCard').classList.remove('d-none');
  el('sbOffIcon').className='bx '+icon;
  el('sbOffTitle').textContent=title;
  el('sbOffSub').innerHTML=sub;
}
function setLive(){ el('sbOffCard').classList.add('d-none'); el('sbLive').classList.remove('d-none'); }

function renderStrip(nowMin){
  var span=(PERIODS[PERIODS.length-1].e-PERIODS[0].s)||1;
  el('sbStrip').innerHTML=PERIODS.map(function(p){
    var w=Math.max(p.e-p.s,0)/span*100;
    var state=(nowMin>=p.s && nowMin<p.e)?'now':(nowMin>=p.e?'done':'');
    return '<div class="sb-seg '+p.type+' '+state+'" style="flex:'+w+' 1 0;" title="'+esc(p.name)+' '+p.start+'–'+p.end+'">'+(w>6?esc(p.name):'')+'</div>';
  }).join('');
}

function tick(){
  var now=new Date();
  el('sbClock').innerHTML=two(now.getHours())+':'+two(now.getMinutes())+':'+two(now.getSeconds())
    +'<small>'+now.toLocaleDateString(undefined,{weekday:'short',day:'numeric',month:'short'})+'</small>';

  if(!PERIODS.length){
    setOff('bx-bell-off','No schedule configured',
      'Set the daily periods in <a href="'+PERIOD_URL+'">Period Structure</a> first.');
    return;
  }

  var nowSec=now.getHours()*3600+now.getMinutes()*60+now.getSeconds();
  var nowMin=now.getHours()*60+now.getMinutes();

  /* Ring for any boundary we just crossed (works even if a tick was missed). */
  if(prevSec!==null){
    BOUNDARIES.forEach(function(b){ if(b.sec>prevSec && b.sec<=nowSec) ring(b); });
  }
  prevSec=nowSec;

  /* Sunday — non-working day. */
  if(now.getDay()===0){
    setOff('bx-calendar-x','Sunday — no bells today','The Smart Bell stays silent on Sundays.');
    return;
  }

  var dayStart=PERIODS[0].s, dayEnd=PERIODS[PERIODS.length-1].e;
  if(nowMin<dayStart){
    setLive();
    showBetween('Before school', PERIODS[0], dayStart*60-nowSec, nowMin);
    return;
  }
  if(nowMin>=dayEnd){
    setOff('bx-moon','School day has ended','See you tomorrow. The last bell rang at '+fmt12(PERIODS[PERIODS.length-1].end)+'.');
    return;
  }

  setLive();
  var cur=null, next=null;
  for(var i=0;i<PERIODS.length;i++){
    if(nowMin>=PERIODS[i].s && nowMin<PERIODS[i].e){ cur=PERIODS[i]; next=PERIODS[i+1]||null; break; }
    if(nowMin<PERIODS[i].s){ next=PERIODS[i]; break; }
  }

  if(cur){ showCurrent(cur,next,nowSec); }
  else if(next){ showBetween('Changeover', next, next.s*60-nowSec, nowMin); }  /* gap between periods */

  renderStrip(nowMin);
  el('sbSummary').textContent=PERIODS.length+' periods · '+fmt12(PERIODS[0].start)+' – '+fmt12(PERIODS[PERIODS.length-1].end);
}

function countdownText(sec){ var m=Math.floor(sec/60), s=sec%60; return two(m)+':'+two(s); }

function showCurrent(cur,next,nowSec){
  var hero=el('sbHero');
  hero.className='sb-hero is-'+cur.type;
  el('sbNowEyebrow').textContent='Now — '+typeLabel(cur.type);
  el('sbNowName').textContent=cur.name;
  var ty=el('sbNowType'); ty.className='sb-type '+cur.type; ty.textContent=typeLabel(cur.type); ty.classList.remove('d-none');
  el('sbNowRange').textContent=fmt12(cur.start)+' – '+fmt12(cur.end);

  var toEnd=cur.e*60-nowSec;
  el('sbCountNum').textContent=countdownText(toEnd);
  el('sbCountLbl').textContent='to next bell';
  el('sbCount').classList.toggle('warn', toEnd<=60);

  var frac=(nowSec-cur.s*60)/((cur.e-cur.s)*60||1);
  el('sbProg').style.width=Math.min(Math.max(frac*100,0),100)+'%';

  if(next){ el('sbNextName').textContent=next.name; el('sbNextMeta').innerHTML='<i class="bx '+typeIcon(next.type)+'"></i> '+fmt12(next.start)+' – '+fmt12(next.end); }
  else { el('sbNextName').textContent='End of day'; el('sbNextMeta').textContent='After '+fmt12(cur.end); }
}

function showBetween(label,upcoming,toStartSec,nowMin){
  var hero=el('sbHero');
  hero.className='sb-hero is-off';
  el('sbNowEyebrow').textContent=label;
  el('sbNowName').textContent='Free time';
  el('sbNowType').classList.add('d-none');
  el('sbNowRange').textContent='Next period starts '+fmt12(upcoming.start);
  el('sbProg').style.width='0%';

  el('sbCountNum').textContent=countdownText(Math.max(toStartSec,0));
  el('sbCountLbl').textContent='to '+esc(upcoming.name);
  el('sbCount').classList.toggle('warn', toStartSec<=60);

  el('sbNextName').textContent=upcoming.name;
  el('sbNextMeta').innerHTML='<i class="bx '+typeIcon(upcoming.type)+'"></i> '+fmt12(upcoming.start)+' – '+fmt12(upcoming.end);
  renderStrip(nowMin);
}

/* ---------------- controls ---------------- */
el('sbBellBtn').addEventListener('click',function(){
  armed=!armed;
  if(armed){
    ensureAudio();
    ding(audioCtx.currentTime+0.02,0.35);   /* confirm chime + satisfies autoplay gesture */
    this.classList.add('armed');
    this.innerHTML='<i class="bx bx-bell"></i><span>Bell On</span>';
    toast('success','Bell enabled — it will ring at each transition.');
  } else {
    this.classList.remove('armed');
    this.innerHTML='<i class="bx bx-bell-off"></i><span>Enable Bell</span>';
    toast('info','Bell muted.');
  }
});

el('sbFsBtn').addEventListener('click',function(){
  var shell=el('sbShell');
  if(!document.fullscreenElement){ (shell.requestFullscreen||shell.webkitRequestFullscreen||function(){}).call(shell); }
  else { document.exitFullscreen(); }
});

/* ---------------- run ---------------- */
tick();
setInterval(tick,1000);

})();
</script>
}
