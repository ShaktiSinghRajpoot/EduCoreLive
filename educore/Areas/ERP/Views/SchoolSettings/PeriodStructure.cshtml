@{
    ViewData["Title"] = "Period Structure";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/SchoolSettings/PeriodStructure.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <!-- Header -->
    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-time fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Period Structure</h4>
            <div class="ec-page-subtitle">Define the daily bell schedule — the timetable grid is built from this</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="ps-card">
          <div class="ps-card-ic bg-label-primary" style="color:var(--ec-primary);"><i class="bx bx-list-ol"></i></div>
          <div><div class="ps-card-val" id="cTeaching">—</div><div class="ps-card-lbl">Teaching Periods</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="ps-card">
          <div class="ps-card-ic bg-label-secondary" style="color:#6c757d;"><i class="bx bx-coffee"></i></div>
          <div><div class="ps-card-val" id="cBreaks">—</div><div class="ps-card-lbl">Non-Teaching</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="ps-card">
          <div class="ps-card-ic bg-label-success text-success"><i class="bx bx-sun"></i></div>
          <div><div class="ps-card-val" id="cStart">—</div><div class="ps-card-lbl">Day Starts</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="ps-card">
          <div class="ps-card-ic bg-label-info text-info"><i class="bx bx-moon"></i></div>
          <div><div class="ps-card-val" id="cEnd">—</div><div class="ps-card-lbl">Day Ends</div></div>
        </div>
      </div>
    </div>

    <!-- Main -->
    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <!-- Which schedule: the default (every day without its own) or one weekday's -->
        <div class="d-flex flex-wrap gap-2 mb-3" id="dayTabs"></div>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 mb-3 d-none" id="modeBar">
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" id="modeDefault">Use default</button>
            <button type="button" class="btn btn-outline-primary" id="modeCustom">Custom schedule</button>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCopyDefault"><i class="bx bx-copy me-1"></i>Copy from default</button>
          <span class="ps-note mb-0" id="modeHint"></span>
        </div>

        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
          <div class="ec-section-title-wrap">
            <span class="ec-section-icon"><i class="bx bx-time"></i></span>
            <div>
              <div class="ec-section-title" id="schedTitle">Default Schedule</div>
              <div class="ec-section-subtitle" id="resultText">Loading…</div>
            </div>
          </div>
          <div class="d-flex flex-column flex-sm-row gap-2">
            <button class="btn btn-primary" id="btnAdd"><i class="bx bx-plus me-1"></i>Add Period</button>
          </div>
        </div>

        <!-- day at a glance -->
        <div class="ps-glance mb-2" id="glance"></div>
        <div class="ps-legend">
          <span><span class="ps-l-dot ps-g-class"></span>Class</span>
          <span><span class="ps-l-dot ps-g-assembly"></span>Assembly</span>
          <span><span class="ps-l-dot ps-g-break"></span>Break</span>
          <span><span class="ps-l-dot ps-g-lunch"></span>Lunch</span>
          <span><span class="ps-l-dot ps-g-diary"></span>Diary</span>
          <span class="ms-auto" id="totalDur"></span>
        </div>
      </div>

      <div class="ec-card-body pt-2">
        <div class="ps-warn d-none mb-3" id="warnBox"><i class="bx bx-error-circle"></i><span id="warnTxt"></span></div>

        <div class="ps-tl" id="tlList"></div>

        <p class="ps-note mt-3 mb-0">
          <i class="bx bx-info-circle"></i> These schedules feed the <strong>Timetable</strong> grid and the <strong>Smart Bell</strong>. Every day runs on the default unless it has a custom schedule. Breaks &amp; lunch show as non-teaching bars.
        </p>
      </div>
    </div>

    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-end mt-3">
      <button class="btn btn-primary px-4" id="btnSave"><i class="bx bx-save me-1"></i>Save Schedule</button>
    </div>

  </div>
</div>

<!-- Period modal -->
<div class="modal fade" id="periodModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:0;border-radius:20px;overflow:hidden;">
      <div class="ec-card-header d-flex align-items-center justify-content-between p-3 p-lg-4">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-time"></i></span>
          <div>
            <div class="ec-section-title" id="pmTitle">Add Period</div>
            <div class="ec-section-subtitle">Part of the daily bell schedule</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="ec-card-body p-3 p-lg-4">
        <div class="row g-3">
          <div class="col-12 col-sm-6">
            <label class="form-label ps-modal-lbl">Type</label>
            <select class="form-select" id="mType">
              <option value="class">Class (teaching)</option>
              <option value="assembly">Assembly / Prayer</option>
              <option value="break">Break</option>
              <option value="lunch">Lunch</option>
              <option value="diary">Diary time</option>
            </select>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label ps-modal-lbl">Label</label>
            <input type="text" class="form-control" id="mName" maxlength="50" placeholder="e.g. P1 / Break">
          </div>
          <div class="col-6">
            <label class="form-label ps-modal-lbl">Start Time</label>
            <input type="time" class="form-control" id="mStart">
          </div>
          <div class="col-6">
            <label class="form-label ps-modal-lbl">End Time</label>
            <input type="time" class="form-control" id="mEnd">
          </div>
        </div>
        <div class="ps-warn mt-3 d-none" id="mWarn"><i class="bx bx-error"></i><span id="mWarnTxt"></span></div>
      </div>
      <div class="ec-card-body pt-0 p-3 p-lg-4 d-flex flex-column flex-sm-row justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary px-4" id="pmSave"><i class="bx bx-check me-1"></i>Save Period</button>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
(function(){
'use strict';

var SAVE_URL='@Url.Action("SavePeriodStructure","SchoolSettings",new{area="ERP"})';
var DEFAULT_URL='@Url.Action("UseDefaultPeriodSchedule","SchoolSettings",new{area="ERP"})';
var seed=@Html.Raw(ViewBag.PeriodJson ?? "[]");
var weeklyOffs=@Html.Raw(ViewBag.WeeklyOffJson ?? "[0]");

var DAY_NAMES=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
var nextId=100, editId=null;

/* SAVED holds every schedule as the server has it: SAVED.d = the default,
   SAVED[1] = Monday's own schedule, and so on. A weekday with no key runs on
   the default. PERIODS is the working copy of the schedule on screen. */
var SAVED={ d: [] };
(seed||[]).forEach(function(p){
  var k=(p.day===null || p.day===undefined) ? 'd' : String(p.day);
  if(!SAVED[k]) SAVED[k]=[];
  SAVED[k].push({id:(p.id||++nextId), name:p.name, start:p.start, end:p.end, type:p.type||'class'});
});

var curKey='d';        /* 'd' = default, '0'..'6' = a weekday */
var custom=false;      /* is the weekday on screen using its own schedule? */
var dirty=false;
var PERIODS=[];

function copyList(list){ return (list||[]).map(function(r){ return {id:++nextId, name:r.name, start:r.start, end:r.end, type:r.type}; }); }
function rows(){ return PERIODS; }
function editable(){ return curKey==='d' || custom; }
function keyName(k){ return k==='d' ? 'Default' : DAY_NAMES[parseInt(k,10)]; }

function toMin(t){ if(!t) return 0; var p=t.split(':'); return parseInt(p[0],10)*60+parseInt(p[1],10); }
function dur(r){ return toMin(r.end)-toMin(r.start); }
function fmt12(t){ if(!t) return '—'; var p=t.split(':'),h=parseInt(p[0],10),m=p[1]; var ap=h>=12?'PM':'AM'; var hh=h%12||12; return hh+':'+m+' '+ap; }
function typeLabel(t){ return {class:'Class',assembly:'Assembly',break:'Break',lunch:'Lunch',diary:'Diary'}[t]||'Class'; }
function typeIcon(t){ return {class:'bx-book',assembly:'bx-group',break:'bx-coffee',lunch:'bx-restaurant',diary:'bx-notepad'}[t]||'bx-book'; }
// The glance bar has a colour per type; anything unknown is drawn as a class.
function typeKey(t){ return {class:1,assembly:1,break:1,lunch:1,diary:1}[t]?t:'class'; }

/* ---- day selector: Default + every weekday that is not a weekly off (Mon first) ---- */
function renderTabs(){
  var order=[1,2,3,4,5,6,0], html='';
  html+='<button type="button" class="btn btn-sm '+(curKey==='d'?'btn-primary':'btn-outline-primary')+' js-day" data-k="d">Default</button>';
  order.forEach(function(d){
    if(weeklyOffs.indexOf(d)>=0) return;
    var k=String(d), on=(curKey===k);
    html+='<button type="button" class="btn btn-sm '+(on?'btn-primary':'btn-outline-primary')+' js-day" data-k="'+k+'">'
        + DAY_NAMES[d].slice(0,3)
        + (SAVED[k] ? ' <span class="badge bg-label-warning ms-1">Custom</span>' : '')
        + '</button>';
  });
  document.getElementById('dayTabs').innerHTML=html;
  document.querySelectorAll('.js-day').forEach(function(b){
    b.addEventListener('click',function(){ switchDay(this.dataset.k); });
  });
}

function switchDay(k){
  if(k===curKey) return;
  if(!dirty){ openDay(k); return; }
  EC.confirm({ title:'Discard unsaved changes?', name:keyName(curKey)+' schedule',
               message:'Your edits to this schedule have not been saved.', okText:'Discard', danger:false })
    .then(function(ok){ if(ok) openDay(k); });
}

function openDay(k){
  curKey=k; dirty=false;
  custom = (k!=='d' && !!SAVED[k]);
  PERIODS = copyList(k==='d' ? SAVED.d : (SAVED[k] || SAVED.d));
  renderTabs(); render();
}

/* ---- Use default / Custom schedule for a weekday ---- */
function renderMode(){
  var bar=document.getElementById('modeBar');
  bar.classList.toggle('d-none', curKey==='d');
  document.getElementById('schedTitle').textContent = curKey==='d' ? 'Default Schedule' : keyName(curKey)+' Schedule';
  if(curKey==='d'){
    document.getElementById('modeHint').textContent='';
  } else {
    document.getElementById('modeDefault').className='btn '+(custom?'btn-outline-primary':'btn-primary');
    document.getElementById('modeCustom').className ='btn '+(custom?'btn-primary':'btn-outline-primary');
    document.getElementById('btnCopyDefault').classList.toggle('d-none', !custom);
    document.getElementById('modeHint').textContent = custom
      ? keyName(curKey)+' rings on its own schedule.'
      : keyName(curKey)+' runs on the default schedule. Choose "Custom schedule" to give it different periods.';
  }
  document.getElementById('btnAdd').disabled = !editable();
  document.getElementById('btnSave').disabled = !editable();
}

document.getElementById('modeCustom').addEventListener('click',function(){
  if(custom) return;
  /* start from a copy of the default; it is stored when the user saves */
  custom=true; dirty=true;
  PERIODS=copyList(SAVED.d);
  render();
  ecToast('info','Copied the default schedule. Edit it, then click Save Schedule.');
});

document.getElementById('modeDefault').addEventListener('click',function(){
  if(!custom) return;
  var k=curKey;
  if(!SAVED[k]){ custom=false; dirty=false; PERIODS=copyList(SAVED.d); render(); return; }   /* never saved */
  EC.confirm({ title:'Use the default schedule on '+keyName(k)+'?',
               message:keyName(k)+'’s own schedule is removed. Its timetable lessons move to the default period with the same name.',
               okText:'Use default', danger:false }).then(function(ok){
    if(!ok) return;
    var $btn=$('#modeDefault');
    EC.buttonBusy($btn,'Saving…');
    post(DEFAULT_URL,{ day: parseInt(k,10) })
      .done(function(res){
        if(res && res.success){
          delete SAVED[k];
          ecToast('success', res.message || 'Done.');
          openDay(k);
        } else ecToast('error',(res && res.message) || 'Could not change the schedule.');
      })
      .fail(function(xhr){ ecToast('error', EC.ajaxError(xhr, 'Save failed')); })
      .always(function(){ EC.buttonReset($btn); renderMode(); });
  });
});

document.getElementById('btnCopyDefault').addEventListener('click',function(){
  EC.confirm({ title:'Copy the default schedule?', name:keyName(curKey),
               message:'This replaces the periods on screen with the default ones. Nothing is stored until you save.',
               okText:'Copy', danger:false }).then(function(ok){
    if(!ok) return;
    PERIODS=copyList(SAVED.d); dirty=true; render();
  });
});

/* validate ordering: detect overlaps / negative durations */
function findIssue(){
  var list=rows();
  for(var i=0;i<list.length;i++){
    if(dur(list[i])<=0) return list[i].name+' has an invalid time (end before start).';
    if(i>0 && toMin(list[i].start)<toMin(list[i-1].end)) return list[i].name+' overlaps '+list[i-1].name+'.';
  }
  return null;
}

function updateCards(){
  var list=rows();
  document.getElementById('cTeaching').textContent=list.filter(function(r){return r.type==='class';}).length;
  document.getElementById('cBreaks').textContent=list.filter(function(r){return r.type!=='class';}).length;
  document.getElementById('cStart').textContent=list.length?fmt12(list[0].start):'—';
  document.getElementById('cEnd').textContent=list.length?fmt12(list[list.length-1].end):'—';
}

function renderGlance(){
  var list=rows(), g=document.getElementById('glance');
  var total=list.reduce(function(a,r){return a+Math.max(dur(r),0);},0)||1;
  g.innerHTML=list.map(function(r){
    var w=Math.max(dur(r),0)/total*100;
    var cls='ps-g-'+typeKey(r.type);
    return '<div class="ps-g-seg '+cls+'" style="flex:'+w+' 1 0;" title="'+EC.esc(r.name)+' · '+r.start+'–'+r.end+'">'+(w>5?EC.esc(r.name):'')+'</div>';
  }).join('');
  var hrs=Math.floor(total/60), mins=total%60;
  document.getElementById('totalDur').textContent='Total day: '+(hrs?hrs+'h ':'')+(mins?mins+'m':'');
}

function render(){
  var list=rows(), box=document.getElementById('tlList'), canEdit=editable();
  box.innerHTML=list.map(function(r,i){
    var d=dur(r);
    return '<div class="ps-item ps-t-'+typeKey(r.type)+'">'
      +'<div class="ps-time">'+r.start+'<small>'+r.end+'</small></div>'
      +'<div class="ps-line"><span class="ps-dot"></span></div>'
      +'<div class="ps-block">'
      +  '<div class="ps-blk-ic"><i class="bx '+typeIcon(r.type)+'"></i></div>'
      +  '<div class="ps-blk-info"><div class="ps-blk-name">'+EC.esc(r.name)+'</div>'
      +     '<div class="ps-blk-meta">'+fmt12(r.start)+' – '+fmt12(r.end)+'</div></div>'
      +  '<span class="ps-dur">'+(d>0?d+' min':'—')+'</span>'
      +  '<span class="ps-type '+typeKey(r.type)+'">'+typeLabel(r.type)+'</span>'
      +  (canEdit
          ? '<div class="ps-acts">'
            +  '<button class="ps-icon-btn js-edit" data-id="'+r.id+'"><i class="bx bx-edit-alt"></i></button>'
            +  '<button class="ps-icon-btn danger js-del" data-id="'+r.id+'"><i class="bx bx-trash"></i></button>'
            +'</div>'
          : '')
      +'</div>'
      +'</div>';
  }).join('');

  var issue=findIssue(), wb=document.getElementById('warnBox');
  if(issue){ document.getElementById('warnTxt').textContent=issue; wb.classList.remove('d-none'); }
  else wb.classList.add('d-none');

  document.getElementById('resultText').textContent=list.length+' periods · '+list.filter(function(r){return r.type==='class';}).length+' teaching'
    +(curKey!=='d' && !custom ? ' · from the default' : '');

  updateCards(); renderGlance(); renderMode(); bindRows();
}

function bindRows(){
  document.querySelectorAll('.js-edit').forEach(function(b){ b.addEventListener('click',function(){ openModal(parseInt(this.dataset.id,10)); }); });
  document.querySelectorAll('.js-del').forEach(function(b){ b.addEventListener('click',function(){ del(parseInt(this.dataset.id,10)); }); });
}

/* Periods are always in clock order (the server sorts by start time too), so
   there are no up/down buttons: to move a period, change its time. */
function del(id){
  var list=rows(), r=list.find(function(x){return x.id===id;});
  if(!r) return;
  EC.confirm({ title:'Remove from schedule?', name:r.name, okText:'Remove' }).then(function(ok){
    if(!ok) return;
    PERIODS=list.filter(function(x){return x.id!==id;});
    dirty=true;
    render(); ecToast('info','Period removed. Click Save Schedule to keep the change.');
  });
}

/* ---- modal ---- */
function openModal(id){
  if(!editable()) return;
  editId=id;
  var r=id?rows().find(function(x){return x.id===id;}):null;
  document.getElementById('pmTitle').textContent=r?'Edit Period':'Add Period';
  document.getElementById('mType').value=r?r.type:'class';
  document.getElementById('mName').value=r?r.name:'';
  document.getElementById('mStart').value=r?r.start:'';
  document.getElementById('mEnd').value=r?r.end:'';
  document.getElementById('mWarn').classList.add('d-none');
  new bootstrap.Modal(document.getElementById('periodModal')).show();
}
document.getElementById('btnAdd').addEventListener('click',function(){ openModal(null); });

document.getElementById('pmSave').addEventListener('click',function(){
  var name=document.getElementById('mName').value.trim();
  var start=document.getElementById('mStart').value, end=document.getElementById('mEnd').value;
  var type=document.getElementById('mType').value;
  if(!name){ ecToast('error','Enter a label.'); return; }
  if(!start||!end){ ecToast('error','Enter start and end time.'); return; }
  if(toMin(end)<=toMin(start)){
    document.getElementById('mWarnTxt').textContent='End time must be after start time.';
    document.getElementById('mWarn').classList.remove('d-none'); return;
  }
  var dup=rows().some(function(x){ return x.id!==editId && x.name.toLowerCase()===name.toLowerCase(); });
  if(dup){ ecToast('warning','A period called "'+name+'" already exists.'); return; }
  if(editId){
    var r=rows().find(function(x){return x.id===editId;});
    r.name=name; r.start=start; r.end=end; r.type=type;
    ecToast('success','Period updated.');
  } else {
    rows().push({id:++nextId,name:name,start:start,end:end,type:type});
    ecToast('success','Period added.');
  }
  dirty=true;
  /* keep chronological order */
  rows().sort(function(a,b){return toMin(a.start)-toMin(b.start);});
  bootstrap.Modal.getInstance(document.getElementById('periodModal')).hide();
  render();
});

function post(url,payload){
  var token=document.querySelector('input[name="__RequestVerificationToken"]');
  return $.ajax({
    url:         url,
    type:        'POST',
    contentType: 'application/json',
    headers:     { 'RequestVerificationToken': token ? token.value : '', 'X-Requested-With': 'XMLHttpRequest' },
    data:        JSON.stringify(payload)
  });
}

/* ---- save the schedule on screen (replace-all for that one schedule) ---- */
document.getElementById('btnSave').addEventListener('click',function(){
  if(!editable()) return;
  if(findIssue()){ ecToast('error','Fix the highlighted timing issue before saving.'); return; }
  if(!rows().length){ ecToast('error','Add at least one period. An empty schedule stops the bell.'); return; }
  var key=curKey, $btn=$(this);
  var payload={ day: key==='d' ? null : parseInt(key,10),
                periods: rows().map(function(r){ return {name:r.name,start:r.start,end:r.end,type:r.type}; }) };
  EC.buttonBusy($btn,'Saving…');
  post(SAVE_URL,payload)
  .done(function(res){
    if(res && res.success){
      SAVED[key]=copyList(PERIODS);
      dirty=false;
      renderTabs();
      ecToast('success', res.message || 'Schedule saved.');
    }
    else ecToast('error', (res && res.message) || 'Save failed.');
  })
  .fail(function(xhr){ ecToast('error', EC.ajaxError(xhr, 'Save failed')); })
  .always(function(){ EC.buttonReset($btn); renderMode(); });
});

/* Warn before leaving with edits that were never saved. */
window.addEventListener('beforeunload',function(e){
  if(dirty){ e.preventDefault(); e.returnValue=''; }
});

/* init */
openDay('d');

})();
</script>
}
