@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Student Attendance";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var classList = ViewBag.ClassList as List<SelectListItem> ?? new();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Attendance/StudentAttendance.css" asp-append-version="true" />
}

<div class="ec-page-shell att-page">
    <div class="ec-page-content">

        <!-- Title -->
        <div class="ec-page-header">
            <div class="ec-page-title-wrap d-flex align-items-start gap-3">
                <div class="ec-page-icon"><i class="bx bx-calendar-check"></i></div>
                <div>
                    <h4 class="ec-page-title mb-1">Student Attendance</h4>
                </div>
            </div>
        </div>

        <!-- Selector bar -->
        <div class="att-selector mb-3 mb-xl-4">
            <div class="row g-3 align-items-end">
                <div class="col-6 col-md-3">
                    <div class="att-field-label">CLASS</div>
                    <select class="form-select" id="filterClass">
                        <option value="">Select class</option>
                        @foreach (var c in classList)
                        {
                            <option value="@c.Text">@c.Text</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <div class="att-field-label">SECTION</div>
                    <select class="form-select" id="filterSection">
                        <option value="">Select section</option>
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <div class="att-field-label">DATE</div>
                    <input type="date" class="form-control" id="attendanceDate">
                </div>
            </div>
        </div>

        <!-- Roster -->
        <div class="ec-card">
            <div class="ec-card-body">
                <div class="att-head mb-3">
                    <div class="att-head-left">
                        <div class="ahd-title"><span id="dbDay">Day</span>, <span id="dbDate">Date</span></div>
                        <span class="db-status today" id="dbStatus"><span class="db-dot"></span>Today</span>
                    </div>
                    <div class="att-summary">
                        <div class="att-sum-item"><span class="att-sum-dot green"></span><span class="att-sum-num" id="sumPresent">0</span><span class="att-sum-txt">Present</span></div>
                        <div class="att-sum-item"><span class="att-sum-dot red"></span><span class="att-sum-num" id="sumAbsent">0</span><span class="att-sum-txt">Absent</span></div>
                        <div class="att-sum-item"><span class="att-sum-dot grey"></span><span class="att-sum-num" id="sumTotal">0</span><span class="att-sum-txt">Total</span></div>
                        <div class="att-sum-rate" id="sumRate">100%</div>
                    </div>
                </div>

                <!-- Holiday / weekly off / future date: the save proc refuses these days -->
                <div class="alert alert-warning py-2 small fw-semibold mb-3" id="dayNotice" style="display:none;"></div>

                <div class="att-list" id="list"></div>
            </div>
        </div>

        <!-- Sticky action bar (inside content → matches page width, never under the sidebar) -->
        <div class="att-bar">
            <!-- Why Save is disabled (not the class teacher, holiday, ...) -->
            <div class="small fw-semibold text-warning mb-2" id="saveNote" style="display:none;"><i class="bx bx-info-circle me-1"></i><span id="saveNoteText"></span></div>
            <div class="att-bar-inner">
                <div id="barLabel"><i class="bx bx-chalkboard"></i><span id="barLabelText"></span></div>
                <div class="att-bar-actions">
                    <button class="btn btn-att-outline" id="notifyBtn" style="display:none;">
                        <i class="bx bx-user-x"></i><span>Absent Students</span><span class="count-badge-dark" id="notifyCount">0</span>
                    </button>
                    <button class="btn btn-att-primary" id="saveBtn"><i class="bx bx-save"></i><span>Save<span class="d-none d-md-inline"> Attendance</span></span></button>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Absent Students modal -->
<div class="modal fade att-modal" id="notifyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1 d-flex align-items-center gap-2">
                        <i class="bx bx-user-x" style="color:var(--ec-danger);"></i>
                        Absent Students
                        <span id="modalAbsentCount" class="badge rounded-pill" style="background:var(--ec-danger);font-size:.7rem;">0</span>
                    </h5>
                    <small class="text-muted fw-semibold">Review absences and send WhatsApp notifications to parents.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">

                <!-- Section 1: Student list (leads the modal) -->
                <div class="p-3" style="border-bottom:1px solid var(--ec-border);">
                    <div class="att-field-label mb-2">ABSENT STUDENTS</div>
                    <div id="modalList" style="max-height:260px;overflow-y:auto;"></div>
                </div>

                <!-- Section 2: Message template (secondary) -->
                <div class="p-3">
                    <div class="att-field-label mb-2">
                        MESSAGE TEMPLATE
                        <span class="fw-normal text-lowercase ms-1">— {parent} {student} {class} {date}</span>
                    </div>
                    <textarea class="form-control" id="msgTemplate" rows="3" style="font-weight:600;resize:vertical;"></textarea>
                    <div class="mt-2" style="font-size:.74rem;font-weight:700;color:var(--ec-muted);">
                        <i class="bx bx-info-circle me-1"></i>Each parent receives a personalised message. Opens one WhatsApp chat per parent.
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-att-ghost px-4 py-2" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
$(document).ready(function () {


    var ROSTER_URL   = '@Url.Action("Roster",   "Attendance", new { area = "ERP" })';
    var SECTIONS_URL = '@Url.Action("Sections", "Attendance", new { area = "ERP" })';
    var SAVE_URL     = '@Url.Action("Save",     "Attendance", new { area = "ERP" })';

    // The roster is loaded from the server for the chosen class/section/date.
    // status[id] is present | absent | late | leave. Late and Leave come from the
    // stored mark and are kept as they are unless the teacher taps a button.
    let students = [];
    const status = {}, notified = {}, marked = {}, picked = {};   // picked = a status was tapped
    let touched = false; // true once teacher interacts with any toggle
    let canMark = true;  // false when Save would be refused (see cannotMarkWhy)
    let cannotMarkWhy = '';

    // Only the class teacher (or an admin) may save, and only on a school day that
    // is not in the future. The reason stays visible next to the Save button.
    function applyCanMark() {
        $('#saveBtn').prop('disabled', !canMark);
        $('#saveNoteText').text(cannotMarkWhy);
        $('#saveNote').toggle(!canMark && !!cannotMarkWhy);
    }

    // The day itself: future dates and School Calendar days off have no register.
    function dayBlockReason(res) {
        var v = $('#attendanceDate').val() || iso;
        if (v > iso) return 'This is a future date. Attendance can be marked only for today or earlier.';
        if (res && res.dayType === 'holiday')
            return 'This day is a school holiday' + (res.dayTitle ? ' (' + res.dayTitle + ')' : '') + '. No attendance is taken.';
        if (res && res.dayType === 'weekly_off')
            return 'This day is a weekly off' + (res.dayTitle ? ' (' + res.dayTitle + ')' : '') + '. No attendance is taken.';
        return '';
    }

    function initials(name) {
        return String(name || '').trim().split(/\s+/).map(function (w) { return w.charAt(0); }).slice(0, 2).join('').toUpperCase();
    }

    function updateSaveBtn() {
        if (touched) {
            $('#saveBtn').removeClass('unconfirmed').find('.save-hint').remove();
        } else {
            if (!$('#saveBtn').hasClass('unconfirmed')) {
                $('#saveBtn').addClass('unconfirmed').append('<span class="save-hint">Not confirmed</span>');
            }
        }
    }

    // "Today" is the school's date from the server. The browser's toISOString()
    // is UTC, which before 05:30 IST is still yesterday.
    var iso = '@ViewBag.Today';
    $('#attendanceDate').val(iso).attr('max', iso);

    // yyyy-MM-dd -> local Date (new Date('yyyy-MM-dd') would parse it as UTC).
    function parseDay(v) { var p = String(v || iso).split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }

    // The date as a parent reads it: "Wed, 14 Oct 2026" (no "(Today)" in a message).
    function plainDateStr() {
        const v = $('#attendanceDate').val() || iso;
        return parseDay(v).toLocaleDateString('en-IN', { weekday:'short', day:'2-digit', month:'short', year:'numeric' }).replace(/,(?= \d{4})/, '');
    }
    function dateStr() {
        const v = $('#attendanceDate').val() || iso;
        return v === iso ? plainDateStr() + ' (Today)' : plainDateStr();
    }

    // ── Attractive live date banner ──
    function updateDateBanner() {
        const v = $('#attendanceDate').val() || iso;
        const d = parseDay(v);
        $('#dbDay').text(d.toLocaleDateString('en-IN', { weekday: 'long' }));
        $('#dbDate').text(d.toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }));
        const isToday = v === iso;
        // yyyy-MM-dd strings compare correctly as text.
        const label = isToday ? 'Today' : (v > iso ? 'Future date' : 'Back-dated');
        $('#dbStatus')
            .attr('class', 'db-status ' + (isToday ? 'today' : 'past'))
            .html('<span class="db-dot"></span>' + label);
    }
    updateDateBanner();
    function classStr() { return $('#filterClass').val() + '-' + $('#filterSection').val(); }

    function renderList() {
        if (!students.length) {
            $('#list').html('<p class="text-muted text-center py-4 mb-0">Pick a class, section and date to load the roster.</p>');
            return;
        }
        var anyMarked = students.some(function (s) { return marked[s.id]; });
        var head = anyMarked ? (students.some(notMarkedYet)
                ? '<p class="text-warning text-center small py-2 mb-0"><i class="bx bx-info-circle me-1"></i>' +
                  'Some students were added after this register was saved. Mark them and save again.</p>' : '') :
            '<p class="text-muted text-center small py-2 mb-0"><i class="bx bx-info-circle me-1"></i>' +
            'This day is not marked yet — everyone starts as Present until you save.</p>';
        $('#list').html(head + students.map(function (s) {
            const ab = status[s.id] === 'absent';
            // Late / Leave are shown, never silently turned into Present.
            const tag = notMarkedYet(s) ? ' <span class="badge bg-label-secondary ms-1">Not marked</span>'
                      : status[s.id] === 'late'  ? ' <span class="badge bg-label-warning ms-1">Late</span>'
                      : status[s.id] === 'leave' ? ' <span class="badge bg-label-info ms-1">Leave</span>'
                      : '';
            const on = function (st) { return !notMarkedYet(s) && status[s.id] === st ? 'on' : ''; };
            const notify = ab
                ? '<div class="att-notify">' +
                    '<span class="notify-chip ' + (notified[s.id]?'sent':'pending') + '">' +
                      '<i class="bx ' + (notified[s.id]?'bx-check-circle':'bx-time-five') + '"></i>' + (notified[s.id]?'Notified':'Not notified') + '</span>' +
                    '<button class="btn-wa wa-one" data-id="' + s.id + '" title="WhatsApp"><i class="bx bxl-whatsapp"></i></button>' +
                  '</div>'
                : '';
            return (
                '<div class="att-row ' + (ab?'absent':'') + '">' +
                    '<div class="att-av">' + EC.esc(s.av) + '</div>' +
                    '<div class="att-info"><div class="att-name">' + EC.esc(s.name) + tag + '</div><div class="att-roll">Roll No. ' + EC.esc(s.roll || '—') + '</div></div>' +
                    '<div class="att-toggle">' +
                        '<button class="seg-p ' + on('present') + '" data-id="' + s.id + '" data-set="present" title="Present"><i class="bx bx-check"></i>Present</button>' +
                        '<button class="seg-a ' + on('absent') + '" data-id="' + s.id + '" data-set="absent" title="Absent"><i class="bx bx-x"></i>Absent</button>' +
                        '<button class="seg-l ' + on('late') + '" data-id="' + s.id + '" data-set="late" title="Late"><i class="bx bx-time-five"></i>Late</button>' +
                        '<button class="seg-v ' + on('leave') + '" data-id="' + s.id + '" data-set="leave" title="Leave"><i class="bx bx-calendar-minus"></i>Leave</button>' +
                    '</div>' +
                    notify +
                '</div>'
            );
        }).join(''));
    }

    function renderStats() {
        const total = students.length;
        // Late counts as present; Leave is neither present nor absent; a student
        // not on the saved register yet is not counted as present (QA BUG-106).
        const present = students.filter(s => !notMarkedYet(s) && (status[s.id]==='present' || status[s.id]==='late')).length;
        const absent = students.filter(s => status[s.id]==='absent').length;
        const rate = total ? Math.round(present/total*100) : 0;
        $('#sumPresent').text(present); $('#sumAbsent').text(absent); $('#sumTotal').text(total); $('#sumRate').text(rate + '%');
        $('#barLabelText').text(($('#filterClass').val() || 'Class') + ' - ' + ($('#filterSection').val() || '—') + ' · ' + dateStr());
        $('#notifyCount').text(absent);
        absent > 0 ? $('#notifyBtn').show() : $('#notifyBtn').hide();
    }

    function render() { renderList(); renderStats(); }

    // The register was saved for this day, but this student was not on it (added
    // later) and nobody has tapped a status for them yet.
    function notMarkedYet(s) {
        return !marked[s.id] && !picked[s.id] && students.some(function (x) { return marked[x.id]; });
    }

    // Load the real roster for the current class/section/date.
    function loadRoster() {
        const cls = $('#filterClass').val(), sec = $('#filterSection').val(), date = $('#attendanceDate').val();
        touched = false; updateSaveBtn();
        $('#dayNotice').hide();
        canMark = true; cannotMarkWhy = ''; applyCanMark();
        if (!cls || !sec) { students = []; render(); return; }

        EC.showLoader();
        EC.listLoading('#list', 'Loading roster...');
        $.getJSON(ROSTER_URL, { "class": cls, section: sec, date: date })
            .done(function (res) {
                var rows = (res && res.students) || [];
                students = rows.map(function (r) {
                    return { id:r.id, name:r.name, roll:r.roll, parent:r.parent, phone:r.phone, av:initials(r.name) };
                });
                students.forEach(function (s, i) {
                    var st = rows[i].status;   // '' when the day is not marked yet
                    status[s.id]   = (st === 'absent' || st === 'late' || st === 'leave') ? st : 'present';
                    marked[s.id]   = !!rows[i].marked;
                    picked[s.id]   = false;
                    notified[s.id] = wasNotified(s.id);
                });
                var dayWhy = dayBlockReason(res);
                if (dayWhy) $('#dayNotice').text(dayWhy).show();
                else if (res && res.actingFor)
                    $('#dayNotice').text('You are taking this register for ' + res.actingFor + ', who is away today.').show();
                cannotMarkWhy = dayWhy || (res && res.cannotMark) || '';
                canMark = !cannotMarkWhy && (!res || res.canMark !== false);
                applyCanMark();
                if (!students.length) {
                    renderStats();
                    EC.listEmpty('#list', 'No students on this register for the chosen date.', 'bx-user-x');
                    return;
                }
                render();
            })
            .fail(function (xhr) {
                students = [];
                renderStats();
                EC.listEmpty('#list', EC.ajaxError(xhr, 'Could not load the roster'), 'bx-error-circle');
            })
            .always(EC.hideLoader);
    }

    $(document).on('click', '.att-toggle button', function () {
        const id = Number($(this).data('id')), set = $(this).data('set');
        // Any tap counts as reviewing the roster, even Present on a student
        // who already shows Present.
        if (!touched) { touched = true; updateSaveBtn(); }
        var wasPending = !picked[id];
        picked[id] = true;
        if (status[id] === set && !wasPending) return;
        status[id] = set;
        if (set === 'present') notified[id] = false;
        render();
    });

    // Class change → load that class's sections, then wait for a section pick.
    $('#filterClass').on('change', function () {
        var cls = $(this).val();
        var $sec = $('#filterSection').html('<option value="">Select section</option>');
        students = []; render();
        if (!cls) return;
        $.getJSON(SECTIONS_URL, { "class": cls }).done(function (list) {
            $.each(list || [], function (i, s) { $sec.append($('<option>').val(s).text(s)); });
        });
    });

    // Section or date change → it's a fresh sheet, reload the roster.
    $('#filterSection, #attendanceDate').on('change', function () { updateDateBanner(); loadRoster(); });

    $('#saveBtn').on('click', function () {
        if (!students.length) { ecToast('warning', 'Load a class roster first.'); return; }
        if (!canMark) { ecToast('error', cannotMarkWhy || 'You cannot mark attendance for this class.'); return; }
        var $btn = $(this);
        // Nothing tapped yet: ask once instead of refusing, so a roster where
        // everyone is present can still be saved as shown.
        if (!touched) {
            EC.confirm({
                title:   'Save the roster as shown?',
                message: 'You have not changed anyone. Present ' + $('#sumPresent').text() + ', Absent ' + $('#sumAbsent').text() + '.',
                okText:  'Save attendance',
                danger:  false
            }).then(function (ok) {
                if (!ok) return;
                touched = true; updateSaveBtn();
                saveRoster($btn);
            });
            return;
        }
        saveRoster($btn);
    });

    function saveRoster($btn) {
        // Send the whole roster with each student's status as it stands (the server
        // only rewrites rows whose status actually changed).
        var STATUS = { present: 'Present', absent: 'Absent', late: 'Late', leave: 'Leave' };
        var items = students.map(function (s) {
            return { studentId: s.id, status: STATUS[status[s.id]] || 'Present', remarks: '' };
        });
        EC.buttonBusy($btn, 'Saving…');
        $.ajax({
            url: SAVE_URL,
            type: 'POST',
            contentType: 'application/json',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
            data: JSON.stringify({ date: $('#attendanceDate').val(), "class": $('#filterClass').val(), section: $('#filterSection').val(), items: items })
        })
        .done(function (res) {
            if (res && res.success) { ecToast('success', res.message); loadRoster(); }
            else ecToast('error', (res && res.message) || 'Could not save.');
        })
        .fail(function (xhr) { ecToast('error', EC.ajaxError(xhr, 'Could not save')); })
        .always(function () { EC.buttonReset($btn); });
    }

    // {class} is already "Class 8-A", so the template must not add "Class" again (QA BUG-103).
    function template() { return 'Dear {parent}, your ward {student} ({class}) was marked absent on {date}. Kindly inform the school if this is unexpected.'; }
    function buildMsg(s) {
        return ($('#msgTemplate').val() || template())
            .replace(/{parent}/g, s.parent || 'Parent').replace(/{student}/g, s.name)
            .replace(/{class}/g, classStr()).replace(/{date}/g, plainDateStr());
    }
    // "Notified" survives a reload on this browser (the WhatsApp message itself
    // is sent from the phone, so the server never knows). Per student per day.
    function notifiedKey(id) { return 'ec-att-notified-' + ($('#attendanceDate').val() || iso) + '-' + id; }
    function rememberNotified(id) { try { localStorage.setItem(notifiedKey(id), '1'); } catch (e) { } }
    function wasNotified(id) { try { return localStorage.getItem(notifiedKey(id)) === '1'; } catch (e) { return false; } }

    function sendWA(id) {
        const s = students.find(x => x.id === id); if (!s) return;
        if (!s.phone) { ecToast('warning', 'No mobile number on record for ' + s.name + '.'); return; }
        window.open('https://wa.me/91' + String(s.phone).replace(/\D/g,'') + '?text=' + encodeURIComponent(buildMsg(s)), '_blank');
        notified[id] = true; rememberNotified(id); render(); refreshModal();
    }
    $(document).on('click', '.wa-one', function () { sendWA(Number($(this).data('id'))); });
    $(document).on('click', '.wa-modal', function () { sendWA(Number($(this).data('id'))); });

    function refreshModal() {
        const absent = students.filter(s => status[s.id]==='absent');
        $('#modalAbsentCount').text(absent.length);
        if (!absent.length) { $('#modalList').html('<p class="text-muted text-center small py-3 mb-0">No absent students.</p>'); return; }
        $('#modalList').html(absent.map(function (s) {
            return '<div class="modal-row">' +
                '<div class="att-av" style="width:36px;height:36px;border-radius:10px;font-size:.7rem;background:#fee2e2;color:var(--ec-danger);">' + EC.esc(s.av) + '</div>' +
                '<div style="flex:1;min-width:0;"><div style="font-weight:800;font-size:.83rem;color:var(--ec-heading);">' + EC.esc(s.name) + '</div>' +
                '<div style="font-size:.71rem;font-weight:700;color:var(--ec-muted);">' + EC.esc(s.parent || 'Parent') + ' · +91 ' + EC.esc(s.phone || '—') + '</div></div>' +
                '<span class="notify-chip ' + (notified[s.id]?'sent':'pending') + '" style="flex:0 0 auto;"><i class="bx ' + (notified[s.id]?'bx-check-circle':'bx-time-five') + '"></i>' + (notified[s.id]?'Sent':'Pending') + '</span>' +
                '<button class="btn-wa wa-modal" data-id="' + s.id + '"><i class="bx bxl-whatsapp"></i></button></div>';
        }).join(''));
    }

    $('#notifyBtn').on('click', function () { $('#msgTemplate').val(template()); refreshModal(); $('#notifyModal').modal('show'); });

    render();
    updateSaveBtn();
});
</script>
}
