@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model EduCoreDataAccessLayer.Models.ERP.TcListModel
@{
    ViewData["Title"] = "Transfer Certificate Register";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";

    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search);
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-award fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Transfer Certificate Register</h4>
            <div class="ec-page-subtitle">Every certificate issued by this school — reprint or void from here</div>
          </div>
        </div>
      </div>
    </div>

    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <div class="ec-section-title-wrap mb-3">
          <span class="ec-section-icon"><i class="bx bx-list-ul"></i></span>
          <div>
            <div class="ec-section-title">Issued Certificates</div>
            <div class="ec-section-subtitle">
              @(Model.TotalCount > 0 ? $"Showing {Model.FirstRow}–{Model.LastRow} of {Model.TotalCount}" : "No records")
            </div>
          </div>
        </div>

        <form id="tcRegForm" method="get" asp-area="ERP" asp-controller="Tc" asp-action="Register" class="d-flex gap-2 flex-wrap align-items-center">
          <div class="input-group input-group-sm" style="max-width:340px">
            <span class="input-group-text"><i class="bx bx-search"></i></span>
            <input type="search" class="form-control" name="Search" value="@Model.Search"
                   placeholder="Search TC no, name, admission no…" />
          </div>
          <button type="submit" class="btn btn-sm btn-primary"><i class="bx bx-search me-1"></i>Search</button>
          @if (hasFilter)
          {
              <a asp-area="ERP" asp-controller="Tc" asp-action="Register" class="btn btn-sm btn-outline-secondary"><i class="bx bx-x me-1"></i>Clear</a>
          }
        </form>
      </div>

      <div class="ec-card-body pt-2">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>TC No</th>
                <th>Student</th>
                <th>Class</th>
                <th>Issued On</th>
                <th>Format</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var t in Model.Items)
              {
                  <tr class="@(t.IsVoid ? "text-muted" : "")">
                    <td class="fw-bold">@t.TcNo</td>
                    <td>
                      <div>@t.StudentName</div>
                      <div class="text-muted" style="font-size:.76rem">@t.AdmissionNo</div>
                    </td>
                    <td>@t.ClassDisplay<div class="text-muted" style="font-size:.76rem">@t.AcademicYear</div></td>
                    <td>@t.IssueDateDisplay</td>
                    <td>@t.Format</td>
                    <td>
                      @if (t.IsVoid)
                      {
                          <span class="ec-badge bg-label-danger text-danger">Void</span>
                      }
                      else
                      {
                          <span class="ec-badge bg-label-success text-success">Live</span>
                          @if (t.PrintCount > 0)
                          {
                              <div class="text-muted" style="font-size:.72rem">@t.PrintCount print(s)</div>
                          }
                      }
                    </td>
                    <td class="text-end">
                      @if (!t.IsVoid)
                      {
                          <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Print", "Tc", new { area = "ERP", id = t.TcId })" target="_blank">
                            <i class="bx bx-printer me-1"></i>Print
                          </a>
                          <button type="button" class="btn btn-sm btn-outline-danger btn-tc-void"
                                  data-id="@t.TcId" data-no="@t.TcNo">
                            <i class="bx bx-x-circle"></i>
                          </button>
                      }
                    </td>
                  </tr>
              }
            </tbody>
          </table>
        </div>

        @if (Model.TotalCount == 0)
        {
            <div class="text-center text-muted py-5">
              <i class="bx bx-award" style="font-size:2.5rem;opacity:.4"></i>
              <h6 class="fw-bold mb-1 mt-2">No certificates yet</h6>
              <p class="small mb-0">Issue a TC from the Inactive / Left Students page.</p>
            </div>
        }

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mt-3">
          <partial name="_PageSize" model="Model" view-data='@(new ViewDataDictionary(ViewData) { { "FormId", "tcRegForm" } })' />
          <partial name="_Pager" model="Model" />
        </div>
      </div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
    $(function () {

        $('.btn-tc-void').on('click', function () {
            var no = $(this).data('no');
            var tcId = $(this).data('id');
            EC.prompt({
                title: 'Void this certificate?',
                name: no,
                message: 'The reason is kept for audit and cannot be edited later.',
                label: 'Reason',
                placeholder: 'Why is this certificate being voided?',
                required: true,
                okText: 'Void certificate'
            }).then(function (reason) {
            if (reason === null) return;   // cancelled

            $.ajax({
                url: '@Url.Action("Void", "Tc", new { area = "ERP" })',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
                data: JSON.stringify({ tcId: tcId, reason: reason })
            })
            .done(function (res) {
                if (res && res.success) { ecToast('success', res.message); location.reload(); }
                else ecToast('error', (res && res.message) || 'Could not void.');
            })
            .fail(function () { ecToast('error', 'Something went wrong.'); });
            });
        });

    });
</script>
}
