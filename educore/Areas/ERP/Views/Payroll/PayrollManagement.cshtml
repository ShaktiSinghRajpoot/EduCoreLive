@{
    ViewData["Title"] = "Payroll & Salary";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Payroll/PayrollManagement.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content pr-page">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-money fs-4"></i></div>
          <div>
            <h4 class="ec-page-title mb-1">Payroll &amp; Salary</h4>
            <div class="ec-page-subtitle">Monthly salary run — earnings, statutory deductions &amp; loss-of-pay from attendance</div>
          </div>
        </div>
        <button class="btn-pr-run" id="btnExport"><i class="bx bx-download"></i><span>Export</span></button>
      </div>
    </div>

    <div class="pr-stats">
      <div class="pr-stat k-net"><div class="pr-stat-ic"><i class="bx bx-wallet"></i></div><div class="pr-stat-val" id="kNet">₹0.00</div><div class="pr-stat-lbl">Net Payroll</div></div>
      <div class="pr-stat k-ded"><div class="pr-stat-ic"><i class="bx bx-minus-circle"></i></div><div class="pr-stat-val" id="kDed">₹0.00</div><div class="pr-stat-lbl">Total Deductions</div></div>
      <div class="pr-stat k-paid"><div class="pr-stat-ic"><i class="bx bx-check-circle"></i></div><div class="pr-stat-val" id="kPaid">0</div><div class="pr-stat-lbl">Payslips Paid</div></div>
      <div class="pr-stat k-pend"><div class="pr-stat-ic"><i class="bx bx-time-five"></i></div><div class="pr-stat-val" id="kPend">0</div><div class="pr-stat-lbl">Pending Payslips</div></div>
    </div>

    <div class="pr-toolbar">
      <div>
        <div class="pr-field-label">PAY PERIOD</div>
        @* Last twelve months from the controller — payroll is never run ahead. *@
        <select class="form-select" id="fMonth">
          @foreach (var m in ViewBag.Months as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>())
          {
              <option value="@m.value">@m.label</option>
          }
        </select>
      </div>
      <div>
        <div class="pr-field-label">DEPARTMENT</div>
        <select class="form-select" id="fDept">
          <option value="">All Departments</option>
          <option>Teaching</option><option>Administration</option>
          <option>Accounts</option><option>Library</option>
          <option>Transport</option><option>Support Staff</option>
        </select>
      </div>
      <button class="btn-pr-run ms-auto" id="btnRun"><i class="bx bx-play-circle"></i><span>Run Payroll</span></button>
    </div>

    <div class="ec-card">
      <div class="ec-card-body">
        <div class="pr-tbl-wrap">
          <table class="pr-tbl">
            <thead>
              <tr>
                <th>Staff</th>
                <th class="text-end">Gross</th>
                <th class="text-end">Deductions</th>
                <th class="text-center">LOP</th>
                <th class="text-end">Net Pay</th>
                <th class="text-center">Status</th>
                <th class="text-center">Payslip</th>
              </tr>
            </thead>
            <tbody id="prBody"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Payslip modal -->
<div class="modal fade ps-modal" id="payslipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="ps-head">
        <div class="d-flex align-items-center gap-3">
          <div class="pr-av" id="psAv">--</div>
          <div>
            <div class="pr-nm" id="psName" style="font-size:1rem;">Staff Name</div>
            <div class="pr-sub" id="psSub">EMP · Designation</div>
          </div>
        </div>
        <div class="text-end">
          <div style="font-size:.7rem;font-weight:800;color:var(--pr-muted);text-transform:uppercase;">Payslip</div>
          <div style="font-weight:900;color:var(--pr-heading);" id="psPeriod">June 2026</div>
        </div>
      </div>

      <div class="ps-att" id="psAtt"></div>

      <div class="ps-cols">
        <div class="ps-col earn">
          <div class="ps-col-title"><i class="bx bx-trending-up"></i>Earnings</div>
          <div id="psEarn"></div>
        </div>
        <div class="ps-col ded">
          <div class="ps-col-title"><i class="bx bx-trending-down"></i>Deductions</div>
          <div id="psDed"></div>
        </div>
      </div>

      <div class="ps-net">
        <span class="l">Net Salary Payable</span>
        <span class="v" id="psNet">₹0.00</span>
      </div>
      <div class="ps-note"><i class="bx bx-info-circle me-1"></i>LOP = (Gross ÷ working days) × unpaid days. Unpaid days are pulled from Staff Attendance (absent + ½×half-day) and unpaid Leave.</div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn-pr-run" id="psPrint"><i class="bx bx-printer"></i>Print</button>
        <button type="button" class="btn btn-success px-4 fw-bold" id="psMarkPaid"><i class="bx bx-check me-1"></i>Mark Paid</button>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
$(document).ready(function () {

    const LIST_URL = '@Url.Action("List","Payroll",new{area="ERP"})';
    const RUN_URL  = '@Url.Action("RunPayroll","Payroll",new{area="ERP"})';
    const PAID_URL = '@Url.Action("MarkPaid","Payroll",new{area="ERP"})';
    function token(){ return $('input[name="__RequestVerificationToken"]').first().val(); }
    function period(){ const v=($('#fMonth').val()||'').split('-'); return { year:+v[0], month:+v[1] }; }
    function ini(n){ return (n||'').split(' ').slice(0,2).map(function(w){return w[0]||'';}).join('').toUpperCase(); }

    const COLORS = ['bg-label-primary text-primary','bg-label-info text-info','bg-label-success text-success','bg-label-warning text-warning','bg-label-danger text-danger'];
    function inr(n){ return '₹' + Math.round(n).toLocaleString('en-IN'); }

    /* Rows come from the server, already computed.

       WHAT IS NOT HERE, and why. The mock this replaced split pay into basic /
       HRA / DA / conveyance / medical / special and deducted EPF, ESI,
       professional tax and TDS off hardcoded income-tax slabs. None of that is
       configured anywhere in the app: core.staff holds ONE monthly_salary
       figure, and there is no salary-component or statutory-rate table.
       Hardcoding tax slabs into a page would be wrong for most schools and
       stale after any budget. So the payslip shows what the school actually
       recorded — gross, Loss of Pay, net — and a component breakdown can come
       when there is a salary structure to read it from. */
    let ROWS = [];

    function periodLabel(){ return $('#fMonth option:selected').text(); }

    // The department filter is applied by the proc, so the page just draws what
    // came back — no second filtering rule to drift out of step.
    function visible(){ return ROWS; }

    function render(){
        const rows = visible();
        let totNet = 0, totDed = 0, paid = 0, pend = 0;

        if(!rows.length){
            // No payslips is not the same as zero pay — the month simply has not
            // been run yet.
            $('#prBody').html('<tr><td colspan="7" class="text-muted small p-3">'
                + 'No payslips for this month yet. Press <strong>Run Payroll</strong> to generate them.</td></tr>');
            $('#kNet').text(inr(0)); $('#kDed').text(inr(0)); $('#kPaid').text(0); $('#kPend').text(0);
            return;
        }

        $('#prBody').html(rows.map(function(s){
            const isPaid = (s.status||'').toLowerCase() === 'paid';
            totNet += s.net; totDed += s.deductions;
            isPaid ? paid++ : pend++;
            const lopCls = s.lopDays > 0 ? 'has' : 'zero';
            const col = COLORS[s.staffId % COLORS.length];
            return ''
              + '<tr>'
              +   '<td><div class="pr-staff"><div class="pr-av '+col+'">'+EC.esc(ini(s.name))+'</div><div>'
              +     '<div class="pr-nm">'+EC.esc(s.name)+'</div>'
              +     '<div class="pr-sub">'+EC.esc(s.code||'—')+' · '+EC.esc(s.designation||'—')+'</div></div></div></td>'
              +   '<td class="text-end pr-amt">'+inr(s.gross)+'</td>'
              +   '<td class="text-end pr-amt ded">'+(s.deductions>0?'−'+inr(s.deductions):inr(0))+'</td>'
              +   '<td class="text-center"><span class="pr-lop '+lopCls+'" title="Approved unpaid leave days in this month">'
              +     '<i class="bx bx-calendar-x"></i>'+s.lopDays+'</span></td>'
              +   '<td class="text-end pr-amt net">'+inr(s.net)+'</td>'
              +   '<td class="text-center"><span class="pr-status '+(isPaid?'ps-paid':'ps-pending')+'">'+(isPaid?'Paid':'Pending')+'</span></td>'
              +   '<td class="text-center"><button class="pr-view" data-id="'+s.id+'"><i class="bx bx-receipt"></i>View</button></td>'
              + '</tr>';
        }).join(''));

        $('#kNet').text(inr(totNet));
        $('#kDed').text(inr(totDed));
        $('#kPaid').text(paid);
        $('#kPend').text(pend);
    }

    /* ── Payslip modal ── */
    let activeId = null;
    function openPayslip(s){
        const isPaid = (s.status||'').toLowerCase()==='paid';
        activeId = s.id;
        $('#psAv').attr('class','pr-av '+COLORS[s.staffId % COLORS.length]).text(ini(s.name));
        $('#psName').text(s.name);
        $('#psSub').text((s.code||'—') + ' · ' + (s.designation||'—') + (s.department?' · '+s.department:''));
        $('#psPeriod').text(periodLabel());

        // LOP days is the only attendance figure this payslip actually has —
        // there is no staff attendance register, so present/half/paid-leave
        // counts would be invented.
        $('#psAtt').html(chip('LOP Days', s.lopDays, s.lopDays>0));

        $('#psEarn').html(
            line('Monthly salary', s.gross) + lineTotal('Gross Earnings', s.gross)
        );
        $('#psDed').html(
            (s.lopDays > 0 ? line('Loss of Pay ('+s.lopDays+'d)', s.lopAmount) : '')
            + lineTotal('Total Deductions', s.deductions)
        );
        $('#psNet').text(inr(s.net));

        $('#psMarkPaid').prop('disabled', isPaid).html(
            isPaid ? '<i class="bx bx-check-double me-1"></i>Already Paid' : '<i class="bx bx-check me-1"></i>Mark Paid'
        );
        new bootstrap.Modal(document.getElementById('payslipModal')).show();
    }
    function chip(l,v,warn){ return '<div class="ps-att-chip"><div class="ps-att-v" '+(warn?'style="color:var(--pr-amber)"':'')+'>'+v+'</div><div class="ps-att-l">'+l+'</div></div>'; }
    function line(l,v){ return '<div class="ps-line"><span>'+l+'</span><span>'+inr(v)+'</span></div>'; }
    function lineTotal(l,v){ return '<div class="ps-line total"><span>'+l+'</span><span>'+inr(v)+'</span></div>'; }

    $('#prBody').on('click','.pr-view',function(){
        const s=ROWS.find(x=>x.id===Number($(this).data('id'))); if(s) openPayslip(s);
    });

    // The server refuses to pay a payslip twice, so the button reports what it says.
    $('#psMarkPaid').on('click',function(){
        const $btn=$(this);
        EC.buttonBusy($btn,'Saving…');
        $.ajax({ url:PAID_URL, type:'POST',
                 headers:{ 'RequestVerificationToken': token() }, data:{ id: activeId } })
        .done(function(res){
            if(!res||!res.success){ ecToast('error',(res&&res.message)||'Could not mark paid.'); return; }
            bootstrap.Modal.getOrCreateInstance(document.getElementById('payslipModal')).hide();
            ecToast('success', res.message);
            load();
        })
        .fail(function(xhr){
            ecToast('error', xhr && xhr.status===403
                ? 'You do not have permission to mark payslips paid.'
                : 'Could not reach the server. Nothing was changed.');
        })
        .always(function(){ EC.buttonReset($btn); });
    });
    $('#psPrint').on('click',function(){ window.print(); });

    $('#fMonth, #fDept').on('change', load);

    $('#btnRun').on('click', function(){
        const p=period(), $btn=$(this);
        EC.buttonBusy($btn,'Running…');
        $.ajax({ url:RUN_URL, type:'POST',
                 headers:{ 'RequestVerificationToken': token() },
                 data:{ month:p.month, year:p.year } })
        .done(function(res){
            if(!res||!res.success){ ecToast('error',(res&&res.message)||'Could not run payroll.'); return; }
            // The proc reports how many it generated and how many it left alone
            // because they were already paid — repeat it verbatim.
            ecToast('success', res.message);
            load();
        })
        .fail(function(xhr){
            ecToast('error', xhr && xhr.status===403
                ? 'You do not have permission to run payroll.'
                : 'Could not reach the server. Nothing was generated.');
        })
        .always(function(){ EC.buttonReset($btn); });
    });
    $('#btnExport').on('click', function(){
        if(!ROWS.length){ ecToast('warning','Nothing to export — run the payroll first.'); return; }
        // The old export had EPF/ESI/PT/TDS columns computed in the browser and
        // stored nowhere. These are the figures the payslip actually holds.
        const rows = ROWS.map(function(s){
            return [s.code,s.name,s.department,s.gross,s.lopDays,s.lopAmount,s.deductions,s.net,s.status]; });
        const hdr = ['Emp','Name','Department','Gross','LOP Days','LOP Amount','Deductions','NetPay','Status'];
        const csv = '﻿'+[hdr].concat(rows).map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(',')).join('\r\n');
        const a=document.createElement('a'); a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);
        a.download='payroll_'+$('#fMonth').val()+'.csv'; a.click();
        ecToast('success','Payroll exported.');
    });

    function load(){
        const p=period();
        $('#prBody').html('<tr><td colspan="7" class="text-muted small p-3">Loading…</td></tr>');
        $.getJSON(LIST_URL,{ month:p.month, year:p.year, department:$('#fDept').val()||null })
         .done(function(rows){ ROWS=rows||[]; render(); })
         .fail(function(){
            ROWS=[];
            $('#prBody').html('<tr><td colspan="7" class="text-muted small p-3">Could not load payroll.</td></tr>');
         });
    }

    load();
});
</script>
}
