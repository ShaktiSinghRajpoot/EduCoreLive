@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Homework";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var isStaff   = (bool?)ViewBag.IsStaff ?? false;
    var canManage = (bool?)ViewBag.CanManage ?? false;   // academics.manage
    var canOverview = (bool?)ViewBag.CanOverview ?? false; // reports.view
}

@*
   Homework — teachers give homework to a class section and tick who did it
   (academic.sp_homework_manage). Grouped by day and class; each group can be
   sent home on WhatsApp or printed as the class's homework diary.
*@

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Homework/Homework.css" asp-append-version="true" />
}

<div class="ec-page-shell hw-page">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="d-flex align-items-center gap-2">
          <div class="ec-page-icon"><i class="bx bx-book-open"></i></div>
          <div><h4 class="ec-page-title mb-1">Homework</h4>
            <p class="ec-page-subtitle">Give homework, check who did it, and send the day's homework home</p></div>
        </div>
        @if (isStaff || canManage)
        {
            <button id="btnNew" class="btn btn-primary btn-sm"><i class="bx bx-plus me-1"></i>Give homework</button>
        }
      </div>
    </div>

    @if (canOverview)
    {
        <div class="hw-tabs mb-3" id="hwTabs">
          <button class="on" data-t="list"><i class="bx bx-list-ul me-1"></i>Homework</button>
          <button data-t="overview"><i class="bx bx-pie-chart-alt-2 me-1"></i>Overview</button>
        </div>
    }

    <div id="paneList">
    <div class="ec-card mb-3"><div class="ec-card-body hw-tools">
      <div><label class="form-label mb-1">Class</label><select id="hSection" class="form-select form-select-sm"><option value="">All classes</option></select></div>
      <div><label class="form-label mb-1">Given from</label><input type="date" id="hFrom" class="form-control form-control-sm"></div>
      <div><label class="form-label mb-1">to</label><input type="date" id="hTo" class="form-control form-control-sm"></div>
      @if (isStaff)
      {
          <div class="form-check mb-1"><input id="hMine" class="form-check-input" type="checkbox" @(canManage ? "" : "checked")>
            <label class="form-check-label" for="hMine">Only mine</label></div>
      }
    </div></div>

    <div id="hList"></div>
    </div>

    @if (canOverview)
    {
    @* ── Overview: who is (not) giving homework, from the timetable ── *@
    <div id="paneOverview" class="d-none">
      <div class="ec-card mb-3"><div class="ec-card-body">
        <div class="hw-ov-bar">
          <div class="hw-chips" id="ovRange">
            <button data-r="0">Today</button><button data-r="6">7 days</button><button class="on" data-r="29">30 days</button>
            <button data-r="all">This session</button><button data-r="custom">Custom</button>
          </div>
          <div class="hw-ov-custom d-none" id="ovCustom">
            <input type="date" id="ovFrom" class="form-control form-control-sm"><span>to</span><input type="date" id="ovTo" class="form-control form-control-sm">
          </div>
        </div>
        <div class="hw-chips mt-2" id="ovClasses"></div>
      </div></div>

      <div class="hw-kpis" id="ovKpis"></div>

      <div class="row g-3 mb-3">
        <div class="col-12 col-lg-5">
          <div class="ec-card h-100"><div class="ec-card-body">
            <h6 class="hw-ov-h">Who is giving homework?</h6>
            <div class="hw-donut-wrap"><div class="hw-donut" id="ovDonut"><div><b id="ovDonutN">0</b><small>teachers</small></div></div>
              <div class="hw-legend" id="ovLegend"></div></div>
            <div class="hw-note">From the timetable: a teacher who gives nothing still appears here. Tap a line to list those teachers.</div>
          </div></div>
        </div>
        <div class="col-12 col-lg-7">
          <div class="ec-card h-100"><div class="ec-card-body">
            <h6 class="hw-ov-h">Nobody is giving homework here</h6>
            <div class="hw-nobody" id="ovNobody"></div>
          </div></div>
        </div>
      </div>

      <div class="ec-card mb-3"><div class="ec-card-body">
        <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-2">
          <h6 class="hw-ov-h mb-0">Homework by teacher <small class="text-muted" id="ovTeacherFilter"></small></h6>
          <input id="ovSearch" class="form-control form-control-sm" style="max-width:220px" placeholder="Search teacher">
        </div>
        <div class="table-responsive"><table class="table align-middle mb-0 hw-ov-table">
          <thead><tr><th>Teacher</th><th>Status</th><th class="text-center">Given</th><th class="text-center">Sections</th><th class="text-center">Periods / week</th><th>Last given</th><th class="text-center">Checked</th><th class="text-center">Done</th></tr></thead>
          <tbody id="ovTeachers"></tbody>
        </table></div>
      </div></div>

      <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
          <div class="ec-card h-100"><div class="ec-card-body">
            <h6 class="hw-ov-h">Leaderboard</h6>
            <div id="ovLeaders"></div>
            <div class="hw-note">Score = 60% sections covered + 40% students checked: the parts a teacher controls. How many students did it is shown, not scored.</div>
          </div></div>
        </div>
        <div class="col-12 col-lg-6">
          <div class="ec-card h-100"><div class="ec-card-body">
            <h6 class="hw-ov-h">Was the homework done?</h6>
            <div id="ovDone"></div>
            <h6 class="hw-ov-h mt-4">By subject</h6>
            <div id="ovSubjects"></div>
          </div></div>
        </div>
      </div>

      <div class="ec-card mb-3"><div class="ec-card-body">
        <h6 class="hw-ov-h">By class</h6>
        <div class="hw-class-grid" id="ovClassGrid"></div>
      </div></div>
    </div>
    }

  </div>
</div>

<div class="modal fade" id="hwModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="hwModalTitle">Give homework</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12 col-md-6"><label class="form-label">Class <span class="text-danger">*</span></label>
            <select id="fSection" class="form-select"></select></div>
          <div class="col-12 col-md-6"><label class="form-label">Subject <span class="text-danger">*</span></label>
            <select id="fSubject" class="form-select"><option value="">Pick a class first</option></select></div>
          <div class="col-12"><label class="form-label">Homework <span class="text-danger">*</span></label>
            <input id="fTitle" class="form-control" maxlength="200" placeholder="e.g. Learn the poem 'The Rainbow'"></div>
          <div class="col-12"><label class="form-label">Details <small class="text-muted">(optional)</small></label>
            <textarea id="fDetails" class="form-control" rows="3" maxlength="2000" placeholder="Page numbers, questions, what to bring..."></textarea></div>
          <div class="col-6"><label class="form-label">Given on</label><input id="fGiven" type="date" class="form-control"></div>
          <div class="col-6"><label class="form-label">Due on <span class="text-danger">*</span></label><input id="fDue" type="date" class="form-control"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="btnSave"><i class="bx bx-send me-1"></i>Give homework</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="chkModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div><h5 class="modal-title mb-0">Who did it?</h5><small class="text-muted" id="chkTitle"></small></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-2" id="chkList"></div>
      <div class="modal-footer justify-content-between">
        <button type="button" class="btn btn-sm ec-btn-soft" id="btnAllDone"><i class="bx bx-check-double me-1"></i>Unmarked → Done</button>
        <button type="button" class="btn btn-primary" id="btnChkSave"><i class="bx bx-save me-1"></i>Save</button>
      </div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
$(function () {
    'use strict';

    var CSRF = $('input[name="__RequestVerificationToken"]').val();
    var URL = {
        sections: '@Url.Action("Sections","Homework",new{area="ERP"})',
        subjects: '@Url.Action("Subjects","Homework",new{area="ERP"})',
        list:     '@Url.Action("List","Homework",new{area="ERP"})',
        save:     '@Url.Action("Save","Homework",new{area="ERP"})',
        del:      '@Url.Action("Delete","Homework",new{area="ERP"})',
        students: '@Url.Action("Students","Homework",new{area="ERP"})',
        check:    '@Url.Action("Check","Homework",new{area="ERP"})',
        overview: '@Url.Action("Overview","Homework",new{area="ERP"})'
    };

    function iso(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
    function addDays(n) { var d = new Date(); d.setDate(d.getDate() + n); return iso(d); }
    var TODAY = addDays(0);
    function show(s) {   // "2026-10-14" -> "Wed, 14 Oct"
        var d = new Date(s + 'T00:00:00');
        return d.toLocaleDateString('en-IN', { weekday: 'short', day: '2-digit', month: 'short' });
    }
    function post(url, body) {
        return $.ajax({ url: url, type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': CSRF }, data: JSON.stringify(body) });
    }

    $('#hFrom').val(addDays(-6)); $('#hTo').val(TODAY);

    var items = [], editId = 0;

    // ── sections for the filter and the form ────────────────────────────
    $.getJSON(URL.sections).done(function (list) {
        var opts = (list || []).map(function (s) { return '<option value="' + s.id + '">' + EC.esc(s.label) + '</option>'; }).join('');
        $('#hSection').append(opts);
        $('#fSection').html('<option value="">Pick a class</option>' + opts);
    });

    function loadSubjects(sectionId, selected) {
        if (!sectionId) { $('#fSubject').html('<option value="">Pick a class first</option>'); return; }
        $('#fSubject').html('<option value="">Loading...</option>');
        $.getJSON(URL.subjects, { sectionId: sectionId }).done(function (list) {
            $('#fSubject').html('<option value="">Pick a subject</option>' + (list || []).map(function (s) {
                return '<option value="' + s.id + '">' + EC.esc(s.name) + '</option>';
            }).join(''));
            if (selected) $('#fSubject').val(selected);
        });
    }
    $('#fSection').on('change', function () { loadSubjects(this.value); });

    // ── list ────────────────────────────────────────────────────────────
    function load() {
        EC.listLoading('#hList', 'Loading homework...');
        $.getJSON(URL.list, { sectionId: $('#hSection').val() || null, from: $('#hFrom').val(), to: $('#hTo').val(), mine: $('#hMine').is(':checked') })
            .done(function (rows) { items = rows || []; draw(); })
            .fail(function () { ecToast('error', 'Could not load the homework.'); });
    }

    function draw() {
        if (!items.length) { EC.listEmpty('#hList', 'No homework in these dates.', 'bx-book-open'); return; }
        // group by day given, then class
        var groups = [], map = {};
        items.forEach(function (h) {
            var k = h.given + '|' + h.sectionId;
            if (!map[k]) { map[k] = { given: h.given, section: h.section, list: [] }; groups.push(map[k]); }
            map[k].list.push(h);
        });
        $('#hList').html(groups.map(function (g, gi) {
            return '<div class="ec-card hw-group"><div class="hw-ghead"><div><b>' + EC.esc(show(g.given)) + '</b> · ' + EC.esc(g.section) + '</div>'
                 + '<div class="hw-gacts"><a class="btn btn-xs hw-wa" target="_blank" rel="noopener" href="https://wa.me/?text=' + encodeURIComponent(diaryText(g)) + '"><i class="bx bxl-whatsapp me-1"></i>WhatsApp</a>'
                 + '<button class="btn btn-xs ec-btn-soft hw-print" data-g="' + gi + '"><i class="bx bx-printer me-1"></i>Diary</button></div></div>'
                 + g.list.map(card).join('') + '</div>';
        }).join(''));
        window.__hwGroups = groups;
    }

    function dueText(h) {
        if (h.due === TODAY) return '<span class="hw-due today">Due today</span>';
        if (h.due < TODAY) return '<span class="hw-due late">Was due ' + EC.esc(show(h.due)) + '</span>';
        return '<span class="hw-due">Due ' + EC.esc(show(h.due)) + '</span>';
    }

    function card(h) {
        var checked = h.done + h.notDone;
        var acts = '';
        if (h.canEdit) {
            acts = '<button class="btn btn-xs btn-primary hw-check" data-id="' + h.id + '"><i class="bx bx-check-square me-1"></i>Check (' + h.done + '/' + h.students + ' done)</button>'
                 + '<button class="btn btn-xs btn-outline-secondary hw-edit" data-id="' + h.id + '"><i class="bx bx-edit-alt"></i></button>'
                 + '<button class="btn btn-xs btn-outline-danger hw-del" data-id="' + h.id + '"><i class="bx bx-trash"></i></button>';
        } else if (checked) {
            acts = '<span class="text-muted small">' + h.done + ' of ' + h.students + ' done</span>';
        }
        return '<div class="hw-item"><div class="hw-main"><div><span class="hw-subj">' + EC.esc(h.subject) + '</span> ' + dueText(h) + '</div>'
             + '<div class="hw-title">' + EC.esc(h.title) + '</div>'
             + (h.details ? '<div class="hw-details">' + EC.esc(h.details) + '</div>' : '')
             + '<div class="hw-meta">' + EC.esc(h.teacher || '') + '</div></div>'
             + '<div class="hw-acts">' + acts + '</div></div>';
    }

    function diaryText(g) {
        return '*Homework — ' + g.section + ' — ' + show(g.given) + '*\n\n' + g.list.map(function (h, i) {
            return (i + 1) + '. *' + h.subject + '*: ' + h.title + (h.details ? '\n   ' + h.details : '') + '\n   (due ' + show(h.due) + ')';
        }).join('\n');
    }

    $('#hList').on('click', '.hw-print', function () {
        var g = window.__hwGroups[$(this).data('g')];
        var w = window.open('', '_blank');
        if (!w) { ecToast('error', 'Allow pop-ups to print the diary.'); return; }
        w.document.write('<html><head><title>Homework diary</title><style>body{font-family:Segoe UI,Arial,sans-serif;padding:24px;color:#111}'
            + 'h2{margin:0 0 4px;color:#26426b}table{border-collapse:collapse;width:100%;margin-top:14px}th,td{border:1px solid #bbb;padding:8px;text-align:left;vertical-align:top}'
            + 'th{background:#f2f4f7}</style></head><body><h2>Homework diary</h2><div>' + EC.esc(g.section) + ' · ' + EC.esc(show(g.given)) + '</div>'
            + '<table><tr><th>Subject</th><th>Homework</th><th>Due</th><th>Teacher</th></tr>'
            + g.list.map(function (h) {
                return '<tr><td><b>' + EC.esc(h.subject) + '</b></td><td>' + EC.esc(h.title) + (h.details ? '<br><small>' + EC.esc(h.details) + '</small>' : '')
                     + '</td><td>' + EC.esc(show(h.due)) + '</td><td>' + EC.esc(h.teacher || '') + '</td></tr>';
            }).join('') + '</table><p style="margin-top:40px">Parent\'s signature: ____________________</p></body></html>');
        w.document.close(); w.focus(); w.print();
    });

    $('#hSection, #hFrom, #hTo, #hMine').on('change', load);

    // ── give / edit ─────────────────────────────────────────────────────
    function openForm(h) {
        editId = h ? h.id : 0;
        $('#hwModalTitle').text(h ? 'Edit homework' : 'Give homework');
        $('#btnSave').html(h ? '<i class="bx bx-save me-1"></i>Save changes' : '<i class="bx bx-send me-1"></i>Give homework');
        $('#fSection').val(h ? h.sectionId : ($('#hSection').val() || ''));
        loadSubjects($('#fSection').val(), h ? h.subjectId : null);
        $('#fTitle').val(h ? h.title : ''); $('#fDetails').val(h ? (h.details || '') : '');
        $('#fGiven').val(h ? h.given : TODAY); $('#fDue').val(h ? h.due : addDays(1));
        bootstrap.Modal.getOrCreateInstance(document.getElementById('hwModal')).show();
    }
    function byId(id) { return items.filter(function (h) { return h.id === id; })[0]; }

    $('#btnNew').on('click', function () { openForm(null); });
    $('#hList').on('click', '.hw-edit', function () { openForm(byId($(this).data('id'))); });

    $('#btnSave').on('click', function () {
        var body = { id: editId || null, sectionId: +$('#fSection').val() || 0, subjectId: +$('#fSubject').val() || 0,
                     title: $('#fTitle').val().trim(), details: $('#fDetails').val().trim(), given: $('#fGiven').val(), due: $('#fDue').val() };
        if (!body.sectionId || !body.subjectId) { ecToast('error', 'Pick the class and subject.'); return; }
        if (!body.title) { ecToast('error', 'Write what the homework is.'); return; }
        if (!body.due) { ecToast('error', 'Choose the due date.'); return; }
        var $b = $(this); EC.buttonBusy($b);
        post(URL.save, body)
            .done(function (r) {
                ecToast(r.success ? 'success' : 'error', r.message);
                if (r.success) { bootstrap.Modal.getInstance(document.getElementById('hwModal')).hide(); load(); }
            })
            .fail(function () { ecToast('error', 'Could not save. Please try again.'); })
            .always(function () { EC.buttonReset($b); });
    });

    $('#hList').on('click', '.hw-del', function () {
        var h = byId($(this).data('id'));
        EC.confirm({ title: 'Delete this homework?', name: h.subject + ': ' + h.title, okText: 'Delete' }).then(function (ok) {
            if (!ok) return;
            $.ajax({ url: URL.del + '?id=' + h.id, type: 'POST', headers: { 'RequestVerificationToken': CSRF } })
                .done(function (r) { ecToast(r.success ? 'success' : 'error', r.message); if (r.success) load(); })
                .fail(function () { ecToast('error', 'Could not delete. Please try again.'); });
        });
    });

    // ── who did it ──────────────────────────────────────────────────────
    var chkId = 0, chk = [];
    var MARKS = [['Done', 'Done'], ['NotDone', 'Not done'], ['Late', 'Late']];

    $('#hList').on('click', '.hw-check', function () {
        var h = byId($(this).data('id'));
        chkId = h.id;
        $('#chkTitle').text(h.section + ' · ' + h.subject + ': ' + h.title);
        $('#chkList').html('<div class="text-muted p-3">Loading...</div>');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('chkModal')).show();
        $.getJSON(URL.students, { id: h.id }).done(function (list) { chk = list || []; drawCheck(); });
    });

    function drawCheck() {
        if (!chk.length) { $('#chkList').html('<div class="text-muted p-3">No students in this class.</div>'); return; }
        $('#chkList').html(chk.map(function (s, i) {
            return '<div class="hw-stu"><div class="hw-sname">' + (s.roll ? '<small>' + EC.esc(s.roll) + '.</small> ' : '') + EC.esc(s.name) + '</div><div class="hw-marks">'
                 + MARKS.map(function (m) { return '<button class="hw-mk mk-' + m[0] + (s.status === m[0] ? ' on' : '') + '" data-i="' + i + '" data-s="' + m[0] + '">' + m[1] + '</button>'; }).join('')
                 + '</div></div>';
        }).join(''));
    }
    $('#chkList').on('click', '.hw-mk', function () {
        var s = chk[$(this).data('i')], v = $(this).data('s');
        s.status = s.status === v ? null : v;
        $(this).siblings().removeClass('on'); $(this).toggleClass('on', !!s.status);
    });
    $('#btnAllDone').on('click', function () { chk.forEach(function (s) { if (!s.status) s.status = 'Done'; }); drawCheck(); });
    $('#btnChkSave').on('click', function () {
        var $b = $(this); EC.buttonBusy($b);
        post(URL.check, { id: chkId, marks: chk.map(function (s) { return { id: s.id, status: s.status || '' }; }) })
            .done(function (r) {
                ecToast(r.success ? 'success' : 'error', r.message);
                if (r.success) { bootstrap.Modal.getInstance(document.getElementById('chkModal')).hide(); load(); }
            })
            .fail(function () { ecToast('error', 'Could not save. Please try again.'); })
            .always(function () { EC.buttonReset($b); });
    });

    // ── Overview (academics.view) ───────────────────────────────────────
    // Teachers come from the timetable, so someone who gives nothing still shows.
    var OV = null, ovClass = '', ovFilter = '', ovAllClasses = null;

    $('#hwTabs').on('click', 'button', function () {
        $('#hwTabs button').removeClass('on'); $(this).addClass('on');
        var ov = $(this).data('t') === 'overview';
        $('#paneList').toggleClass('d-none', ov); $('#paneOverview').toggleClass('d-none', !ov);
        $('#btnNew').toggleClass('d-none', ov);
        if (ov && !OV) loadOverview();
    });

    function pct(a, b) { return b > 0 ? Math.round(a * 100 / b) : null; }
    function pctText(a, b) { var p = pct(a, b); return p === null ? '—' : p + '%'; }
    function daysAgo(iso) {
        if (!iso) return 'never';
        var n = Math.round((new Date(TODAY + 'T00:00:00') - new Date(iso + 'T00:00:00')) / 86400000);
        return n <= 0 ? 'today' : n === 1 ? 'yesterday' : n + ' days ago';
    }
    // All = homework in every section they teach; Some = in a few; None = nothing in these dates
    function coverage(t) { return t.sets === 0 ? 'None' : t.covered >= t.sections ? 'All' : 'Some'; }

    function ovRange() {
        var r = $('#ovRange .on').data('r');
        if (r === 'custom') return { from: $('#ovFrom').val(), to: $('#ovTo').val() };
        if (r === 'all') return { from: '2000-01-01', to: TODAY };
        return { from: addDays(-r), to: TODAY };
    }

    function loadOverview() {
        var r = ovRange();
        if (!r.from || !r.to) return;
        $('#ovTeachers').html('<tr><td colspan="8" class="text-muted text-center py-3">Loading...</td></tr>');
        $.getJSON(URL.overview, { from: r.from, to: r.to, cls: ovClass }).done(function (d) {
            OV = d; drawOverview();
        }).fail(function () { ecToast('error', 'Could not load the overview.'); });
    }

    $('#ovRange').on('click', 'button', function () {
        $('#ovRange button').removeClass('on'); $(this).addClass('on');
        var custom = $(this).data('r') === 'custom';
        $('#ovCustom').toggleClass('d-none', !custom);
        if (custom && !$('#ovFrom').val()) { $('#ovFrom').val(addDays(-29)); $('#ovTo').val(TODAY); }
        loadOverview();
    });
    $('#ovFrom, #ovTo').on('change', loadOverview);
    $('#ovClasses').on('click', 'button', function () { ovClass = $(this).data('c') || ''; ovFilter = ''; loadOverview(); });
    $('#ovLegend').on('click', '.hw-leg', function () { ovFilter = ovFilter === $(this).data('f') ? '' : $(this).data('f'); drawTeachers(); });
    $('#ovSearch').on('input', drawTeachers);

    function drawOverview() {
        var T = OV.teachers || [], C = OV.classes || [], S = OV.subjects || [];

        // class chips (done % of the homework given in that class); the list is kept from the "All" load
        if (!ovClass) ovAllClasses = C;
        var chips = ovAllClasses || C;
        $('#ovClasses').html('<button data-c="" class="' + (ovClass ? '' : 'on') + '">All classes</button>' + chips.map(function (c) {
            return '<button data-c="' + EC.esc(c.name) + '" class="' + (ovClass === c.name ? 'on' : '') + '">' + EC.esc(c.name)
                 + ' <small>' + (c.sets ? pctText(c.done, c.expected) : '—') + '</small></button>';
        }).join(''));

        var none = T.filter(function (t) { return coverage(t) === 'None'; }),
            some = T.filter(function (t) { return coverage(t) === 'Some'; }),
            all  = T.filter(function (t) { return coverage(t) === 'All'; });
        var sets = 0, givers = 0, checked = 0, classSets = 0;
        T.forEach(function (t) { sets += t.sets; checked += t.checkedSets; if (t.sets) givers++; });
        // homework given by someone with no timetable periods (e.g. the admin) still counts in the class totals
        C.forEach(function (c) { classSets += c.sets; });

        $('#ovKpis').html(
            kpi('bx-user-x', 'red', none.length, 'Teachers giving none', 'of ' + T.length + ' teaching here')
          + kpi('bx-error-circle', 'amber', some.length, 'Missing some sections', 'give homework, but not in every section')
          + kpi('bx-book-open', 'blue', classSets, 'Homework given', 'by ' + givers + ' teacher(s)')
          + kpi('bx-check-square', 'green', pctText(checked, sets), 'Checked in class', checked + ' of ' + sets + ' marked'));

        // donut
        var n = T.length || 1, a = all.length * 360 / n, b = (all.length + some.length) * 360 / n;
        $('#ovDonut').css('background', T.length
            ? 'conic-gradient(#28c76f 0 ' + a + 'deg, #ff9f43 ' + a + 'deg ' + b + 'deg, #ea5455 ' + b + 'deg 360deg)' : '#eef0f2');
        $('#ovDonutN').text(T.length);
        var legend = [['All', 'All their sections', '#28c76f', all], ['Some', 'Some sections', '#ff9f43', some], ['None', 'None at all', '#ea5455', none]];
        $('#ovLegend').html(legend.map(function (l) {
            return '<div class="hw-leg" data-f="' + l[0] + '"><i style="background:' + l[2] + '"></i>' + l[1]
                 + '<b>' + l[3].length + '</b><small>' + pctText(l[3].length, T.length) + '</small></div>';
        }).join(''));

        // nobody giving homework: the busiest teachers first
        none.sort(function (x, y) { return y.periods - x.periods; });
        $('#ovNobody').html(none.length ? none.map(function (t) {
            return '<div class="hw-nb"><div><b>' + EC.esc(t.name) + '</b><small>' + t.periods + ' periods/week across ' + t.sections + ' section(s)</small></div>'
                 + '<span>' + EC.esc(t.last ? 'last ' + daysAgo(t.last) : 'never') + '</span></div>';
        }).join('') : '<div class="text-muted p-3 text-center"><i class="bx bx-check-circle me-1"></i>Every teacher gave homework in these dates.</div>');

        drawTeachers();

        // leaderboard: only teachers who gave something
        var lead = T.filter(function (t) { return t.sets > 0; }).map(function (t) {
            var cov = t.sections ? Math.min(t.covered / t.sections, 1) : 0, rec = t.expected ? t.recorded / t.expected : 0;
            return { t: t, cov: cov, rec: rec, score: Math.round(60 * cov + 40 * rec) };
        });
        lead.sort(function (x, y) { return y.score - x.score || y.t.sets - x.t.sets; });
        $('#ovLeaders').html(lead.length ? lead.slice(0, 10).map(function (l, i) {
            return '<div class="hw-lead"><span class="hw-rank">' + (i + 1) + '</span><div class="hw-lead-n"><b>' + EC.esc(l.t.name) + '</b>'
                 + '<small>' + l.t.sets + ' given · ' + l.t.covered + '/' + l.t.sections + ' sections · ' + pctText(l.t.done, l.t.expected) + ' done</small></div>'
                 + '<div class="hw-lead-s"><small>Coverage ' + Math.round(l.cov * 100) + '% · Checked ' + Math.round(l.rec * 100) + '%</small><b>' + l.score + '</b></div></div>';
        }).join('') : '<div class="text-muted">No homework given in these dates.</div>');

        // was it done (class totals)
        var exp = 0, recd = 0, done = 0;
        C.forEach(function (c) { exp += c.expected; recd += c.recorded; done += c.done; });
        var notDone = recd - done, noRecord = Math.max(exp - recd, 0);
        $('#ovDone').html(exp
            ? '<div class="hw-stack"><i style="width:' + pct(done, exp) + '%;background:#28c76f"></i><i style="width:' + pct(notDone, exp) + '%;background:#ea5455"></i></div>'
              + '<div class="hw-done-legend"><span><b class="s-d">' + done + '</b> done (' + pctText(done, exp) + ')</span>'
              + '<span><b class="s-n">' + notDone + '</b> not done</span><span><b>' + noRecord + '</b> not checked</span></div>'
            : '<div class="text-muted">No homework given in these dates.</div>');

        $('#ovSubjects').html(S.length ? S.map(function (x) {
            var p = pct(x.done, x.expected);
            return '<div class="hw-subj-row"><span>' + EC.esc(x.name) + '</span><small>' + x.sets + ' given</small>'
                 + '<div class="hw-bar"><i style="width:' + (p || 0) + '%"></i></div><b>' + (p === null ? '—' : p + '%') + '</b></div>';
        }).join('') : '<div class="text-muted">—</div>');

        $('#ovClassGrid').html(C.map(function (c) {
            return '<div class="hw-class-card' + (c.sets ? '' : ' empty') + '"><b>' + EC.esc(c.name) + '</b>'
                 + '<small>' + c.sections + ' section(s) · ' + c.students + ' students</small>'
                 + '<div>' + (c.sets ? c.sets + ' homework · <b>' + pctText(c.done, c.expected) + '</b> done' : 'No homework') + '</div></div>';
        }).join('') || '<div class="text-muted">No classes.</div>');
    }

    function kpi(icon, tone, value, label, sub) {
        return '<div class="hw-kpi"><span class="hw-kpi-ic ' + tone + '"><i class="bx ' + icon + '"></i></span><b>' + EC.esc(value) + '</b>'
             + '<div class="hw-kpi-l">' + EC.esc(label) + '</div><small>' + EC.esc(sub) + '</small></div>';
    }

    function drawTeachers() {
        if (!OV) return;
        var q = ($('#ovSearch').val() || '').trim().toLowerCase();
        var rows = (OV.teachers || []).filter(function (t) {
            return (!ovFilter || coverage(t) === ovFilter) && (!q || t.name.toLowerCase().indexOf(q) >= 0);
        });
        var filterName = { All: 'all their sections', Some: 'some sections', None: 'none at all' };
        $('#ovTeacherFilter').text(ovFilter ? '· ' + filterName[ovFilter] : '');
        $('#ovLegend .hw-leg').each(function () { $(this).toggleClass('on', $(this).data('f') === ovFilter); });
        var badge = { All: 'ok', Some: 'some', None: 'none' }, label = { All: 'All sections', Some: 'Some sections', None: 'None set' };
        $('#ovTeachers').html(rows.length ? rows.map(function (t) {
            var c = coverage(t);
            return '<tr><td class="fw-semibold">' + EC.esc(t.name) + '</td><td><span class="hw-badge ' + badge[c] + '">' + label[c] + '</span></td>'
                 + '<td class="text-center">' + t.sets + '</td><td class="text-center">' + t.covered + '/' + t.sections + '</td>'
                 + '<td class="text-center">' + t.periods + '</td><td>' + EC.esc(daysAgo(t.last)) + '</td>'
                 + '<td class="text-center">' + pctText(t.recorded, t.expected) + '</td><td class="text-center">' + pctText(t.done, t.expected) + '</td></tr>';
        }).join('') : '<tr><td colspan="8" class="text-muted text-center py-3">No teachers.</td></tr>');
    }

    load();
});
</script>
}
