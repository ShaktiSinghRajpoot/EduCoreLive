@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Linq
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model EduCoreDataAccessLayer.Models.StaffListItem
@{
    ViewData["Title"] = "All Staff";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";

    var palette = new[] { "primary", "info", "success", "warning", "danger", "secondary" };

    string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "—" : string.Concat(parts.Take(2).Select(w => w[0])).ToUpper();
    }

    // Whitelisted server-side sort header link (preserves filters, drops Page).
    string SortUrl(string col)
    {
        var q = Context.Request.Query
            .Where(k => !new[] { "SortColumn", "SortDir", "Page" }.Contains(k.Key, StringComparer.OrdinalIgnoreCase))
            .ToDictionary(k => k.Key, k => k.Value.ToString());
        q["SortColumn"] = col;
        q["SortDir"] = (string.Equals(Model.SortColumn, col, StringComparison.OrdinalIgnoreCase) && !Model.Desc) ? "desc" : "asc";
        return Context.Request.Path + QueryString.Create(q);
    }
    string SortIcon(string col)
    {
        if (!string.Equals(Model.SortColumn, col, StringComparison.OrdinalIgnoreCase)) return "bx bx-sort";
        return "bx " + (Model.Desc ? "bx-sort-down" : "bx-sort-up") + " text-primary";
    }
    bool Sel(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Staff/StaffList.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content st-page">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap d-flex align-items-center gap-2">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-group fs-4"></i></div>
          <div>
            <h4 class="ec-page-title mb-0">All Staff</h4>
            <div class="text-muted" style="font-size:.8rem">@Model.TotalCount staff member@(Model.TotalCount == 1 ? "" : "s")</div>
          </div>
        </div>
        <a class="btn btn-primary d-flex align-items-center gap-1" asp-area="ERP" asp-controller="Staff" asp-action="AddStaff">
          <i class="bx bx-user-plus"></i><span>Add Staff</span>
        </a>
      </div>
    </div>

    <div class="st-card p-3">

      @* All filtering/sorting/paging is server-side: this GET form round-trips
         the query string. Omitting Page resets to page 1 on any filter change;
         sort is carried in hidden fields so it survives a filter change. *@
      <form id="staffFilterForm" method="get" asp-area="ERP" asp-controller="Staff" asp-action="StaffList" class="st-bar mb-3">
        <input type="hidden" name="SortColumn" value="@Model.SortColumn" />
        <input type="hidden" name="SortDir" value="@Model.SortDirection" />

        <div class="st-search">
          <i class="bx bx-search"></i>
          <input type="text" name="Search" value="@Model.Search" class="form-control"
                 placeholder="Search name, ID or designation…" onchange="this.form.submit()">
        </div>
        <select name="FilterDepartment" class="form-select" style="max-width:170px" onchange="this.form.submit()">
          <option value="">All Departments</option>
          @foreach (var d in Model.DepartmentList)
          {
              <option value="@d.Value" selected="@Sel(d.Value, Model.FilterDepartment)">@d.Text</option>
          }
        </select>
        <select name="FilterStaffType" class="form-select" style="max-width:150px" onchange="this.form.submit()">
          <option value="">All Types</option>
          @foreach (var t in Model.StaffTypeList)
          {
              <option value="@t.Value" selected="@Sel(t.Value, Model.FilterStaffType)">@t.Text</option>
          }
        </select>
        <select name="FilterStatus" class="form-select" style="max-width:140px" onchange="this.form.submit()">
          <option value="">All Status</option>
          <option value="Active" selected="@Sel("Active", Model.FilterStatus)">Active</option>
          <option value="On Leave" selected="@Sel("On Leave", Model.FilterStatus)">On Leave</option>
          <option value="Inactive" selected="@Sel("Inactive", Model.FilterStatus)">Inactive</option>
        </select>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.FilterDepartment)
             || !string.IsNullOrEmpty(Model.FilterStaffType) || !string.IsNullOrEmpty(Model.FilterStatus))
        {
            <a asp-area="ERP" asp-controller="Staff" asp-action="StaffList" class="btn btn-outline-secondary">
              <i class="bx bx-x"></i> Clear
            </a>
        }
      </form>

      <!-- Table -->
      <div class="table-responsive">
        <table class="table align-middle mb-0" id="tbl">
          <thead>
            <tr>
              <th><a class="text-reset text-decoration-none" href="@SortUrl("name")">Staff <i class="@SortIcon("name")"></i></a></th>
              <th><a class="text-reset text-decoration-none" href="@SortUrl("designation")">Designation <i class="@SortIcon("designation")"></i></a></th>
              <th><a class="text-reset text-decoration-none" href="@SortUrl("department")">Department <i class="@SortIcon("department")"></i></a></th>
              <th>Type</th><th>Contact</th><th>Status</th><th></th>
            </tr>
          </thead>
          <tbody>
          @{ int i = 0; }
          @foreach (var s in Model.Items)
          {
              var status = string.IsNullOrEmpty(s.Status) ? "Active" : s.Status;
              var color = palette[i % palette.Length];
              i++;
              <tr>
                <td>
                  <a asp-area="ERP" asp-controller="Staff" asp-action="StaffProfile" asp-route-id="@s.StaffId"
                     class="d-flex align-items-center gap-2 text-decoration-none">
                    <span class="st-av bg-label-@color text-@color">@Initials(s.FullName)</span>
                    <div>
                      <div class="fw-bold" style="color:var(--ec-text-dark)">@s.FullName</div>
                      <div class="text-muted" style="font-size:.75rem">@(string.IsNullOrWhiteSpace(s.EmployeeCode) ? "—" : s.EmployeeCode)</div>
                    </div>
                  </a>
                </td>
                <td>@(string.IsNullOrWhiteSpace(s.Designation) ? "—" : s.Designation)</td>
                <td>@(string.IsNullOrWhiteSpace(s.Department) ? "—" : s.Department)</td>
                <td>@(string.IsNullOrWhiteSpace(s.StaffType) ? "—" : Html.Raw($"<span class='st-type'>{s.StaffType}</span>"))</td>
                <td>@(string.IsNullOrWhiteSpace(s.Mobile) ? "—" : s.Mobile)</td>
                <td><span class="st-bdg b-@(status.Replace(" ", ""))">@status</span></td>
                <td class="text-end">
                  <a asp-area="ERP" asp-controller="Staff" asp-action="StaffProfile" asp-route-id="@s.StaffId"
                     class="btn btn-sm btn-outline-secondary">Profile</a>
                </td>
              </tr>
          }
          </tbody>
        </table>
        @if (!Model.Items.Any())
        {
          <div class="text-center text-muted py-4">No staff match your filters.</div>
        }
      </div>

      <div class="sl-pg-wrap d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3 pt-3 border-top">
        <div class="d-flex align-items-center gap-2 text-muted" style="font-size:.81rem">
          <partial name="_PageSize" model="Model" view-data='@(new ViewDataDictionary(ViewData) { { "FormId", "staffFilterForm" } })' />
          @if (Model.TotalCount > 0)
          {
              <span class="ms-1">Showing @Model.FirstRow–@Model.LastRow of @Model.TotalCount staff</span>
          }
        </div>
        <partial name="_Pager" model="Model" />
      </div>

    </div>
  </div>
</div>
