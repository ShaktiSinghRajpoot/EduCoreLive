@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Purchase Entry";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Inventory/PurchaseEntry.css" asp-append-version="true" />
}

<div class="ec-page-shell purchase-page">
    <div class="ec-page-content">

        <div class="ec-page-header">
            <div class="ec-page-header-inner">
                <div class="ec-page-title-wrap d-flex align-items-center gap-3">
                    <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
                        <i class="bx bx-cart-download fs-4"></i>
                    </div>
                    <div>
                        <h4 class="ec-page-title mb-1">Purchase Entry</h4>
                        <div class="ec-page-subtitle">Record supplier purchases and automatically increase inventory stock.</div>
                    </div>
                </div>
                <div class="header-actions d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-1" id="historyBtn">
                        <i class="bx bx-history"></i><span>Purchase History</span>
                    </button>
                    <button type="button" class="btn btn-primary d-flex align-items-center gap-1" id="printBtn">
                        <i class="bx bx-printer"></i><span>Print Preview</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="iv-card">
                    <div class="iv-card-ic bg-label-primary text-primary"><i class="bx bx-rupee"></i></div>
                    <div><div class="iv-card-val" id="sumToday">—</div><div class="iv-card-lbl">Today's Purchases</div></div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="iv-card">
                    <div class="iv-card-ic bg-label-info text-info"><i class="bx bx-receipt"></i></div>
                    <div><div class="iv-card-val" id="sumBills">—</div><div class="iv-card-lbl">Bills This Month</div></div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="iv-card">
                    <div class="iv-card-ic bg-label-success text-success"><i class="bx bx-package"></i></div>
                    <div><div class="iv-card-val" id="sumQty">—</div><div class="iv-card-lbl">Quantity Bought This Month</div></div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="iv-card">
                    <div class="iv-card-ic bg-label-warning text-warning"><i class="bx bx-store"></i></div>
                    <div><div class="iv-card-val" id="sumSuppliers">—</div><div class="iv-card-lbl">Suppliers</div></div>
                </div>
            </div>
        </div>

        <div class="ec-card mb-3">
            <div class="ec-card-header">
                <div class="ec-section-title-wrap d-flex align-items-center gap-2">
                    <div class="ec-section-icon"><i class="bx bx-file"></i></div>
                    <div>
                        <div class="ec-section-title">Purchase Information</div>
                        <div class="ec-section-subtitle">Supplier invoice and purchase details.</div>
                    </div>
                </div>
            </div>
            <div class="ec-card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">Supplier</label>
                        <div class="d-flex gap-1">
                          <select class="form-select" id="supplierId">
                            <option value="">Select Supplier</option>
@foreach (var s in (List<EduCoreDataAccessLayer.Models.ERP.InventorySupplier>)(ViewBag.Suppliers ?? new List<EduCoreDataAccessLayer.Models.ERP.InventorySupplier>()))
{
                            <option value="@s.SupplierId">@s.SupplierName</option>
}
                          </select>
                          <button type="button" class="btn btn-outline-secondary" id="addSupplierBtn" title="Add supplier">
                            <i class="bx bx-plus"></i>
                          </button>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">Purchase Date</label>
                        <input type="date" class="form-control" id="purchaseDate" max="@ViewBag.Today">
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">Invoice Number</label>
                        <input type="text" class="form-control" id="invoiceNumber" placeholder="INV-2026-001">
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">Payment Mode</label>
                        <select class="form-select" id="paymentMode">
                            <option>Cash</option><option>Bank Transfer</option><option>UPI</option><option>Cheque</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" id="purchaseRemarks" rows="2" placeholder="Purchase remarks"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="ec-card mb-3">
            <div class="ec-card-header">
                <div class="d-flex justify-content-between gap-3 flex-wrap align-items-center">
                    <div class="ec-section-title-wrap d-flex align-items-center gap-2">
                        <div class="ec-section-icon"><i class="bx bx-grid-alt"></i></div>
                        <div>
                            <div class="ec-section-title">Purchase Items</div>
                            <div class="ec-section-subtitle">Add inventory items for stock purchase.</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary d-flex align-items-center gap-1" id="addPurchaseRowBtn">
                        <i class="bx bx-plus"></i><span>Add Item</span>
                    </button>
                </div>
            </div>
            <div class="ec-card-body p-0">
                <div class="purchase-grid-wrap">
                    <table class="table purchase-grid">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th width="150">Quantity</th>
                                <th width="160">Unit Price</th>
                                <th width="140">Tax %</th>
                                <th width="180">Total</th>
                                <th width="70"></th>
                            </tr>
                        </thead>
                        <tbody id="purchaseGridBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <div class="ec-card h-100 mb-0">
                    <div class="ec-card-body">
                        <div class="ec-section-title-wrap d-flex align-items-center gap-2 mb-3">
                            <div class="ec-section-icon"><i class="bx bx-info-circle"></i></div>
                            <div>
                                <div class="ec-section-title">Purchase Notes</div>
                                <div class="ec-section-subtitle">Inventory stock will increase after purchase save.</div>
                            </div>
                        </div>
                        <div class="ec-detail-box">
                            <ul class="mb-0 ps-3 small fw-semibold">
                                <li>Every purchase creates inventory transaction history.</li>
                                <li>Stock is automatically updated after save.</li>
                                <li>A bill number can be entered only once per supplier (and once among bills with no supplier).</li>
                                <li>Quantities and prices take at most 2 decimal places; a bill cannot be dated in the future.</li>
                                <li>Purchase can later be linked with accounts module.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="purchase-total-box p-3 h-100">
                    <div class="purchase-total-row"><span>Sub Total</span><strong id="subTotalAmount">₹0.00</strong></div>
                    <div class="purchase-total-row"><span>Total Tax</span><strong id="taxAmount">₹0.00</strong></div>
                    <div class="purchase-total-row"><span>Grand Total</span><strong class="fs-5" id="grandTotalAmount">₹0.00</strong></div>
                </div>
            </div>
        </div>

        <div class="purchase-sticky-footer mt-3 p-3 rounded-4">
            <div class="d-flex justify-content-end gap-2 flex-wrap purchase-footer-actions">
                <button type="button" class="btn btn-outline-secondary px-4" id="cancelPurchaseBtn">Cancel</button>
                <button type="button" class="btn btn-primary px-4" id="savePurchaseBtn">
                    <i class="bx bx-save me-1"></i> Save Purchase
                </button>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <div>
          <h5 class="modal-title fw-bold">Purchase History</h5>
          <small class="text-muted">A saved purchase is never edited — it can only be cancelled, which reverses its stock.</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Date</th><th>Supplier</th><th>Invoice</th><th>Mode</th>
                <th class="text-end">Items</th><th class="text-end">Total</th>
                <th>Status</th><th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody id="historyBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="supplierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Add Supplier</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Supplier Name</label>
            <input type="text" class="form-control" id="spName" placeholder="ABC Uniform House">
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label">Contact Person</label>
            <input type="text" class="form-control" id="spContact">
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label">Mobile</label>
            <input type="text" class="form-control" id="spMobile">
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" id="spEmail">
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label">GSTIN</label>
            <input type="text" class="form-control" id="spGstin">
          </div>
          <div class="col-12">
            <label class="form-label">Address</label>
            <textarea class="form-control" id="spAddress" rows="2"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer flex-column flex-sm-row">
        <button type="button" class="btn btn-outline-secondary w-100 w-sm-auto" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary w-100 w-sm-auto" id="saveSupplierBtn">
          <i class="bx bx-save me-1"></i> Save Supplier
        </button>
      </div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
(function () {
    'use strict';

    var SAVE_URL      = '@Url.Action("SavePurchase", "Inventory", new { area = "ERP" })';
    var LIST_URL      = '@Url.Action("Purchases", "Inventory", new { area = "ERP" })';
    var CANCEL_URL    = '@Url.Action("CancelPurchase", "Inventory", new { area = "ERP" })';
    var SUPPLIER_URL  = '@Url.Action("SaveSupplier", "Inventory", new { area = "ERP" })';
    var SUPPLIERS_URL = '@Url.Action("Suppliers", "Inventory", new { area = "ERP" })';

    // The item catalog is rendered by the server from the same list the item
    // master shows — the page used to carry its own hardcoded copy.
    var ITEMS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ((List<EduCoreDataAccessLayer.Models.ERP.InventoryItem>)(ViewBag.Items
            ?? new List<EduCoreDataAccessLayer.Models.ERP.InventoryItem>()))
        .Select(i => new { id = i.ItemId, name = i.ItemName, unit = i.UnitType, cost = i.CostPrice })));

    // The school's date from the server. new Date().toISOString() is the UTC
    // date, which in India is still yesterday until 05:30 in the morning.
    var TODAY = '@ViewBag.Today';

    var rows = [];      // the lines being entered
    var seq  = 0;
    var lastList = []; // the last purchase list loaded, for the cancel dialog

    function token() {
        return $('input[name="__RequestVerificationToken"]').first().val();
    }

    function postJson(url, body) {
        return $.ajax({
            url: url, type: 'POST', contentType: 'application/json',
            headers: { 'RequestVerificationToken': token(), 'X-Requested-With': 'XMLHttpRequest' },
            data: JSON.stringify(body)
        });
    }

    function itemOptions(selected) {
        var html = '<option value="">Select item</option>';
        ITEMS.forEach(function (i) {
            html += '<option value="' + i.id + '"' + (i.id === selected ? ' selected' : '') + '>' +
                    EC.esc(i.name) + '</option>';
        });
        return html;
    }

    // Round to paise the way PostgreSQL does (half away from zero). The tiny
    // nudge stops 83.325 being read as 83.32499999 by floating point.
    function r2(x) {
        return Math.round(x * 100 + (x >= 0 ? 1e-6 : -1e-6)) / 100;
    }

    // Same arithmetic as the proc: the line's base and its tax are each rounded
    // once, and the bill is the sum of its lines -- so screen and saved bill agree.
    function lineBase(r) { return r2(EC.num(r.qty) * EC.num(r.price)); }
    function lineTax(r)  { return r2(lineBase(r) * EC.num(r.tax) / 100); }
    function lineTotal(r) { return lineBase(r) + lineTax(r); }

    // At most 2 decimals, as the server insists.
    function twoDp(v) {
        v = String(v == null ? '' : v).trim();
        return v === '' || /^\d+(\.\d{1,2})?$/.test(v);
    }

    function renderGrid() {
        if (!rows.length) {
            $('#purchaseGridBody').html(
                '<tr><td colspan="6" class="text-center py-4">' +
                '<div class="text-muted mb-2">No items added yet.</div>' +
                '<button type="button" class="btn btn-primary" id="emptyAddRowBtn">' +
                '<i class="bx bx-plus me-1"></i>Add Purchase Item</button></td></tr>');
            totals();
            return;
        }

        $('#purchaseGridBody').html(rows.map(function (r) {
            var it = ITEMS.find(function (x) { return x.id === r.itemId; });
            return '<tr data-id="' + r.id + '">' +
                '<td><select class="form-select form-select-sm" data-f="itemId">' + itemOptions(r.itemId) + '</select>' +
                    (it ? '<div class="text-muted small mt-1">' + EC.esc(it.unit) + '</div>' : '') + '</td>' +
                '<td><input type="number" class="form-control form-control-sm" data-f="qty" min="0" step="0.01" value="' + r.qty + '"></td>' +
                '<td><input type="number" class="form-control form-control-sm" data-f="price" min="0" step="0.01" value="' + r.price + '"></td>' +
                '<td><input type="number" class="form-control form-control-sm" data-f="tax" min="0" max="100" step="0.01" value="' + r.tax + '"></td>' +
                '<td class="fw-semibold">' + EC.money(lineTotal(r)) + '</td>' +
                '<td class="text-end"><button type="button" class="btn btn-sm btn-icon btn-text-danger" data-drop="' + r.id + '">' +
                    '<i class="bx bx-trash"></i></button></td>' +
            '</tr>';
        }).join(''));
        totals();
    }

    function totals() {
        var sub = 0, tax = 0;
        rows.forEach(function (r) {
            sub += lineBase(r);
            tax += lineTax(r);
        });
        $('#subTotalAmount').text(EC.money(sub));
        $('#taxAmount').text(EC.money(tax));
        $('#grandTotalAmount').text(EC.money(sub + tax));
    }

    function addRow() {
        if (!ITEMS.length) {
            ecToast('warning', 'Add an item in the Item Master first.');
            return;
        }
        rows.push({ id: ++seq, itemId: 0, qty: 1, price: 0, tax: 0 });
        renderGrid();
    }

    $(document)
        .on('click', '#addPurchaseRowBtn, #emptyAddRowBtn', addRow)
        .on('click', '[data-drop]', function () {
            var id = EC.num($(this).data('drop'));
            rows = rows.filter(function (r) { return r.id !== id; });
            renderGrid();
        })
        .on('change input', '#purchaseGridBody [data-f]', function () {
            var $el = $(this);
            var id  = EC.num($el.closest('tr').data('id'));
            var r   = rows.find(function (x) { return x.id === id; });
            if (!r) return;

            var field = $el.data('f');
            if (field === 'itemId') {
                r.itemId = EC.num($el.val());
                // Prefill the price from the item's standard cost, which the
                // buyer can still override with what the invoice actually says.
                var it = ITEMS.find(function (x) { return x.id === r.itemId; });
                if (it && EC.num(r.price) === 0) r.price = EC.num(it.cost);
                renderGrid();
                return;
            }
            r[field] = EC.numPos($el.val());
            r[field + 'Raw'] = $el.val();   // kept to check decimals on save
            // Only the affected line and the totals change, so the inputs keep
            // focus while the user is typing.
            $el.closest('tr').find('td').eq(4).text(EC.money(lineTotal(r)));
            totals();
        });

    // ── Save ────────────────────────────────────────────────────────────────
    $('#savePurchaseBtn').on('click', function () {
        var $btn = $(this);
        var date = $('#purchaseDate').val();
        if (!date) { ecToast('warning', 'Choose the purchase date.'); $('#purchaseDate').focus(); return; }

        if (date > TODAY) { ecToast('warning', 'A purchase cannot be dated in the future.'); $('#purchaseDate').focus(); return; }

        var lines = rows.filter(function (r) { return r.itemId > 0 && EC.num(r.qty) > 0; });
        if (!lines.length) { ecToast('warning', 'Add at least one item with a quantity.'); return; }
        if (rows.some(function (r) { return !(r.itemId > 0); })) {
            ecToast('warning', 'Pick an item on every line, or remove the empty line.'); return;
        }
        var badDp = lines.some(function (r) {
            return !twoDp(r.qtyRaw) || !twoDp(r.priceRaw) || !twoDp(r.taxRaw);
        });
        if (badDp) { ecToast('warning', 'Quantity, price and tax take at most 2 decimal places.'); return; }
        if (lines.some(function (r) { return EC.num(r.tax) > 100; })) {
            ecToast('warning', 'Tax must be between 0 and 100 percent.'); return;
        }

        EC.buttonBusy($btn, 'Saving…');
        postJson(SAVE_URL, {
            supplierId:   EC.num($('#supplierId').val()) || null,
            purchaseDate: date,
            invoiceNo:    $.trim($('#invoiceNumber').val()),
            paymentMode:  $('#paymentMode').val(),
            remarks:      $.trim($('#purchaseRemarks').val()),
            items: lines.map(function (r) {
                return {
                    itemId:     r.itemId,
                    quantity:   EC.numPos(r.qty),
                    unitPrice:  EC.numPos(r.price),
                    taxPercent: EC.numPos(r.tax)
                };
            })
        })
        .done(function (res) {
            if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not save.'); return; }
            ecToast('success', res.message + ' Stock has been updated.');
            resetForm();
            loadSummary();
        })
        .fail(function () { ecToast('error', 'Could not save the purchase.'); })
        .always(function () { EC.buttonReset($btn); });
    });

    function resetForm() {
        rows = [];
        $('#invoiceNumber,#purchaseRemarks').val('');
        $('#supplierId').val('');
        $('#purchaseDate').val(TODAY);
        renderGrid();
    }

    $('#cancelPurchaseBtn').on('click', function () {
        EC.confirm({
            title:   'Clear this form?',
            message: 'Everything typed on this form will be discarded. Nothing has been saved yet.',
            okText:  'Clear form',
            danger:  false,
            icon:    'bx-eraser'
        }).then(function (ok) { if (ok) resetForm(); });
    });

    // ── Summary cards ───────────────────────────────────────────────────────
    // Real figures from the same purchase list the history shows; cancelled
    // bills do not count. Refreshed after every save and cancel.
    function loadSummary() {
        $.get(LIST_URL).done(function (d) {
            var month = TODAY.slice(0, 7);
            var today = 0, bills = 0, qty = 0;
            (d || []).forEach(function (p) {
                if (p.cancelled) return;
                var iso = String(p.iso || '');
                if (iso === TODAY) today += EC.num(p.total);
                if (iso.slice(0, 7) === month) { bills++; qty += EC.num(p.qty); }
            });
            $('#sumToday').text(EC.money(today));
            $('#sumBills').text(bills);
            $('#sumQty').text(qty);
        });
        $.get(SUPPLIERS_URL).done(function (list) { $('#sumSuppliers').text((list || []).length); });
    }

    // ── History ─────────────────────────────────────────────────────────────
    $('#historyBtn').on('click', function () {
        EC.listLoading('#historyBody', 'Loading purchases…');
        new bootstrap.Modal(document.getElementById('historyModal')).show();

        $.get(LIST_URL)
            .done(function (d) {
                lastList = d || [];
                if (!d || !d.length) {
                    EC.listEmpty('#historyBody', 'No purchases recorded yet.', 'bx-receipt');
                    return;
                }
                $('#historyBody').html(d.map(function (p) {
                    return '<tr' + (p.cancelled ? ' class="text-muted"' : '') + '>' +
                        '<td>' + EC.esc(p.date) + '</td>' +
                        '<td>' + EC.esc(p.supplier || '—') + '</td>' +
                        '<td>' + EC.esc(p.invoice || '—') + '</td>' +
                        '<td>' + EC.esc(p.mode || '—') + '</td>' +
                        '<td class="text-end">' + p.lines + '</td>' +
                        '<td class="text-end fw-semibold">' + EC.money(p.total) + '</td>' +
                        '<td>' + (p.cancelled
                            ? '<span class="badge bg-label-danger">Cancelled</span>'
                            : '<span class="badge bg-label-success">Saved</span>') + '</td>' +
                        '<td class="text-end">' + (p.cancelled ? '' :
                            '<button class="btn btn-sm btn-text-danger" data-cancel="' + p.id + '">Cancel</button>') +
                        '</td></tr>';
                }).join(''));
            })
            .fail(function () {
                EC.listEmpty('#historyBody', 'Could not load purchases.', 'bx-error-circle');
            });
    });

    $(document).on('click', '[data-cancel]', function () {
        var id = EC.num($(this).data('cancel'));
        var p  = lastList.find(function (x) { return x.id === id; });
        EC.prompt({
            title:    'Cancel this purchase?',
            name:     p ? ((p.invoice ? 'Bill ' + p.invoice : 'Bill without number') +
                           ' — ' + (p.supplier || 'no supplier') + ' — ' + EC.money(p.total)) : '',
            message:  'The stock it brought in will be taken back out. The bill stays on record, marked cancelled.',
            label:    'Why is it being cancelled?',
            required: true,
            okText:   'Cancel purchase',
            icon:     'bx-x-circle'
        }).then(function (reason) {
            if (reason === null) return;
            EC.showLoader();
            postJson(CANCEL_URL, { id: id, reason: reason })
                .done(function (res) {
                    // Refused when the goods have already been issued — the proc
                    // says which item and by how much.
                    if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not cancel.'); return; }
                    ecToast('success', res.message);
                    loadSummary();
                    $('#historyBtn').trigger('click');
                })
                .fail(function () { ecToast('error', 'Could not cancel the purchase.'); })
                .always(EC.hideLoader);
        });
    });

    // ── Supplier ────────────────────────────────────────────────────────────
    $('#addSupplierBtn').on('click', function () {
        $('#spName,#spContact,#spMobile,#spEmail,#spGstin,#spAddress').val('');
        new bootstrap.Modal(document.getElementById('supplierModal')).show();
    });

    $('#saveSupplierBtn').on('click', function () {
        var $btn = $(this);
        var name = $.trim($('#spName').val());
        if (!name) { ecToast('warning', 'Enter the supplier name.'); $('#spName').focus(); return; }

        EC.buttonBusy($btn, 'Saving…');
        postJson(SUPPLIER_URL, {
            supplierId:    0,
            supplierName:  name,
            contactPerson: $.trim($('#spContact').val()),
            mobile:        $.trim($('#spMobile').val()),
            email:         $.trim($('#spEmail').val()),
            gstin:         $.trim($('#spGstin').val()),
            address:       $.trim($('#spAddress').val())
        })
        .done(function (res) {
            if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not save.'); return; }
            ecToast('success', res.message);
            bootstrap.Modal.getInstance(document.getElementById('supplierModal')).hide();

            // Refresh the picker and select what was just added.
            $.get(SUPPLIERS_URL).done(function (list) {
                var html = '<option value="">Select Supplier</option>';
                (list || []).forEach(function (s) {
                    html += '<option value="' + s.id + '">' + EC.esc(s.name) + '</option>';
                });
                $('#supplierId').html(html).val(res.id);
                $('#sumSuppliers').text((list || []).length);
            });
        })
        .fail(function () { ecToast('error', 'Could not save the supplier.'); })
        .always(function () { EC.buttonReset($btn); });
    });

    // Printing a purchase was never built in the shell and still is not.
    $('#printBtn').on('click', function () {
        ecToast('info', 'Purchase printing is not built yet.');
    });

    $('#purchaseDate').val(TODAY);
    renderGrid();
    loadSummary();
})();
</script>
}
