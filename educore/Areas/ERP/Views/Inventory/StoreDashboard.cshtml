@{
    ViewData["Title"] = "Store Dashboard";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    string year = ViewBag.CurrentYear as string ?? "";
    bool canGive = ViewBag.CanGive == true;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Inventory/InventoryItem.css" asp-append-version="true" />
<style>
  .sd-kpi { display:block; text-decoration:none; color:inherit; }
  .sd-kpi .iv-card { height:100%; }
  .sd-sub { font-size:.72rem; color:var(--ec-text-muted, #8b8fa3); font-weight:650; margin-top:.15rem; }
  .sd-panel .ec-card-body { padding-top:.5rem; }
  .sd-row { display:flex; align-items:center; gap:.6rem; padding:.5rem 0; border-bottom:1px solid #f4eee7; }
  .sd-row:last-child { border-bottom:0; }
  .sd-bar { height:.4rem; border-radius:999px; background:#f0eee9; overflow:hidden; margin-top:.25rem; }
  .sd-bar span { display:block; height:100%; border-radius:inherit; }
  .sd-empty { text-align:center; color:var(--ec-text-muted, #8b8fa3); font-size:.85rem; padding:1.4rem .5rem; }
  .sd-empty i { display:block; font-size:1.7rem; color:#16a34a; margin-bottom:.2rem; }
  .sd-scroll { max-height:20rem; overflow-y:auto; overflow-x:hidden; }
</style>
}

<div class="ec-page-shell inventory-item-page">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap d-flex align-items-center gap-3">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-grid-alt fs-4"></i></div>
          <div>
            <h4 class="ec-page-title mb-1">Store Dashboard</h4>
            <div class="ec-page-subtitle">The store at a glance: stock, what is running out, what to order, who still needs items, and money in and out@(year != "" ? " · session " + year : "")</div>
          </div>
        </div>
        <div class="d-flex gap-2 flex-wrap ec-head-actions">
          <a class="btn btn-outline-secondary d-flex align-items-center gap-1" asp-area="ERP" asp-controller="Inventory" asp-action="InventoryItem">
            <i class="bx bx-box"></i><span>Store</span>
          </a>
          @if (canGive)
          {
              <a class="btn btn-primary d-flex align-items-center gap-1" asp-area="ERP" asp-controller="Inventory" asp-action="StudentSale">
                <i class="bx bx-gift"></i><span>Give items</span>
              </a>
          }
        </div>
      </div>
    </div>

    @* the six figures; each card opens the page it comes from *@
    <div class="row g-3 mb-3" id="sdKpis">
      <div class="col-6 col-xl-2"><a class="sd-kpi" href="@Url.Action("InventoryItem", "Inventory", new { area = "ERP" })"><div class="iv-card">
        <div class="iv-card-ic bg-label-primary text-primary"><i class="bx bx-package"></i></div>
        <div><div class="iv-card-val" id="kStock">—</div><div class="iv-card-lbl">Stock value</div><div class="sd-sub" id="kStockSub">&nbsp;</div></div></div></a></div>
      <div class="col-6 col-xl-2"><a class="sd-kpi" href="@Url.Action("InventoryItem", "Inventory", new { area = "ERP" })"><div class="iv-card">
        <div class="iv-card-ic bg-label-danger text-danger"><i class="bx bx-error-circle"></i></div>
        <div><div class="iv-card-val" id="kLow">—</div><div class="iv-card-lbl">Low / out of stock</div><div class="sd-sub" id="kLowSub">&nbsp;</div></div></div></a></div>
      <div class="col-6 col-xl-2"><a class="sd-kpi" href="@Url.Action("StudentSale", "Inventory", new { area = "ERP" })"><div class="iv-card">
        <div class="iv-card-ic bg-label-success text-success"><i class="bx bx-trending-up"></i></div>
        <div><div class="iv-card-val" id="kSold">—</div><div class="iv-card-lbl">Sold this month</div><div class="sd-sub" id="kSoldSub">&nbsp;</div></div></div></a></div>
      <div class="col-6 col-xl-2"><a class="sd-kpi" href="@Url.Action("Index", "FeeDueReminders", new { area = "ERP" })"><div class="iv-card">
        <div class="iv-card-ic bg-label-warning text-warning"><i class="bx bx-time-five"></i></div>
        <div><div class="iv-card-val" id="kUnpaid">—</div><div class="iv-card-lbl">Unpaid by students</div><div class="sd-sub" id="kUnpaidSub">&nbsp;</div></div></div></a></div>
      <div class="col-6 col-xl-2"><a class="sd-kpi" href="@Url.Action("PurchaseEntry", "Inventory", new { area = "ERP" })"><div class="iv-card">
        <div class="iv-card-ic bg-label-info text-info"><i class="bx bx-cart"></i></div>
        <div><div class="iv-card-val" id="kBought">—</div><div class="iv-card-lbl">Bought this month</div><div class="sd-sub" id="kBoughtSub">&nbsp;</div></div></div></a></div>
      <div class="col-6 col-xl-2"><a class="sd-kpi" href="@Url.Action("SupplierMaster", "Inventory", new { area = "ERP" })"><div class="iv-card">
        <div class="iv-card-ic bg-label-secondary text-secondary"><i class="bx bx-store"></i></div>
        <div><div class="iv-card-val" id="kOwed">—</div><div class="iv-card-lbl">Owed to suppliers</div><div class="sd-sub" id="kOwedSub">&nbsp;</div></div></div></a></div>
    </div>

    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <div class="ec-card h-100 mb-0 sd-panel">
          <div class="ec-card-header d-flex justify-content-between align-items-center gap-2">
            <div><div class="ec-section-title">Running low</div><div class="ec-section-subtitle">At or below the minimum stock alert</div></div>
            <a class="btn btn-sm btn-outline-primary" style="width:auto" asp-area="ERP" asp-controller="Inventory" asp-action="PurchaseEntry">Purchase</a>
          </div>
          <div class="ec-card-body sd-scroll" id="pLow"><div class="sd-empty">Loading…</div></div>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="ec-card h-100 mb-0 sd-panel">
          <div class="ec-card-header d-flex justify-content-between align-items-center gap-2">
            <div><div class="ec-section-title">To order</div><div class="ec-section-subtitle">Children who still need an item, minus stock@(year != "" ? " · " + year : "")</div></div>
            <a class="btn btn-sm btn-outline-primary" style="width:auto" asp-area="ERP" asp-controller="Inventory" asp-action="OrderList">Order list</a>
          </div>
          <div class="ec-card-body sd-scroll" id="pOrder"><div class="sd-empty">Loading…</div></div>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="ec-card h-100 mb-0 sd-panel">
          <div class="ec-card-header d-flex justify-content-between align-items-center gap-2">
            <div><div class="ec-section-title">Children with everything</div><div class="ec-section-subtitle">Per class: who has every item meant for them@(year != "" ? " · " + year : "")</div></div>
            <a class="btn btn-sm btn-outline-primary" style="width:auto" asp-area="ERP" asp-controller="StoreRegister" asp-action="Index">Register</a>
          </div>
          <div class="ec-card-body sd-scroll" id="pClasses"><div class="sd-empty">Loading…</div></div>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="ec-card h-100 mb-0 sd-panel">
          <div class="ec-card-header d-flex justify-content-between align-items-center gap-2">
            <div><div class="ec-section-title">Latest sales</div><div class="ec-section-subtitle">Books and uniform given to students</div></div>
            @if (canGive)
            {
                <a class="btn btn-sm btn-outline-primary" style="width:auto" asp-area="ERP" asp-controller="Inventory" asp-action="StudentSale">Give items</a>
            }
          </div>
          <div class="ec-card-body sd-scroll" id="pSales"><div class="sd-empty">Loading…</div></div>
        </div>
      </div>
    </div>

  </div>
</div>

@section PageScripts {
<script>
$(function () {
    var URL = {
        items:     '@Url.Action("Items", "Inventory", new { area = "ERP" })',
        summary:   '@Url.Action("StoreSummary", "Inventory", new { area = "ERP" })',
        suppliers: '@Url.Action("Suppliers", "Inventory", new { area = "ERP" })',
        order:     '@Url.Action("OrderListData", "Inventory", new { area = "ERP" })',
        overview:  '@Url.Action("Overview", "StoreRegister", new { area = "ERP" })',
        sales:     '@Url.Action("Sales", "Inventory", new { area = "ERP" })'
    };
    var YEAR = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(year))';
    var month = EC.dateRange('month');

    function empty(msg, ok) {
        return '<div class="sd-empty">' + (ok ? '<i class="bx bx-check-circle"></i>' : '') + EC.esc(msg) + '</div>';
    }

    // ── stock: value, low / out, and the "Running low" list ──
    $.getJSON(URL.items).done(function (rows) {
        rows = rows || [];
        var value = 0, low = [], nLow = 0, nOut = 0;
        rows.forEach(function (r) {
            value += EC.num(r.value);
            if (r.status === 'Low Stock')    { nLow++; low.push(r); }
            if (r.status === 'Out of Stock') { nOut++; low.push(r); }
        });
        $('#kStock').text(EC.money(value));
        $('#kStockSub').text(rows.length + ' item' + (rows.length === 1 ? '' : 's') + ' · at cost');
        $('#kLow').text(nLow + nOut);
        $('#kLowSub').text(nLow + ' low · ' + nOut + ' out');
        if (!low.length) { $('#pLow').html(empty('Every item is above its minimum stock.', true)); return; }
        low.sort(function (a, b) { return EC.num(a.stock) - EC.num(b.stock); });
        $('#pLow').html(low.map(function (r) {
            var out = r.status === 'Out of Stock';
            return '<div class="sd-row"><div class="flex-grow-1 min-w-0"><div class="fw-semibold text-truncate">' + EC.esc(r.name) + '</div>'
                 + '<div class="small text-muted">' + EC.num(r.stock) + ' ' + EC.esc(r.unit) + ' left · alert at ' + EC.num(r.minStock) + '</div></div>'
                 + '<span class="badge ' + (out ? 'bg-label-danger' : 'bg-label-warning') + '">' + (out ? 'Out' : 'Low') + '</span></div>';
        }).join(''));
    }).fail(function () { $('#pLow').html(empty('Could not load the items.')); });

    // ── money this month, and what students still owe this session ──
    $.getJSON(URL.summary, { from: month.from, to: month.to }).done(function (s) {
        $('#kSold').text(EC.money(s.sold));
        $('#kSoldSub').text('margin ' + EC.money(s.margin));
        $('#kBought').text(EC.money(s.bought));
        $('#kBoughtSub').text('supplier bills, returns taken off');
    });
    // everything sold so far, so "unpaid" is all that is still owed, not just this month's
    $.getJSON(URL.summary, { from: '2000-01-01', to: month.to }).done(function (s) {
        $('#kUnpaid').text(EC.money(s.unpaid));
        $('#kUnpaidSub').text('collected ' + EC.money(s.collected) + ' so far');
    });

    // ── what the school owes its suppliers (credit bills) ──
    $.getJSON(URL.suppliers).done(function (list) {
        var owed = 0, n = 0;
        (list || []).forEach(function (s) { if (EC.num(s.due) > 0) { owed += EC.num(s.due); n++; } });
        $('#kOwed').text(EC.money(owed));
        $('#kOwedSub').text(n ? n + ' supplier' + (n === 1 ? '' : 's') + ' to pay' : 'nothing on credit');
    });

    // ── to order for this session ──
    if (!YEAR) {
        $('#pOrder, #pClasses').html(empty('No current session is set (School Setup › Academic Year).'));
    } else {
        $.getJSON(URL.order, { year: YEAR }).done(function (r) {
            var list = (r && r.rows || []).filter(function (x) { return x.order > 0; });
            if (!r || !r.success) { $('#pOrder').html(empty('Could not load the order list.')); return; }
            if (!list.length) { $('#pOrder').html(empty('Nothing to order: the stock covers every child who still needs an item.', true)); return; }
            list.sort(function (a, b) { return b.order - a.order; });
            $('#pOrder').html(list.map(function (x) {
                return '<div class="sd-row"><div class="flex-grow-1 min-w-0"><div class="fw-semibold text-truncate">' + EC.esc(x.item) + '</div>'
                     + '<div class="small text-muted">' + EC.num(x.need) + ' still need · ' + EC.num(x.stock) + ' in stock</div></div>'
                     + '<span class="fw-bold text-nowrap" style="color:#c2410c">Order ' + EC.num(x.order) + '</span></div>';
            }).join(''));
        }).fail(function () { $('#pOrder').html(empty('Could not load the order list.')); });

        // ── children with everything, per class ──
        $.getJSON(URL.overview, { year: YEAR }).done(function (r) {
            if (!r || !r.success) { $('#pClasses').html(empty((r && r.message) || 'Could not load the register.')); return; }
            if (!r.rows.length || !r.columns.length) { $('#pClasses').html(empty('No items for students, or no children in this session yet.')); return; }
            $('#pClasses').html(r.rows.map(function (x) {
                var pct = x.students ? Math.round(x.complete * 100 / x.students) : 0;
                var color = pct === 100 ? '#16a34a' : (pct >= 50 ? '#d97706' : '#dc2626');
                return '<div class="sd-row"><div class="flex-grow-1 min-w-0">'
                     + '<div class="d-flex justify-content-between"><span class="fw-semibold">' + EC.esc(x.cls) + (x.sec ? ' – ' + EC.esc(x.sec) : '') + '</span>'
                     + '<span class="small fw-semibold">' + x.complete + ' / ' + x.students + '</span></div>'
                     + '<div class="sd-bar"><span style="width:' + pct + '%;background:' + color + '"></span></div></div></div>';
            }).join(''));
        }).fail(function () { $('#pClasses').html(empty('Could not load the register.')); });
    }

    // ── latest sales ──
    $.getJSON(URL.sales).done(function (rows) {
        rows = (rows || []).slice(0, 10);
        if (!rows.length) { $('#pSales').html(empty('No sales yet.')); return; }
        $('#pSales').html(rows.map(function (x) {
            var status = x.returned ? '<span class="badge bg-label-secondary">Returned</span>'
                       : x.open <= 0 ? '<span class="badge bg-label-success">Paid</span>'
                       : x.paid > 0 ? '<span class="badge bg-label-warning">Part paid</span>'
                       : '<span class="badge bg-label-danger">Unpaid</span>';
            return '<div class="sd-row"><div class="flex-grow-1 min-w-0"><div class="fw-semibold text-truncate">' + EC.esc(x.item) + (x.qty !== 1 ? ' × ' + EC.num(x.qty) : '') + '</div>'
                 + '<div class="small text-muted text-truncate">' + EC.esc(x.name) + ' · ' + EC.esc(x.cls) + ' · ' + EC.esc(x.date ? EC.date(x.date) : '') + '</div></div>'
                 + '<div class="text-end text-nowrap"><div class="fw-semibold">' + EC.money(x.amount) + '</div>' + status + '</div></div>';
        }).join(''));
    }).fail(function () { $('#pSales').html(empty('Could not load the sales.')); });
});
</script>
}
