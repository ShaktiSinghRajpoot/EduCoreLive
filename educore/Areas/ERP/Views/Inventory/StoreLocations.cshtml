@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Store Locations";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Inventory/InventoryItem.css" asp-append-version="true" />
}

<div class="ec-page-shell inventory-item-page">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap d-flex align-items-center gap-3">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-map-pin fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Store Locations</h4>
            <div class="ec-page-subtitle">Where stock is kept: Main Store, labs, sports room. Stock moves between them by transfer.</div>
          </div>
        </div>
        <div class="d-flex gap-2 flex-wrap ec-head-actions">
          <a class="btn btn-outline-secondary d-flex align-items-center gap-1" asp-area="ERP" asp-controller="Inventory" asp-action="InventoryItem">
            <i class="bx bx-box"></i><span>Store</span>
          </a>
          <button class="btn btn-primary d-flex align-items-center gap-1" id="addLocationBtn">
            <i class="bx bx-plus"></i><span>Add Location</span>
          </button>
        </div>
      </div>
    </div>

    <div class="ec-card mb-3">
      <div class="ec-card-header">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-buildings"></i></span>
          <div>
            <div class="ec-section-title">Locations</div>
            <div class="ec-section-subtitle">The default location takes purchases and movements that name no location. It cannot be deactivated. A location that still holds stock cannot be deactivated either.</div>
          </div>
        </div>
      </div>
      <div class="ec-card-body pt-2">
        <div class="iv-tbl-wrap">
          <table class="table iv-tbl align-middle mb-0">
            <thead>
              <tr>
                <th>Location</th><th>Status</th>
                <th class="text-end">Items held</th><th class="text-end">Quantity</th>
                <th class="text-end" title="Quantity x each item's cost price">Value (at cost)</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody id="locBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
          <div class="ec-section-title-wrap">
            <span class="ec-section-icon"><i class="bx bx-transfer-alt"></i></span>
            <div>
              <div class="ec-section-title">Transfer History</div>
              <div class="ec-section-subtitle">Newest first. Transfers are made from the item list (Inventory › Store).</div>
            </div>
          </div>
          <select class="iv-chip" id="trFilter" title="Transfers in or out of one location">
            <option value="">All locations</option>
          </select>
        </div>
      </div>
      <div class="ec-card-body pt-2">
        <div class="iv-tbl-wrap">
          <table class="table iv-tbl align-middle mb-0">
            <thead>
              <tr>
                <th>Date</th><th>Item</th><th>From</th><th>To</th>
                <th class="text-end">Qty</th><th>Reason</th><th>By</th>
              </tr>
            </thead>
            <tbody id="trBody"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<div class="modal fade" id="locModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="locModalTitle">Add Location</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="locId">
        <label class="form-label">Location name</label>
        <input type="text" class="form-control" id="locName" maxlength="100" placeholder="Science Lab">
      </div>
      <div class="modal-footer flex-column flex-sm-row">
        <button type="button" class="btn btn-outline-secondary w-100 w-sm-auto" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary w-100 w-sm-auto" id="saveLocBtn">
          <i class="bx bx-save me-1"></i> Save Location
        </button>
      </div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
(function () {
    'use strict';

    var LOCS_URL      = '@Url.Action("Locations", "Inventory", new { area = "ERP" })';
    var SAVE_URL      = '@Url.Action("SaveLocation", "Inventory", new { area = "ERP" })';
    var ACTIVE_URL    = '@Url.Action("SetLocationActive", "Inventory", new { area = "ERP" })';
    var TRANSFERS_URL = '@Url.Action("Transfers", "Inventory", new { area = "ERP" })';

    var locations = [];

    function token() {
        return $('input[name="__RequestVerificationToken"]').first().val();
    }

    function postJson(url, body) {
        return $.ajax({
            url: url, type: 'POST', contentType: 'application/json',
            headers: { 'RequestVerificationToken': token(), 'X-Requested-With': 'XMLHttpRequest' },
            data: JSON.stringify(body)
        });
    }

    // ── Locations ───────────────────────────────────────────────────────────
    function loadLocations() {
        EC.listLoading('#locBody', 'Loading locations…');
        $.get(LOCS_URL)
            .done(function (d) {
                locations = d || [];
                if (!locations.length) {
                    EC.listEmpty('#locBody', 'No locations yet.', 'bx-map-pin');
                    return;
                }
                $('#locBody').html(locations.map(function (l) {
                    return '<tr' + (l.active ? '' : ' class="text-muted"') + '>' +
                        '<td class="fw-semibold">' + EC.esc(l.name) +
                            (l.isDefault ? ' <span class="badge bg-label-primary ms-1">Default</span>' : '') + '</td>' +
                        '<td>' + (l.active ? '<span class="badge bg-label-success">Active</span>'
                                           : '<span class="badge bg-label-secondary">Inactive</span>') + '</td>' +
                        '<td class="text-end">' + EC.num(l.items) + '</td>' +
                        '<td class="text-end">' + EC.num(l.qty) + '</td>' +
                        '<td class="text-end">' + EC.money(l.value) + '</td>' +
                        '<td class="text-end text-nowrap">' +
                            '<button class="btn btn-sm btn-icon btn-text-secondary" data-rename="' + l.id + '" title="Rename"><i class="bx bx-edit"></i></button>' +
                            (l.isDefault ? '' : (l.active
                                ? '<button class="btn btn-sm btn-text-danger" data-off="' + l.id + '">Deactivate</button>'
                                : '<button class="btn btn-sm btn-text-success" data-on="' + l.id + '">Activate</button>')) +
                        '</td></tr>';
                }).join(''));

                var keep = $('#trFilter').val();
                $('#trFilter').html('<option value="">All locations</option>' + locations.map(function (l) {
                    return '<option value="' + l.id + '">' + EC.esc(l.name) + '</option>';
                }).join('')).val(keep);
            })
            .fail(function () {
                EC.listEmpty('#locBody', 'Could not load locations. Please retry.', 'bx-error-circle');
            });
    }

    function findLoc(id) {
        return locations.find(function (x) { return x.id === id; });
    }

    $('#addLocationBtn').on('click', function () {
        $('#locId').val('');
        $('#locName').val('');
        $('#locModalTitle').text('Add Location');
        new bootstrap.Modal(document.getElementById('locModal')).show();
    });

    $(document).on('click', '[data-rename]', function () {
        var l = findLoc(EC.num($(this).data('rename')));
        if (!l) return;
        $('#locId').val(l.id);
        $('#locName').val(l.name);
        $('#locModalTitle').text('Rename Location');
        new bootstrap.Modal(document.getElementById('locModal')).show();
    });

    $('#saveLocBtn').on('click', function () {
        var $btn = $(this);
        var name = $.trim($('#locName').val());
        if (!name) { ecToast('warning', 'Enter the location name.'); $('#locName').focus(); return; }

        EC.buttonBusy($btn, 'Saving…');
        postJson(SAVE_URL, { id: EC.num($('#locId').val()) || 0, name: name })
            .done(function (res) {
                if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not save.'); return; }
                ecToast('success', res.message);
                bootstrap.Modal.getInstance(document.getElementById('locModal')).hide();
                loadLocations();
                loadTransfers();
            })
            .fail(function () { ecToast('error', 'Could not save the location.'); })
            .always(function () { EC.buttonReset($btn); });
    });

    function setActive(id, active) {
        var l = findLoc(id);
        EC.confirm({
            title:   active ? 'Activate this location?' : 'Deactivate this location?',
            name:    l ? l.name : '',
            message: active
                ? 'It can be picked again for purchases, movements and transfers.'
                : 'It will no longer be offered for purchases, movements or transfers. Its history is kept.',
            okText:  active ? 'Activate' : 'Deactivate',
            danger:  !active
        }).then(function (ok) {
            if (!ok) return;
            EC.showLoader();
            postJson(ACTIVE_URL, { id: id, active: active })
                .done(function (res) {
                    // Refused (with the amounts) when the location still holds stock.
                    if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not change it.'); return; }
                    ecToast('success', res.message);
                    loadLocations();
                })
                .fail(function () { ecToast('error', 'Could not change the location.'); })
                .always(EC.hideLoader);
        });
    }

    $(document)
        .on('click', '[data-off]', function () { setActive(EC.num($(this).data('off')), false); })
        .on('click', '[data-on]',  function () { setActive(EC.num($(this).data('on')), true); });

    // ── Transfers ───────────────────────────────────────────────────────────
    function loadTransfers() {
        EC.listLoading('#trBody', 'Loading transfers…');
        var loc = $('#trFilter').val();
        $.get(TRANSFERS_URL, loc ? { location: loc } : {})
            .done(function (d) {
                if (!d || !d.length) {
                    EC.listEmpty('#trBody', 'No transfers yet.', 'bx-transfer-alt');
                    return;
                }
                $('#trBody').html(d.map(function (t) {
                    return '<tr>' +
                        '<td>' + EC.esc(t.date) + '</td>' +
                        '<td class="fw-semibold">' + EC.esc(t.item) + '</td>' +
                        '<td>' + EC.esc(t.from) + '</td>' +
                        '<td>' + EC.esc(t.to) + '</td>' +
                        '<td class="text-end">' + EC.num(t.qty) + ' <span class="small text-muted">' + EC.esc(t.unit) + '</span></td>' +
                        '<td class="small">' + EC.esc(t.reason) + '</td>' +
                        '<td class="small">' + EC.esc(t.by) + '<div class="text-muted">' + EC.esc(t.at) + '</div></td>' +
                    '</tr>';
                }).join(''));
            })
            .fail(function () {
                EC.listEmpty('#trBody', 'Could not load transfers. Please retry.', 'bx-error-circle');
            });
    }

    $('#trFilter').on('change', loadTransfers);

    loadLocations();
    loadTransfers();
})();
</script>
}
