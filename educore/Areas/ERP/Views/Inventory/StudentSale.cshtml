@{
    ViewData["Title"] = "Student Items";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var locations = ViewBag.Locations as List<EduCoreDataAccessLayer.Models.ERP.InventoryLocation>
                    ?? new List<EduCoreDataAccessLayer.Models.ERP.InventoryLocation>();
    string? sessionStart = ViewBag.SessionStart as string;   // for the summary's "This session"
    string schoolName    = ViewBag.SchoolName as string ?? "";      // for the "Items given" slip
    string schoolAddress = ViewBag.SchoolAddress as string ?? "";
    string givenBy       = User.FindFirst(EduCoreDataAccessLayer.Helpers.Common.SK_UserName)?.Value ?? "";
}

@section PageStyles {
<style>
  .ss-pick { cursor:pointer; }
  .ss-qty { width:80px; }
  .ss-cat td { background:var(--bs-tertiary-bg); font-weight:800; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
  .ss-total { font-size:1.4rem; font-weight:900; }
  .ss-kpi { border:1px solid var(--bs-border-color); border-radius:12px; padding:.6rem .75rem; background:var(--bs-body-bg); height:100%; }
  .ss-kpi .v { font-size:1.15rem; font-weight:900; line-height:1.1; }
  .ss-kpi .l { font-size:.68rem; font-weight:700; text-transform:uppercase; color:var(--bs-secondary-color); letter-spacing:.03em; }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
          <div class="ec-page-title-wrap">
            <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
              <i class="bx bx-book-bookmark fs-4"></i>
            </div>
            <div>
              <h4 class="ec-page-title mb-1">Student Items</h4>
              <div class="ec-page-subtitle">Give books, uniform, diary to a student — the amount goes on their fee account, paid now or later at Collect Fees</div>
            </div>
          </div>
          <a class="btn btn-outline-secondary text-nowrap ms-lg-auto" href="@Url.Action("InventoryItem", "Inventory", new { area = "ERP" })"><i class="bx bx-plus me-1"></i>Add item</a>
        </div>
      </div>
    </div>

    @await Html.PartialAsync("_StudentItemsTabs", "give")

    <!-- store summary: bought, sold, margin, collected, unpaid, stock -->
    <div class="ec-card mb-3"><div class="ec-card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div class="fw-semibold">Store summary <span class="text-muted small fw-normal" id="sumRange"></span></div>
        <div class="btn-group btn-group-sm" role="group">
          <button type="button" class="btn btn-outline-primary active" data-sum="month">This month</button>
          <button type="button" class="btn btn-outline-primary" data-sum="last">Last month</button>
          @if (!string.IsNullOrEmpty(sessionStart))
          {
              <button type="button" class="btn btn-outline-primary" data-sum="session">This session</button>
          }
        </div>
      </div>
      <div class="row g-2" id="sumCards"></div>
      <div class="small text-muted mt-2">Sold = what went on the children's fee accounts (returns taken off). Margin = sold − what those items cost. Bought = supplier bills of these items (returns taken off). The money comes in at Collect Fees and shows in the Cash Book as "Books &amp; Uniform sales".</div>
    </div></div>

    <!-- 1. the student -->
    <div class="ec-card mb-3"><div class="ec-card-body">
      <div class="d-flex flex-wrap gap-2 align-items-end">
        <div class="flex-grow-1" style="max-width:420px">
          <label class="form-label mb-1">Find student</label>
          <div class="input-group">
            <input id="ssFind" class="form-control" placeholder="Name, father's name, mobile or adm. no">
            <button class="btn btn-primary" id="ssFindGo" type="button"><i class="bx bx-search"></i></button>
          </div>
        </div>
        @if (locations.Count > 1)
        {
            <div>
              <label class="form-label mb-1">From store</label>
              <select id="ssLoc" class="form-select">
                @foreach (var l in locations)
                {
                    <option value="@l.LocationId" selected="@l.IsDefault">@l.LocationName</option>
                }
              </select>
            </div>
        }
      </div>
      <div id="ssResults" class="mt-2 d-none"></div>
      <div id="ssStudent" class="mt-3 d-none"></div>
    </div></div>

    <!-- 2. the items -->
    <div class="ec-card mb-3 d-none" id="ssItemsCard"><div class="ec-card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div class="fw-semibold" id="ssItemsTitle">Items</div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-primary" id="ssFillKit"><i class="bx bx-check-double me-1"></i>Tick all (1 each)</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="ssClear">Clear</button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead><tr><th>Item</th><th class="text-end">Price</th><th class="text-end d-none d-sm-table-cell">In stock</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
          <tbody id="ssItems"></tbody>
        </table>
      </div>
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <div><span class="text-muted small">Total</span> <span class="ss-total" id="ssTotal">₹0.00</span></div>
        <button type="button" class="btn btn-primary" id="ssGive"><i class="bx bx-check me-1"></i>Give items &amp; add to fee account</button>
      </div>
      <div id="ssDone" class="alert alert-success mt-3 mb-0 d-none"></div>
    </div></div>

    <!-- 3. sales -->
    <div class="ec-card mb-0"><div class="ec-card-body p-0">
      <div class="px-3 pt-3 fw-semibold" id="ssSalesTitle">Latest sales</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Date</th><th>Student</th><th>Item</th><th class="text-end">Amount</th><th>Status</th><th></th></tr></thead>
          <tbody id="ssSales"><tr><td colspan="6" class="text-muted small p-3">Loading…</td></tr></tbody>
        </table>
      </div>
    </div></div>

    @Html.AntiForgeryToken()
  </div>
</div>

@section PageScripts {
<script>
$(function () {
    var URL = {
        search:  '@Url.Action("SaleSearch", "Inventory", new { area = "ERP" })',
        student: '@Url.Action("SaleStudent", "Inventory", new { area = "ERP" })',
        items:   '@Url.Action("SaleItems", "Inventory", new { area = "ERP" })',
        sell:    '@Url.Action("Sell", "Inventory", new { area = "ERP" })',
        ret:     '@Url.Action("SaleReturn", "Inventory", new { area = "ERP" })',
        sales:   '@Url.Action("Sales", "Inventory", new { area = "ERP" })',
        kit:     '@Url.Action("SaveClassKit", "Inventory", new { area = "ERP" })',
        collect: '@Url.Action("ManageFee", "Fee", new { area = "ERP" })'
    };
    var student = null;      // {id, name, admNo, sessions:[{year, cls, sec, current}]}
    var items = [];          // items for sale, with the chosen class's set in .kit
    var qty = {};            // itemId -> quantity typed

    function token() { return $('input[name="__RequestVerificationToken"]').val(); }
    function post(url, data) {
        return $.ajax({ url: url, type: 'POST', contentType: 'application/json',
                        headers: { 'RequestVerificationToken': token() }, data: JSON.stringify(data) });
    }
    function storeId() { return $('#ssLoc').val() || null; }
    function session() {
        var y = $('#ssFor').val();
        return student ? student.sessions.filter(function (s) { return s.year === y; })[0] : null;
    }

    /* ── 1. find the student ── */
    function find() {
        var q = $('#ssFind').val().trim();
        if (q.length < 2) { ecToast('warning', 'Type at least 2 letters.'); return; }
        $.getJSON(URL.search, { q: q }).done(function (list) {
            list = list || [];
            if (!list.length) { $('#ssResults').addClass('d-none'); ecToast('error', 'No student found for "' + q + '".'); return; }
            if (list.length === 1) { pick(list[0].id); return; }
            $('#ssResults').removeClass('d-none').html('<div class="list-group">' + list.map(function (s) {
                return '<button type="button" class="list-group-item list-group-item-action ss-pick" data-id="' + s.id + '">'
                     + '<b>' + EC.esc(s.name) + '</b> <span class="text-muted small">' + EC.esc(s.cls) + (s.sec ? ' – ' + EC.esc(s.sec) : '')
                     + ' · ' + EC.esc(s.guardian || '—') + ' · ' + EC.esc(s.mobile || '—') + ' · ' + EC.esc(s.admNo) + '</span></button>';
            }).join('') + '</div>');
        }).fail(function () { ecToast('error', 'Could not search students.'); });
    }
    $('#ssFindGo').on('click', find);
    $('#ssFind').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); find(); } });
    $('#ssResults').on('click', '.ss-pick', function () { pick(+$(this).data('id')); });

    function pick(id) {
        $('#ssResults').addClass('d-none');
        $('#ssDone').addClass('d-none');
        $.getJSON(URL.student, { id: id }).done(function (r) {
            if (!r || !r.success) { ecToast('error', (r && r.message) || 'Could not open the student.'); return; }
            student = r;
            // a child promoted early can be given next session's books (charged in that session)
            var opts = r.sessions.map(function (s) {
                return '<option value="' + EC.esc(s.year) + '"' + (s.current ? ' selected' : '') + '>'
                     + EC.esc(s.year) + ' · ' + EC.esc(s.cls) + (s.sec ? ' – ' + EC.esc(s.sec) : '') + (s.current ? ' (now)' : ' (next session)') + '</option>';
            }).join('');
            $('#ssStudent').removeClass('d-none').html(
                '<div class="d-flex flex-wrap align-items-end gap-3">'
              + '<div><div class="fw-bold fs-5">' + EC.esc(r.name) + '</div><div class="text-muted small">' + EC.esc(r.admNo) + '</div></div>'
              + '<div><label class="form-label mb-1">Items for</label><select id="ssFor" class="form-select form-select-sm">' + opts + '</select></div>'
              + '</div>');
            $('#ssFor').on('change', function () { loadItems(false); });
            loadItems(false);
            loadSales();
        }).fail(function () { ecToast('error', 'Could not open the student.'); });
    }

    /* ── 2. the items ── */
    function loadItems(fillKit) {
        var s = session();
        $.getJSON(URL.items, { cls: s ? s.cls : '', location: storeId() }).done(function (list) {
            items = list || [];
            qty = {};
            if (fillKit) items.forEach(function (i) { if (i.kit > 0) qty[i.id] = i.kit; });
            $('#ssItemsCard').removeClass('d-none');
            $('#ssItemsTitle').text('Items' + (s ? ' for ' + s.cls + ' (' + s.year + ') — tick what the parent takes' : ''));
            renderItems();
        }).fail(function () { ecToast('error', 'Could not load the items.'); });
    }

    function renderItems() {
        if (!items.length) {
            $('#ssItems').html('<tr><td colspan="5" class="text-muted small p-3">Nothing to give yet. Use "Add item": type <b>Saleable</b>, a selling price, and which class it is for (sizes in one go).</td></tr>');
            $('#ssTotal').text(EC.money(0));
            return;
        }
        var html = '', cat = null;
        items.forEach(function (i) {
            if (i.category !== cat) { cat = i.category; html += '<tr class="ss-cat"><td colspan="5">' + EC.esc(cat) + '</td></tr>'; }
            var q = qty[i.id] || 0;
            html += '<tr' + (i.stock <= 0 ? ' class="text-muted"' : '') + '><td>' + EC.esc(i.name)
                  + (i.forClass ? ' <span class="badge bg-label-info">' + EC.esc(i.forClass) + '</span>' : '') + '</td>'
                  + '<td class="text-end">' + EC.money(i.price) + '</td>'
                  + '<td class="text-end d-none d-sm-table-cell">' + EC.num(i.stock) + '</td>'
                  + '<td class="text-end"><input type="number" min="0" step="1" class="form-control form-control-sm ss-qty ms-auto" data-id="' + i.id + '" value="' + (q || '') + '"'
                  + (i.stock <= 0 ? ' disabled title="Out of stock"' : '') + '></td>'
                  + '<td class="text-end" data-amt="' + i.id + '">' + (q ? EC.money(q * i.price) : '—') + '</td></tr>';
        });
        $('#ssItems').html(html);
        total();
    }

    function total() {
        var t = 0;
        items.forEach(function (i) { t += (qty[i.id] || 0) * i.price; });
        $('#ssTotal').text(EC.money(t));
        $('#ssGive').prop('disabled', t <= 0);
        return t;
    }

    $('#ssItems').on('input', '.ss-qty', function () {
        var id = +$(this).data('id'), q = Math.max(0, Number(this.value) || 0);
        var it = items.filter(function (i) { return i.id === id; })[0];
        if (q) qty[id] = q; else delete qty[id];
        $('[data-amt="' + id + '"]').text(q ? EC.money(q * it.price) : '—');
        total();
    });
    $('#ssFillKit').on('click', function () { loadItems(true); });
    $('#ssClear').on('click', function () { qty = {}; renderItems(); });
    $('#ssLoc').on('change', function () { if (student) loadItems(false); });

    $('#ssGive').on('click', function () {
        var s = session(), lines = Object.keys(qty).map(function (id) { return { itemId: +id, qty: qty[id] }; });
        if (!student || !s || !lines.length) return;
        // what the slip will show, taken now: the item list reloads after saving
        var slipLines = items.filter(function (i) { return qty[i.id]; })
                             .map(function (i) { return { name: i.name, qty: qty[i.id], price: i.price }; });
        var $btn = $(this);
        EC.buttonBusy($btn, 'Saving…');
        post(URL.sell, { studentId: student.id, academicYear: s.year, locationId: storeId(), items: lines })
            .done(function (r) {
                if (!r || !r.success) { ecToast('error', (r && r.message) || 'Could not give the items.'); return; }
                var now = student.sessions.filter(function (x) { return x.current; })[0] || s;
                lastSlip = { student: student.name, admNo: student.admNo, cls: s.cls + (s.sec ? ' – ' + s.sec : ''),
                             year: s.year, lines: slipLines, total: r.total };
                $('#ssDone').removeClass('d-none').html(EC.esc(r.message)
                    + ' <a class="btn btn-sm btn-success ms-2" href="' + URL.collect + '?adm=' + encodeURIComponent(student.admNo)
                    + '&session=' + encodeURIComponent(now.year) + '"><i class="bx bx-wallet me-1"></i>Collect now</a>'
                    + ' <button type="button" class="btn btn-sm btn-outline-secondary ms-1" id="ssSlip"><i class="bx bx-printer me-1"></i>Print slip</button>');
                ecToast('success', r.message);
                loadItems(false);
                loadSales();
            })
            .fail(function (xhr) { ecToast('error', EC.ajaxError(xhr, 'Could not give the items')); })
            .always(function () { EC.buttonReset($btn); });
    });

    /* ── "Items given" slip for the parent: what was taken, and that it is on the
          fee account. Not a receipt -- the receipt comes from Collect Fees. ── */
    var SCHOOL = { name:    '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(schoolName))',
                   address: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(schoolAddress))',
                   givenBy: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(givenBy))' };
    var lastSlip = null;

    function printSlip(d) {
        var rows = d.lines.map(function (l) {
            return '<tr><td>' + EC.esc(l.name) + '</td><td class="r">' + EC.num(l.qty) + '</td>'
                 + '<td class="r">' + EC.money(l.price) + '</td><td class="r">' + EC.money(l.qty * l.price) + '</td></tr>';
        }).join('');
        var html = '<!doctype html><html><head><meta charset="utf-8"><title>Items given</title><style>'
            + 'body{font-family:Arial,sans-serif;font-size:13px;color:#111;margin:16px;max-width:560px}'
            + 'h1{font-size:17px;margin:0}.sub{color:#555;font-size:12px}'
            + '.t{font-size:15px;font-weight:bold;margin:12px 0 6px;border-top:1px dashed #999;padding-top:8px}'
            + 'table{width:100%;border-collapse:collapse;margin-top:6px}td,th{padding:5px 4px;border-bottom:1px solid #ddd;text-align:left}.r{text-align:right}'
            + '.tot td{font-weight:bold;border-top:2px solid #111;border-bottom:0}'
            + '.note{margin-top:10px;padding:8px;border:1px solid #999;font-size:12px}'
            + '.sign{margin-top:36px;display:flex;justify-content:space-between;font-size:12px}'
            + '</style></head><body>'
            + '<h1>' + EC.esc(SCHOOL.name) + '</h1>' + (SCHOOL.address ? '<div class="sub">' + EC.esc(SCHOOL.address) + '</div>' : '')
            + '<div class="t">Items given (books &amp; uniform)</div>'
            + '<div><b>' + EC.esc(d.student) + '</b> · ' + EC.esc(d.admNo) + '</div>'
            + '<div class="sub">' + EC.esc(d.cls) + ' · Session ' + EC.esc(d.year) + ' · ' + EC.esc(EC.date(EC.today())) + '</div>'
            + '<table><thead><tr><th>Item</th><th class="r">Qty</th><th class="r">Rate</th><th class="r">Amount</th></tr></thead><tbody>' + rows
            + '<tr class="tot"><td colspan="3">Total</td><td class="r">' + EC.money(d.total) + '</td></tr></tbody></table>'
            + '<div class="note">This amount has been added to the child&rsquo;s fee account. Please pay at the school office; '
            + 'the fee receipt is given when you pay. This slip is not a receipt.</div>'
            + '<div class="sign"><span>Given by: ' + EC.esc(SCHOOL.givenBy) + '</span><span>Parent&rsquo;s signature: ____________</span></div>'
            + '</body></html>';
        // a hidden frame, not a pop-up window: phones and pop-up blockers allow it
        var f = document.createElement('iframe');
        f.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0';
        document.body.appendChild(f);
        f.contentDocument.open(); f.contentDocument.write(html); f.contentDocument.close();
        setTimeout(function () {
            f.contentWindow.focus(); f.contentWindow.print();
            setTimeout(function () { f.remove(); }, 1000);
        }, 300);
    }
    $('#ssDone').on('click', '#ssSlip', function () { if (lastSlip) printSlip(lastSlip); });

    /* ── 3. sales (this student's, or the latest of everyone) ── */
    function loadSales() {
        $.getJSON(URL.sales, { studentId: student ? student.id : null }).done(function (rows) {
            rows = rows || [];
            $('#ssSalesTitle').text(student ? 'Sales to ' + student.name : 'Latest sales');
            if (!rows.length) { $('#ssSales').html('<tr><td colspan="6" class="text-muted small p-3">No sales yet.</td></tr>'); return; }
            $('#ssSales').html(rows.map(function (x) {
                var status = x.returned ? '<span class="badge bg-label-secondary" title="' + EC.esc(x.returnReason) + '">Returned</span>'
                           : x.open <= 0 ? '<span class="badge bg-label-success">Paid</span>'
                           : x.paid > 0 ? '<span class="badge bg-label-warning">Part paid</span>'
                           : '<span class="badge bg-label-danger">Unpaid</span>';
                var canReturn = !x.returned && x.paid <= 0 && x.open > 0;
                return '<tr><td class="text-nowrap small">' + EC.esc(x.date ? EC.date(x.date) : '') + '</td>'
                     + '<td><div class="fw-semibold">' + EC.esc(x.name) + '</div><div class="small text-muted">' + EC.esc(x.cls) + ' · ' + EC.esc(x.year) + '</div></td>'
                     + '<td>' + EC.esc(x.item) + (x.qty !== 1 ? ' × ' + EC.num(x.qty) : '') + '</td>'
                     + '<td class="text-end">' + EC.money(x.amount) + '</td>'
                     + '<td>' + status + '</td>'
                     + '<td class="text-end">' + (canReturn ? '<button type="button" class="btn btn-sm btn-outline-danger ss-ret" data-id="' + x.lineId + '" data-name="' + EC.esc(x.item) + '">Return</button>'
                          // money and stock must agree: a paid item comes back only after its receipt is cancelled
                          : (!x.returned && x.paid > 0 ? '<span class="small text-muted">To return: cancel its receipt first</span>' : '')) + '</td></tr>';
            }).join(''));
        }).fail(function () { $('#ssSales').html('<tr><td colspan="6" class="text-muted small p-3">Could not load the sales.</td></tr>'); });
    }

    $('#ssSales').on('click', '.ss-ret', function () {
        var id = +$(this).data('id'), name = $(this).data('name');
        EC.prompt({ title: 'Return this item?', name: name, label: 'Reason', required: true,
                    placeholder: 'Wrong size / wrong book / not needed', okText: 'Return item' }).then(function (reason) {
            if (reason === null) return;
            post(URL.ret, { id: id, reason: reason }).done(function (r) {
                if (r && r.success) { ecToast('success', r.message); loadSales(); if (student) loadItems(false); }
                else ecToast('error', (r && r.message) || 'Could not return the item.');
            }).fail(function (xhr) { ecToast('error', EC.ajaxError(xhr, 'Could not return the item')); });
        });
    });

    /* ── store summary ── */
    var SESSION_START = '@(sessionStart ?? "")';
    function loadSummary(kind) {
        var r = EC.dateRange(kind, SESSION_START);
        $('#sumRange').text('· ' + EC.date(r.from) + ' to ' + EC.date(r.to));
        $.getJSON('@Url.Action("StoreSummary", "Inventory", new { area = "ERP" })', { from: r.from, to: r.to }).done(function (s) {
            var card = function (label, val, color) {
                return '<div class="col-6 col-md-4 col-xl-2"><div class="ss-kpi"><div class="v" style="color:' + color + '">' + EC.money(val) + '</div><div class="l">' + label + '</div></div></div>';
            };
            $('#sumCards').html(card('Sold', s.sold, '#0f766e') + card('Margin', s.margin, s.margin < 0 ? '#dc2626' : '#16a34a')
                + card('Collected', s.collected, '#16a34a') + card('Still unpaid', s.unpaid, '#dc2626')
                + card('Bought', s.bought, '#b45309') + card('Stock on hand (cost)', s.stock, '#334155'));
        });
    }
    $('[data-sum]').on('click', function () {
        $('[data-sum]').removeClass('active'); $(this).addClass('active');
        loadSummary($(this).data('sum'));
    });

    loadSales();
    loadSummary('month');
});
</script>
}
