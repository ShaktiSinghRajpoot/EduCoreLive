@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Store";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var classes = ViewBag.ClassList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                  ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Inventory/InventoryItem.css" asp-append-version="true" />
}

<div class="ec-page-shell inventory-item-page">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap d-flex align-items-center gap-3">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-package fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Store</h4>
            <div class="ec-page-subtitle">Everything the school keeps: books, uniform, diary to give to students, and things used in school.</div>
          </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a class="btn btn-outline-secondary d-flex align-items-center gap-1" asp-area="ERP" asp-controller="Inventory" asp-action="StoreLocations">
            <i class="bx bx-map-pin"></i><span>Store Locations</span>
          </a>
          <button class="btn btn-primary d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#itemModal">
            <i class="bx bx-plus"></i><span>Add Item</span>
          </button>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="iv-card">
          <div class="iv-card-ic bg-label-primary text-primary"><i class="bx bx-package"></i></div>
          <div><div class="iv-card-val" id="sumTotal">—</div><div class="iv-card-lbl">Total Items</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="iv-card">
          <div class="iv-card-ic bg-label-warning text-warning"><i class="bx bx-error-circle"></i></div>
          <div><div class="iv-card-val" id="sumLow">—</div><div class="iv-card-lbl">Low Stock</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="iv-card">
          <div class="iv-card-ic bg-label-danger text-danger"><i class="bx bx-block"></i></div>
          <div><div class="iv-card-val" id="sumOut">—</div><div class="iv-card-lbl">Out of Stock</div></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="iv-card">
          <div class="iv-card-ic bg-label-success text-success"><i class="bx bx-rupee"></i></div>
          <div><div class="iv-card-val" id="sumValue">—</div><div class="iv-card-lbl">Stock Value (at cost price)</div></div>
        </div>
      </div>
    </div>

    <div class="ec-card mb-0">

      <div class="ec-card-header">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
          <div class="ec-section-title-wrap">
            <span class="ec-section-icon"><i class="bx bx-list-ul"></i></span>
            <div>
              <div class="ec-section-title">Item List</div>
              <div class="ec-section-subtitle" id="resultText">Loading…</div>
            </div>
          </div>
        </div>

        <div class="iv-fbar">
          <div class="iv-srch-wrap">
            <i class="bx bx-search iv-srch-ic"></i>
            <input type="search" class="iv-srch-inp" id="ivSearch" placeholder="Search name, SKU, brand…">
          </div>

          <div class="iv-fbar-div"></div>

          <select class="iv-chip" id="fLocation" title="Show the stock at one location">
            <option value="">All locations</option>
          </select>

          <select class="iv-chip" id="fCategory">
            <option value="">Category</option>
            <option>Uniform</option><option>Books</option><option>Stationery</option>
            <option>Sports</option><option>Furniture</option><option>Electronics</option><option>Lab Items</option>
          </select>

          <select class="iv-chip" id="fType">
            <option value="">Type</option>
            <option value="Saleable">Given to students</option><option value="Consumable">Used up in school</option><option value="Reusable">School equipment</option>
          </select>

          <select class="iv-chip" id="fClass" title="Items a child of this class can be given (its own and the all-class ones)">
            <option value="">For class</option>
            @foreach (var c in classes)
            {
                <option value="@c.Text">@c.Text</option>
            }
          </select>

          <select class="iv-chip" id="fStock">
            <option value="">Stock</option>
            <option value="available">Available</option>
            <option value="low">Low Stock</option>
            <option value="out">Out of Stock</option>
            <option value="opening">Came in without a bill</option>
          </select>

          <select class="iv-chip" id="perPage" title="Rows per page">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
          </select>

          <button class="iv-clear-btn d-none" id="clearBtn" title="Clear all filters">
            <i class="bx bx-x"></i>Clear
          </button>

          <div class="ms-auto d-flex gap-1 align-items-center">
            <button class="iv-export-btn xl" id="btnExcel" title="Export to Excel"><i class="bx bx-spreadsheet"></i></button>
            <button class="iv-export-btn pdf" id="btnPdf" title="Export to PDF"><i class="bxs-file-pdf bx"></i></button>
          </div>
        </div>
      </div>

      <div class="ec-card-body pt-2">

        <div class="iv-tbl-wrap">
          <table class="table iv-tbl align-middle mb-0">
            <thead>
              <tr>
                <th class="iv-sortable" data-col="name">Item <i class="bx bx-sort iv-si" id="si-name"></i></th>
                <th class="iv-sku">SKU</th>
                <th>Category</th>
                <th>Type</th>
                <th>Unit</th>
                <th class="iv-sortable" data-col="stock">Current Stock <i class="bx bx-sort iv-si" id="si-stock"></i></th>
                <th>Minimum</th>
                <th class="iv-sortable" data-col="value" title="Current stock x the item's cost price">Value (at cost) <i class="bx bx-sort iv-si" id="si-value"></i></th>
                <th>Status</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody id="itemTableBody"></tbody>
          </table>
          <div class="iv-empty d-none" id="emptyDesk">
            <div class="iv-empty-ic"><i class="bx bx-search-alt"></i></div>
            <h6 class="fw-bold mb-1" style="color:var(--ec-text-dark);">No items found</h6>
            <p class="text-muted small mb-0">Try adjusting your search or filters.</p>
          </div>
        </div>

        <div class="iv-mob-list" id="mobList"></div>
        <div class="iv-empty d-none" id="emptyMob">
          <div class="iv-empty-ic"><i class="bx bx-search-alt"></i></div>
          <h6 class="fw-bold mb-1" style="color:var(--ec-text-dark);">No items found</h6>
          <p class="text-muted small mb-0">Try adjusting filters.</p>
        </div>

        <div class="iv-pg-wrap" id="pgWrap">
          <div class="iv-pg-info" id="pgInfo">—</div>
          <div class="d-flex gap-1 flex-wrap justify-content-end" id="pgBtns"></div>
        </div>

      </div>
    </div>

  </div>
</div>

<div class="modal fade" id="itemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="itemModalTitle">Add Inventory Item</h5>
                    <small class="text-muted">Create item master for purchase, issue, return and stock tracking.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="itemId">

                <div class="row g-3">
                    <div class="col-12">
                        <div class="ec-detail-box">
                            <div class="ec-section-title-wrap d-flex align-items-center gap-2 mb-3">
                                <div class="ec-section-icon"><i class="bx bx-info-circle"></i></div>
                                <div>
                                    <div class="ec-section-title">Basic Information</div>
                                    <div class="ec-section-subtitle">Name, code, category and classification.</div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Item Name</label>
                                    <input type="text" class="form-control" id="itemName" placeholder="School Tie">
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Item Code / SKU</label>
                                    <input type="text" class="form-control" id="itemCode" placeholder="UNI-TIE-001">
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Category</label>
                                    <select class="form-select" id="itemCategory">
                                        <option value="">Select Category</option>
                                        <option>Uniform</option><option>Books</option><option>Stationery</option>
                                        <option>Sports</option><option>Furniture</option><option>Electronics</option><option>Lab Items</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Sub Category</label>
                                    <input type="text" class="form-control" id="itemSubCategory" placeholder="Tie / Belt / Notebook">
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">What is it for?</label>
                                    <select class="form-select" id="itemType">
                                        <option value="Saleable">Given to students (books, uniform, diary)</option>
                                        <option value="Consumable">Used up in school (chalk, paper, ink)</option>
                                        <option value="Reusable">School equipment (lab, sports, furniture)</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Unit Type</label>
                                    <select class="form-select" id="unitType">
                                        <option>Piece</option><option>Box</option><option>Set</option><option>Kg</option><option>Liter</option>
                                    </select>
                                </div>
                                @* Saleable items (books, uniform, diary ...) are given to students: *@
                                <div class="col-12 sale-only d-none">
                                    <label class="form-label">For which classes?</label>
                                    @* one item, one stock, for a group of classes (senior uniform: 9-12) *@
                                    <div class="ifc-box" id="itemForClass">
                                        @foreach (var c in classes)
                                        {
                                            <label class="ifc-pill"><input type="checkbox" class="form-check-input ifc-cls" value="@c.Text"> @c.Text</label>
                                        }
                                    </div>
                                    <div class="form-text" id="itemForClassHint">None ticked = <b>all classes</b> (tie, diary). Tick a few for an item only they get: senior uniform for Class 9–12, a book for one class.</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-8 sale-only new-only d-none">
                                    <label class="form-label">Sizes <span class="text-muted">(optional)</span></label>
                                    <input type="text" class="form-control" id="itemSizes" placeholder="e.g. 24, 28, 32 or S, M, L">
                                    <div class="form-text">One item is made per size ("Name - 24" ...), each with the opening stock below. The register shows them as one column.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="ec-detail-box">
                            <div class="ec-section-title-wrap d-flex align-items-center gap-2 mb-3">
                                <div class="ec-section-icon"><i class="bx bx-store"></i></div>
                                <div>
                                    <div class="ec-section-title">Stock &amp; Pricing</div>
                                    <div class="ec-section-subtitle">Opening stock, alert quantity and valuation.</div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-3" id="openingWrap">
                                    <label class="form-label">Stock already in school (before today)</label>
                                    <input type="number" class="form-control" id="openingStock" min="0" step="0.01" placeholder="0">
                                    <select class="form-select form-select-sm mt-1" id="openingLocation" title="Where the opening stock is kept"></select>
                                    <div class="form-text">Only what you have now, bought earlier. New stock goes through <b>Purchase</b> (supplier + bill).</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Minimum Stock Alert</label>
                                    <input type="number" class="form-control" id="minimumStock" min="0" step="0.01" placeholder="10">
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Cost Price</label>
                                    <input type="number" class="form-control" id="costPrice" min="0" step="0.01" placeholder="0">
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Selling Price</label>
                                    <input type="number" class="form-control" id="sellingPrice" min="0" step="0.01" placeholder="0">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="ec-detail-box">
                            <div class="ec-section-title-wrap d-flex align-items-center gap-2 mb-3">
                                <div class="ec-section-icon"><i class="bx bx-detail"></i></div>
                                <div>
                                    <div class="ec-section-title">Additional Details</div>
                                    <div class="ec-section-subtitle">Brand, model, description and status.</div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Brand</label>
                                    <input type="text" class="form-control" id="brand" placeholder="Brand name">
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Model</label>
                                    <input type="text" class="form-control" id="model" placeholder="Model">
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Status</label>
                                    <select class="form-select" id="itemStatus">
                                        <option>Active</option><option>Inactive</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" id="description" rows="3" placeholder="Item details"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer flex-column flex-sm-row">
                <button type="button" class="btn btn-outline-secondary w-100 w-sm-auto" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary w-100 w-sm-auto" id="saveItemBtn">
                    <i class="bx bx-save me-1"></i> Save Item
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="stockModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <div>
          <h5 class="modal-title fw-bold">Stock Movement</h5>
          <small class="text-muted" id="stockItemLabel">—</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="mvItemId">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Location</label>
            <select class="form-select" id="mvLocation"></select>
            <div class="form-text" id="mvAtLabel">&nbsp;</div>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label">What happened</label>
            <select class="form-select" id="mvType">
              <option value="Issue">Issue — given out</option>
              <option value="Return">Return — came back</option>
              <option value="Damage">Damage / lost</option>
              <option value="Adjustment">Adjustment — add stock found</option>
              <option value="StockTake">Stock-take — enter the counted quantity</option>
            </select>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label" id="mvQtyLabel">Quantity</label>
            <input type="number" class="form-control" id="mvQty" min="0" step="0.01" placeholder="0">
          </div>
          <div class="col-12" id="mvIssuedWrap">
            <label class="form-label">Issued to</label>
            <input type="text" class="form-control" id="mvIssuedTo" placeholder="Class 5A / Mr Sharma / Sports room">
          </div>
          <div class="col-12">
            <label class="form-label">Remarks</label>
            <textarea class="form-control" id="mvRemarks" rows="2" placeholder="Optional"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer flex-column flex-sm-row">
        <button type="button" class="btn btn-outline-secondary w-100 w-sm-auto" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary w-100 w-sm-auto" id="saveMoveBtn">
          <i class="bx bx-transfer me-1"></i> Record Movement
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <div>
          <h5 class="modal-title fw-bold">Transfer Stock</h5>
          <small class="text-muted" id="trItemLabel">—</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="trItemId">
        <div class="row g-3">
          <div class="col-12 col-sm-6">
            <label class="form-label">From</label>
            <select class="form-select" id="trFrom"></select>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label">To</label>
            <select class="form-select" id="trTo"></select>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label">Quantity</label>
            <input type="number" class="form-control" id="trQty" min="0" step="0.01" placeholder="0">
            <div class="form-text" id="trAtLabel">&nbsp;</div>
          </div>
          <div class="col-12">
            <label class="form-label">Reason</label>
            <textarea class="form-control" id="trReason" rows="2" placeholder="Why is it moving? (required)"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer flex-column flex-sm-row">
        <button type="button" class="btn btn-outline-secondary w-100 w-sm-auto" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary w-100 w-sm-auto" id="saveTransferBtn">
          <i class="bx bx-transfer-alt me-1"></i> Transfer
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="ledgerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <div>
          <h5 class="modal-title fw-bold">Stock History</h5>
          <small class="text-muted" id="ledgerItemLabel">—</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex flex-wrap gap-2 mb-3" id="ledgerPlaces"></div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Date</th><th>Movement</th><th>Location</th>
                <th class="text-end">Qty</th><th class="text-end">Rate</th>
                <th class="text-end" title="Item total, all locations">Balance</th><th>By</th>
                <th>Issued to</th><th>Remarks</th>
              </tr>
            </thead>
            <tbody id="ledgerBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script>
(function () {
    'use strict';

    var ITEMS_URL    = '@Url.Action("Items", "Inventory", new { area = "ERP" })';
    var ITEM_URL     = '@Url.Action("Item", "Inventory", new { area = "ERP" })';
    var SAVE_URL     = '@Url.Action("SaveItem", "Inventory", new { area = "ERP" })';
    var DELETE_URL   = '@Url.Action("DeleteItem", "Inventory", new { area = "ERP" })';
    var MOVE_URL     = '@Url.Action("MoveStock", "Inventory", new { area = "ERP" })';
    var LEDGER_URL   = '@Url.Action("Ledger", "Inventory", new { area = "ERP" })';
    var LOCS_URL     = '@Url.Action("Locations", "Inventory", new { area = "ERP" })';
    var STOCK_URL    = '@Url.Action("ItemStock", "Inventory", new { area = "ERP" })';
    var TRANSFER_URL = '@Url.Action("TransferStock", "Inventory", new { area = "ERP" })';

    var locations = [];  // active store locations, default first

    var rows = [];      // everything the server sent, unfiltered
    // the item type in the words the form uses
    var TYPE_WORDS = { Saleable: 'Given to students', Consumable: 'Used up in school', Reusable: 'School equipment' };
    var page = 1;
    var sortCol = 'name', sortDir = 1;

    function token() {
        return $('input[name="__RequestVerificationToken"]').first().val();
    }

    // Every write posts JSON, so the token rides in the header.
    function postJson(url, body) {
        return $.ajax({
            url: url, type: 'POST', contentType: 'application/json',
            headers: { 'RequestVerificationToken': token(), 'X-Requested-With': 'XMLHttpRequest' },
            data: JSON.stringify(body)
        });
    }

    // Quantities and prices are kept to 2 decimals; the server refuses a third,
    // so say so here before the round trip. Blank counts as fine (it means 0).
    function twoDp(v) {
        v = $.trim(v == null ? '' : String(v));
        return v === '' || /^\d+(\.\d{1,2})?$/.test(v);
    }

    function statusBadge(s) {
        var cls = s === 'Out of Stock' ? 'bg-label-danger'
                : s === 'Low Stock'    ? 'bg-label-warning'
                : 'bg-label-success';
        return '<span class="badge ' + cls + '">' + EC.esc(s) + '</span>';
    }

    // ── Locations ───────────────────────────────────────────────────────────
    // Options for a location picker. The default location comes first, so a
    // fresh picker is already on it.
    function locationOptions(selected) {
        return locations.map(function (l) {
            return '<option value="' + l.id + '"' + (l.id === selected ? ' selected' : '') + '>' +
                   EC.esc(l.name) + (l.isDefault ? ' (default)' : '') + '</option>';
        }).join('');
    }

    function loadLocations() {
        return $.get(LOCS_URL).done(function (d) {
            locations = (d || []).filter(function (l) { return l.active; });
            var keep = $('#fLocation').val();
            $('#fLocation').html('<option value="">All locations</option>' + locationOptions(0)).val(keep);
            $('#openingLocation').html(locationOptions(0)).toggleClass('d-none', locations.length < 2);
            $('#fLocation').toggleClass('d-none', locations.length < 2);
            if (rows.length) render();
        });
    }

    // ── Load ────────────────────────────────────────────────────────────────
    function load() {
        EC.listLoading('#itemTableBody', 'Loading items…');
        $('#resultText').text('Loading…');

        var loc = $('#fLocation').val();
        $.get(ITEMS_URL, loc ? { location: loc } : {})
            .done(function (d) {
                rows = d || [];
                page = 1;
                render();
            })
            .fail(function () {
                rows = [];
                EC.listEmpty('#itemTableBody', 'Could not load items. Please retry.', 'bx-error-circle');
                $('#resultText').text('Could not load.');
            });
    }

    // ── Filter, sort, paginate — all client-side; a school store is small ───
    function visible() {
        var q    = ($('#ivSearch').val() || '').toLowerCase().trim();
        var cat  = $('#fCategory').val();
        var typ  = $('#fType').val();
        var stk  = $('#fStock').val();
        var cls  = $('#fClass').val();

        return rows.filter(function (r) {
            if (q && (r.name + ' ' + r.sku + ' ' + r.category + ' ' + r.subCat).toLowerCase().indexOf(q) < 0) return false;
            if (cat && r.category !== cat) return false;
            if (typ && r.type !== typ) return false;
            // what a child of that class can be given: items for that class and for every class
            if (cls && (r.type !== 'Saleable' || (r.forClass && classList(r.forClass).indexOf(cls) < 0))) return false;
            if (stk === 'available' && r.status !== 'Available')    return false;
            if (stk === 'low'       && r.status !== 'Low Stock')    return false;
            if (stk === 'out'       && r.status !== 'Out of Stock') return false;
            if (stk === 'opening'   && !(noBill(r) > 0))            return false;
            return true;
        }).sort(function (a, b) {
            var x, y;
            if (sortCol === 'stock')      { x = EC.num(a.stock); y = EC.num(b.stock); }
            else if (sortCol === 'value') { x = EC.num(a.value); y = EC.num(b.value); }
            else                          { x = (a.name || '').toLowerCase(); y = (b.name || '').toLowerCase(); }
            return x < y ? -sortDir : x > y ? sortDir : 0;
        });
    }

    // The four cards describe the WHOLE store, not the filtered view, and are
    // computed from the same rows the table draws — so they can never disagree
    // with the list under them.
    function summarise() {
        var out = 0, low = 0, value = 0;
        rows.forEach(function (r) {
            if (r.status === 'Out of Stock')     out++;
            else if (r.status === 'Low Stock')   low++;
            value += EC.num(r.value);
        });
        $('#sumTotal').text(rows.length);
        $('#sumLow').text(low);
        $('#sumOut').text(out);
        $('#sumValue').text(EC.money(value));
    }

    // One "⋮" button per item; its menu holds every action, with words, so the row
    // stays clean. The menu floats over the page (fixed), so the scrolling table
    // cannot cut it off. The buttons keep their data-* names: the wiring below is
    // unchanged.
    function actionMenu(r, xfer) {
        var item = function (attr, icon, text, cls) {
            return '<li><button type="button" class="dropdown-item d-flex align-items-center gap-2' + (cls || '') + '" ' + attr + '="' + r.id + '">'
                 + '<i class="bx ' + icon + '"></i>' + text + '</button></li>';
        };
        return '<div class="dropdown d-inline-block">'
             + '<button type="button" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" data-bs-toggle="dropdown" '
             + 'data-bs-popper-config="{&quot;strategy&quot;:&quot;fixed&quot;}" aria-expanded="false" title="Actions"><i class="bx bx-dots-vertical-rounded fs-5"></i></button>'
             + '<ul class="dropdown-menu dropdown-menu-end shadow-sm py-1" style="min-width:210px;font-size:.85rem">'
             + item('data-move', 'bx-package', 'Stock in / out')
             + (xfer ? item('data-xfer', 'bx-transfer-alt', 'Move to another store') : '')
             + item('data-hist', 'bx-history', 'Stock history')
             + item('data-edit', 'bx-edit', 'Edit item')
             + '<li><hr class="dropdown-divider my-1"></li>'
             + item('data-del', 'bx-trash', 'Delete', ' text-danger')
             + '</ul></div>';
    }

    // Given to students: the classes it is for ('Class 9|Class 10|Class 11'; '' = every class)
    function classList(v) { return (v || '').split('|').filter(Boolean); }
    function classText(v) { var l = classList(v); return l.length ? l.join(', ') : 'All classes'; }
    function classNote(r) {
        if (r.type !== 'Saleable') return '';
        return '<div class="small ' + (r.forClass ? 'text-primary fw-semibold' : 'text-muted') + '">' + EC.esc(classText(r.forClass)) + '</div>';
    }
    // the form's class ticks
    function setForClasses(v) {
        var l = classList(v);
        $('.ifc-cls').each(function () { this.checked = l.indexOf(this.value) >= 0; });
    }
    function forClasses() {
        return $('.ifc-cls:checked').map(function () { return this.value; }).get().join('|');
    }

    // Stock that came in without a supplier bill: entered as "already in school"
    // when the item was made, or added by hand later (Adjustment / stock-take).
    // Shown apart from what came through Purchase.
    function noBill(r) { return EC.num(r.opening) + EC.num(r.added); }
    function openingNote(r) {
        var opening = EC.num(r.opening), added = EC.num(r.added);
        if (!(opening + added > 0)) return '';
        // what CAME IN without a bill, so it can be more than the stock left now
        var how  = opening && added ? EC.num(opening) + ' opening + ' + EC.num(added) + ' added by hand'
                 : opening ? 'opening' : 'added by hand';
        var text = EC.num(opening + added) + ' came in without a bill (' + how + ')';
        return '<div class="small fw-normal text-warning" title="Came in without a supplier bill">' + EC.esc(text) + '</div>';
    }

    function render() {
        summarise();
        var list = visible();
        var per  = parseInt($('#perPage').val(), 10) || 10;
        var pages = Math.max(1, Math.ceil(list.length / per));
        if (page > pages) page = pages;
        var slice = list.slice((page - 1) * per, page * per);

        $('#resultText').text(
            list.length ? list.length + (list.length === 1 ? ' item' : ' items') : 'No items');

        $('#emptyDesk').toggleClass('d-none', list.length > 0);
        $('#emptyMob').toggleClass('d-none', list.length > 0);
        var none = !rows.length;   // nothing in the store at all, not just nothing matching
        $('#emptyDesk h6, #emptyMob h6').text(none ? 'Your store is empty' : 'No items found');
        $('#emptyDesk p, #emptyMob p').text(none
            ? 'Click "+ Add Item" to add the first one: a diary, tie, belt, uniform (sizes in one go) or a book for a class.'
            : 'Try adjusting your search or filters.');
        $('#clearBtn').toggleClass('d-none', !(
            $('#ivSearch').val() || $('#fCategory').val() || $('#fType').val() || $('#fClass').val() || $('#fStock').val() ||
            $('#fLocation').val()));

        if (!list.length) {
            $('#itemTableBody').empty();
            $('#mobList').empty();
            $('#pgWrap').addClass('d-none');
            return;
        }
        $('#pgWrap').removeClass('d-none');

        // most small schools leave SKU empty: then the column is only dashes, so it goes
        var anySku = rows.some(function (r) { return r.sku; });
        $('.iv-sku').toggleClass('d-none', !anySku);
        // moving stock between stores only means something with two or more of them
        var xfer = locations.length > 1;

        var html = slice.map(function (r) {
            return '<tr>' +
                '<td><div class="fw-semibold">' + EC.esc(r.name) + '</div>' +
                    (r.subCat ? '<div class="text-muted small">' + EC.esc(r.subCat) + '</div>' : '') + '</td>' +
                (anySku ? '<td>' + EC.esc(r.sku || '—') + '</td>' : '') +
                '<td>' + EC.esc(r.category || '—') + '</td>' +
                '<td>' + EC.esc(TYPE_WORDS[r.type] || r.type) + classNote(r) + '</td>' +
                '<td>' + EC.esc(r.unit) + '</td>' +
                '<td class="fw-semibold">' + EC.num(r.stock) + openingNote(r) + '</td>' +
                '<td>' + EC.num(r.minStock) + '</td>' +
                '<td>' + EC.money(r.value) + '</td>' +
                '<td>' + statusBadge(r.status) + '</td>' +
                '<td class="text-end text-nowrap">' +
                    actionMenu(r, xfer) +
                '</td></tr>';
        }).join('');
        $('#itemTableBody').html(html);

        $('#mobList').html(slice.map(function (r) {
            return '<div class="iv-mob-card">' +
                '<div class="d-flex justify-content-between align-items-start gap-2">' +
                    '<div><div class="fw-semibold">' + EC.esc(r.name) + '</div>' +
                        '<div class="text-muted small">' + EC.esc(r.sku || r.category || '') + (r.type === 'Saleable' ? ' · ' + EC.esc(classText(r.forClass)) : '') + '</div></div>' +
                    statusBadge(r.status) + '</div>' +
                '<div class="d-flex justify-content-between align-items-center mt-2">' +
                    '<div class="small text-muted">' + EC.num(r.stock) + ' ' + EC.esc(r.unit) +
                        ' · min ' + EC.num(r.minStock) + '</div>' +
                    '<div>' +
                        actionMenu(r, xfer) +
                    '</div></div>' + openingNote(r) + '</div>';
        }).join(''));

        $('#pgInfo').text('Showing ' + ((page - 1) * per + 1) + '–' +
                          Math.min(page * per, list.length) + ' of ' + list.length);

        var btns = '';
        for (var i = 1; i <= pages; i++) {
            btns += '<button class="btn btn-sm ' + (i === page ? 'btn-primary' : 'btn-outline-secondary') +
                    '" data-page="' + i + '">' + i + '</button>';
        }
        $('#pgBtns').html(btns);
    }

    // ── Item form ───────────────────────────────────────────────────────────
    // "For which class?" is for saleable items; "Sizes" only when adding one.
    function syncSaleFields() {
        var sale = $('#itemType').val() === 'Saleable';
        $('.sale-only').toggleClass('d-none', !sale);
        $('.new-only').toggleClass('d-none', !sale || !!$('#itemId').val());
    }
    $('#itemType').on('change', syncSaleFields);
    syncSaleFields();   // the form opens on "Given to students": show its two fields from the start

    function clearForm() {
        $('#itemId').val('');
        $('#itemName,#itemCode,#itemSubCategory,#brand,#model,#description').val('');
        $('#itemCategory').val('');
        $('#itemType').val('Saleable');   // most items a small school adds are for students
        $('#unitType').val('Piece');
        $('#openingStock,#minimumStock,#costPrice,#sellingPrice').val('');
        $('#itemStatus').val('Active');
        $('#openingWrap').removeClass('d-none');
        $('#openingLocation').html(locationOptions(0));
        setForClasses('');
        $('#itemSizes').val('');
        $('#itemModalTitle').text('Add Inventory Item');
        syncSaleFields();
    }

    function openEdit(id) {
        EC.showLoader();
        $.get(ITEM_URL, { id: id })
            .done(function (d) {
                if (!d || !d.success) { ecToast('error', (d && d.message) || 'Could not load.'); return; }
                $('#itemId').val(d.id);
                $('#itemName').val(d.name);
                $('#itemCode').val(d.sku);
                // A category the dropdown does not list would make the select
                // blank, and saving would then wipe it -- so add it first.
                if (d.category && !$('#itemCategory option').filter(function () {
                        return $(this).val() === d.category; }).length) {
                    $('#itemCategory').append($('<option>').text(d.category));
                }
                $('#itemCategory').val(d.category);
                $('#itemSubCategory').val(d.subCat);
                $('#itemType').val(d.type);
                $('#unitType').val(d.unit);
                $('#minimumStock').val(d.minStock);
                $('#costPrice').val(d.costPrice);
                $('#sellingPrice').val(d.sellingPrice);
                $('#brand').val(d.brand);
                $('#model').val(d.model);
                $('#description').val(d.description);
                $('#itemStatus').val(d.isActive ? 'Active' : 'Inactive');
                setForClasses(d.forClass);
                syncSaleFields();

                // Opening stock is only meaningful when creating. Stock moves
                // through a movement, so an edit cannot invent inventory.
                $('#openingWrap').addClass('d-none');
                $('#itemModalTitle').text('Edit Inventory Item');
                new bootstrap.Modal(document.getElementById('itemModal')).show();
            })
            .fail(function () { ecToast('error', 'Could not load the item.'); })
            .always(EC.hideLoader);
    }

    $('#saveItemBtn').on('click', function () {
        var $btn = $(this);
        var name = $.trim($('#itemName').val());
        if (!name) { ecToast('warning', 'Enter the item name.'); $('#itemName').focus(); return; }
        var bad = ['#openingStock', '#minimumStock', '#costPrice', '#sellingPrice'].filter(function (f) {
            return !twoDp($(f).val());
        });
        if (bad.length) {
            ecToast('warning', 'Use a number 0 or more, with at most 2 decimal places.');
            $(bad[0]).focus();
            return;
        }

        EC.buttonBusy($btn, 'Saving…');
        postJson(SAVE_URL, {
            itemId:       EC.num($('#itemId').val()) || 0,
            itemName:     name,
            sku:          $.trim($('#itemCode').val()),
            category:     $('#itemCategory').val(),
            subCategory:  $.trim($('#itemSubCategory').val()),
            itemType:     $('#itemType').val(),
            unitType:     $('#unitType').val(),
            openingStock: EC.numPos($('#openingStock').val()),
            minStock:     EC.numPos($('#minimumStock').val()),
            costPrice:    EC.numPos($('#costPrice').val()),
            sellingPrice: EC.numPos($('#sellingPrice').val()),
            brand:        $.trim($('#brand').val()),
            model:        $.trim($('#model').val()),
            description:  $.trim($('#description').val()),
            isActive:     $('#itemStatus').val() === 'Active',
            locationId:   EC.num($('#openingLocation').val()) || null,
            forClass:     $('#itemType').val() === 'Saleable' ? (forClasses() || null) : null,
            sizes:        $('#itemId').val() ? null : ($.trim($('#itemSizes').val()) || null)
        })
        .done(function (res) {
            if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not save.'); return; }
            ecToast('success', res.message);
            // Warn only -- selling below cost can be deliberate (clearance, subsidised kit).
            var cost = EC.numPos($('#costPrice').val()), sell = EC.numPos($('#sellingPrice').val());
            if (sell > 0 && sell < cost) {
                ecToast('warning', 'Selling price (' + EC.money(sell) + ') is below cost price (' + EC.money(cost) + ').');
            }
            bootstrap.Modal.getInstance(document.getElementById('itemModal')).hide();
            load();
        })
        .fail(function () { ecToast('error', 'Could not save the item.'); })
        .always(function () { EC.buttonReset($btn); });
    });

    $('#itemModal').on('hidden.bs.modal', clearForm);

    // ── Stock movement ──────────────────────────────────────────────────────
    function openMove(id) {
        var r = rows.find(function (x) { return x.id === id; });
        if (!r) return;
        $('#mvItemId').val(id);
        $('#stockItemLabel').text(r.name + ' (' + r.unit + ')');
        $('#mvType').val('Issue');
        $('#mvQty,#mvIssuedTo,#mvRemarks').val('');
        // Start on the location the list is filtered to, else the default.
        $('#mvLocation').html(locationOptions(EC.num($('#fLocation').val())));
        moveTypeChanged();
        loadItemStock(id);
        new bootstrap.Modal(document.getElementById('stockModal')).show();
    }

    // The item's stock per location, for the "at this location" hints.
    var itemStock = [];
    function loadItemStock(id) {
        itemStock = [];
        $('#mvAtLabel,#trAtLabel').html('&nbsp;');
        return $.get(STOCK_URL, { id: id }).done(function (d) {
            itemStock = d || [];
            showAt();
        });
    }

    function qtyAt(locId) {
        var s = itemStock.find(function (x) { return x.id === locId; });
        return s ? EC.num(s.qty) : 0;
    }

    function showAt() {
        $('#mvAtLabel').text(qtyAt(EC.num($('#mvLocation').val())) + ' in stock here');
        $('#trAtLabel').text(qtyAt(EC.num($('#trFrom').val())) + ' available at the source');
    }
    $('#mvLocation,#trFrom').on('change', showAt);

    // "Issued to" only means something when stock is going out. A stock-take
    // asks for the quantity COUNTED (the server records the difference) and
    // needs a reason.
    function moveTypeChanged() {
        var t = $('#mvType').val();
        $('#mvIssuedWrap').toggleClass('d-none', t !== 'Issue');
        $('#mvQtyLabel').text(t === 'StockTake' ? 'Counted quantity' : 'Quantity');
        $('#mvRemarks').attr('placeholder', t === 'StockTake' ? 'Why does the count differ? (required)' : 'Optional');
    }
    $('#mvType').on('change', moveTypeChanged);

    $('#saveMoveBtn').on('click', function () {
        var $btn = $(this);
        var type = $('#mvType').val();
        var raw  = $.trim($('#mvQty').val());
        var qty  = EC.numPos(raw);
        // A minus sign is a wrong quantity, not a decimals problem (QA BUG-110).
        if (raw.charAt(0) === '-') { ecToast('warning', 'The quantity cannot be negative.'); $('#mvQty').focus(); return; }
        if (!twoDp(raw)) { ecToast('warning', 'Use at most 2 decimal places.'); $('#mvQty').focus(); return; }
        if (type === 'StockTake') {
            if (raw === '') { ecToast('warning', 'Enter the quantity you counted.'); $('#mvQty').focus(); return; }
            if (!$.trim($('#mvRemarks').val())) {
                ecToast('warning', 'Give a reason for the stock-take difference.'); $('#mvRemarks').focus(); return;
            }
        } else if (qty <= 0) { ecToast('warning', 'Enter a quantity.'); $('#mvQty').focus(); return; }

        EC.buttonBusy($btn, 'Saving…');
        postJson(MOVE_URL, {
            itemId:       EC.num($('#mvItemId').val()),
            movementType: type,
            quantity:     qty,
            issuedTo:     $.trim($('#mvIssuedTo').val()),
            remarks:      $.trim($('#mvRemarks').val()),
            locationId:   EC.num($('#mvLocation').val()) || null
        })
        .done(function (res) {
            // The proc refuses by name and amount ("Only 3 Piece of School Tie
            // left"), so its wording goes straight to the toast.
            if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not record.'); return; }
            ecToast('success', res.message);
            bootstrap.Modal.getInstance(document.getElementById('stockModal')).hide();
            load();
        })
        .fail(function () { ecToast('error', 'Could not record the movement.'); })
        .always(function () { EC.buttonReset($btn); });
    });

    // ── Transfer ────────────────────────────────────────────────────────────
    function openTransfer(id) {
        var r = rows.find(function (x) { return x.id === id; });
        if (!r) return;
        if (locations.length < 2) {
            ecToast('warning', 'Add a second store location first (Store Locations page).');
            return;
        }
        $('#trItemId').val(id);
        $('#trItemLabel').text(r.name + ' (' + r.unit + ')');
        $('#trQty,#trReason').val('');
        $('#trFrom').html(locationOptions(EC.num($('#fLocation').val())));
        $('#trTo').html('<option value="">Choose…</option>' + locationOptions(0));
        loadItemStock(id);
        new bootstrap.Modal(document.getElementById('transferModal')).show();
    }

    $('#saveTransferBtn').on('click', function () {
        var $btn = $(this);
        var raw  = $.trim($('#trQty').val());
        var qty  = EC.numPos(raw);
        var from = EC.num($('#trFrom').val());
        var to   = EC.num($('#trTo').val());
        if (!to)          { ecToast('warning', 'Choose where the stock is going.'); $('#trTo').focus(); return; }
        if (from === to)  { ecToast('warning', 'Choose two different locations.'); $('#trTo').focus(); return; }
        if (raw.charAt(0) === '-') { ecToast('warning', 'Quantity must be more than 0.'); $('#trQty').focus(); return; }
        if (!twoDp(raw))  { ecToast('warning', 'Use at most 2 decimal places.'); $('#trQty').focus(); return; }
        if (qty <= 0)     { ecToast('warning', 'Enter a quantity.'); $('#trQty').focus(); return; }
        if (!$.trim($('#trReason').val())) { ecToast('warning', 'Give a reason for the transfer.'); $('#trReason').focus(); return; }

        EC.buttonBusy($btn, 'Moving…');
        postJson(TRANSFER_URL, {
            itemId:         EC.num($('#trItemId').val()),
            fromLocationId: from,
            toLocationId:   to,
            quantity:       qty,
            reason:         $.trim($('#trReason').val())
        })
        .done(function (res) {
            if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not transfer.'); return; }
            ecToast('success', res.message);
            bootstrap.Modal.getInstance(document.getElementById('transferModal')).hide();
            load();
        })
        .fail(function () { ecToast('error', 'Could not transfer the stock.'); })
        .always(function () { EC.buttonReset($btn); });
    });

    // ── History ─────────────────────────────────────────────────────────────
    var MOVE_LABELS = {
        Opening: 'Opening stock (no bill)', Purchase: 'Purchase', PurchaseCancel: 'Purchase cancelled',
        Issue: 'Issue', Return: 'Return', Damage: 'Damage / lost',
        Adjustment: 'Adjustment', StockTake: 'Stock-take',
        TransferOut: 'Transfer out', TransferIn: 'Transfer in', SupplierReturn: 'Returned to supplier'
    };

    function openHistory(id) {
        var r = rows.find(function (x) { return x.id === id; });
        $('#ledgerItemLabel').text(r ? r.name : '');
        EC.listLoading('#ledgerBody', 'Loading history…');
        $('#ledgerPlaces').empty();
        new bootstrap.Modal(document.getElementById('ledgerModal')).show();

        // Where the stock is now, location by location.
        $.get(STOCK_URL, { id: id }).done(function (d) {
            $('#ledgerPlaces').html((d || []).map(function (s) {
                return '<span class="badge ' + (EC.num(s.qty) > 0 ? 'bg-label-primary' : 'bg-label-secondary') + '">' +
                       EC.esc(s.name) + ': ' + EC.num(s.qty) + '</span>';
            }).join(''));
        });

        $.get(LEDGER_URL, { id: id })
            .done(function (d) {
                if (!d || !d.length) {
                    EC.listEmpty('#ledgerBody', 'No stock movement yet.', 'bx-history');
                    return;
                }
                // Newest date first, then newest entry; Balance is the running
                // total in that same order, so it reads cleanly top to bottom.
                $('#ledgerBody').html(d.map(function (m) {
                    var q = EC.num(m.qty);
                    var label = MOVE_LABELS[m.type] || m.type;
                    if (m.invoice) label += ' · Bill ' + m.invoice;
                    if (m.with) label += (m.type === 'TransferOut' ? ' → ' : ' ← ') + m.with;
                    return '<tr>' +
                        '<td>' + EC.esc(m.date) + '</td>' +
                        '<td>' + EC.esc(label) + '</td>' +
                        '<td class="small">' + EC.esc(m.place || '—') +
                            (m.place ? '<div class="text-muted">bal ' + EC.num(m.placeBalance) + '</div>' : '') + '</td>' +
                        '<td class="text-end ' + (q < 0 ? 'text-danger' : 'text-success') + '">' +
                            (q > 0 ? '+' : '') + q + '</td>' +
                        '<td class="text-end">' + (m.rate === null || m.rate === undefined ? '—' : EC.money(m.rate)) + '</td>' +
                        '<td class="text-end fw-semibold">' + EC.num(m.balance) + '</td>' +
                        '<td class="small">' + EC.esc(m.by || '—') + '</td>' +
                        '<td>' + EC.esc(m.to || '—') + '</td>' +
                        '<td class="text-muted small">' + EC.esc(m.remarks || '—') + '</td>' +
                    '</tr>';
                }).join(''));
            })
            .fail(function () {
                EC.listEmpty('#ledgerBody', 'Could not load the history.', 'bx-error-circle');
            });
    }

    // ── Delete ──────────────────────────────────────────────────────────────
    function del(id) {
        var r = rows.find(function (x) { return x.id === id; });
        // EC.confirm escapes name and message itself.
        EC.confirm({
            title:   'Delete this item?',
            name:    r ? r.name : '',
            message: 'It is removed from the store list. Its stock history is kept.',
            okText:  'Delete item'
        }).then(function (ok) {
            if (!ok) return;
            EC.showLoader();
            postJson(DELETE_URL, { id: id })
                .done(function (res) {
                    // Refused when stock is still on the shelf, by name and amount.
                    if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not delete.'); return; }
                    ecToast('success', res.message);
                    load();
                })
                .fail(function () { ecToast('error', 'Could not delete the item.'); })
                .always(EC.hideLoader);
        });
    }

    // ── Wiring ──────────────────────────────────────────────────────────────
    $(document)
        .on('click', '[data-edit]', function () { openEdit(EC.num($(this).data('edit'))); })
        .on('click', '[data-move]', function () { openMove(EC.num($(this).data('move'))); })
        .on('click', '[data-xfer]', function () { openTransfer(EC.num($(this).data('xfer'))); })
        .on('click', '[data-hist]', function () { openHistory(EC.num($(this).data('hist'))); })
        .on('click', '[data-del]',  function () { del(EC.num($(this).data('del'))); })
        .on('click', '[data-page]', function () { page = EC.num($(this).data('page')); render(); });

    $('#ivSearch').on('input', function () { page = 1; render(); });
    $('#fCategory,#fType,#fClass,#fStock,#perPage').on('change', function () { page = 1; render(); });
    // A location changes the figures themselves, so it reloads from the server.
    $('#fLocation').on('change', load);

    $('#clearBtn').on('click', function () {
        var hadLocation = !!$('#fLocation').val();
        $('#ivSearch,#fCategory,#fType,#fClass,#fStock,#fLocation').val('');
        page = 1;
        if (hadLocation) load(); else render();
    });

    $('.iv-sortable').on('click', function () {
        var col = $(this).data('col');
        sortDir = (col === sortCol) ? -sortDir : 1;
        sortCol = col;
        render();
    });

    // Export buttons had no implementation in the shell and still have none —
    // left visible rather than wired to a half-working download.
    $('#btnExcel,#btnPdf').on('click', function () {
        ecToast('info', 'Export is not built yet.');
    });

    loadLocations();
    load();
})();
</script>
}
