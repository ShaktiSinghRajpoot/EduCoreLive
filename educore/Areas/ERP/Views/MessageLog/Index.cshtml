@{
    ViewData["Title"] = "Message Log";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    bool whatsAppOn = ViewBag.WhatsAppOn == true;
    bool whatsAppTest = ViewBag.WhatsAppTest == true;
}

@section PageStyles {
<style>
  .ml-kpi { border:1px solid var(--bs-border-color); border-radius:12px; padding:.6rem .75rem; background:var(--bs-body-bg); }
  .ml-kpi .v { font-size:1.25rem; font-weight:900; line-height:1.1; }
  .ml-kpi .l { font-size:.68rem; font-weight:700; text-transform:uppercase; color:var(--bs-secondary-color); letter-spacing:.03em; }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bxl-whatsapp fs-4"></i></div>
          <div>
            <h4 class="ec-page-title mb-1">Message Log</h4>
            <div class="ec-page-subtitle">Every WhatsApp message to parents — absent alerts, fee reminders, notices — sent or not</div>
          </div>
        </div>
      </div>
    </div>

    @if (!whatsAppOn)
    {
        <div class="alert alert-secondary">WhatsApp is not switched on for this school. Ask SmartSchoolWala to switch it on; until then the pages keep their "open WhatsApp" buttons.</div>
    }
    else if (whatsAppTest)
    {
        <div class="alert alert-warning"><b>Test mode.</b> The WhatsApp account is not connected yet, so messages are built and recorded here as "Test" — nothing reaches parents.</div>
    }

    <div class="ec-card mb-3"><div class="ec-card-body d-flex flex-wrap gap-2 align-items-end">
      <div><label class="form-label mb-1">From</label><input type="date" id="mFrom" class="form-control form-control-sm"></div>
      <div><label class="form-label mb-1">To</label><input type="date" id="mTo" class="form-control form-control-sm"></div>
      <div><label class="form-label mb-1">Type</label>
        <select id="mType" class="form-select form-select-sm">
          <option value="">All</option><option value="Absent">Absent alert</option><option value="FeeDue">Fee reminder</option><option value="Notice">Notice</option>
        </select></div>
      <button type="button" class="btn btn-sm btn-primary" id="mShow"><i class="bx bx-search me-1"></i>Show</button>
    </div></div>

    <div class="row g-2 mb-3" id="mKpis"></div>

    <div class="ec-card mb-0"><div class="ec-card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead><tr><th>When</th><th>Type</th><th>To</th><th class="d-none d-md-table-cell">Message</th><th>Status</th></tr></thead>
          <tbody id="mRows"><tr><td colspan="5" class="text-muted small p-3">Loading…</td></tr></tbody>
        </table>
      </div>
    </div></div>
  </div>
</div>

@section PageScripts {
<script>
$(function () {
    var DATA_URL = '@Url.Action("Data", "MessageLog", new { area = "ERP" })';
    var TYPES = { Absent: 'Absent alert', FeeDue: 'Fee reminder', Notice: 'Notice' };
    var BADGE = { Sent: 'bg-label-success', Test: 'bg-label-warning', Failed: 'bg-label-danger', NoPhone: 'bg-label-secondary' };
    var r0 = EC.dateRange('month');
    $('#mFrom').val(r0.from); $('#mTo').val(r0.to);

    function load() {
        $.getJSON(DATA_URL, { from: $('#mFrom').val(), to: $('#mTo').val(), type: $('#mType').val() }).done(function (r) {
            var s = r.summary;
            var kpi = function (label, val, color) {
                return '<div class="col-6 col-md-3"><div class="ml-kpi"><div class="v" style="color:' + color + '">' + val + '</div><div class="l">' + label + '</div></div></div>';
            };
            $('#mKpis').html(kpi('Sent', s.sent, '#16a34a') + kpi('Test (not sent)', s.test, '#b45309') + kpi('Failed', s.failed, '#dc2626') + kpi('No mobile number', s.noPhone, '#64748b'));
            if (!r.rows.length) { $('#mRows').html('<tr><td colspan="5" class="text-muted small p-3">No messages in these dates.</td></tr>'); return; }
            $('#mRows').html(r.rows.map(function (x) {
                return '<tr><td class="text-nowrap small">' + EC.esc(x.at) + '<div class="text-muted">' + EC.esc(x.by) + '</div></td>'
                     + '<td class="small">' + EC.esc(TYPES[x.type] || x.type) + '</td>'
                     + '<td><div class="fw-semibold">' + EC.esc(x.name) + '</div><div class="small text-muted">' + EC.esc(x.phone || '—') + '</div></td>'
                     + '<td class="d-none d-md-table-cell small" style="max-width:420px">' + EC.esc(x.text) + '</td>'
                     + '<td><span class="badge ' + (BADGE[x.status] || 'bg-label-secondary') + '">' + EC.esc(x.status === 'NoPhone' ? 'No number' : x.status) + '</span>'
                     + (x.error ? '<div class="small text-danger">' + EC.esc(x.error) + '</div>' : '') + '</td></tr>';
            }).join(''));
        }).fail(function () { ecToast('error', 'Could not load the messages.'); });
    }
    $('#mShow').on('click', load);
    $('#mType').on('change', load);
    load();
});
</script>
}
