@{
    ViewData["Title"] = "My Leave";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var me = ViewBag.Me as EduCoreDataAccessLayer.Models.ERP.MyStaffInfo;
    bool moduleOff = ViewBag.ModuleOff == true;
    bool canApply = me != null && me.IsCurrent;
}

@section PageStyles {
<style>
  .ml-wrap { max-width: 760px; margin: 0 auto; }
  .ml-card { background:#fff; border:1px solid var(--bs-border-color); border-radius:18px; padding:1.1rem; margin-bottom:1rem; }
  .ml-title { font-size:.8rem; font-weight:900; text-transform:uppercase; letter-spacing:.04em; color:var(--bs-secondary-color); margin-bottom:.6rem; }
  .ml-bal { display:grid; grid-template-columns:repeat(3, 1fr); gap:.6rem; }
  .ml-bal-item { border:1px solid var(--bs-border-color); border-radius:14px; padding:.6rem .7rem; text-align:center; }
  .ml-bal-v { font-size:1.25rem; font-weight:900; color:var(--heading); line-height:1.1; }
  .ml-bal-l { font-size:.72rem; font-weight:800; color:var(--bs-secondary-color); text-transform:uppercase; }
  .ml-bal-s { font-size:.72rem; color:var(--bs-secondary-color); }
  .ml-req { border:1px solid var(--bs-border-color); border-radius:14px; padding:.8rem .9rem; margin-bottom:.6rem; }
  .ml-req-top { display:flex; justify-content:space-between; align-items:flex-start; gap:.5rem; }
  .ml-req-type { font-weight:900; color:var(--heading); }
  .ml-req-dates { font-size:.86rem; font-weight:700; }
  .ml-req-meta { font-size:.78rem; color:var(--bs-secondary-color); margin-top:.3rem; }
  .ml-badge { font-size:.72rem; font-weight:800; padding:.25rem .6rem; border-radius:999px; white-space:nowrap; }
  .st-pending   { background:#fff3cd; color:#b7791f; }
  .st-approved  { background:#dcfce7; color:#15803d; }
  .st-rejected  { background:#fde8e8; color:#b91c1c; }
  .st-cancelled { background:#f1f1f4; color:#6b7280; }
  @@media (max-width:575.98px) { .ml-bal { grid-template-columns:repeat(2, 1fr); } }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content ml-wrap">
    <div class="d-flex align-items-center gap-2 mb-3">
      <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center" style="background:var(--soft);color:var(--p);width:46px;height:46px"><i class="bx bx-calendar-minus fs-4"></i></div>
      <div>
        <h4 class="mb-0" style="color:var(--heading);font-weight:900">My Leave</h4>
        <div class="text-muted" style="font-size:.8rem">Your leave balance, your requests, and applying for leave</div>
      </div>
    </div>

    @if (moduleOff)
    {
      <div class="ml-card text-center text-muted">Leave and payroll are turned off for this school.</div>
    }
    else if (me == null)
    {
      <div class="ml-card text-center">
        <i class="bx bx-info-circle fs-1 text-muted"></i>
        <div class="fw-bold mt-2">You do not have a staff record in this school.</div>
        <div class="text-muted small mt-1">My Leave is for staff members. Ask the school office to link your login to your staff record.</div>
      </div>
    }
    else
    {
      @if (!canApply)
      {
        <div class="alert alert-warning" style="border-radius:14px">Your staff record is inactive. You can see your past requests but cannot apply for leave.</div>
      }

      <div class="ml-card">
        <div class="ml-title" id="balTitle">Leave left this year</div>
        <div class="ml-bal" id="balGrid"><div class="text-muted small">Loading…</div></div>
        <div class="text-muted mt-2" style="font-size:.72rem">Pending and approved requests both count. Comp-off and Unpaid have no yearly limit; once a type is used up, apply the rest as Unpaid.</div>
      </div>

      @if (canApply)
      {
      <div class="ml-card">
        <div class="ml-title">Apply for leave</div>
        <form id="applyForm" autocomplete="off">
          <div class="row g-2">
            <div class="col-12 col-sm-6">
              <label class="form-label small fw-bold mb-1" for="lvType">Leave type</label>
              <select class="form-select" id="lvType" required>
                <option value="">Choose…</option>
                <option>Casual</option><option>Sick</option><option>Earned</option>
                <option>Maternity</option><option>Comp-off</option><option>Unpaid</option>
              </select>
            </div>
            <div class="col-12 col-sm-6 d-flex align-items-end">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="lvHalf">
                <label class="form-check-label" for="lvHalf">Half day (one date, counts 0.5)</label>
              </div>
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold mb-1" for="lvFrom">From</label>
              <input type="date" class="form-control" id="lvFrom" required>
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold mb-1" for="lvTo">To</label>
              <input type="date" class="form-control" id="lvTo" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold mb-1" for="lvReason">Reason</label>
              <textarea class="form-control" id="lvReason" rows="2" maxlength="500" placeholder="Optional"></textarea>
            </div>
          </div>
          <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
            <div class="fw-bold" id="lvDays">— days</div>
            <button type="submit" class="btn btn-primary px-4"><i class="bx bx-send me-1"></i>Send for approval</button>
          </div>
          <div class="text-muted mt-1" style="font-size:.72rem">Weekly offs and school holidays are not counted. Your request goes to the school office as Pending.</div>
        </form>
      </div>
      }

      <div class="ml-card">
        <div class="ml-title">My requests</div>
        <div id="reqList"></div>
      </div>
    }
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
@if (!moduleOff && me != null)
{
<script>
$(function () {
  'use strict';
  var CSRF  = $('input[name="__RequestVerificationToken"]').val();
  var URL   = { list: '@Url.Action("List")', balance: '@Url.Action("Balance")', days: '@Url.Action("CountDays")',
                apply: '@Url.Action("Apply")', cancel: '@Url.Action("Cancel")' };
  var TODAY = '@Dates.Now.ToString("yyyy-MM-dd")';   // the school's today, not the browser's UTC one

  function dayText(d) { return d + (Number(d) === 1 ? ' day' : ' days'); }

  // ── Balance ─────────────────────────────────────────────
  function loadBalance() {
    var date = $('#lvFrom').val() || TODAY;
    $.getJSON(URL.balance, { date: date }).done(function (rows) {
      if (!rows || !rows.length) { $('#balGrid').html('<div class="text-muted small">No balance to show.</div>'); return; }
      $('#balTitle').text('Leave left in ' + rows[0].year);
      $('#balGrid').html(rows.map(function (b) {
        var capped = b.entitled !== null;
        return '<div class="ml-bal-item">'
             + '<div class="ml-bal-l">' + EC.esc(b.type) + '</div>'
             + '<div class="ml-bal-v">' + (capped ? EC.esc(b.remaining) + '<span class="ml-bal-s"> / ' + EC.esc(b.entitled) + '</span>' : '—') + '</div>'
             + '<div class="ml-bal-s">taken ' + EC.esc(b.taken) + (Number(b.pending) > 0 ? ' · pending ' + EC.esc(b.pending) : '') + '</div>'
             + '</div>';
      }).join(''));
    }).fail(function () {
      $('#balGrid').html('<div class="text-muted small">Could not load the balance.</div>');
    });
  }

  // ── My requests ─────────────────────────────────────────
  function requestHtml(r) {
    var st = (r.status || '').toLowerCase();
    var dates = r.from === r.to ? r.from : r.from + ' – ' + r.to;
    var html = '<div class="ml-req">'
      + '<div class="ml-req-top"><div>'
      + '<div class="ml-req-type">' + EC.esc(r.type) + (r.halfDay ? ' (half day)' : '') + '</div>'
      + '<div class="ml-req-dates">' + EC.esc(dates) + ' · ' + EC.esc(dayText(r.days)) + '</div>'
      + '</div><span class="ml-badge st-' + EC.esc(st) + '">' + EC.esc(r.status) + '</span></div>';
    if (r.reason) html += '<div class="ml-req-meta">Reason: ' + EC.esc(r.reason) + '</div>';
    html += '<div class="ml-req-meta">Applied ' + EC.esc(r.applied) + (r.appliedBy ? ' by ' + EC.esc(r.appliedBy) : '') + '</div>';
    if (r.decided) html += '<div class="ml-req-meta">' + (st === 'rejected' ? 'Rejected' : 'Approved') + ' ' + EC.esc(r.decided)
                         + (r.decidedBy ? ' by ' + EC.esc(r.decidedBy) : '') + (r.remark ? ' — ' + EC.esc(r.remark) : '') + '</div>';
    if (r.cancelled) html += '<div class="ml-req-meta">Cancelled ' + EC.esc(r.cancelled)
                           + (r.cancelledBy ? ' by ' + EC.esc(r.cancelledBy) : '') + (r.cancelReason ? ' — ' + EC.esc(r.cancelReason) : '') + '</div>';
    if (r.canCancel) html += '<div class="text-end mt-2"><button type="button" class="btn btn-sm btn-outline-danger ml-cancel" data-id="' + Number(r.id) + '">Cancel request</button></div>';
    return html + '</div>';
  }

  function load() {
    EC.showLoader();
    EC.listLoading('#reqList');
    $.getJSON(URL.list).done(function (res) {
      if (!res || !res.success) { EC.listEmpty('#reqList', (res && res.message) || 'Could not load.', 'bx-error-circle'); return; }
      if (!res.rows.length) { EC.listEmpty('#reqList', 'You have not applied for any leave yet.', 'bx-calendar'); return; }
      $('#reqList').html(res.rows.map(requestHtml).join(''));
    }).fail(function () {
      EC.listEmpty('#reqList', 'Could not load your requests. Please retry.', 'bx-error-circle');
    }).always(EC.hideLoader);
  }

  $('#reqList').on('click', '.ml-cancel', function () {
    var $btn = $(this);
    var id = Number($btn.data('id'));
    EC.prompt({ title: 'Cancel this leave request?', message: 'Tell the office why.', label: 'Reason', placeholder: 'Reason',
                okText: 'Cancel request', required: true, danger: true }).then(function (reason) {
      if (reason === null) return;
      EC.buttonBusy($btn, 'Cancelling…');
      $.ajax({ url: URL.cancel, type: 'POST', headers: { 'RequestVerificationToken': CSRF },
               data: { id: id, reason: reason } })
        .done(function (res) {
          if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not cancel.'); return; }
          ecToast('success', res.message);
          load(); loadBalance();
        })
        .fail(function () { ecToast('error', 'Could not reach the server. Nothing was changed.'); })
        .always(function () { EC.buttonReset($btn); });
    });
  });

  // ── Apply ───────────────────────────────────────────────
  // Day count asked from the server, so the School Calendar is counted exactly as Apply will count it.
  function calcDays() {
    var f = $('#lvFrom').val(), t = $('#lvTo').val(), half = $('#lvHalf').is(':checked');
    if (half && f) { $('#lvTo').val(f); t = f; }
    if (!f || !t || t < f) { $('#lvDays').text('— days'); return; }
    $.getJSON(URL.days, { fromDate: f, toDate: t, halfDay: half }).done(function (res) {
      var d = res && res.success ? res.days : 0;
      $('#lvDays').text(d ? dayText(d) : 'no working days');
    });
  }
  $('#lvFrom,#lvTo,#lvHalf').on('change', calcDays);
  $('#lvFrom').on('change', loadBalance);

  $('#applyForm').on('submit', function (e) {
    e.preventDefault();
    var $btn = $(this).find('button[type=submit]');
    EC.buttonBusy($btn, 'Sending…');
    $.ajax({
      url: URL.apply, type: 'POST', headers: { 'RequestVerificationToken': CSRF },
      data: { leaveType: $('#lvType').val(), fromDate: $('#lvFrom').val(), toDate: $('#lvTo').val(),
              reason: $('#lvReason').val(), halfDay: $('#lvHalf').is(':checked') }
    })
    .done(function (res) {
      if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not apply.'); return; }
      document.getElementById('applyForm').reset();
      $('#lvDays').text('— days');
      ecToast('success', res.message + ' Sent for approval.');
      load(); loadBalance();
    })
    .fail(function () { ecToast('error', 'Could not reach the server. Nothing was saved.'); })
    .always(function () { EC.buttonReset($btn); });
  });

  loadBalance();
  load();
});
</script>
}
}
