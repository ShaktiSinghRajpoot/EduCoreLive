@{
    ViewData["Title"] = "Leave Management";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Leave/LeaveManagement.css" asp-append-version="true" />
}

<div class="ec-page-shell">
  <div class="ec-page-content lm-page">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-calendar-minus fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Leave Management</h4>
            <div class="ec-page-subtitle">Review, approve and track staff leave requests</div>
          </div>
        </div>
        <button class="btn-lm-apply" data-bs-toggle="modal" data-bs-target="#applyLeaveModal">
          <i class="bx bx-plus-circle"></i><span>Apply Leave</span>
        </button>
      </div>
    </div>

    <!-- Summary cards -->
    <div class="lm-stats">
      <div class="lm-stat s-pend">
        <div class="lm-stat-ic"><i class="bx bx-time-five"></i></div>
        <div class="lm-stat-val" id="kpiPending">0</div>
        <div class="lm-stat-lbl">Pending Approvals</div>
      </div>
      <div class="lm-stat s-today">
        <div class="lm-stat-ic"><i class="bx bx-user-minus"></i></div>
        <div class="lm-stat-val" id="kpiToday">0</div>
        <div class="lm-stat-lbl">On Leave Today</div>
      </div>
      <div class="lm-stat s-appr">
        <div class="lm-stat-ic"><i class="bx bx-check-circle"></i></div>
        <div class="lm-stat-val" id="kpiApproved">0</div>
        <div class="lm-stat-lbl">Approved This Month</div>
      </div>
      <div class="lm-stat s-bal">
        <div class="lm-stat-ic"><i class="bx bx-wallet"></i></div>
        <div class="lm-stat-val" id="kpiRequests">0</div>
        <div class="lm-stat-lbl">Total Requests</div>
      </div>
    </div>

    <!-- Leave balance legend -->
    <div class="ec-card mb-3">
      <div class="ec-card-body py-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
          <div class="lm-balance">
            <div class="lm-bal-chip"><span class="lm-bal-dot" style="background:#2563eb;"></span><span class="lm-bal-name">Casual</span><span class="lm-bal-val">12/yr</span></div>
            <div class="lm-bal-chip"><span class="lm-bal-dot" style="background:#dc2626;"></span><span class="lm-bal-name">Sick</span><span class="lm-bal-val">10/yr</span></div>
            <div class="lm-bal-chip"><span class="lm-bal-dot" style="background:#16a34a;"></span><span class="lm-bal-name">Earned</span><span class="lm-bal-val">15/yr</span></div>
            <div class="lm-bal-chip"><span class="lm-bal-dot" style="background:#be185d;"></span><span class="lm-bal-name">Maternity</span><span class="lm-bal-val">90 days</span></div>
            <div class="lm-bal-chip"><span class="lm-bal-dot" style="background:#7c3aed;"></span><span class="lm-bal-name">Comp-off</span><span class="lm-bal-val">As earned</span></div>
            <div class="lm-bal-chip"><span class="lm-bal-dot" style="background:#64748b;"></span><span class="lm-bal-name">Unpaid</span><span class="lm-bal-val">LOP</span></div>
          </div>
          @* Same figures the proc enforces (core.fn_leave_entitlement), per calendar year.
             Beyond them the rest is applied as Unpaid (Loss of Pay). *@
          <span class="text-muted" style="font-size:.74rem;font-weight:700;"><i class="bx bx-info-circle me-1"></i>Annual entitlement per staff · beyond it, apply as Unpaid</span>
        </div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="lm-toolbar">
      <div class="lm-tabs" id="lmTabs">
        <button class="lm-tab active" data-f="all">All <span class="lm-tab-count" id="cAll">0</span></button>
        <button class="lm-tab" data-f="pending">Pending <span class="lm-tab-count" id="cPending">0</span></button>
        <button class="lm-tab" data-f="approved">Approved <span class="lm-tab-count" id="cApproved">0</span></button>
        <button class="lm-tab" data-f="rejected">Rejected <span class="lm-tab-count" id="cRejected">0</span></button>
        <button class="lm-tab" data-f="cancelled">Cancelled <span class="lm-tab-count" id="cCancelled">0</span></button>
      </div>
      <div class="position-relative" style="max-width:240px;width:100%;">
        <i class="bx bx-search" style="position:absolute;left:.7rem;top:50%;transform:translateY(-50%);color:var(--lm-muted);"></i>
        <input type="search" class="form-control" id="lmSearch" placeholder="Search staff…" style="padding-left:2.1rem;border-radius:12px;min-height:42px;">
      </div>
    </div>

    <!-- List -->
    <div class="lm-list" id="lmList"></div>
    <div class="lm-empty d-none" id="lmEmpty">
      <div class="lm-empty-ic"><i class="bx bx-calendar-x"></i></div>
      <h6 class="fw-bold mb-1" style="color:var(--lm-heading);">No leave requests</h6>
      <p class="text-muted small mb-0">Nothing matches this filter.</p>
    </div>

  </div>
</div>

<!-- Apply Leave modal -->
<div class="modal fade lm-modal" id="applyLeaveModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="d-flex align-items-center gap-3">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-calendar-plus fs-5"></i></div>
          <div>
            <h5 class="modal-title mb-0">Apply for Leave</h5>
            <small class="text-muted fw-semibold">Submit a leave request for approval</small>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      @* Posted over ajax so the proc's own wording (overlapping dates, a range that
         is all Sundays) lands on the modal instead of a page reload losing it. *@
      <form id="applyLeaveForm" novalidate>
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Staff Member</label>
              <select name="StaffId" id="lvStaff" class="form-select" required>
                <option value="">Select staff</option>
                @foreach (var st in ViewBag.StaffList as IEnumerable<EduCoreDataAccessLayer.Models.StaffListItem>
                                    ?? Enumerable.Empty<EduCoreDataAccessLayer.Models.StaffListItem>())
                {
                    <option value="@st.StaffId">@st.FullName@(string.IsNullOrWhiteSpace(st.EmployeeCode) ? "" : " · " + st.EmployeeCode)</option>
                }
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Leave Type</label>
              <select name="LeaveType" class="form-select" required>
                <option value="">Select type</option>
                <option>Casual</option><option>Sick</option><option>Earned</option>
                <option>Maternity</option><option>Comp-off</option>
                @* The only type payroll charges as Loss of Pay — see staff_payroll.sql *@
                <option>Unpaid</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label">From Date</label>
              <input type="date" name="FromDate" id="lvFrom" class="form-control" required>
            </div>
            <div class="col-6">
              <label class="form-label">To Date</label>
              <input type="date" name="ToDate" id="lvTo" class="form-control" required>
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="lvHalf">
                <label class="form-check-label" for="lvHalf">Half day (one date, counts 0.5)</label>
              </div>
            </div>
            <div class="col-12">
              <div class="d-flex align-items-center gap-2">
                <span class="text-muted" style="font-size:.78rem;font-weight:700;">Duration:</span>
                <span class="lm-daypill" id="lvDays">— days</span>
              </div>
              <div class="text-muted small mt-1">Counted on the School Calendar: weekly offs and holidays are not leave days.</div>
              <div class="small mt-1" id="lvBalance"></div>
            </div>
            <div class="col-12">
              <label class="form-label">Reason</label>
              <textarea name="Reason" class="form-control" rows="3" placeholder="Brief reason for leave" required></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-lm-apply"><i class="bx bx-send"></i>Submit Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section PageScripts {
<script>
$(document).ready(function () {

    var LIST_URL    = '@Url.Action("List","Leave",new{area="Staff"})';
    var APPLY_URL   = '@Url.Action("ApplyLeave","Leave",new{area="Staff"})';
    var APPROVE_URL = '@Url.Action("Approve","Leave",new{area="Staff"})';
    var REJECT_URL  = '@Url.Action("Reject","Leave",new{area="Staff"})';
    var CANCEL_URL  = '@Url.Action("Cancel","Leave",new{area="Staff"})';
    var DAYS_URL    = '@Url.Action("CountDays","Leave",new{area="Staff"})';
    var BAL_URL     = '@Url.Action("Balance","Leave",new{area="Staff"})';
    var TODAY       = '@Dates.Now.ToString("yyyy-MM-dd")';   // the school's today, not the browser's UTC one

    var TYPE = { Casual:'t-casual', Sick:'t-sick', Earned:'t-earned', Maternity:'t-maternity',
                 'Comp-off':'t-comp', Unpaid:'t-comp' };

    // Loaded from the server; the page filters and counts in the browser because a
    // school's leave register is small.
    var requests = [];
    var curFilter = 'all', curSearch = '';

    function token() { return $('input[name="__RequestVerificationToken"]').first().val(); }
    // The DB stores Pending/Approved/Rejected/Cancelled; the page's tabs and CSS use lowercase.
    function st(r){ return (r.status||'').toLowerCase(); }
    function ini(n){ return (n||'').split(' ').slice(0,2).map(function(w){return w[0]||'';}).join('').toUpperCase(); }
    function dayText(d){ return d + ' working day' + (Number(d) === 1 ? '' : 's'); }

    function statusBadge(s){
        var m={ pending:['st-pending','Pending'], approved:['st-approved','Approved'],
                rejected:['st-rejected','Rejected'], cancelled:['st-rejected','Cancelled'] };
        var x=m[s]||m.pending; return '<span class="lm-status '+x[0]+'">'+x[1]+'</span>';
    }

    // A pending request can always be withdrawn; an approved one only before it starts
    // (the server also refuses it when that month's salary is already paid).
    function canCancel(r){ return st(r)==='pending' || (st(r)==='approved' && r.fromIso > TODAY); }

    function count(s){ return requests.filter(function(r){ return st(r)===s; }).length; }

    function updateKpis(){
        // onLeaveToday is decided server-side so every caller agrees on "today".
        var month = TODAY.slice(0,7);
        $('#kpiPending').text(count('pending'));
        $('#kpiToday').text(requests.filter(function(r){ return r.onLeaveToday; }).length);
        $('#kpiApproved').text(requests.filter(function(r){ return st(r)==='approved' && (r.fromIso||'').slice(0,7)===month; }).length);
        $('#kpiRequests').text(requests.length);
        $('#cAll').text(requests.length);
        $('#cPending').text(count('pending'));
        $('#cApproved').text(count('approved'));
        $('#cRejected').text(count('rejected'));
        $('#cCancelled').text(count('cancelled'));
    }

    function render(){
        var list = requests.slice();
        if(curFilter!=='all') list = list.filter(function(r){ return st(r)===curFilter; });
        if(curSearch) list = list.filter(function(r){ return r.name.toLowerCase().indexOf(curSearch) >= 0
                                         || (r.code||'').toLowerCase().indexOf(curSearch) >= 0; });

        if(!list.length){ $('#lmList').html(''); $('#lmEmpty').removeClass('d-none'); updateKpis(); return; }
        $('#lmEmpty').addClass('d-none');

        $('#lmList').html(list.map(function(r){
            // days comes from the server -- counted on the School Calendar.
            var range = r.from===r.to ? r.from : r.from+' → '+r.to;
            var cancelBtn = canCancel(r)
              ? '<button class="lm-btn lm-btn-reject" data-act="cancel" data-id="'+r.id+'" title="Withdraw this request"><i class="bx bx-undo"></i>Cancel</button>'
              : '';
            var actions = st(r)==='pending'
              ? '<div class="lm-actions">'
                + '<button class="lm-btn lm-btn-approve" data-act="approve" data-id="'+r.id+'"><i class="bx bx-check"></i>Approve</button>'
                + '<button class="lm-btn lm-btn-reject" data-act="reject" data-id="'+r.id+'"><i class="bx bx-x"></i>Reject</button>'
                + cancelBtn + '</div>'
              : '<div class="lm-actions">'+statusBadge(st(r))+cancelBtn+'</div>';
            var note = st(r)==='cancelled' && r.cancelReason ? ' · cancelled: '+EC.esc(r.cancelReason)
                     : (r.remark ? ' · '+EC.esc(r.remark) : '');
            return ''
              + '<div class="lm-card is-'+st(r)+'">'
              +   '<div class="lm-av bg-label-primary text-primary">'+EC.esc(ini(r.name))+'</div>'
              +   '<div class="lm-who"><div class="lm-name">'+EC.esc(r.name)+'</div><div class="lm-meta">'
              +     EC.esc(r.code||'—')+' · '+EC.esc(r.designation||'—')+'</div></div>'
              +   '<div><span class="lm-type '+(TYPE[r.type]||'t-casual')+'"><i class="bx bx-bookmark"></i>'+EC.esc(r.type)
              +     (r.unpaid?' <span title="Payroll charges these days as Loss of Pay">(LOP)</span>':'')+'</span></div>'
              +   '<div class="lm-dates"><div class="lm-range"><i class="bx bx-calendar"></i>'+EC.esc(range)+'</div>'
              +     '<div class="lm-days">'+EC.esc(dayText(r.days))+(r.halfDay?' (half day)':'')
              +     ' · <span class="lm-reason">'+EC.esc(r.reason||'—')+note+'</span></div></div>'
              +   actions
              + '</div>';
        }).join(''));
        updateKpis();
    }

    // Tabs
    $('#lmTabs').on('click','.lm-tab',function(){
        $('.lm-tab').removeClass('active'); $(this).addClass('active');
        curFilter = $(this).data('f'); render();
    });
    // Search
    $('#lmSearch').on('input',function(){ curSearch = this.value.toLowerCase().trim(); render(); });

    function post(url, data, $btn, busyText, okType){
        EC.buttonBusy($btn, busyText);
        $.ajax({ url: url, type: 'POST', headers: { 'RequestVerificationToken': token() }, data: data })
        .done(function (res) {
            if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not update.'); return; }
            ecToast(okType, res.message);
            load();
        })
        .fail(function (xhr) {
            ecToast('error', xhr && xhr.status === 403
                ? 'You do not have permission to change leave.'
                : 'Could not reach the server. Nothing was changed.');
        })
        .always(function () { EC.buttonReset($btn); });
    }

    // Approve / Reject / Cancel -- the server decides, and refuses a second decision
    // on a request that was already approved or rejected.
    $('#lmList').on('click','.lm-btn',function(){
        var id = Number($(this).data('id')), act = $(this).data('act'), $btn = $(this);
        if (act === 'approve') { post(APPROVE_URL, { id: id }, $btn, 'Approving…', 'success'); return; }
        if (act === 'reject')  { post(REJECT_URL,  { id: id }, $btn, 'Rejecting…', 'warning'); return; }
        EC.prompt({ title: 'Cancel this leave request?', message: 'The request is kept, marked Cancelled, with your reason.', label: 'Reason',
                    okText: 'Cancel request', required: true, danger: true }).then(function (reason) {
            if (reason === null) return;
            post(CANCEL_URL, { id: id, reason: reason }, $btn, 'Cancelling…', 'success');
        });
    });

    // Apply
    $('#applyLeaveForm').on('submit', function (e) {
        e.preventDefault();
        var $btn = $(this).find('button[type=submit]');
        EC.buttonBusy($btn, 'Submitting…');

        $.ajax({
            url: APPLY_URL,
            type: 'POST',
            headers: { 'RequestVerificationToken': token() },
            data: {
                staffId:   $('#lvStaff').val(),
                leaveType: $('[name=LeaveType]').val(),
                fromDate:  $('#lvFrom').val(),
                toDate:    $('#lvTo').val(),
                reason:    $('[name=Reason]').val(),
                halfDay:   $('#lvHalf').is(':checked')
            }
        })
        .done(function (res) {
            if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not apply.'); return; }
            bootstrap.Modal.getOrCreateInstance(document.getElementById('applyLeaveModal')).hide();
            document.getElementById('applyLeaveForm').reset();
            $('#lvDays').text('— days');
            $('#lvBalance').html('');
            ecToast('success', res.message);
            load();
        })
        .fail(function (xhr) {
            ecToast('error', xhr && xhr.status === 403
                ? 'You do not have permission to apply for leave.'
                : 'Could not reach the server. Nothing was saved.');
        })
        .always(function () { EC.buttonReset($btn); });
    });

    function load(){
        EC.showLoader();
        EC.listLoading('#lmList');
        $.getJSON(LIST_URL).done(function (rows) {
            requests = rows || [];
            render();
        }).fail(function () {
            requests = [];
            EC.listEmpty('#lmList', 'Could not load leave requests. Please retry.', 'bx-error-circle');
        }).always(EC.hideLoader);
    }

    // Modal duration: asked from the server, so holidays and weekly offs on the
    // School Calendar are counted exactly as Apply will count them.
    function calcDays(){
        var f=$('#lvFrom').val(), t=$('#lvTo').val(), half=$('#lvHalf').is(':checked');
        if (half && f) { $('#lvTo').val(f); t = f; }
        if (!f || !t || t < f) { $('#lvDays').text('— days'); return; }
        $.getJSON(DAYS_URL, { fromDate: f, toDate: t, halfDay: half }).done(function (res) {
            var d = res && res.success ? res.days : 0;
            $('#lvDays').text(d ? dayText(d) : 'no working days');
        });
    }
    $('#lvFrom,#lvTo,#lvHalf').on('change', calcDays);

    // Balance of the chosen staff member, for the year of the chosen from date.
    function loadBalance(){
        var sid = $('#lvStaff').val();
        if (!sid) { $('#lvBalance').html(''); return; }
        $.getJSON(BAL_URL, { staffId: sid, date: $('#lvFrom').val() || TODAY }).done(function (rows) {
            if (!rows || !rows.length) { $('#lvBalance').html(''); return; }
            $('#lvBalance').html('<span class="text-muted">Left in ' + EC.esc(rows[0].year) + ':</span> ' + rows
                .filter(function (b) { return b.entitled !== null; })
                .map(function (b) { return '<span class="me-2"><b>' + EC.esc(b.type) + '</b> ' + EC.esc(b.remaining) + '/' + EC.esc(b.entitled) + '</span>'; })
                .join(''));
        });
    }
    $('#lvStaff,#lvFrom').on('change', loadBalance);

    load();
});
</script>
}
