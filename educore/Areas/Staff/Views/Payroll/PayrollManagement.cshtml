@{
    ViewData["Title"] = "Payroll & Salary";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/ERP/Payroll/PayrollManagement.css" asp-append-version="true" />
}

@* The page posts over ajax with this token. It used to borrow the one in the
   menu's logout form, which only worked as long as that form existed. *@
@Html.AntiForgeryToken()

<div class="ec-page-shell">
  <div class="ec-page-content pr-page">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-money fs-4"></i></div>
          <div>
            <h4 class="ec-page-title mb-1">Payroll &amp; Salary</h4>
            <div class="ec-page-subtitle">Monthly salary run — pro-rata for joiners and leavers, loss of pay from unpaid leave, adjustments</div>
          </div>
        </div>
        <button class="btn-pr-run" id="btnExport"><i class="bx bx-download"></i><span>Export</span></button>
      </div>
    </div>

    <div class="pr-stats">
      <div class="pr-stat k-net"><div class="pr-stat-ic"><i class="bx bx-wallet"></i></div><div class="pr-stat-val" id="kNet">₹0.00</div><div class="pr-stat-lbl">Net Payroll</div></div>
      <div class="pr-stat k-ded"><div class="pr-stat-ic"><i class="bx bx-minus-circle"></i></div><div class="pr-stat-val" id="kDed">₹0.00</div><div class="pr-stat-lbl">Total Deductions</div></div>
      <div class="pr-stat k-paid"><div class="pr-stat-ic"><i class="bx bx-check-circle"></i></div><div class="pr-stat-val" id="kPaid">0</div><div class="pr-stat-lbl">Payslips Paid</div></div>
      <div class="pr-stat k-pend"><div class="pr-stat-ic"><i class="bx bx-time-five"></i></div><div class="pr-stat-val" id="kPend">0</div><div class="pr-stat-lbl">Draft (unpaid) Payslips</div></div>
    </div>

    <div class="pr-toolbar">
      <div>
        <div class="pr-field-label">PAY PERIOD</div>
        @* Last twelve months from the controller — payroll is never run ahead. *@
        <select class="form-select" id="fMonth">
          @foreach (var m in ViewBag.Months as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>())
          {
              <option value="@m.value">@m.label</option>
          }
        </select>
      </div>
      <div>
        <div class="pr-field-label">DEPARTMENT</div>
        <select class="form-select" id="fDept">
          <option value="">All Departments</option>
          @foreach (var d in ViewBag.Departments as IEnumerable<string> ?? Enumerable.Empty<string>())
          {
              <option value="@d">@d</option>
          }
        </select>
      </div>
      <button class="btn btn-outline-primary ms-auto" id="btnAdj"><i class="bx bx-plus-circle me-1"></i>Adjustment</button>
      <button class="btn-pr-run" id="btnRun"><i class="bx bx-play-circle"></i><span>Run Payroll</span></button>
    </div>

    <div class="ec-card">
      <div class="ec-card-body">
        <div class="pr-tbl-wrap">
          <table class="pr-tbl">
            <thead>
              <tr>
                <th>Staff</th>
                <th class="text-end">Gross</th>
                <th class="text-end">Deductions</th>
                <th class="text-center">LOP</th>
                <th class="text-end">Net Pay</th>
                <th class="text-center">Status</th>
                <th class="text-center">Payslip</th>
              </tr>
            </thead>
            <tbody id="prBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="ec-card mt-3">
      <div class="ec-card-body">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="fw-bold">Adjustments this month</div>
          <span class="text-muted small">Additions, deductions and advances. Never edited — voided with a reason while the month is unpaid.</span>
        </div>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Staff</th><th>Kind</th><th class="text-end">Amount</th><th>Reason</th><th>Recorded</th><th></th></tr></thead>
            <tbody id="adjBody"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Payslip modal -->
<div class="modal fade ps-modal" id="payslipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="ps-head">
        <div class="d-flex align-items-center gap-3">
          <div class="pr-av" id="psAv">--</div>
          <div>
            <div class="pr-nm" id="psName" style="font-size:1rem;">Staff Name</div>
            <div class="pr-sub" id="psSub">EMP · Designation</div>
          </div>
        </div>
        <div class="text-end">
          <div style="font-size:.7rem;font-weight:800;color:var(--pr-muted);text-transform:uppercase;">Payslip</div>
          <div style="font-weight:900;color:var(--pr-heading);" id="psPeriod">June 2026</div>
        </div>
      </div>

      <div class="ps-att" id="psAtt"></div>

      <div class="ps-cols">
        <div class="ps-col earn">
          <div class="ps-col-title"><i class="bx bx-trending-up"></i>Earnings</div>
          <div id="psEarn"></div>
        </div>
        <div class="ps-col ded">
          <div class="ps-col-title"><i class="bx bx-trending-down"></i>Deductions</div>
          <div id="psDed"></div>
        </div>
      </div>

      <div class="ps-net">
        <span class="l">Net Salary Payable</span>
        <span class="v" id="psNet">₹0.00</span>
      </div>
      <div class="ps-note"><i class="bx bx-info-circle me-1"></i>Days are school working days (School Calendar). Gross = salary × days employed ÷ working days; LOP = approved unpaid leave days plus days marked Absent / Half day (0.5) / Leave in Staff Attendance without approved leave, at the same rate. Run payroll again after marking attendance.</div>

      <div class="px-4 pb-2" id="psPaidInfo"></div>
      <div class="px-4 pb-2 row g-2 align-items-end" id="psPayForm">
        <div class="col-12 col-md-4">
          <label class="form-label small fw-bold mb-1">Paid by</label>
          <select class="form-select form-select-sm" id="psMode">
            <option value="">Choose…</option><option>Bank Transfer</option><option>UPI</option><option>Cheque</option><option>Cash</option>
          </select>
        </div>
        <div class="col-12 col-md-8">
          <label class="form-label small fw-bold mb-1">Reference (UTR / cheque no. / UPI id)</label>
          <input class="form-control form-control-sm" id="psRef" maxlength="60" placeholder="Not needed for cash">
        </div>
      </div>

      <div class="px-4 pb-3">
        <div class="small fw-bold text-muted mb-1">Money trail</div>
        <div id="psTrail" class="small"></div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn-pr-run" id="psPrint"><i class="bx bx-printer"></i>Print</button>
        <button type="button" class="btn btn-success px-4 fw-bold" id="psMarkPaid"><i class="bx bx-check me-1"></i>Mark Paid</button>
      </div>
    </div>
  </div>
</div>

<!-- Adjustment modal -->
<div class="modal fade" id="adjModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:18px">
      <div class="modal-header"><h5 class="modal-title">Payroll adjustment — <span id="adjPeriod"></span></h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label fw-bold">Staff member</label>
            <select class="form-select" id="adjStaff">
              <option value="">Choose…</option>
              @foreach (var s in ViewBag.Staff as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>())
              {
                  <option value="@s.id">@s.name</option>
              }
            </select>
          </div>
          <div class="col-6">
            <label class="form-label fw-bold">Kind</label>
            <select class="form-select" id="adjKind">
              <option value="Addition">Addition (arrears, bonus, encashment)</option>
              <option value="Deduction">Deduction (recovery, fine)</option>
              <option value="Advance">Advance (paid now, deducted this month)</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label fw-bold">Amount (₹)</label>
            <input type="number" min="0.01" step="0.01" class="form-control" id="adjAmount">
          </div>
          <div class="col-12">
            <label class="form-label fw-bold">Reason</label>
            <input class="form-control" id="adjReason" maxlength="300" placeholder="e.g. LOP 22 Jul approved after July was paid">
          </div>
          <div class="col-6 adj-adv"><label class="form-label fw-bold">Advance paid by</label>
            <select class="form-select" id="adjMode"><option value="">Choose…</option><option>Cash</option><option>Bank Transfer</option><option>UPI</option><option>Cheque</option></select>
          </div>
          <div class="col-6 adj-adv"><label class="form-label fw-bold">Reference</label>
            <input class="form-control" id="adjRef" maxlength="60" placeholder="Not needed for cash">
          </div>
          <div class="col-12 text-muted small">A paid month cannot be adjusted: record the correction in the next unpaid month.</div>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="adjSave">Record</button></div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
$(document).ready(function () {

    var LIST_URL  = '@Url.Action("List","Payroll",new{area="Staff"})';
    var RUN_URL   = '@Url.Action("RunPayroll","Payroll",new{area="Staff"})';
    var PAID_URL  = '@Url.Action("MarkPaid","Payroll",new{area="Staff"})';
    var HIST_URL  = '@Url.Action("History","Payroll",new{area="Staff"})';
    var ADJ_URL   = '@Url.Action("Adjustments","Payroll",new{area="Staff"})';
    var ADD_URL   = '@Url.Action("AddAdjustment","Payroll",new{area="Staff"})';
    var VOID_URL  = '@Url.Action("VoidAdjustment","Payroll",new{area="Staff"})';
    function token(){ return $('input[name="__RequestVerificationToken"]').first().val(); }
    function period(){ var v=($('#fMonth').val()||'').split('-'); return { year:+v[0], month:+v[1] }; }
    function ini(n){ return (n||'').split(' ').slice(0,2).map(function(w){return w[0]||'';}).join('').toUpperCase(); }
    function periodLabel(){ return $('#fMonth option:selected').text(); }

    var COLORS = ['bg-label-primary text-primary','bg-label-info text-info','bg-label-success text-success','bg-label-warning text-warning','bg-label-danger text-danger'];

    /* Rows come from the server, already computed. There is no salary-component or
       statutory-rate table (EPF / ESI / PT / TDS), so the payslip shows what the
       school recorded: salary, days, LOP, adjustments, net. */
    var ROWS = [];

    function render(){
        var totNet = 0, totDed = 0, paid = 0, pend = 0;

        if(!ROWS.length){
            // No payslips is not the same as zero pay — the month simply has not been run.
            EC.listEmpty('#prBody', 'No payslips for this month yet. Press Run Payroll to generate them.', 'bx-receipt');
            $('#kNet').text(EC.money(0)); $('#kDed').text(EC.money(0)); $('#kPaid').text(0); $('#kPend').text(0);
            return;
        }

        $('#prBody').html(ROWS.map(function(s){
            var isPaid = (s.status||'').toLowerCase() === 'paid';
            totNet += s.net; totDed += s.deductions;
            if (isPaid) paid++; else pend++;
            var lopCls = s.lopDays > 0 ? 'has' : 'zero';
            var col = COLORS[s.staffId % COLORS.length];
            var part = s.paidDays < s.workingDays
                ? '<div class="pr-sub" title="Joined or left during the month">'+EC.esc(s.paidDays)+' of '+EC.esc(s.workingDays)+' days</div>' : '';
            return ''
              + '<tr>'
              +   '<td><div class="pr-staff"><div class="pr-av '+col+'">'+EC.esc(ini(s.name))+'</div><div>'
              +     '<div class="pr-nm">'+EC.esc(s.name)+'</div>'
              +     '<div class="pr-sub">'+EC.esc(s.code||'—')+' · '+EC.esc(s.designation||'—')+'</div></div></div></td>'
              +   '<td class="text-end pr-amt">'+EC.money(s.gross + s.additions)+part+'</td>'
              +   '<td class="text-end pr-amt ded">'+(s.deductions>0?'−'+EC.money(s.deductions):EC.money(0))+'</td>'
              +   '<td class="text-center"><span class="pr-lop '+lopCls+'" title="'+EC.esc(lopTitle(s))+'">'
              +     '<i class="bx bx-calendar-x"></i>'+EC.esc(s.lopDays)+'</span>'
              +     (s.absentDays > 0 ? '<div class="pr-sub">'+EC.esc(s.absentDays)+' absent</div>' : '')+'</td>'
              +   '<td class="text-end pr-amt net">'+EC.money(s.net)+'</td>'
              +   '<td class="text-center"><span class="pr-status '+(isPaid?'ps-paid':'ps-pending')+'">'+(isPaid?'Paid':'Draft')+'</span></td>'
              +   '<td class="text-center"><button class="pr-view" data-id="'+s.id+'"><i class="bx bx-receipt"></i>View</button></td>'
              + '</tr>';
        }).join(''));

        $('#kNet').text(EC.money(totNet));
        $('#kDed').text(EC.money(totDed));
        $('#kPaid').text(paid);
        $('#kPend').text(pend);
    }

    // Loss of pay = approved unpaid leave + days absent in Staff Attendance (no approved leave).
    function lopTitle(s){
        var absent = s.absentDays || 0, leave = s.lopDays - absent, parts = [];
        if (leave > 0)  parts.push(leave + ' day(s) unpaid leave');
        if (absent > 0) parts.push(absent + ' day(s) absent (Staff Attendance)');
        return parts.join(' + ') || 'No loss of pay';
    }

    /* ── Payslip modal ── */
    var activeId = null;
    function line(l,v){ return '<div class="ps-line"><span>'+EC.esc(l)+'</span><span>'+EC.money(v)+'</span></div>'; }
    function lineTotal(l,v){ return '<div class="ps-line total"><span>'+EC.esc(l)+'</span><span>'+EC.money(v)+'</span></div>'; }
    function chip(l,v,warn){ return '<div class="ps-att-chip"><div class="ps-att-v" '+(warn?'style="color:var(--pr-amber)"':'')+'>'+EC.esc(v)+'</div><div class="ps-att-l">'+EC.esc(l)+'</div></div>'; }

    function openPayslip(s){
        var isPaid = (s.status||'').toLowerCase()==='paid';
        activeId = s.id;
        $('#psAv').attr('class','pr-av '+COLORS[s.staffId % COLORS.length]).text(ini(s.name));
        $('#psName').text(s.name);
        $('#psSub').text((s.code||'—') + ' · ' + (s.designation||'—') + (s.department?' · '+s.department:''));
        $('#psPeriod').text(periodLabel());

        $('#psAtt').html(chip('Working Days', s.workingDays) + chip('Days Employed', s.paidDays, s.paidDays < s.workingDays)
                         + chip('LOP Days', s.lopDays, s.lopDays > 0));

        $('#psEarn').html(
            line('Monthly salary (rate)', s.salary)
            + (s.paidDays < s.workingDays ? line('Earned for '+s.paidDays+' of '+s.workingDays+' days', s.gross) : '')
            + (s.additions > 0 ? line('Additions', s.additions) : '')
            + lineTotal('Gross Earnings', s.gross + s.additions)
        );
        $('#psDed').html(
            (s.lopDays > 0 ? line('Loss of Pay ('+s.lopDays+'d: '+lopTitle(s)+')', s.lopAmount) : '')
            + (s.otherDeduct > 0 ? line('Advances / deductions', s.otherDeduct) : '')
            + lineTotal('Total Deductions', s.deductions)
        );
        $('#psNet').text(EC.money(s.net));

        $('#psPaidInfo').html(isPaid
            ? '<div class="alert alert-success py-2 mb-0 small"><b>Paid</b> ' + EC.esc(s.paidAt) + ' by ' + EC.esc(s.paidBy || '—')
              + ' · ' + EC.esc(s.payMode || '—') + (s.payRef ? ' · ref ' + EC.esc(s.payRef) : '') + '</div>'
            : '');
        $('#psPayForm').toggle(!isPaid);
        $('#psMode').val(''); $('#psRef').val('');
        $('#psMarkPaid').toggle(!isPaid);

        // The append-only trail for this person and month.
        EC.listLoading('#psTrail');
        $.getJSON(HIST_URL, { id: s.id }).done(function (rows) {
            if (!rows || !rows.length) { EC.listEmpty('#psTrail', 'No history yet.'); return; }
            $('#psTrail').html('<ul class="list-unstyled mb-0">' + rows.map(function (h) {
                return '<li><b>' + EC.esc(h.action) + '</b> · ' + EC.esc(h.at) + ' · ' + EC.esc(h.by || '—')
                     + (h.net !== null ? ' · net ' + EC.money(h.net) : '')
                     + (h.mode ? ' · ' + EC.esc(h.mode) : '') + (h.reference ? ' (' + EC.esc(h.reference) + ')' : '')
                     + (h.note ? ' — ' + EC.esc(h.note) : '') + '</li>';
            }).join('') + '</ul>');
        }).fail(function () { EC.listEmpty('#psTrail', 'Could not load the history.', 'bx-error-circle'); });

        bootstrap.Modal.getOrCreateInstance(document.getElementById('payslipModal')).show();
    }

    $('#prBody').on('click','.pr-view',function(){
        var id = Number($(this).data('id'));
        var s = ROWS.filter(function(x){ return x.id === id; })[0];
        if (s) openPayslip(s);
    });

    // The server refuses to pay a payslip twice, and refuses a payment without a
    // mode (or without a reference unless it was cash).
    $('#psMarkPaid').on('click',function(){
        var $btn=$(this), mode=$('#psMode').val(), ref=$('#psRef').val().trim();
        if (!mode) { ecToast('warning','Choose how the salary was paid.'); return; }
        if (mode !== 'Cash' && !ref) { ecToast('warning','Enter the payment reference.'); return; }
        var s = ROWS.filter(function(x){ return x.id === activeId; })[0];
        EC.confirm({ title:'Mark this payslip paid?', name:(s ? s.name + ' — ' + EC.money(s.net) : ''),
                     message:'A paid payslip can never be changed. Corrections go as an adjustment in an unpaid month.',
                     okText:'Mark paid', danger:false }).then(function(ok){
            if (!ok) return;
            EC.buttonBusy($btn,'Saving…');
            $.ajax({ url:PAID_URL, type:'POST', headers:{ 'RequestVerificationToken': token() },
                     data:{ id: activeId, paymentMode: mode, paymentReference: ref } })
            .done(function(res){
                if(!res||!res.success){ ecToast('error',(res&&res.message)||'Could not mark paid.'); return; }
                bootstrap.Modal.getOrCreateInstance(document.getElementById('payslipModal')).hide();
                ecToast('success', res.message);
                load();
            })
            .fail(function(xhr){
                ecToast('error', xhr && xhr.status===403
                    ? 'You do not have permission to mark payslips paid.'
                    : 'Could not reach the server. Nothing was changed.');
            })
            .always(function(){ EC.buttonReset($btn); });
        });
    });
    $('#psPrint').on('click',function(){ window.print(); });

    $('#fMonth, #fDept').on('change', load);

    // Running again rebuilds every draft payslip of the month, so ask first (QA BUG-087).
    $('#btnRun').on('click', function(){
        var $btn=$(this), drafts=0, paidCount=0;
        ROWS.forEach(function(s){ if ((s.status||'').toLowerCase()==='paid') paidCount++; else drafts++; });
        // With a department filter the list shows only part of the month, so no counts then.
        var msg = $('#fDept').val()
            ? 'This rebuilds every draft payslip of ' + $('#fMonth option:selected').text() + ' (all departments). Paid payslips are not changed.'
            : ROWS.length
            ? 'This rebuilds the ' + drafts + ' draft payslip(s) of ' + $('#fMonth option:selected').text() + ' from the latest salary, attendance and leave.' +
              (paidCount ? ' The ' + paidCount + ' paid payslip(s) are not changed.' : '')
            : 'This generates the payslips of ' + $('#fMonth option:selected').text() + ' for every active staff member.';
        EC.confirm({ title:'Run payroll?', message:msg, okText:'Run payroll', danger:false })
          .then(function(ok){ if (ok) runPayroll($btn); });
    });
    function runPayroll($btn){
        var p=period();
        EC.buttonBusy($btn,'Running…');
        $.ajax({ url:RUN_URL, type:'POST',
                 headers:{ 'RequestVerificationToken': token() },
                 data:{ month:p.month, year:p.year } })
        .done(function(res){
            if(!res||!res.success){ ecToast('error',(res&&res.message)||'Could not run payroll.'); return; }
            // The proc reports what it generated, what it left alone (paid) and
            // which paid payslips no longer match -- repeat it verbatim.
            ecToast('success', res.message);
            load();
        })
        .fail(function(xhr){
            ecToast('error', xhr && xhr.status===403
                ? 'You do not have permission to run payroll.'
                : 'Could not reach the server. Nothing was generated.');
        })
        .always(function(){ EC.buttonReset($btn); });
    }

    /* ── Adjustments ── */
    // A paid payslip's adjustments cannot be voided (the server refuses), so no button.
    function slipPaid(staffId){
        for (var i = 0; i < ROWS.length; i++)
            if (ROWS[i].staffId === staffId && (ROWS[i].status || '').toLowerCase() === 'paid') return true;
        return false;
    }
    function renderAdj(rows){
        if (!rows || !rows.length) { EC.listEmpty('#adjBody', 'No adjustments for this month.', 'bx-list-ul'); return; }
        $('#adjBody').html(rows.map(function (a) {
            var amt = (a.kind === 'Addition' ? '+' : '−') + EC.money(a.amount);
            return '<tr' + (a.isVoid ? ' class="text-muted text-decoration-line-through"' : '') + '>'
                 + '<td>' + EC.esc(a.name) + '</td>'
                 + '<td>' + EC.esc(a.kind) + (a.mode ? ' <span class="small">(' + EC.esc(a.mode) + (a.reference ? ' ' + EC.esc(a.reference) : '') + ')</span>' : '') + '</td>'
                 + '<td class="text-end">' + amt + '</td>'
                 + '<td>' + EC.esc(a.reason) + (a.isVoid ? '<div class="small">void: ' + EC.esc(a.voidReason) + '</div>' : '') + '</td>'
                 + '<td class="small">' + EC.esc(a.at) + ' · ' + EC.esc(a.by || '—') + '</td>'
                 + '<td class="text-end">' + (a.isVoid ? ''
                       : slipPaid(a.staffId) ? '<span class="small text-muted">Paid month</span>'
                       : '<button class="btn btn-sm btn-outline-danger adj-void" data-id="' + a.id + '">Void</button>') + '</td>'
                 + '</tr>';
        }).join(''));
    }

    function loadAdj(){
        var p = period();
        EC.listLoading('#adjBody');
        $.getJSON(ADJ_URL, { month: p.month, year: p.year })
         .done(renderAdj)
         .fail(function () { EC.listEmpty('#adjBody', 'Could not load adjustments.', 'bx-error-circle'); });
    }

    function syncAdvance(){ $('.adj-adv').toggle($('#adjKind').val() === 'Advance'); }
    $('#adjKind').on('change', syncAdvance);

    $('#btnAdj').on('click', function () {
        $('#adjPeriod').text(periodLabel());
        $('#adjStaff').val(''); $('#adjKind').val('Addition'); $('#adjAmount').val(''); $('#adjReason').val('');
        $('#adjMode').val(''); $('#adjRef').val('');
        syncAdvance();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('adjModal')).show();
    });

    $('#adjSave').on('click', function () {
        var p = period(), $btn = $(this);
        var data = { staffId: $('#adjStaff').val(), month: p.month, year: p.year, kind: $('#adjKind').val(),
                     amount: $('#adjAmount').val(), reason: $('#adjReason').val().trim(),
                     paymentMode: $('#adjMode').val(), paymentReference: $('#adjRef').val().trim() };
        if (!data.staffId) { ecToast('warning', 'Choose the staff member.'); return; }
        if (!(EC.numPos(data.amount) > 0)) { ecToast('warning', 'Enter an amount greater than zero.'); return; }
        if (!data.reason) { ecToast('warning', 'Give a reason.'); return; }
        EC.buttonBusy($btn, 'Saving…');
        $.ajax({ url: ADD_URL, type: 'POST', headers: { 'RequestVerificationToken': token() }, data: data })
        .done(function (res) {
            if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not record the adjustment.'); return; }
            bootstrap.Modal.getOrCreateInstance(document.getElementById('adjModal')).hide();
            ecToast('success', res.message);
            load();
        })
        .fail(function (xhr) {
            ecToast('error', xhr && xhr.status === 403 ? 'You do not have permission to adjust payroll.'
                                                        : 'Could not reach the server. Nothing was saved.');
        })
        .always(function () { EC.buttonReset($btn); });
    });

    $('#adjBody').on('click', '.adj-void', function () {
        var id = Number($(this).data('id')), $btn = $(this);
        EC.prompt({ title: 'Void this adjustment?', message: 'It stays on record, marked void, with your reason.',
                    label: 'Reason', required: true, okText: 'Void adjustment' }).then(function (reason) {
            if (reason === null) return;
            EC.buttonBusy($btn, 'Voiding…');
            $.ajax({ url: VOID_URL, type: 'POST', headers: { 'RequestVerificationToken': token() },
                     data: { id: id, reason: reason } })
            .done(function (res) {
                if (!res || !res.success) { ecToast('error', (res && res.message) || 'Could not void.'); return; }
                ecToast('success', res.message);
                load();
            })
            .fail(function () { ecToast('error', 'Could not reach the server. Nothing was changed.'); })
            .always(function () { EC.buttonReset($btn); });
        });
    });

    $('#btnExport').on('click', function(){
        if(!ROWS.length){ ecToast('warning','Nothing to export — run the payroll first.'); return; }
        // The figures the payslip actually holds (no browser-side tax maths).
        var rows = ROWS.map(function(s){
            return [s.code,s.name,s.department,s.salary,s.workingDays,s.paidDays,s.gross,s.lopDays,s.absentDays,s.lopAmount,
                    s.additions,s.otherDeduct,s.net,s.status,s.payMode,s.payRef,s.paidAt]; });
        var hdr = ['Emp','Name','Department','Salary','Working Days','Days Employed','Gross','LOP Days','Of which Absent','LOP Amount',
                   'Additions','Advances/Deductions','NetPay','Status','Paid By','Reference','Paid At'];
        var csv = '﻿'+[hdr].concat(rows).map(function(r){ return r.map(function(c){ return '"'+String(c).replace(/"/g,'""')+'"'; }).join(','); }).join('\r\n');
        var a=document.createElement('a'); a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);
        a.download='payroll_'+$('#fMonth').val()+'.csv'; a.click();
        ecToast('success','Payroll exported.');
    });

    function load(){
        var p=period();
        EC.showLoader();
        EC.listLoading('#prBody');
        $.getJSON(LIST_URL,{ month:p.month, year:p.year, department:$('#fDept').val()||null })
         .done(function(rows){ ROWS=rows||[]; render(); })
         .fail(function(){
            ROWS=[];
            EC.listEmpty('#prBody', 'Could not load payroll. Please retry.', 'bx-error-circle');
         })
         .always(function(){
            EC.hideLoader();
            loadAdj();   // after the payslips, so it knows which are paid
         });
    }

    load();
});
</script>
}
