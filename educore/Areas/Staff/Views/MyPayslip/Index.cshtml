@model List<EduCoreDataAccessLayer.Models.ERP.MyPayslip>
@{
    ViewData["Title"] = "My Payslip";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var me = ViewBag.Me as EduCoreDataAccessLayer.Models.ERP.MyStaffInfo;
    bool moduleOff = ViewBag.ModuleOff == true;
    var inr = new System.Globalization.CultureInfo("en-IN");
}
@functions {
    string Period(int month, int year) =>
        new DateTime(year, Math.Clamp(month, 1, 12), 1).ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
}

@section PageStyles {
<style>
  .mp-wrap { max-width: 760px; margin: 0 auto; }
  .mp-card { background:#fff; border:1px solid var(--bs-border-color); border-radius:18px; padding:1.1rem; margin-bottom:1rem; }
  .mp-slip { display:block; border:1px solid var(--bs-border-color); border-radius:14px; padding:.8rem .9rem; margin-bottom:.6rem; color:inherit; text-decoration:none; }
  .mp-slip:hover { border-color:var(--p); }
  .mp-top { display:flex; justify-content:space-between; align-items:center; gap:.5rem; }
  .mp-month { font-weight:900; color:var(--heading); }
  .mp-net { font-size:1.2rem; font-weight:900; color:#15803d; }
  .mp-figs { display:flex; flex-wrap:wrap; gap:.25rem 1rem; font-size:.8rem; color:var(--bs-secondary-color); margin-top:.3rem; }
  .mp-figs b { color:var(--bs-body-color); }
  .mp-badge { font-size:.72rem; font-weight:800; padding:.25rem .6rem; border-radius:999px; }
  .mp-paid  { background:#dcfce7; color:#15803d; }
  .mp-draft { background:#fff3cd; color:#b7791f; }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content mp-wrap">
    <div class="d-flex align-items-center gap-2 mb-3">
      <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center" style="background:var(--soft);color:var(--p);width:46px;height:46px"><i class="bx bx-receipt fs-4"></i></div>
      <div>
        <h4 class="mb-0" style="color:var(--heading);font-weight:900">My Payslip</h4>
        <div class="text-muted" style="font-size:.8rem">Your monthly payslips — open one to view or print it</div>
      </div>
    </div>

    @if (moduleOff)
    {
      <div class="mp-card text-center text-muted">Leave and payroll are turned off for this school.</div>
    }
    else if (me == null)
    {
      <div class="mp-card text-center">
        <i class="bx bx-info-circle fs-1 text-muted"></i>
        <div class="fw-bold mt-2">You do not have a staff record in this school.</div>
        <div class="text-muted small mt-1">My Payslip is for staff members. Ask the school office to link your login to your staff record.</div>
      </div>
    }
    else if (!Model.Any())
    {
      <div class="mp-card text-center">
        <i class="bx bx-receipt fs-1 text-muted"></i>
        <div class="fw-bold mt-2">No payslips yet.</div>
        <div class="text-muted small mt-1">A payslip appears here once the school office runs payroll for the month.</div>
      </div>
    }
    else
    {
      <div class="mp-card">
        @foreach (var p in Model)
        {
          bool paid = string.Equals(p.Status, "Paid", StringComparison.OrdinalIgnoreCase);
          <a class="mp-slip" asp-action="Slip" asp-route-id="@p.PayrollId">
            <div class="mp-top">
              <div class="mp-month">@Period(p.PayMonth, p.PayYear)</div>
              <span class="mp-badge @(paid ? "mp-paid" : "mp-draft")">@(paid ? "Paid" : "Draft")</span>
            </div>
            <div class="mp-top mt-1">
              <div class="mp-figs">
                <span>Gross <b>₹@((p.Gross + p.OtherAdd).ToString("N2", inr))</b></span>
                <span>Deductions <b>₹@p.TotalDeduct.ToString("N2", inr)</b></span>
                @if (p.LopDays > 0) { <span>LOP <b>@p.LopDays.ToString("0.#") d</b>@(p.AbsentDays > 0 ? " (" + p.AbsentDays.ToString("0.#") + " absent)" : "")</span> }
              </div>
              <div class="mp-net">₹@p.NetPay.ToString("N2", inr)</div>
            </div>
            <div class="mp-figs">
              @if (paid)
              {
                <span>Paid @(p.PaidAt?.ToString("dd MMM yyyy") ?? "") @(string.IsNullOrWhiteSpace(p.PaymentMode) ? "" : "· " + p.PaymentMode)</span>
              }
              else
              {
                <span>Not paid yet — figures can still change until the office pays it.</span>
              }
            </div>
          </a>
        }
      </div>
    }
  </div>
</div>
