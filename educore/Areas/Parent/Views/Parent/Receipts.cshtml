@model List<ParentReceiptRow>
@{
    ViewData["Title"] = "Receipts";
    var child = (ParentChild)ViewBag.Child;
    string Money(decimal v) => "₹" + v.ToString("N2", new System.Globalization.CultureInfo("en-IN"));
}

<div class="pa-card">
    <h2>Receipts</h2>
    @if (Model.Count == 0)
    {
        <div class="pa-muted">No receipts yet.</div>
    }
    @foreach (var r in Model)
    {
        <a class="pa-row text-reset text-decoration-none" href="/parent/receipt?c=@child.StudentId&no=@Uri.EscapeDataString(r.ReceiptNo)">
            <div>
                <span class="@(r.IsCancelled ? "pa-cancelled" : "")">@r.ReceiptNo</span>
                <div class="pa-muted">@Dates.Show(r.Date) · @r.Mode</div>
            </div>
            <div class="text-end">
                <span class="@(r.IsCancelled ? "pa-cancelled" : "")">@Money(r.Amount)</span>
                @if (r.IsCancelled)
                {
                    <div><span class="badge bg-label-secondary">Cancelled</span></div>
                }
            </div>
        </a>
    }
</div>
