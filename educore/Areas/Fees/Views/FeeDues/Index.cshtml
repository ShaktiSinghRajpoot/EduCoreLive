@{
    ViewData["Title"] = "Month-wise Dues";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var years = ViewBag.YearList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var classes = ViewBag.ClassList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                  ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    bool canCollect = ViewBag.CanCollect == true;
    bool canManage  = ViewBag.CanManage == true;   // reminders, letters, late fee, settings, don't chase
    string schoolName    = ViewBag.SchoolName as string ?? "";
    string schoolAddress = ViewBag.SchoolAddress as string ?? "";
    string schoolLogo    = ViewBag.SchoolLogo as string ?? "";
}

@section PageStyles {
<style>
  .fd-kpi { border:1px solid var(--bs-border-color); border-radius:14px; padding:.75rem .9rem; background:var(--bs-body-bg); height:100%; }
  .fd-kpi .v { font-size:1.3rem; font-weight:900; line-height:1.1; }
  .fd-kpi .l { font-size:.68rem; font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:var(--bs-secondary-color); }
  .fd-kpi.fd-click { cursor:pointer; }
  .fd-kpi.fd-on { border-color:#dc2626; background:#fff5f5; }
  .fd-bar { height:.35rem; border-radius:999px; background:#f0eee9; overflow:hidden; margin-top:.2rem; min-width:60px; }
  .fd-bar span { display:block; height:100%; border-radius:inherit; background:#dc2626; }
  .fd-mon { display:inline-block; padding:.05rem .4rem; margin:0 .15rem .15rem 0; border-radius:999px; background:#fff1f0; color:#b91c1c; font-size:.7rem; font-weight:800; }
  .fd-left { display:inline-flex; align-items:center; gap:.2rem; border:0; border-radius:999px; padding:.05rem .45rem; background:#fef3c7; color:#92400e; font-size:.68rem; font-weight:800; cursor:pointer; }
  .fd-table th, .fd-table td { vertical-align:middle; }
  .fd-class-row { cursor:pointer; }
  .fd-class-row.fd-sel td { background:#fff7e6; }
  .fd-scroll { max-height:19rem; overflow:auto; }
  .fd-card { border:1px solid var(--bs-border-color); border-radius:12px; padding:.7rem .8rem; margin-bottom:.5rem; }
  .fd-tag { display:inline-block; padding:.05rem .45rem; border-radius:999px; font-size:.68rem; font-weight:800; margin:.1rem .15rem 0 0; }
  .fd-tag.hold { background:#fee2e2; color:#b91c1c; }
  .fd-tag.nochase { background:#e5e7eb; color:#374151; }
  .fd-tag.note { background:#e0f2fe; color:#075985; cursor:pointer; }
  .fd-tag.note.due { background:#fef3c7; color:#92400e; }
  .fd-fam td { background:#f8fafc; font-size:.8rem; font-weight:700; }
  .fd-selbar { position:sticky; top:0; z-index:3; background:#fff7e6; border:1px solid #fed7aa; border-radius:10px; }
  .fd-check { width:1.1rem; height:1.1rem; cursor:pointer; }
  /* phones: the two summary tables fit the screen (tighter cells, no "Due" column) */
  @@media (max-width:575.98px) {
    .fd-table th, .fd-table td { padding:.35rem .3rem; font-size:.8rem; }
    .fd-hide-sm { display:none; }
    .fd-bar { min-width:40px; }
    #fdFind { max-width:none !important; width:100%; }   /* the Find box takes its own full line */
  }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap d-flex align-items-center gap-2">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center"><i class="bx bx-calendar-exclamation fs-4"></i></div>
          <div>
            <h4 class="ec-page-title mb-1">Month-wise Dues</h4>
            <div class="ec-page-subtitle">Fees still unpaid, month by month and class by class. ⚠ marks a child who may have left the school.</div>
          </div>
        </div>
        <div class="d-flex gap-2 flex-wrap ec-head-actions">
          @if (canManage)
          {
              <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-1" id="fdSettingsBtn" title="Late fee and hold rule">
                <i class="bx bx-cog"></i><span>Settings</span>
              </button>
              <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-1" id="fdLateBtn" title="Add late fees for overdue months">
                <i class="bx bx-time-five"></i><span>Late fees</span>
              </button>
          }
          <button type="button" class="btn btn-primary d-flex align-items-center gap-1" id="fdCsv">
            <i class="bx bx-download"></i><span>Download</span>
          </button>
        </div>
      </div>
    </div>

    @* one tidy bar: Filters (opens the side panel), what is applied, and a quick Find *@
    <div class="ec-card mb-3"><div class="ec-card-body d-flex flex-wrap gap-2 align-items-center py-2">
      <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" style="width:auto"
              data-bs-toggle="offcanvas" data-bs-target="#fdFilters" aria-controls="fdFilters">
        <i class="bx bx-filter-alt"></i><span>Filters</span><span class="badge bg-primary rounded-pill d-none" id="fdFilterCount">0</span>
      </button>
      <div class="d-flex flex-wrap gap-1 flex-grow-1" id="fdChips"></div>
      <input id="fdFind" class="form-control form-control-sm" style="max-width:240px" placeholder="Find: name, father, mobile, adm. no">
    </div></div>

    <div class="row g-2 mb-3">
      <div class="col-6 col-md-3"><div class="fd-kpi"><div class="v text-danger" id="kPending">—</div><div class="l">Pending</div></div></div>
      <div class="col-6 col-md-3"><div class="fd-kpi"><div class="v" id="kKids">—</div><div class="l">Children with dues</div></div></div>
      <div class="col-6 col-md-3"><div class="fd-kpi fd-click" data-show="3" title="Show them"><div class="v" style="color:#c2410c" id="kLong">—</div><div class="l">3+ months pending</div></div></div>
      <div class="col-6 col-md-3"><div class="fd-kpi fd-click" data-show="left" title="Show them"><div class="v" style="color:#92400e" id="kLeft">—</div><div class="l">⚠ May have left</div></div></div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-12 col-lg-6">
        <div class="ec-card h-100 mb-0"><div class="ec-card-body">
          <div class="fw-semibold mb-1">Month by month</div>
          <div class="small text-muted mb-2">Fees that fell due in each month: billed, collected and still pending</div>
          <div class="fd-scroll"><table class="table table-sm fd-table mb-0">
            <thead><tr><th>Month</th><th class="text-end fd-hide-sm">Due</th><th class="text-end">Collected</th><th class="text-end">Pending</th></tr></thead>
            <tbody id="fdMonths"><tr><td colspan="4" class="text-muted small">Loading…</td></tr></tbody>
          </table></div>
        </div></div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="ec-card h-100 mb-0"><div class="ec-card-body">
          <div class="fw-semibold mb-1">Class by class</div>
          <div class="small text-muted mb-2">Click a class to see its children below</div>
          <div class="fd-scroll"><table class="table table-sm fd-table mb-0">
            <thead><tr><th>Class</th><th class="text-end">Owing</th><th class="text-end">Pending</th></tr></thead>
            <tbody id="fdClasses"><tr><td colspan="3" class="text-muted small">Loading…</td></tr></tbody>
          </table></div>
        </div></div>
      </div>
    </div>

    <div class="ec-card mb-0"><div class="ec-card-body p-0">
      <div class="px-3 pt-3 d-flex justify-content-between align-items-center">
        <div class="fw-semibold" id="fdListTitle">Children with dues</div>
        <div class="small text-muted" id="fdCount"></div>
      </div>
      <div class="px-3 pt-2 d-flex flex-wrap gap-1 align-items-center">
        <div class="d-flex flex-wrap gap-1 flex-grow-1" id="fdByMonths"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary" style="width:auto" id="fdFamilyBtn" title="Children with the same parent mobile together">
          <i class="bx bx-group me-1"></i>Group by family
        </button>
      </div>
      @* what is ticked: send a reminder or print letters to those parents *@
      <div class="mx-3 mt-2 p-2 fd-selbar d-none d-flex flex-wrap gap-2 align-items-center" id="fdSelBar">
        <b id="fdSelCount">0 selected</b>
        @if (canManage)
        {
            <button type="button" class="btn btn-sm btn-primary" style="width:auto" id="fdRemindBtn"><i class="bx bx-send me-1"></i>Send reminder</button>
            <button type="button" class="btn btn-sm btn-outline-primary" style="width:auto" id="fdLetterBtn"><i class="bx bx-printer me-1"></i>Print letters</button>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" style="width:auto" id="fdSelClear">Clear</button>
      </div>
      @* phones: a card per child *@
      <div class="d-md-none p-2" id="fdCards"></div>
      <div class="table-responsive d-none d-md-block">
        <table class="table table-sm fd-table mb-0">
          <thead><tr><th style="width:1%"><input type="checkbox" class="form-check-input fd-check" id="fdCheckAll" title="Tick everyone shown"></th>
            <th>Student</th><th>Class</th><th>Father / mobile</th><th>Months unpaid</th><th class="text-end">Pending</th><th>Last paid</th><th class="text-end"></th></tr></thead>
          <tbody id="fdRows"><tr><td colspan="8" class="text-muted small p-3">Loading…</td></tr></tbody>
        </table>
      </div>
    </div></div>
  </div>
</div>

<!-- Filters: a side panel, so the page stays tidy -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="fdFilters" aria-labelledby="fdFiltersTitle" style="max-width:340px">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title fw-bold" id="fdFiltersTitle"><i class="bx bx-filter-alt me-1"></i>Filters</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body d-flex flex-column gap-3">
    <div>
      <label class="form-label mb-1">Session</label>
      <select id="fdYear" class="form-select">
          @foreach (var y in years)
          {
              <option value="@y.Text" selected="@y.Selected">@y.Text</option>
          }
        </select>
    </div>
    <div class="row g-2">
      <div class="col-6">
        <label class="form-label mb-1">From month</label>
        <input type="month" id="fdFrom" class="form-control">
      </div>
      <div class="col-6">
        <label class="form-label mb-1">To month</label>
        <input type="month" id="fdUpto" class="form-control">
      </div>
      <div class="col-12"><div class="form-text mt-0">Fees that fell due between these months. Leave "From" empty for the whole session so far.</div></div>
    </div>
    <div>
      <label class="form-label mb-1">Class</label>
      <select id="fdClass" class="form-select">
          <option value="">All classes</option>
          @foreach (var c in classes)
          {
              <option value="@c.Text">@c.Text</option>
          }
        </select>
    </div>
    <div>
      <label class="form-label mb-1">Section</label>
      <select id="fdSec" class="form-select"><option value="">All sections</option></select>
    </div>
    <div>
      <label class="form-label mb-1">Show</label>
      <select id="fdShow" class="form-select">
        <option value="">Everyone with dues</option>
        <option value="1">1 month pending</option>
        <option value="2">2 months pending</option>
        <option value="3">3+ months pending</option>
        <option value="left">May have left (⚠)</option>
        <option value="followup">Follow-up due (promise date reached)</option>
        <option value="hold">On hold</option>
        <option value="nochase">Not chased</option>
      </select>
    </div>
  </div>
  <div class="border-top p-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary flex-fill" id="fdClear">Clear</button>
    <button type="button" class="btn btn-primary flex-fill" id="fdApply"><i class="bx bx-check me-1"></i>Apply</button>
  </div>
</div>

<!-- Send a reminder to the ticked parents (posts to FeeDueReminders/SendReminders) -->
<div class="modal fade" id="fdRemModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <div><h5 class="modal-title fw-bold">Send reminder</h5><small class="text-muted" id="fdRemSub">—</small></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <label class="form-label mb-1">Send by</label>
            <div class="form-check"><input class="form-check-input fd-ch" type="checkbox" value="WhatsApp" id="fdChWa" checked><label class="form-check-label" for="fdChWa">WhatsApp</label></div>
            <div class="form-check"><input class="form-check-input fd-ch" type="checkbox" value="Sms" id="fdChSms"><label class="form-check-label" for="fdChSms">SMS</label></div>
            <div class="form-check"><input class="form-check-input fd-ch" type="checkbox" value="Email" id="fdChEmail"><label class="form-check-label" for="fdChEmail">Email</label></div>
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label mb-1">Language</label>
            <select class="form-select" id="fdRemLang"></select>
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label mb-1">Tone</label>
            <select class="form-select" id="fdRemTone">
              <option value="polite">Polite reminder</option>
              <option value="firm">Firm reminder</option>
              <option value="final">Final notice</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label mb-1">Message</label>
            <textarea class="form-control" id="fdRemMsg" rows="5"></textarea>
            <div class="form-text">Filled for each child when sent: {student_name} {class} {due_amount} {days} {school_name}. Children marked "not chased" are left out.</div>
          </div>
        </div>
      </div>
      <div class="modal-footer flex-nowrap">
        <button type="button" class="btn btn-outline-secondary flex-fill" style="width:auto" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary flex-fill" style="width:auto" id="fdRemSend"><i class="bx bx-send me-1"></i>Send</button>
      </div>
    </div>
  </div>
</div>

<!-- Notes / promise to pay, and "don't chase" -->
<div class="modal fade" id="fdNoteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <div><h5 class="modal-title fw-bold" id="fdNoteTitle">Notes</h5><small class="text-muted" id="fdNoteSub">—</small></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        @if (canCollect)
        {
            <label class="form-label mb-1">What did the parent say?</label>
            <textarea class="form-control mb-2" id="fdNoteText" rows="2" maxlength="300" placeholder="e.g. Father will pay on the 25th"></textarea>
            <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
              <div class="flex-grow-1" style="min-width:180px"><label class="form-label mb-1">Promise date <span class="text-muted">(optional)</span></label><input type="date" class="form-control" id="fdNoteDate"></div>
              <button type="button" class="btn btn-primary flex-grow-1" id="fdNoteSave"><i class="bx bx-check me-1"></i>Save note</button>
            </div>
        }
        <div id="fdNoteList" class="mb-3"></div>
        @if (canManage)
        {
            <div class="border-top pt-3">
              <div class="fw-semibold mb-1">Don't chase this child</div>
              <div class="small text-muted mb-2">Scholarship, RTE seat, staff child, a written promise … They stay in the list, but reminders, letters, late fees and the hold list leave them out.</div>
              <div id="fdNcState" class="mb-2"></div>
              <div class="d-flex gap-2 align-items-end flex-wrap">
                <div class="flex-grow-1"><label class="form-label mb-1">Reason</label><input type="text" class="form-control" id="fdNcReason" maxlength="200" placeholder="RTE seat"></div>
                <div><label class="form-label mb-1">Until <span class="text-muted">(optional)</span></label><input type="date" class="form-control" id="fdNcUntil"></div>
              </div>
              <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" style="width:auto" id="fdNcSet">Don't chase</button>
                <button type="button" class="btn btn-sm btn-outline-primary" style="width:auto" id="fdNcClear">Chase again</button>
              </div>
            </div>
        }
      </div>
    </div>
  </div>
</div>

<!-- The school's late fee and hold rule -->
<div class="modal fade" id="fdSetModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header"><h5 class="modal-title fw-bold">Fee dues settings</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body d-flex flex-column gap-3">
        <div><label class="form-label mb-1">Late fee per overdue month (₹)</label><input type="number" class="form-control" id="fdSetLate" min="0" step="1"><div class="form-text">0 = no late fee.</div></div>
        <div><label class="form-label mb-1">Grace days after the due date</label><input type="number" class="form-control" id="fdSetGrace" min="0" max="90" step="1"></div>
        <div><label class="form-label mb-1">Hold after how many months pending</label><input type="number" class="form-control" id="fdSetHold" min="0" max="12" step="1"><div class="form-text">Shown as "Hold" in the list (e.g. before hall tickets). 0 = off.</div></div>
      </div>
      <div class="modal-footer flex-nowrap">
        <button type="button" class="btn btn-outline-secondary flex-fill" style="width:auto" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary flex-fill" style="width:auto" id="fdSetSave">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Late fees: preview, then add -->
<div class="modal fade" id="fdLateModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <div><h5 class="modal-title fw-bold">Add late fees</h5><small class="text-muted" id="fdLateSub">—</small></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="fdLateBody">Loading…</div>
      <div class="modal-footer flex-nowrap">
        <button type="button" class="btn btn-outline-secondary flex-fill" style="width:auto" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary flex-fill" style="width:auto" id="fdLateApply" disabled><i class="bx bx-check me-1"></i>Add these late fees</button>
      </div>
    </div>
  </div>
</div>

<!-- Attendance of a child who may have left -->
<div class="modal fade" id="fdAttModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0">
      <div class="modal-header">
        <div><h5 class="modal-title fw-bold" id="fdAttTitle">Attendance</h5><small class="text-muted" id="fdAttSub">—</small></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="fdAttBody">Loading…</div>
      <div class="modal-footer flex-nowrap">
        <button type="button" class="btn btn-outline-secondary flex-fill" style="width:auto" data-bs-dismiss="modal">Close</button>
        <a class="btn btn-primary flex-fill" style="width:auto" id="fdAttProfile" href="#"><i class="bx bx-user me-1"></i>Open profile</a>
      </div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section PageScripts {
<script src="~/js/fee-reminder-templates.js" asp-append-version="true"></script>
<script>
$(function () {
    var URL = {
        data:     '@Url.Action("Data", "FeeDues", new { area = "Fees" })',
        att:      '@Url.Action("Attendance", "FeeDues", new { area = "Fees" })',
        secs:     '@Url.Action("PromotionSections", "Student", new { area = "Students" })',
        profile:  '@Url.Action("Dashboard", "Student", new { area = "Students" })',
        collect:  '@Url.Action("ManageFee", "Fee", new { area = "Fees" })',
        remind:   '@Url.Action("SendReminders", "FeeDueReminders", new { area = "Fees" })',
        notes:    '@Url.Action("Followups", "FeeDues", new { area = "Fees" })',
        addNote:  '@Url.Action("AddFollowup", "FeeDues", new { area = "Fees" })',
        noteDone: '@Url.Action("FollowupDone", "FeeDues", new { area = "Fees" })',
        noChase:  '@Url.Action("NoChase", "FeeDues", new { area = "Fees" })',
        settings: '@Url.Action("Settings", "FeeDues", new { area = "Fees" })',
        saveSet:  '@Url.Action("SaveSettings", "FeeDues", new { area = "Fees" })',
        latePrev: '@Url.Action("LateFeePreview", "FeeDues", new { area = "Fees" })',
        lateDo:   '@Url.Action("LateFeeApply", "FeeDues", new { area = "Fees" })'
    };
    var CAN_COLLECT = @(canCollect ? "true" : "false");
    var CAN_MANAGE  = @(canManage ? "true" : "false");
    var SCHOOL = { name:    '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(schoolName))',
                   address: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(schoolAddress))',
                   logo:    '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(schoolLogo))' };
    var picked = {};          // student id -> true, the ticked children
    var byFamily = false;     // group the list by parent mobile
    function token() { return $('input[name="__RequestVerificationToken"]').val(); }
    function post(url, body) {
        return $.ajax({ url: url, type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': token() }, data: JSON.stringify(body) });
    }
    var data = null, loadNo = 0;
    var MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    var SHOW_WORDS = { '1': '1 month pending', '2': '2 months pending', '3': '3+ months pending', left: 'May have left',
                       followup: 'Follow-up due', hold: 'On hold', nochase: 'Not chased' };

    // "2026-10" -> "Oct 2026" / "Oct"
    function monthName(m, short) {
        var p = (m || '').split('-');
        if (p.length < 2) return m || '';
        return MON[+p[1] - 1] + (short ? '' : ' ' + p[0]);
    }
    function profileUrl(s) { return URL.profile + '/' + encodeURIComponent(s.publicId); }

    $('#fdUpto').val(EC.today().slice(0, 7));

    function load() {
        var mine = ++loadNo;
        $('#fdRows').html('<tr><td colspan="8" class="text-muted small p-3">Loading…</td></tr>');
        $('#fdCards').html('<div class="text-muted small p-2">Loading…</div>');
        $.getJSON(URL.data, { year: $('#fdYear').val(), from: $('#fdFrom').val(), upto: $('#fdUpto').val(), cls: $('#fdClass').val(), sec: $('#fdSec').val() })
            .done(function (r) {
                if (mine !== loadNo) return;   // a newer load is on its way
                if (!r || !r.success) { ecToast('error', (r && r.message) || 'Could not load the dues.'); return; }
                data = r;
                renderChips();
                renderTop();
                renderList();
            })
            .fail(function () { ecToast('error', 'Could not load the dues.'); });
    }

    // what is applied, as chips in the bar, and how many filters differ from the default
    function renderChips() {
        var cls = $('#fdClass').val(), sec = $('#fdSec').val(), show = $('#fdShow').val(), upto = $('#fdUpto').val(), from = $('#fdFrom').val();
        var chip = function (t) { return '<span class="badge bg-label-primary fw-semibold">' + EC.esc(t) + '</span>'; };
        var n = (cls ? 1 : 0) + (sec ? 1 : 0) + (show ? 1 : 0) + (from ? 1 : 0) + (upto && upto !== EC.today().slice(0, 7) ? 1 : 0);
        $('#fdChips').html(chip($('#fdYear').val())
            + chip(from ? monthName(from) + ' to ' + monthName(upto) : 'Due up to ' + monthName(upto))
            + chip(cls ? cls + (sec ? ' – ' + sec : '') : 'All classes')
            + (show ? chip(SHOW_WORDS[show] || show) : ''));
        $('#fdFilterCount').text(n).toggleClass('d-none', !n);
    }

    function renderByMonths() {
        var c = { 1: 0, 2: 0, 3: 0 };
        data.students.forEach(function (s) { c[Math.min(s.monthsCount, 3)]++; });
        var show = $('#fdShow').val();
        var b = function (key, label, n) {
            return '<button type="button" class="btn btn-sm ' + (show === key ? 'btn-primary' : 'btn-outline-secondary') + ' fd-bym" style="width:auto" data-show="' + key + '">'
                 + label + '<b class="ms-1">' + n + '</b></button>';
        };
        var today = EC.today(), due = 0, hold = 0, nc = 0;
        data.students.forEach(function (s) { if (s.promise && s.promise <= today) due++; if (s.onHold) hold++; if (s.noChase) nc++; });
        $('#fdByMonths').html(b('', 'All', data.students.length) + b('1', '1 month', c[1]) + b('2', '2 months', c[2]) + b('3', '3+ months', c[3])
            + (due ? b('followup', 'Follow-up due', due) : '') + (hold ? b('hold', 'On hold', hold) : '') + (nc ? b('nochase', 'Not chased', nc) : ''));
    }

    function renderTop() {
        var pending = 0, long = 0, left = 0;
        data.students.forEach(function (s) { pending += s.pending; if (s.monthsCount >= 3) long++; if (s.mayHaveLeft) left++; });
        $('#kPending').text(EC.money(pending));
        $('#kKids').text(data.students.length);
        $('#kLong').text(long);
        $('#kLeft').text(left);

        var maxP = Math.max.apply(null, data.months.map(function (m) { return m.pending; }).concat([1]));
        $('#fdMonths').html(data.months.length ? data.months.map(function (m) {
            return '<tr><td class="fw-semibold">' + EC.esc(monthName(m.month)) + '</td>'
                 + '<td class="text-end fd-hide-sm">' + EC.money(m.due) + '</td>'
                 + '<td class="text-end text-success">' + EC.money(m.collected) + '</td>'
                 + '<td class="text-end"><span class="fw-bold text-danger">' + EC.money(m.pending) + '</span>'
                 + '<div class="fd-bar ms-auto"><span style="width:' + Math.round(m.pending * 100 / maxP) + '%"></span></div>'
                 + '<div class="small text-muted">' + m.children + ' child' + (m.children === 1 ? '' : 'ren') + '</div></td></tr>';
        }).join('') : '<tr><td colspan="4" class="text-muted small">No fees fell due in this session up to that month.</td></tr>');

        var cls = $('#fdClass').val(), sec = $('#fdSec').val();
        // one class picked: a way back to all of them
        var back = cls ? '<tr class="fd-all-classes" style="cursor:pointer"><td colspan="3" class="small text-primary fw-semibold">← Show all classes</td></tr>' : '';
        $('#fdClasses').html(back + (data.classes.length ? data.classes.map(function (c) {
            var sel = c.cls === cls && (!sec || c.sec === sec);
            return '<tr class="fd-class-row' + (sel ? ' fd-sel' : '') + '" data-cls="' + EC.esc(c.cls) + '" data-sec="' + EC.esc(c.sec) + '">'
                 + '<td class="fw-semibold">' + EC.esc(c.cls) + (c.sec ? ' – ' + EC.esc(c.sec) : '') + '</td>'
                 + '<td class="text-end">' + c.withDues + ' <span class="text-muted small">of ' + c.children + '</span></td>'
                 + '<td class="text-end ' + (c.pending > 0 ? 'fw-bold text-danger' : 'text-muted') + '">' + EC.money(c.pending) + '</td></tr>';
        }).join('') : '<tr><td colspan="3" class="text-muted small">No children in this session.</td></tr>'));
    }

    function visible() {
        var find = ($('#fdFind').val() || '').toLowerCase().trim(), show = $('#fdShow').val();
        $('.fd-kpi.fd-click').each(function () { $(this).toggleClass('fd-on', $(this).data('show') + '' === show); });
        return data.students.filter(function (s) {
            if (show === '1' && s.monthsCount !== 1) return false;
            if (show === '2' && s.monthsCount !== 2) return false;
            if (show === '3' && s.monthsCount < 3) return false;
            if (show === 'left' && !s.mayHaveLeft) return false;
            if (show === 'followup' && !(s.promise && s.promise <= EC.today())) return false;
            if (show === 'hold' && !s.onHold) return false;
            if (show === 'nochase' && !s.noChase) return false;
            return !find || (s.name + ' ' + s.father + ' ' + s.mobile + ' ' + s.admNo).toLowerCase().indexOf(find) >= 0;
        });
    }

    function leftFlag(s) {
        if (!s.mayHaveLeft) return '';
        return ' <button type="button" class="fd-left fd-att" data-id="' + s.id + '" title="No attendance for 3 weeks while the class register was taken. Click to see.">'
             + '<i class="bx bx-error"></i>May have left</button>';
    }
    // "3 months pending" (red from 3, amber at 2), then the months themselves
    function monthsChips(s) {
        var n = s.monthsCount, tone = n >= 3 ? 'bg-label-danger' : n === 2 ? 'bg-label-warning' : 'bg-label-secondary';
        return '<span class="badge ' + tone + ' me-1">' + n + ' month' + (n === 1 ? '' : 's') + ' pending</span>'
             + (s.months || '').split(',').filter(Boolean).map(function (m) { return '<span class="fd-mon">' + EC.esc(monthName(m, true)) + '</span>'; }).join('');
    }
    // hold / not chased / the open note / last reminder / late fee, under the name
    function extras(s) {
        var t = '';
        if (s.onHold)  t += '<span class="fd-tag hold" title="Past the school\u2019s hold rule">Hold</span>';
        if (s.noChase) t += '<span class="fd-tag nochase" title="' + EC.esc(s.noChase) + '">Not chased: ' + EC.esc(s.noChase) + '</span>';
        if (s.note) {
            var due = s.promise && s.promise <= EC.today();
            t += '<span class="fd-tag note fd-notes' + (due ? ' due' : '') + '" data-id="' + s.id + '" title="' + EC.esc(s.note) + '">'
               + (s.promise ? (due ? 'Promised ' : 'Will pay ') + EC.esc(EC.date(s.promise)) : 'Note') + '</span>';
        }
        var bits = [];
        if (s.lastReminded) bits.push('reminded ' + EC.date(s.lastReminded));
        if (s.lateFee > 0) bits.push('incl. late fee ' + EC.money(s.lateFee));
        return (t ? '<div>' + t + '</div>' : '') + (bits.length ? '<div class="small text-muted">' + EC.esc(bits.join(' · ')) + '</div>' : '');
    }
    function check(s) {
        return '<input type="checkbox" class="form-check-input fd-check fd-pick" data-id="' + s.id + '"' + (picked[s.id] ? ' checked' : '') + '>';
    }

    function actions(s) {
        var wa = s.mobile ? 'https://wa.me/91' + String(s.mobile).replace(/\D/g, '').slice(-10) + '?text='
               + encodeURIComponent('Dear Parent, fees of ' + EC.money(s.pending) + ' for ' + s.name + ' are pending. Kindly pay at the school office.') : '';
        return '<a class="btn btn-sm btn-icon btn-text-secondary" href="' + profileUrl(s) + '" title="Open profile"><i class="bx bx-user"></i></a>'
             + (CAN_COLLECT && s.admNo ? '<a class="btn btn-sm btn-icon btn-text-success" href="' + URL.collect + '?adm=' + encodeURIComponent(s.admNo) + '&session=' + encodeURIComponent($('#fdYear').val()) + '" title="Collect fee"><i class="bx bx-wallet"></i></a>' : '')
             + (wa ? '<a class="btn btn-sm btn-icon btn-text-success" href="' + wa + '" target="_blank" rel="noopener" title="WhatsApp the parent"><i class="bx bxl-whatsapp"></i></a>' : '')
             + '<button type="button" class="btn btn-sm btn-icon btn-text-primary fd-notes" data-id="' + s.id + '" title="Notes / promise to pay"><i class="bx bx-note"></i></button>';
    }

    function renderList() {
        renderChips();
        renderByMonths();
        var list = visible();
        var cls = $('#fdClass').val(), sec = $('#fdSec').val();
        $('#fdListTitle').text((SHOW_WORDS[$('#fdShow').val()] || 'Children with dues')
                               + (cls ? ' · ' + cls + (sec ? ' – ' + sec : '') : ''));
        var total = list.reduce(function (t, s) { return t + s.pending; }, 0);
        $('#fdCount').text(list.length + ' child' + (list.length === 1 ? '' : 'ren') + ' · ' + EC.money(total));
        if (!list.length) {
            var msg = data.students.length ? 'Nobody matches.' : 'No unpaid fees up to that month.';
            $('#fdRows').html('<tr><td colspan="8" class="text-muted small p-3">' + msg + '</td></tr>');
            $('#fdCards').html('<div class="text-muted small p-2">' + msg + '</div>');
            return;
        }
        // one row / card per child; with "Group by family", children sharing a parent
        // mobile come together under a line with the family total
        var rowHtml = function (s) {
            return '<tr><td>' + check(s) + '</td>'
                 + '<td><a class="fw-semibold text-body" href="' + profileUrl(s) + '">' + EC.esc(s.name) + '</a>' + leftFlag(s)
                 + (s.status !== 'Active' ? ' <span class="badge bg-label-secondary">' + EC.esc(s.status) + '</span>' : '')
                 + '<div class="small text-muted">' + EC.esc(s.admNo) + (s.roll ? ' · Roll ' + EC.esc(s.roll) : '') + '</div>' + extras(s) + '</td>'
                 + '<td class="text-nowrap">' + EC.esc(s.cls) + (s.sec ? ' – ' + EC.esc(s.sec) : '') + '</td>'
                 + '<td>' + EC.esc(s.father || '—') + '<div class="small text-muted">' + EC.esc(s.mobile || '') + '</div></td>'
                 + '<td>' + monthsChips(s) + '</td>'
                 + '<td class="text-end fw-bold text-danger text-nowrap">' + EC.money(s.pending) + '</td>'
                 + '<td class="small text-nowrap">' + (s.lastPaid ? EC.esc(EC.date(s.lastPaid)) : '<span class="text-muted">never</span>') + '</td>'
                 + '<td class="text-end text-nowrap">' + actions(s) + '</td></tr>';
        };
        var cardHtml = function (s) {
            return '<div class="fd-card"><div class="d-flex justify-content-between align-items-start gap-2">'
                 + '<div style="min-width:0">' + check(s) + ' <a class="fw-semibold text-body" href="' + profileUrl(s) + '">' + EC.esc(s.name) + '</a>' + leftFlag(s)
                 + '<div class="small text-muted">' + EC.esc(s.cls) + (s.sec ? ' – ' + EC.esc(s.sec) : '') + ' · ' + EC.esc(s.father || '') + '</div>' + extras(s) + '</div>'
                 + '<div class="text-end text-nowrap fw-bold text-danger">' + EC.money(s.pending) + '</div></div>'
                 + '<div class="mt-1">' + monthsChips(s) + '</div>'
                 + '<div class="d-flex justify-content-between align-items-center mt-1"><span class="small text-muted">Last paid: '
                 + (s.lastPaid ? EC.esc(EC.date(s.lastPaid)) : 'never') + '</span><span>' + actions(s) + '</span></div></div>';
        };
        var groups = [];
        if (byFamily) {
            var byKey = {};
            list.forEach(function (s) {
                var key = String(s.mobile || '').replace(/\D/g, '').slice(-10) || ('id' + s.id);   // no mobile: on its own
                if (!byKey[key]) { byKey[key] = { kids: [], total: 0 }; groups.push(byKey[key]); }
                byKey[key].kids.push(s); byKey[key].total += s.pending;
            });
            groups.sort(function (a, b) { return b.total - a.total; });
        } else {
            groups = [{ kids: list, total: 0 }];
        }
        var famLine = function (g) {
            var f = g.kids[0];
            return EC.esc(f.father || 'Family') + (f.mobile ? ' · ' + EC.esc(f.mobile) : '') + ' · ' + g.kids.length + ' child' + (g.kids.length === 1 ? '' : 'ren')
                 + ' · <span class="text-danger">' + EC.money(g.total) + '</span>';
        };
        $('#fdRows').html(groups.map(function (g) {
            return (byFamily ? '<tr class="fd-fam"><td colspan="8"><i class="bx bx-group me-1"></i>' + famLine(g) + '</td></tr>' : '')
                 + g.kids.map(rowHtml).join('');
        }).join(''));
        $('#fdCards').html(groups.map(function (g) {
            return (byFamily ? '<div class="small fw-bold px-1 mt-2 mb-1"><i class="bx bx-group me-1"></i>' + famLine(g) + '</div>' : '')
                 + g.kids.map(cardHtml).join('');
        }).join(''));
        $('#fdCheckAll').prop('checked', list.length > 0 && list.every(function (s) { return picked[s.id]; }));
        renderSelBar();
    }

    // ── "may have left": the child's attendance ──
    $(document).on('click', '.fd-att', function (e) {
        e.preventDefault();
        var id = +$(this).data('id'), s = data.students.filter(function (x) { return x.id === id; })[0];
        if (!s) return;
        $('#fdAttTitle').text(s.name);
        $('#fdAttSub').text(s.cls + (s.sec ? ' – ' + s.sec : '') + ' · ' + s.admNo);
        $('#fdAttProfile').attr('href', profileUrl(s));
        $('#fdAttBody').html('Loading…');
        new bootstrap.Modal(document.getElementById('fdAttModal')).show();
        $.getJSON(URL.att, { id: id, year: $('#fdYear').val() }).done(function (a) {
            if (!a || !a.success) { $('#fdAttBody').html('<div class="text-danger">' + EC.esc((a && a.message) || 'Could not load the attendance.') + '</div>'); return; }
            var rows = a.months.map(function (m) {
                return '<tr><td>' + EC.esc(monthName(m.month)) + '</td><td class="text-end text-success">' + m.present + '</td>'
                     + '<td class="text-end text-danger">' + m.absent + '</td><td class="text-end">' + m.leave + '</td></tr>';
            }).join('');
            $('#fdAttBody').html(
                '<div class="alert alert-warning small mb-3"><b>This child may have left the school.</b> No attendance in the last 3 weeks, '
              + 'while the class register was taken on ' + s.classDays + ' day(s). Call the parents' + (s.mobile ? ' (' + EC.esc(s.mobile) + ')' : '')
              + '. If the child has left, open the profile to mark them as left / issue a TC, so the fees stop being chased.</div>'
              + '<div class="row g-2 mb-3 text-center">'
              + '<div class="col-4"><div class="fd-kpi"><div class="v">' + (a.lastPresent ? EC.esc(EC.date(a.lastPresent)) : 'never') + '</div><div class="l">Last present</div></div></div>'
              + '<div class="col-4"><div class="fd-kpi"><div class="v text-danger">' + a.streak + '</div><div class="l">Marked days absent since</div></div></div>'
              + '<div class="col-4"><div class="fd-kpi"><div class="v">' + a.present + ' / ' + a.marked + '</div><div class="l">Present this session</div></div></div></div>'
              + (rows ? '<table class="table table-sm mb-0"><thead><tr><th>Month</th><th class="text-end">Present</th><th class="text-end">Absent</th><th class="text-end">Leave</th></tr></thead><tbody>' + rows + '</tbody></table>'
                      : '<div class="text-muted small">No attendance marked for this child this session.</div>'));
        }).fail(function () { $('#fdAttBody').html('<div class="text-danger">Could not load the attendance.</div>'); });
    });

    // ── download what is on screen ──
    $('#fdCsv').on('click', function () {
        if (!data) return;
        var q = function (v) { v = String(v == null ? '' : v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
        var lines = [['Student', 'Adm No', 'Class', 'Section', 'Father', 'Mobile', 'Months unpaid', 'Pending', 'Late fee', 'Last paid',
                      'Last reminded', 'Note', 'Promise date', 'Hold', 'Not chased', 'May have left'].join(',')];
        visible().forEach(function (s) {
            lines.push([s.name, s.admNo, s.cls, s.sec, s.father, s.mobile,
                        (s.months || '').split(',').filter(Boolean).map(function (m) { return monthName(m); }).join(' '),
                        s.pending.toFixed(2), s.lateFee.toFixed(2), s.lastPaid, s.lastReminded, s.note, s.promise,
                        s.onHold ? 'Yes' : '', s.noChase, s.mayHaveLeft ? 'Yes' : ''].map(q).join(','));
        });
        var a = document.createElement('a');
        a.href = window.URL.createObjectURL(new Blob(['﻿' + lines.join('\n')], { type: 'text/csv' }));
        a.download = 'month-wise-dues-' + $('#fdYear').val() + '-' + ($('#fdUpto').val() || '') + '.csv';
        document.body.appendChild(a); a.click(); a.remove();
    });

    // ── ticking children: reminders and letters go to the ticked ones ──
    function pickedKids() {
        return (data ? data.students : []).filter(function (s) { return picked[s.id]; });
    }
    function renderSelBar() {
        var n = pickedKids().length;
        $('#fdSelBar').toggleClass('d-none', !n);
        $('#fdSelCount').text(n + ' selected');
    }
    $(document).on('change', '.fd-pick', function () {
        var id = +$(this).data('id');
        if (this.checked) picked[id] = true; else delete picked[id];
        $('.fd-pick[data-id="' + id + '"]').prop('checked', this.checked);   // the table and the card of one child
        renderSelBar();
    });
    $('#fdCheckAll').on('change', function () {
        var on = this.checked;
        visible().forEach(function (s) { if (on) picked[s.id] = true; else delete picked[s.id]; });
        renderList();
    });
    $('#fdSelClear').on('click', function () { picked = {}; renderList(); });
    $('#fdFamilyBtn').on('click', function () {
        byFamily = !byFamily;
        $(this).toggleClass('btn-primary', byFamily).toggleClass('btn-outline-secondary', !byFamily);
        renderList();
    });

    // ── send a reminder (the message is filled per child on the server) ──
    Object.keys(EcFeeReminder.LANG_NAME).forEach(function (k) {
        $('#fdRemLang').append('<option value="' + k + '">' + EC.esc(EcFeeReminder.LANG_NAME[k]) + '</option>');
    });
    function fillTemplate() { $('#fdRemMsg').val(EcFeeReminder.build($('#fdRemLang').val(), $('#fdRemTone').val())); }
    $('#fdRemLang, #fdRemTone').on('change', fillTemplate);
    $('#fdRemindBtn').on('click', function () {
        var kids = pickedKids().filter(function (s) { return !s.noChase; });
        if (!kids.length) { ecToast('warning', 'Tick the children to remind (not chased ones are left out).'); return; }
        var skipped = pickedKids().length - kids.length;
        $('#fdRemSub').text(kids.length + ' parent(s)' + (skipped ? ' · ' + skipped + ' not chased, left out' : ''));
        fillTemplate();
        new bootstrap.Modal(document.getElementById('fdRemModal')).show();
    });
    $('#fdRemSend').on('click', function () {
        var kids = pickedKids().filter(function (s) { return !s.noChase; });
        var channels = $('.fd-ch:checked').map(function () { return this.value; }).get();
        if (!channels.length) { ecToast('warning', 'Choose WhatsApp, SMS or Email.'); return; }
        if (!$.trim($('#fdRemMsg').val())) { ecToast('warning', 'Write the message.'); return; }
        var $btn = $(this);
        EC.buttonBusy($btn, 'Sending…');
        post(URL.remind, { studentIds: kids.map(function (s) { return s.id; }), channels: channels, message: $('#fdRemMsg').val() })
            .done(function (r) {
                ecToast(r && r.success ? 'success' : 'warning', (r && r.message) || 'Could not send.');
                if (r && (r.success || r.delivered >= 0)) { bootstrap.Modal.getInstance(document.getElementById('fdRemModal')).hide(); picked = {}; load(); }
            })
            .fail(function (x) { ecToast('error', EC.ajaxError(x, 'Could not send the reminders')); })
            .always(function () { EC.buttonReset($btn); });
    });

    // ── reminder letters: one page per child, the school's letterhead ──
    $('#fdLetterBtn').on('click', function () {
        var kids = pickedKids().filter(function (s) { return !s.noChase; });
        if (!kids.length) { ecToast('warning', 'Tick the children to print letters for.'); return; }
        var payBy = new Date(); payBy.setDate(payBy.getDate() + 7);
        var payByIso = payBy.getFullYear() + '-' + ('0' + (payBy.getMonth() + 1)).slice(-2) + '-' + ('0' + payBy.getDate()).slice(-2);
        var head = (SCHOOL.logo ? '<img src="' + EC.esc(SCHOOL.logo) + '" style="max-height:60px;max-width:120px" onerror="this.style.display=\'none\'">' : '')
                 + '<div class="sch">' + EC.esc(SCHOOL.name) + '</div>' + (SCHOOL.address ? '<div class="addr">' + EC.esc(SCHOOL.address) + '</div>' : '');
        var pages = kids.map(function (s) {
            var months = (s.months || '').split(',').filter(Boolean).map(function (m) { return monthName(m); }).join(', ');
            return '<div class="page"><div class="head">' + head + '</div>'
                 + '<div class="meta"><span>Date: ' + EC.esc(EC.date(EC.today())) + '</span><span>Ref: ' + EC.esc(s.admNo) + '</span></div>'
                 + '<p>To<br>The Parent / Guardian of <b>' + EC.esc(s.name) + '</b><br>' + EC.esc(s.cls) + (s.sec ? ' – ' + EC.esc(s.sec) : '') + '</p>'
                 + '<p class="subj"><b>Subject: Reminder for pending school fees</b></p>'
                 + '<p>Dear Parent,</p>'
                 + '<p>This is to remind you that the school fees of your ward <b>' + EC.esc(s.name) + '</b> are pending'
                 + (months ? ' for <b>' + EC.esc(months) + '</b>' : '') + '. The amount due is <b>' + EC.money(s.pending) + '</b>'
                 + (s.lateFee > 0 ? ' (including a late fee of ' + EC.money(s.lateFee) + ')' : '') + '.</p>'
                 + '<p>We request you to kindly clear the dues at the school office on or before <b>' + EC.esc(EC.date(payByIso)) + '</b>. '
                 + 'If you have already paid, please ignore this letter and accept our thanks.</p>'
                 + '<p>For any difficulty, please meet the school office.</p>'
                 + '<div class="sign"><div>Accounts Office</div><div>Principal</div></div></div>';
        }).join('');
        var html = '<!doctype html><html><head><meta charset="utf-8"><title>Fee reminder letters</title><style>'
            + 'body{font-family:Arial,sans-serif;color:#111;margin:0} .page{padding:28px 36px;font-size:14px;line-height:1.55;page-break-after:always}'
            + '.head{text-align:center;border-bottom:2px solid #111;padding-bottom:8px;margin-bottom:14px} .sch{font-size:20px;font-weight:bold} .addr{font-size:12px;color:#444}'
            + '.meta{display:flex;justify-content:space-between;font-size:12px;margin-bottom:14px} .subj{margin-top:12px}'
            + '.sign{display:flex;justify-content:space-between;margin-top:60px;font-size:13px} .sign div{border-top:1px solid #111;padding-top:4px;min-width:150px;text-align:center}'
            + '</style></head><body>' + pages + '</body></html>';
        // a hidden frame, not a pop-up: phones and pop-up blockers allow it
        var f = document.createElement('iframe');
        f.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0';
        document.body.appendChild(f);
        f.contentDocument.open(); f.contentDocument.write(html); f.contentDocument.close();
        setTimeout(function () { f.contentWindow.focus(); f.contentWindow.print(); setTimeout(function () { f.remove(); }, 1500); }, 400);
    });

    // ── notes / promise to pay, and don't chase ──
    var noteKid = null;
    function loadNotes() {
        $('#fdNoteList').html('<div class="text-muted small">Loading…</div>');
        $.getJSON(URL.notes, { id: noteKid.id }).done(function (list) {
            if (!list || !list.length) { $('#fdNoteList').html('<div class="text-muted small">No notes yet.</div>'); return; }
            $('#fdNoteList').html(list.map(function (n) {
                return '<div class="border rounded-3 p-2 mb-2' + (n.done ? ' text-muted' : '') + '">'
                     + '<div class="d-flex justify-content-between gap-2"><div>' + EC.esc(n.note) + '</div>'
                     + (n.done ? '<span class="badge bg-label-secondary">Done</span>'
                               : (CAN_COLLECT ? '<button type="button" class="btn btn-sm btn-outline-success fd-note-done" style="width:auto" data-id="' + n.id + '">Done</button>' : '')) + '</div>'
                     + '<div class="small text-muted">' + (n.promise ? 'Promise: <b>' + EC.esc(EC.date(n.promise)) + '</b> · ' : '') + EC.esc(EC.date(n.on)) + ' · ' + EC.esc(n.by) + '</div></div>';
            }).join(''));
        });
    }
    $(document).on('click', '.fd-notes', function () {
        var id = +$(this).data('id');
        noteKid = data.students.filter(function (x) { return x.id === id; })[0];
        if (!noteKid) return;
        $('#fdNoteTitle').text(noteKid.name);
        $('#fdNoteSub').text(noteKid.cls + (noteKid.sec ? ' – ' + noteKid.sec : '') + ' · pending ' + EC.money(noteKid.pending));
        $('#fdNoteText').val(''); $('#fdNoteDate').val('');
        $('#fdNcState').html(noteKid.noChase ? '<span class="fd-tag nochase">Not chased: ' + EC.esc(noteKid.noChase) + '</span>' : '<span class="small text-muted">Chased as usual.</span>');
        $('#fdNcReason').val(noteKid.noChase || ''); $('#fdNcUntil').val('');
        loadNotes();
        new bootstrap.Modal(document.getElementById('fdNoteModal')).show();
    });
    $('#fdNoteSave').on('click', function () {
        if (!$.trim($('#fdNoteText').val())) { ecToast('warning', 'Write what the parent said.'); return; }
        post(URL.addNote, { studentId: noteKid.id, note: $('#fdNoteText').val(), promiseDate: $('#fdNoteDate').val() }).done(function (r) {
            if (!r || !r.success) { ecToast('error', (r && r.message) || 'Could not save the note.'); return; }
            ecToast('success', r.message); $('#fdNoteText').val(''); $('#fdNoteDate').val(''); loadNotes(); load();
        });
    });
    $(document).on('click', '.fd-note-done', function () {
        post(URL.noteDone, { id: +$(this).data('id') }).done(function (r) {
            if (!r || !r.success) { ecToast('error', (r && r.message) || 'Could not mark it done.'); return; }
            loadNotes(); load();
        });
    });
    function setNoChase(on) {
        if (on && !$.trim($('#fdNcReason').val())) { ecToast('warning', 'Give the reason (RTE seat, scholarship …).'); return; }
        post(URL.noChase, { studentId: noteKid.id, reason: $('#fdNcReason').val(), until: $('#fdNcUntil').val(), on: on }).done(function (r) {
            if (!r || !r.success) { ecToast('error', (r && r.message) || 'Could not save.'); return; }
            ecToast('success', r.message);
            bootstrap.Modal.getInstance(document.getElementById('fdNoteModal')).hide();
            load();
        });
    }
    $('#fdNcSet').on('click', function () { setNoChase(true); });
    $('#fdNcClear').on('click', function () { setNoChase(false); });

    // ── settings: late fee and hold rule ──
    $('#fdSettingsBtn').on('click', function () {
        $.getJSON(URL.settings).done(function (s) {
            $('#fdSetLate').val(s.lateFee); $('#fdSetGrace').val(s.graceDays); $('#fdSetHold').val(s.holdMonths);
            new bootstrap.Modal(document.getElementById('fdSetModal')).show();
        });
    });
    $('#fdSetSave').on('click', function () {
        post(URL.saveSet, { lateFeeAmount: EC.num($('#fdSetLate').val()), graceDays: EC.num($('#fdSetGrace').val()), holdMonths: EC.num($('#fdSetHold').val()) })
            .done(function (r) {
                if (!r || !r.success) { ecToast('error', (r && r.message) || 'Could not save.'); return; }
                ecToast('success', r.message);
                bootstrap.Modal.getInstance(document.getElementById('fdSetModal')).hide();
                load();
            });
    });

    // ── late fees: preview for the ticked children (or everyone), then add ──
    var lateIds = [];
    $('#fdLateBtn').on('click', function () {
        lateIds = pickedKids().map(function (s) { return s.id; });
        $('#fdLateSub').text(lateIds.length ? lateIds.length + ' ticked child(ren)' : 'Everyone in ' + $('#fdYear').val());
        $('#fdLateBody').html('Loading…'); $('#fdLateApply').prop('disabled', true);
        new bootstrap.Modal(document.getElementById('fdLateModal')).show();
        post(URL.latePrev, { year: $('#fdYear').val(), studentIds: lateIds }).done(function (r) {
            if (!r || !r.success) { $('#fdLateBody').html('<div class="text-danger">' + EC.esc((r && r.message) || 'Could not load.') + '</div>'); return; }
            if (!r.lines.length) { $('#fdLateBody').html('<div class="text-success">Nothing to add: nobody is past ' + r.graceDays + ' grace day(s) without a late fee for that month.</div>'); return; }
            var total = r.lines.reduce(function (t, l) { return t + l.amount; }, 0);
            $('#fdLateBody').html('<div class="alert alert-warning small">' + EC.money(r.amount) + ' per overdue month, after ' + r.graceDays + ' grace day(s). '
                + r.lines.length + ' line(s), <b>' + EC.money(total) + '</b> in all. Each month gets one late fee only, and it goes on the fee account (a concession can waive it).</div>'
                + '<table class="table table-sm mb-0"><thead><tr><th>Student</th><th>Class</th><th>Month</th><th class="text-end">Late fee</th></tr></thead><tbody>'
                + r.lines.map(function (l) {
                    return '<tr><td>' + EC.esc(l.name) + '</td><td>' + EC.esc(l.cls) + (l.sec ? ' – ' + EC.esc(l.sec) : '') + '</td><td>' + EC.esc(monthName(l.month)) + '</td><td class="text-end">' + EC.money(l.amount) + '</td></tr>';
                }).join('') + '</tbody></table>');
            $('#fdLateApply').prop('disabled', false);
        });
    });
    $('#fdLateApply').on('click', function () {
        var $btn = $(this);
        EC.buttonBusy($btn, 'Adding…');
        post(URL.lateDo, { year: $('#fdYear').val(), studentIds: lateIds }).done(function (r) {
            ecToast(r && r.success ? 'success' : 'error', (r && r.message) || 'Could not add the late fees.');
            if (r && r.success) { bootstrap.Modal.getInstance(document.getElementById('fdLateModal')).hide(); load(); }
        }).always(function () { EC.buttonReset($btn); });
    });


    // ── filters ──
    // the section list follows the class (in the panel; Apply loads)
    function loadSections() {
        var cls = $('#fdClass').val();
        $('#fdSec').html('<option value="">All sections</option>');
        if (!cls) return;
        $.getJSON(URL.secs, { 'class': cls, year: $('#fdYear').val() }).done(function (list) {
            (list || []).forEach(function (n) { $('#fdSec').append('<option value="' + EC.esc(n) + '">' + EC.esc(n) + '</option>'); });
        });
    }
    function closePanel() {
        var el = document.getElementById('fdFilters');
        var oc = bootstrap.Offcanvas.getInstance(el);
        if (oc) oc.hide();
    }
    $('#fdApply').on('click', function () { closePanel(); load(); });
    $('#fdClear').on('click', function () {
        $('#fdUpto').val(EC.today().slice(0, 7)); $('#fdFrom').val('');
        $('#fdClass').val(''); $('#fdSec').html('<option value="">All sections</option>'); $('#fdShow').val('');
        closePanel(); load();
    });
    $('#fdClasses').on('click', '.fd-class-row', function () {
        var cls = $(this).data('cls') + '', sec = ($(this).data('sec') || '') + '';
        $('#fdClass').val(cls);
        $('#fdSec').html('<option value="">All sections</option>');
        $.getJSON(URL.secs, { 'class': cls, year: $('#fdYear').val() }).done(function (list) {
            (list || []).forEach(function (n) { $('#fdSec').append('<option value="' + EC.esc(n) + '">' + EC.esc(n) + '</option>'); });
            $('#fdSec').val(sec);
        }).always(load);
    });
    $('#fdClasses').on('click', '.fd-all-classes', function () {
        $('#fdClass').val('');
        $('#fdSec').html('<option value="">All sections</option>');
        load();
    });
    $('#fdByMonths').on('click', '.fd-bym', function () {
        $('#fdShow').val($(this).data('show') + '');
        renderList();
    });
    $('.fd-kpi.fd-click').on('click', function () {
        var v = $(this).data('show') + '';
        $('#fdShow').val($('#fdShow').val() === v ? '' : v);
        if (data) renderList();
    });
    $('#fdYear, #fdClass').on('change', loadSections);
    $('#fdFind').on('input', function () { if (data) renderList(); });

    load();
});
</script>
}
