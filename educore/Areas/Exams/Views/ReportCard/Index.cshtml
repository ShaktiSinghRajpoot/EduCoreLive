@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Report Cards";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var exams = ViewBag.Exams as List<SelectListItem> ?? new();
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-spreadsheet fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Report Cards</h4>
            <div class="ec-page-subtitle">One report card per student: marks, grade, rank, attendance and remarks</div>
          </div>
        </div>
      </div>
    </div>

    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-printer"></i></span>
          <div>
            <div class="ec-section-title">Print report cards</div>
            <div class="ec-section-subtitle">Only exams whose results are published are listed. Section is optional — leave it blank for the whole class.</div>
          </div>
        </div>
      </div>

      <div class="ec-card-body">
        @if (!exams.Any())
        {
            <div class="alert alert-info mb-0">No exam has published results yet. Publish them on Examinations › Result Sheet first.</div>
        }
        else
        {
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Exam</label>
            <select class="form-select" id="rcExam">
              <option value="">Select exam</option>
              @foreach (var e in exams)
              {
                  <option value="@e.Value">@e.Text</option>
              }
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Class</label>
            <select class="form-select" id="rcClass" disabled>
              <option value="">Select exam first</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Section <span class="text-muted">(optional)</span></label>
            <select class="form-select" id="rcSection">
              <option value="">All sections</option>
            </select>
          </div>
        </div>

        <div class="mt-3 d-flex gap-2 flex-wrap">
          <button type="button" class="btn btn-primary" id="rcOpen">
            <i class="bx bx-printer me-1"></i>Open report cards
          </button>
          <span class="text-muted" style="font-size:.85rem; align-self:center;">
            Opens in a new tab, one A4 page per student, with a print button.
          </span>
        </div>
        }
      </div>
    </div>

  </div>
</div>

@section PageScripts {
<script>
    $(function () {

        // The exam's classes and sections come from the admit-card page.
        $('#rcExam').on('change', function () {
            var examId = $(this).val();
            var $cls = $('#rcClass');
            $('#rcSection').html('<option value="">All sections</option>');
            if (!examId) { $cls.prop('disabled', true).html('<option value="">Select exam first</option>'); return; }

            $.getJSON('@Url.Action("Classes", "AdmitCard", new { area = "Exams" })', { examId: examId })
            .done(function (list) {
                var html = '<option value="">Select class</option>';
                $.each(list || [], function (i, c) {
                    html += '<option value="' + c.id + '">' + EC.esc(c.name) + '</option>';
                });
                $cls.html(html).prop('disabled', false);
            })
            .fail(function () { ecToast('error', 'Could not load the classes of this exam.'); });
        });

        $('#rcClass').on('change', function () {
            var $sec = $('#rcSection');
            $sec.html('<option value="">All sections</option>');
            if (!$(this).val()) return;

            $.getJSON('@Url.Action("Sections", "AdmitCard", new { area = "Exams" })',
                { examId: $('#rcExam').val(), classId: $(this).val() })
            .done(function (list) {
                $.each(list || [], function (i, s) { $sec.append($('<option>').val(s).text(s)); });
            });
        });

        $('#rcOpen').on('click', function () {
            if (!$('#rcExam').val())  { ecToast('error', 'Choose an exam.'); return; }
            if (!$('#rcClass').val()) { ecToast('error', 'Choose a class.'); return; }

            window.open('@Url.Action("Print", "ReportCard", new { area = "Exams" })'
                + '?examId='  + encodeURIComponent($('#rcExam').val())
                + '&classId=' + encodeURIComponent($('#rcClass').val())
                + '&section=' + encodeURIComponent($('#rcSection').val() || ''), '_blank');
        });

    });
</script>
}
