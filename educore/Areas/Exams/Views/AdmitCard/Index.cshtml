@using Microsoft.AspNetCore.Mvc.Rendering
@inject educore.Helpers.ModuleFlags Modules
@{
    bool feesOn = await Modules.FeesOn();
    ViewData["Title"] = "Admit Cards";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
    var exams = ViewBag.Exams as List<SelectListItem> ?? new();
}

<div class="ec-page-shell">
  <div class="ec-page-content">

    <div class="ec-page-header">
      <div class="ec-page-header-inner">
        <div class="ec-page-title-wrap">
          <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center">
            <i class="bx bx-id-card fs-4"></i>
          </div>
          <div>
            <h4 class="ec-page-title mb-1">Admit Cards</h4>
            <div class="ec-page-subtitle">Print one admit card per student with the exam's datesheet</div>
          </div>
        </div>
      </div>
    </div>

    <div class="ec-card mb-0">
      <div class="ec-card-header">
        <div class="ec-section-title-wrap">
          <span class="ec-section-icon"><i class="bx bx-printer"></i></span>
          <div>
            <div class="ec-section-title">Print admit cards</div>
            <div class="ec-section-subtitle">Only published exams are listed. Section is optional — leave it blank for the whole class.</div>
          </div>
        </div>
      </div>

      <div class="ec-card-body">
        @if (!exams.Any())
        {
            <div class="alert alert-info mb-0">No published exam yet. Publish an exam's datesheet in Exam Schedule first.</div>
        }
        else
        {
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label">Exam</label>
            <select class="form-select" id="acExam">
              <option value="">Select exam</option>
              @foreach (var e in exams)
              {
                  <option value="@e.Value">@e.Text</option>
              }
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Class</label>
            <select class="form-select" id="acClass" disabled>
              <option value="">Select exam first</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Section <span class="text-muted">(optional)</span></label>
            <select class="form-select" id="acSection">
              <option value="">All sections</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Template</label>
            <select class="form-select" id="acFormat">
              <option value="Classic">Classic — 2 per A4 page</option>
              <option value="Compact">Compact — 4 per A4 page</option>
              <option value="FullPage">Full page — with instructions</option>
            </select>
          </div>
        </div>

        @if (feesOn)
        {
        <div class="form-check mt-3">
          <input class="form-check-input" type="checkbox" id="acHoldDues" />
          <label class="form-check-label" for="acHoldDues">Hold cards of students with fees due (they are listed instead, to hand over once paid)</label>
        </div>
        }

        <div class="mt-3 d-flex gap-2 flex-wrap">
          <button type="button" class="btn btn-primary" id="acOpen">
            <i class="bx bx-printer me-1"></i>Open admit cards
          </button>
          <span class="text-muted" style="font-size:.85rem; align-self:center;">
            Opens in a new tab with a print button.
          </span>
        </div>
        }
      </div>
    </div>

  </div>
</div>

@section PageScripts {
<script>
    $(function () {

        // Exam picked: load the classes it covers.
        $('#acExam').on('change', function () {
            var examId = $(this).val();
            var $cls = $('#acClass');
            $('#acSection').html('<option value="">All sections</option>');
            if (!examId) { $cls.prop('disabled', true).html('<option value="">Select exam first</option>'); return; }

            $.getJSON('@Url.Action("Classes", "AdmitCard", new { area = "Exams" })', { examId: examId })
            .done(function (list) {
                var html = '<option value="">Select class</option>';
                $.each(list || [], function (i, c) {
                    html += '<option value="' + c.id + '">' + EC.esc(c.name) + '</option>';
                });
                $cls.html(html).prop('disabled', false);
            })
            .fail(function () { ecToast('error', 'Could not load the classes of this exam.'); });
        });

        // Class picked: load the sections that have students.
        $('#acClass').on('change', function () {
            var $sec = $('#acSection');
            $sec.html('<option value="">All sections</option>');
            if (!$(this).val()) return;

            $.getJSON('@Url.Action("Sections", "AdmitCard", new { area = "Exams" })',
                { examId: $('#acExam').val(), classId: $(this).val() })
            .done(function (list) {
                $.each(list || [], function (i, s) { $sec.append($('<option>').val(s).text(s)); });
            });
        });

        $('#acOpen').on('click', function () {
            if (!$('#acExam').val())  { ecToast('error', 'Choose an exam.'); return; }
            if (!$('#acClass').val()) { ecToast('error', 'Choose a class.'); return; }

            var url = '@Url.Action("Print", "AdmitCard", new { area = "Exams" })'
                + '?examId='  + encodeURIComponent($('#acExam').val())
                + '&classId=' + encodeURIComponent($('#acClass').val())
                + '&section=' + encodeURIComponent($('#acSection').val() || '')
                + '&format='  + encodeURIComponent($('#acFormat').val())
                + '&holdDues=' + ($('#acHoldDues').is(':checked') ? 'true' : 'false');

            window.open(url, '_blank');
        });

    });
</script>
}
