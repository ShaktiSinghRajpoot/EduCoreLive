@{
    ViewData["Title"] = "Live Tracking";
    Layout = "~/Views/Shared/_ContentNavbarLayout.cshtml";
}

@section VendorStyles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
}

@section PageStyles {
<style>
  .lt-map  { height: 560px; border-radius: 16px; border: 1px solid var(--bs-border-color); }
  .lt-list { max-height: 560px; overflow-y: auto; }
  .lt-item { border: 1px solid var(--bs-border-color); border-radius: 12px; padding: .6rem .75rem; margin-bottom: .5rem; cursor: pointer; background: #fff; }
  .lt-item:hover { border-color: var(--p); }
  .lt-item.stale { opacity: .55; }
  .lt-no   { font-weight: 900; color: var(--heading); }
  .lt-meta { font-size: .78rem; font-weight: 650; color: var(--bs-secondary-color); }
  @@media (max-width: 991px) { .lt-map { height: 420px; } .lt-list { max-height: none; } }
</style>
}

<div class="ec-page-shell">
  <div class="ec-page-content">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <div class="ec-page-icon rounded-4 d-flex align-items-center justify-content-center" style="background:var(--soft);color:var(--p);width:46px;height:46px"><i class="bx bx-current-location fs-4"></i></div>
        <div>
          <h4 class="mb-0" style="color:var(--heading);font-weight:900">Live Tracking</h4>
          <div class="text-muted" style="font-size:.8rem">Buses on a trip right now · refreshes every 10 seconds</div>
        </div>
      </div>
      <a class="btn btn-outline-secondary" asp-action="TripHistory"><i class="bx bx-history me-1"></i>Trip history</a>
    </div>

    <div class="row g-3">
      <div class="col-lg-8"><div id="map" class="lt-map"></div></div>
      <div class="col-lg-4">
        <div class="fw-bold mb-2">Running trips <span class="badge bg-label-primary" id="tripCount">0</span></div>
        <div class="lt-list" id="tripList"></div>
        <div class="text-muted small mt-2">A bus that has not reported for 3 minutes is greyed out. A trip with nothing for 30 minutes ends by itself.</div>
      </div>
    </div>
  </div>
</div>

@section VendorScripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}

@section PageScripts {
<script>
$(function () {
  'use strict';
  var URL_LIVE = '@Url.Action("GetLiveTrips")';
  var STALE_SECONDS = 180;

  var map = L.map('map').setView([22.5, 79.0], 5);   // India, until a bus reports
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  }).addTo(map);

  var markers = {};        // tripId -> Leaflet circle marker
  var firstFit = true;

  // "2 min ago" from a number of seconds.
  function ago(sec) {
    if (sec === null || sec === undefined) return 'no position yet';
    if (sec < 60) return 'just now';
    if (sec < 3600) return Math.floor(sec / 60) + ' min ago';
    return Math.floor(sec / 3600) + ' h ago';
  }

  function isStale(t) { return t.ageSeconds === null || t.ageSeconds > STALE_SECONDS; }

  function popupHtml(t) {
    return '<strong>' + EC.esc(t.vehicleNo) + '</strong><br>' +
      EC.esc(t.routeName || 'No route') + '<br>' +
      'Driver: ' + EC.esc(t.driverName || '—') + '<br>' +
      'Updated ' + EC.esc(ago(t.ageSeconds)) +
      (t.speed !== null ? ' · ' + Math.round(t.speed * 3.6) + ' km/h' : '');
  }

  function render(rows) {
    $('#tripCount').text(rows.length);
    var seen = {};
    var bounds = [];

    rows.forEach(function (t) {
      seen[t.tripId] = true;
      if (t.lat === null || t.lng === null) return;
      var color = isStale(t) ? '#9aa0a6' : '#ff8a00';
      var m = markers[t.tripId];
      if (!m) {
        m = L.circleMarker([t.lat, t.lng], { radius: 10, weight: 3, color: '#fff', fillOpacity: 1 }).addTo(map);
        m.bindTooltip(EC.esc(t.vehicleNo), { permanent: true, direction: 'top', offset: [0, -10] });
        markers[t.tripId] = m;
      }
      m.setLatLng([t.lat, t.lng]);
      m.setStyle({ fillColor: color });
      m.setTooltipContent(EC.esc(t.vehicleNo));
      m.bindPopup(popupHtml(t));
      bounds.push([t.lat, t.lng]);
    });

    // Trips that ended since the last refresh leave the map.
    Object.keys(markers).forEach(function (id) {
      if (!seen[id]) { map.removeLayer(markers[id]); delete markers[id]; }
    });

    if (firstFit && bounds.length) {
      map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
      firstFit = false;
    }

    if (!rows.length) {
      $('#tripList').html('<div class="lt-item text-center text-muted" style="cursor:default">No bus is on a trip right now.</div>');
      return;
    }
    $('#tripList').html(rows.map(function (t) {
      return '<div class="lt-item' + (isStale(t) ? ' stale' : '') + '" data-id="' + t.tripId + '">' +
        '<div class="d-flex justify-content-between"><span class="lt-no">' + EC.esc(t.vehicleNo) + '</span>' +
        '<span class="lt-meta">' + EC.esc(ago(t.ageSeconds)) + '</span></div>' +
        '<div class="lt-meta">' + EC.esc(t.routeName || 'No route') + ' · ' + EC.esc(t.driverName || '—') + '</div>' +
        '<div class="lt-meta">Started ' + EC.esc((t.startedAt || '').substring(11, 16)) + ' · ' + t.points + ' point(s)</div>' +
        '</div>';
    }).join(''));
  }

  function load() {
    $.get(URL_LIVE)
      .done(function (d) {
        if (!d || !d.success) {
          EC.listEmpty('#tripList', (d && d.message) || 'Could not load.', 'bx-error-circle');
          return;
        }
        render(d.rows);
      })
      .fail(function () { EC.listEmpty('#tripList', 'Could not load. Retrying…', 'bx-error-circle'); });
  }

  $('#tripList').on('click', '.lt-item[data-id]', function () {
    var m = markers[$(this).data('id')];
    if (!m) { ecToast('info', 'This bus has not sent a position yet.'); return; }
    map.setView(m.getLatLng(), 16);
    m.openPopup();
  });

  EC.listLoading('#tripList');
  load();
  setInterval(load, 10000);
});
</script>
}
