@model educore.Models.SchoolUnavailableViewModel
@{
    Layout = "_BlankLayout";
    ViewData["Title"] = Model.Heading;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/Account/SchoolUnavailable.css" asp-append-version="true" />
}

@*
    Shown when the password was correct but the school's status blocks sign-in.
    Deliberately a page and not a toast: a toast auto-dismisses after 3.5s and gives
    the user nothing to act on. Nothing here identifies the user or the school — the
    status wording comes from config.school_statuses.login_message via TempData, so
    the page is safe even if opened directly.
*@
<div class="su-page">
    <div class="su-card">

        <div class="su-icon su-icon--@(Model.IsTerminal ? "terminal" : "warn")">
            <i class="bx @Model.Icon"></i>
        </div>

        <h1 class="su-title">@Model.Heading</h1>
        <p class="su-body">@Model.Body</p>

        <p class="su-note">
            @if (Model.IsTerminal)
            {
                <span>Your sign-in details are still valid — it is the school that is no longer active. If you believe this is a mistake, please get in touch.</span>
            }
            else
            {
                <span>Your sign-in details are correct. Access will return as soon as the school is reactivated.</span>
            }
        </p>

        @if (Model.Support.HasAnyContact)
        {
            <div class="su-contact">
                <div class="su-contact-head">Need help? Contact EduCore support</div>

                @if (!string.IsNullOrWhiteSpace(Model.Support.Email))
                {
                    <a class="su-contact-row" href="mailto:@Model.Support.Email">
                        <i class="bx bx-envelope"></i>
                        <span>@Model.Support.Email</span>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Support.Phone))
                {
                    @* tel: strips spaces so the dialler gets a clean number on mobile. *@
                    <a class="su-contact-row" href="tel:@Model.Support.Phone.Replace(" ", "")">
                        <i class="bx bx-phone"></i>
                        <span>@Model.Support.Phone</span>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Support.Website))
                {
                    <a class="su-contact-row" href="@Model.Support.Website" target="_blank" rel="noopener noreferrer">
                        <i class="bx bx-globe"></i>
                        <span>@Model.Support.Website</span>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Support.Hours))
                {
                    <div class="su-hours">
                        <i class="bx bx-time"></i> @Model.Support.Hours
                    </div>
                }
            </div>
        }

        <a class="su-back" asp-controller="Account" asp-action="Login">
            <i class="bx bx-arrow-back"></i> Back to sign in
        </a>
    </div>
</div>
