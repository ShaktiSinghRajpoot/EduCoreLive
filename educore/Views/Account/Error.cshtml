@using EduCoreDataAccessLayer.Models
@model ErrorViewModel

@{
    Layout = "_BlankLayout";

    // UseStatusCodePagesWithReExecute sends EVERY failing status here (403, 404,
    // 500 …). This page used to hardcode "404 Page Not Found", so a user who hit
    // a page their role can't open was told the page did not exist.
    var status = Context.Response.StatusCode;
    var (heading, detail) = status switch
    {
        401 => ("Sign In Required ⚠️", "Your session has ended. Please sign in again."),
        403 => ("Access Denied ⚠️", "Your role does not have permission to open this page. Ask your school admin if you need access."),
        404 => ("Page Not Found ⚠️", "We couldn't find the page you are looking for."),
        _   => ("Something Went Wrong ⚠️", "An unexpected error occurred. Please try again.")
    };
    ViewData["Title"] = $"{status} - EduCore";
}
@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-misc.css" />
}
@* ************** Content ************** *@
<!-- Error -->
<div class="container-xxl container-p-y">
    <div class="misc-wrapper">
        <h1 class="mb-2 mx-2" style="line-height: 6rem;font-size: 6rem;">@status</h1>
        <h4 class="mb-2 mx-2">@heading</h4>
        <p class="mb-6 mx-2">@detail</p>
        @if (status == 401)
        {
            <a href="/Account/Login" class="btn btn-primary">Sign in</a>
        }
        else
        {
            <a href="/" class="btn btn-primary">Back to home</a>
        }
        <div class="mt-6">
            <img src="~/img/illustrations/page-misc-error-light.png" alt="page-misc-error-light" width="500" class="img-fluid" />
        </div>
    </div>
</div>
<!-- /Error -->
