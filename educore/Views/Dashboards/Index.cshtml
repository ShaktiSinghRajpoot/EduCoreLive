@model EduCoreDataAccessLayer.Models.ERP.DashboardSummary
@{
    ViewData["Title"] = "Dashboard";
    var greeting = Dates.Now.Hour < 12 ? "Good morning" : Dates.Now.Hour < 17 ? "Good afternoon" : "Good evening";

    // map per-item accent -> soft theme class
    string Money(decimal v) => "₹" + v.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"));
    string Initials(string n) => string.Concat((n ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                .Take(2).Select(w => char.ToUpper(w[0])));
    // Rotate the accent so a list of rows is not one flat colour.
    string[] accents = { "primary", "info", "success", "warning", "danger", "secondary" };

    // Student attendance card / defaulters link: Attendance Overview (reports.view), else the register.
    var studentAttUrl = Model.CanOpenOverview
        ? Url.Action("Index", "AttendanceOverview", new { area = "ERP" })
        : Url.Action("StudentAttendance", "Attendance", new { area = "ERP" });

    // Total collected this month, for the Payment Modes card.
    var modeTotal = Model.Modes.Sum(m => m.Amount);

    string Soft(string c) => c switch
    {
        "primary" => "soft-orange",
        "info" => "soft-blue",
        "success" => "soft-green",
        "warning" => "soft-amber",
        "danger" => "soft-red",
        _ => "soft-grey"
    };
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/apex-charts/apexcharts.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/Dashboards/Index.css" asp-append-version="true" />
}

@* *************** SmartSchoolWala — School Admin Dashboard **************** *@
<div class="dash">
    <div class="row g-4">

        @* ============ HERO + LIVE ATTENDANCE ============ *@
        <div class="col-12 dash-animate">
            <div class="dash-hero h-100">
                <div class="dash-hero-body d-flex flex-column h-100">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div>
                            <span class="dash-chip mb-3"><i class="bx bx-calendar"></i> @Dates.Now.ToString("dddd, dd MMMM yyyy")</span>
                            <h3 class="text-white fw-bold mb-1">@greeting, @(User.FindFirst(EduCoreDataAccessLayer.Helpers.Common.SK_UserName)?.Value ?? "Admin") 👋</h3>
                            <p class="mb-0" style="color:rgba(255,255,255,.9);max-width:36rem">
                                @if (!Model.ShowFinance && !Model.ShowStudents && !Model.ShowStaff && !Model.ShowAttendance)
                                {
                                    <text>@(Model.IsDriver ? "Open My Bus to start today's trip." : "Use the menu to open the pages your role can use.")</text>
                                }
                                else if (!Model.ShowFinance)
                                {
                                    <text>Here is your school today.</text>
                                }
                                else if (Model.TodayCollection > 0)
                                {
                                    <text>You've collected <strong class="text-white">@Money(Model.TodayCollection)</strong> today. </text>
                                }
                                else
                                {
                                    <text>Nothing collected yet today. </text>
                                }
                                @if (!Model.ShowFinance)
                                {
                                }
                                else if (Model.DueStudents > 0)
                                {
                                    <text><strong class="text-white">@Model.DueStudents</strong> student@(Model.DueStudents == 1 ? "" : "s") still @(Model.DueStudents == 1 ? "has" : "have") pending dues.</text>
                                }
                                else
                                {
                                    <text>No student has a pending due.</text>
                                }
                            </p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.SessionName))
                        {
                            <span class="dash-chip"><i class="bx bx-book-open"></i> Session @Model.SessionName</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-auto pt-4">
                        @if (Model.IsDriver)
                        {
                            <a href="/ERP/MyBus" class="btn btn-sm btn-light text-dark fw-semibold"><i class="bx bx-bus me-1"></i>My Bus</a>
                        }
                        @if (Model.CanAdmit)
                        {
                            <a href="/ERP/Admission/Create" class="btn btn-sm btn-light text-dark fw-semibold"><i class="bx bx-user-plus me-1"></i>New Admission</a>
                        }
                        @if (Model.ShowFinance)
                        {
                            <a href="/ERP/Fee/ManageFee" class="btn btn-sm btn-outline-light"><i class="bx bx-wallet me-1"></i>Collect Fee</a>
                        }
                        @if (Model.ShowAttendance)
                        {
                            <a href="/ERP/Attendance/StudentAttendance" class="btn btn-sm btn-outline-light"><i class="bx bx-user-check me-1"></i>Mark Attendance</a>
                        }
                        @if (Model.ShowFinance)
                        {
                            <a href="/ERP/FeeDueReminders" class="btn btn-sm btn-outline-light"><i class="bx bx-bell me-1"></i>Send Reminders</a>
                        }
                    </div>
                </div>
            </div>
        </div>


        @* ============ PRIMARY KPI CARDS ============ *@
        @{
            // Real figures. Each trend line says only what we can support — no invented
            // "+12.5% vs yesterday" on a day nothing was collected.
            var collectionTrend = Model.YesterdayCollection == 0
                ? (Model.TodayCollection > 0 ? "nothing collected yesterday" : "no collection today")
                : (Model.TodayCollection >= Model.YesterdayCollection ? "up from " : "down from ")
                  + Money(Model.YesterdayCollection) + " yesterday";

            // Today's attendance sits on the Students / Staff cards (one card per thing);
            // clicking them opens the attendance pages.
            var st = Model.StaffToday;
            string studentAtt = !Model.ShowAttendance ? ""
                : Model.MarkedToday == 0 ? "Today: attendance not marked yet"
                : $"Today: {Model.PresentToday} present · {Model.MarkedToday - Model.PresentToday} absent · {Math.Max(Model.Students - Model.MarkedToday, 0)} not marked";
            string staffAtt = st.Marked == 0 && st.OnLeave == 0 ? "Today: attendance not marked yet"
                : $"Today: {st.Present} present · {st.Absent + st.HalfDay} absent · {st.OnLeave} on leave · {Math.Max(st.Total - st.Marked, 0)} not marked";
            var kpis = new[] {
                new { Label="Total Students", Value=Model.Students.ToString(),
                      Trend=Model.Students == 1 ? "1 active student" : $"{Model.Students} active students",
                      Soft="soft-green", Icon="bx-group", Spark="sparkStudents", Up=true,
                      Att=studentAtt, Url=Model.ShowAttendance ? studentAttUrl : null },
                new { Label="Total Staff", Value=Model.Staff.ToString(),
                      Trend=Model.Staff == 1 ? "1 active staff member" : $"{Model.Staff} active staff",
                      Soft="soft-orange", Icon="bx-id-card", Spark="sparkStaff", Up=true,
                      Att=staffAtt, Url=Url.Action("Index", "StaffAttendance", new { area = "ERP" }) },
                new { Label="Today's Collection", Value=Money(Model.TodayCollection),
                      Trend=collectionTrend, Soft="soft-blue", Icon="bx-wallet", Spark="sparkCollection",
                      Up=Model.TodayCollection >= Model.YesterdayCollection, Att="", Url=(string?)null },
                new { Label="Outstanding Due", Value=Money(Model.Outstanding),
                      Trend=Model.DueStudents == 1 ? "1 student pending" : $"{Model.DueStudents} students pending",
                      Soft="soft-red", Icon="bx-error-circle", Spark="sparkDue", Up=false, Att="", Url=(string?)null },
            };

            // Each figure needs its module: students, staff, then the two finance ones.
            kpis = kpis.Where((k, idx) => idx == 0 ? Model.ShowStudents
                                        : idx == 1 ? Model.ShowStaff
                                        : Model.ShowFinance).ToArray();
        }
        @for (var i = 0; i < kpis.Length; i++)
        {
            var k = kpis[i];
            <div class="col-12 col-sm-6 col-xl-3 dash-animate" style="animation-delay:@($"{0.05 * (i + 2):0.00}".Replace(",", "."))s">
                <div class="dash-card dash-kpi h-100" data-card-href="@k.Url" style="@(k.Url != null ? "cursor:pointer" : "")">
                    <div class="dash-card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="dash-label mb-2">@k.Label</div>
                                <div class="dash-value mb-1">@k.Value</div>
                                <small class="fw-semibold" style="color:@(k.Up ? "#16a34a" : "#dc2626")"><i class="bx @(k.Up ? "bx-trending-up" : "bx-trending-down")"></i> @k.Trend</small>
                                @if (k.Att != "")
                                {
                                    <small class="d-block dash-sub mt-1"><i class="bx bx-user-check me-1"></i>@k.Att</small>
                                }
                            </div>
                            <span class="dash-icon @k.Soft"><i class="bx @k.Icon"></i></span>
                        </div>
                    </div>
                    <div id="@k.Spark" class="dash-spark"></div>
                </div>
            </div>
        }

        @* ============ MY CLASS (class teacher) ============ *@
        @foreach (var mc in Model.MyClasses)
        {
        <div class="col-12 dash-animate">
            <div class="dash-card">
                <div class="dash-card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="dash-icon soft-orange"><i class="bx bx-chalkboard"></i></span>
                        <div>
                            <div class="dash-label">Your class · Class Teacher</div>
                            <h5 class="mb-0 dash-card-title">@mc.Label</h5>
                            <small class="dash-sub">@mc.Students student@(mc.Students == 1 ? "" : "s") · @mc.SessionName ·
                                @if (mc.MarkedToday) { <span class="text-success fw-semibold">today's attendance marked</span> }
                                else { <span class="text-danger fw-semibold">today's attendance not marked yet</span> }
                            </small>
                        </div>
                    </div>
                    @if (Model.ShowAttendance)   @* the register needs attendance.view *@
                    {
                    <a class="btn @(mc.MarkedToday ? "btn-outline-primary" : "btn-primary")"
                       href="@Url.Action("StudentAttendance", "Attendance", new { area = "ERP", @class = mc.ClassName, section = mc.SectionName })">
                        <i class="bx bx-user-check me-1"></i>@(mc.MarkedToday ? "Open register" : "Mark attendance")
                    </a>
                    }
                </div>
            </div>
        </div>
        }

        @* ============ UPCOMING + ATTENDANCE DEFAULTERS, side by side ============
           Each is half the row on a wide screen (one alone takes the whole row), with
           rows like the Fee Defaulters / Recent Transactions cards below. *@
        @{
            bool showUpcoming = Model.Upcoming.Any();
            bool showAttDef   = Model.ShowAttendance || Model.ShowStaff;
            string pairCol    = showUpcoming && showAttDef ? "col-12 col-xl-6" : "col-12";
            DateTime today    = Dates.Now.Date;
        }

        @if (showUpcoming)
        {
            <div class="@pairCol dash-animate">
                <div class="dash-card h-100">
                    <div class="dash-card-head d-flex justify-content-between align-items-center gap-2">
                        <div><h5 class="dash-card-title">Upcoming</h5><small class="dash-sub">Next 30 days · events, exams and holidays</small></div>
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("SchoolCalendar", "SchoolSettings", new { area = "ERP" })">Calendar</a>
                    </div>
                    <div class="dash-card-body dash-scroll">
                        @foreach (var e in Model.Upcoming)
                        {
                            var start = DateTime.Parse(e.Start);
                            var end = DateTime.Parse(e.End);
                            // One colour per kind, used for the date tile and the label.
                            string tone = e.Type switch
                            {
                                "Holiday" => "soft-red", "Half day" => "soft-amber", "Exam" => "soft-orange",
                                "PTM" => "soft-green", "Meeting" => "soft-grey", _ => "soft-blue"
                            };
                            string kind = e.Type == "Meeting" ? "Staff meeting" : e.Type;
                            int days = (start - today).Days;
                            string whenText = start <= today ? (end > today ? "On now · till " + end.ToString("dd MMM") : "Today")
                                            : days == 1 ? "Tomorrow" : "In " + days + " days";
                            string detail = (end > start ? start.ToString("dd MMM") + " – " + end.ToString("dd MMM") + " · " : "")
                                          + (e.Time != null ? DateTime.Parse(e.Time).ToString("h:mm tt") + " · " : "")
                                          + (e.ForWhom ?? "");
                            <div class="dash-row">
                                <div class="dash-date @tone">
                                    <b>@start.ToString("dd")</b><span>@start.ToString("MMM")</span>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <h6 class="mb-0 text-truncate">@e.Title</h6>
                                    <small class="text-muted d-block text-truncate">@detail.TrimEnd(' ', '·')</small>
                                </div>
                                <div class="text-end flex-shrink-0">
                                    <span class="dash-pill @tone">@kind</span>
                                    <div class="small text-muted mt-1 text-nowrap">@whenText</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* (today's attendance is on the Students / Staff cards above) *@
        @if (showAttDef)
        {
            bool stuTab = Model.ShowAttendance;
            <div class="@pairCol dash-animate" style="animation-delay:.05s">
                <div class="dash-card h-100">
                    <div class="dash-card-head d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div><h5 class="dash-card-title">Attendance Defaulters</h5><small class="dash-sub">Students below 75% this session · staff absent this month</small></div>
                        <div class="btn-group btn-group-sm flex-shrink-0" role="group">
                            @if (Model.ShowAttendance)
                            {
                                <button type="button" class="btn btn-outline-primary active" data-att-tab="stu">Students (@Model.StudentAttendanceDefaulterCount)</button>
                            }
                            @if (Model.ShowStaff)
                            {
                                <button type="button" class="btn btn-outline-primary @(stuTab ? "" : "active")" data-att-tab="staff">Staff (@Model.StaffAttendanceDefaulterCount)</button>
                            }
                        </div>
                    </div>
                    <div class="dash-card-body dash-scroll">
                        @if (Model.ShowAttendance)
                        {
                            <div data-att-pane="stu">
                                @if (!Model.StudentAttendanceDefaulters.Any())
                                {
                                    <div class="dash-empty"><i class="bx bx-check-circle"></i>No student is below 75% this session<small>(counted after 5 days marked)</small></div>
                                }
                                @foreach (var d in Model.StudentAttendanceDefaulters)
                                {
                                    var pct = Math.Max(0, Math.Min(100, (double)d.Percent));
                                    <a class="dash-row text-reset text-decoration-none" href="@Url.Action("Dashboard", "Student", new { area = "ERP", id = d.PublicId })">
                                        <span class="dash-avatar @Soft(accents[Model.StudentAttendanceDefaulters.IndexOf(d) % accents.Length])">@Initials(d.StudentName)</span>
                                        <div class="flex-grow-1 min-w-0">
                                            <h6 class="mb-0 text-truncate">@d.StudentName</h6>
                                            <small class="text-muted">@d.ClassName@(string.IsNullOrWhiteSpace(d.Section) ? "" : " – " + d.Section) · present @d.Present of @d.Marked days</small>
                                            <div class="dash-progress mt-1"><span style="width:@pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;background:@(pct < 60 ? "#dc2626" : "#d97706")"></span></div>
                                        </div>
                                        <span class="dash-pill @(pct < 60 ? "soft-red" : "soft-amber") flex-shrink-0">@d.Percent.ToString("0.#")%</span>
                                    </a>
                                }
                                @if (Model.StudentAttendanceDefaulterCount > Model.StudentAttendanceDefaulters.Count)
                                {
                                    <div class="dash-sub small p-2">+ @(Model.StudentAttendanceDefaulterCount - Model.StudentAttendanceDefaulters.Count) more — see <a href="@studentAttUrl">Attendance</a>.</div>
                                }
                            </div>
                        }
                        @if (Model.ShowStaff)
                        {
                            <div data-att-pane="staff" class="@(stuTab ? "d-none" : "")">
                                @if (!Model.StaffAttendanceDefaulters.Any())
                                {
                                    <div class="dash-empty"><i class="bx bx-check-circle"></i>No staff absences this month</div>
                                }
                                @foreach (var d in Model.StaffAttendanceDefaulters)
                                {
                                    <a class="dash-row text-reset text-decoration-none" href="@Url.Action("StaffProfile", "Staff", new { area = "ERP", id = d.PublicId })">
                                        <span class="dash-avatar @Soft(accents[Model.StaffAttendanceDefaulters.IndexOf(d) % accents.Length])">@Initials(d.FullName)</span>
                                        <div class="flex-grow-1 min-w-0">
                                            <h6 class="mb-0 text-truncate">@d.FullName</h6>
                                            <small class="text-muted">@(d.Designation ?? "Staff")@(d.LateDays > 0 ? " · late " + d.LateDays + " day" + (d.LateDays == 1 ? "" : "s") : "")</small>
                                        </div>
                                        <span class="dash-pill soft-red flex-shrink-0">@d.AbsentDays.ToString("0.#") day@(d.AbsentDays == 1 ? "" : "s") absent</span>
                                    </a>
                                }
                                @if (Model.StaffAttendanceDefaulterCount > Model.StaffAttendanceDefaulters.Count)
                                {
                                    <div class="dash-sub small p-2">+ @(Model.StaffAttendanceDefaulterCount - Model.StaffAttendanceDefaulters.Count) more — see <a href="@Url.Action("Index", "StaffAttendance", new { area = "ERP" })">Staff Attendance</a>.</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.ShowFinance)
        {
        @* ============ COLLECTION TREND + TARGET ============ *@
        <div class="col-12 col-xl-8 dash-animate">
            <div class="dash-card h-100">
                <div class="dash-card-head d-flex flex-column flex-md-row justify-content-between gap-2">
                    <div><h5 class="dash-card-title">Fee Collection Trend</h5><small class="dash-sub">Daily collection over the last 7 days</small></div>
                    @* Week/Month/Download were never wired to anything. *@
                </div>
                <div class="dash-card-body"><div id="collectionTrendChart" class="dash-chart"></div></div>
            </div>
        </div>
        <div class="col-12 col-xl-4 dash-animate" style="animation-delay:.05s">
            <div class="dash-card h-100">
                @* Was "Collection Target" with a progress ring. No target is configured
                   anywhere in the app, so the ring could only be progress towards an
                   invented number. These two figures are real. *@
                <div class="dash-card-head"><h5 class="dash-card-title">This Month</h5><small class="dash-sub">Collected so far</small></div>
                <div class="dash-card-body text-center">
                    <div class="py-3">
                        <div class="dash-label mb-1">Collected this month</div>
                        <h3 class="mb-0 fw-bold" style="color:#16a34a">@Money(Model.Modes.Sum(m => m.Amount))</h3>
                    </div>
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <div class="p-2 rounded" style="background:var(--ec-bg-soft)">
                                <div class="dash-label mb-1">Today</div>
                                <h6 class="mb-0" style="color:#16a34a">@Money(Model.TodayCollection)</h6>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded" style="background:var(--ec-bg-soft)">
                                <div class="dash-label mb-1">Outstanding</div>
                                <h6 class="mb-0" style="color:#dc2626">@Money(Model.Outstanding)</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        }
        @* ============ ANALYTICS ============ *@
        @if (Model.ShowFinance)
        {
        <div class="col-12 col-lg-6 col-xl-4 dash-animate">
            <div class="dash-card h-100">
                @* Was "Income vs Expense". There is no expense module, so half the chart
                   could only be invented — and income alone under that title misleads.
                   This is the same fee collection, by payment mode. *@
                <div class="dash-card-head"><h5 class="dash-card-title">Collection by Mode</h5><small class="dash-sub">This month</small></div>
                <div class="dash-card-body">
                    @if (!Model.Modes.Any())
                    {
                        <div class="text-muted small py-4 text-center">No fee collected this month.</div>
                    }
                    else
                    {
                        foreach (var m in Model.Modes)
                        {
                            var share = Math.Round(m.Amount * 100 / Model.Modes.Sum(x => x.Amount));
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="dash-sub">@m.Mode</span><strong>@Money(m.Amount)</strong>
                                </div>
                                <div class="dash-progress"><span style="width:@share%;background:var(--ec-primary)"></span></div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        }
        @if (Model.ShowStudents)
        {
        <div class="col-12 col-lg-6 col-xl-4 dash-animate" style="animation-delay:.05s">
            <div class="dash-card h-100">
                <div class="dash-card-head"><h5 class="dash-card-title">Class-wise Strength</h5><small class="dash-sub">Students per class</small></div>
                <div class="dash-card-body"><div id="classStrengthChart"></div></div>
            </div>
        </div>
        }
        @if (Model.ShowFinance)
        {
        <div class="col-12 col-xl-4 dash-animate" style="animation-delay:.1s">
            <div class="dash-card h-100">
                <div class="dash-card-head"><h5 class="dash-card-title">Payment Modes</h5><small class="dash-sub">Collection by method</small></div>
                <div class="dash-card-body">
                    <div id="paymentModeChart"></div>
                    @* The modes the school actually used — the list was fixed at
                       Cash/UPI/Card even for a school that takes none of them. *@
                    <div class="row text-center g-2 mt-2">
                        @if (modeTotal <= 0)
                        {
                            <div class="col"><div class="text-muted small">No collection this month.</div></div>
                        }
                        else
                        {
                            var colours = new[] { "#16a34a", "#ff8a00", "#d97706", "#0284c7" };
                            var i = 0;
                            foreach (var m in Model.Modes.Take(4))
                            {
                                <div class="col @(i > 0 ? "border-start" : "")">
                                    <div class="dash-label mb-1">@m.Mode</div>
                                    <h6 class="mb-0" style="color:@colours[i % colours.Length]">@Math.Round(m.Amount * 100 / modeTotal)%</h6>
                                </div>
                                i++;
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        }
        @if (Model.ShowFinance)
        {
        @* ============ OPERATIONAL ============ *@
        <div class="col-12 col-lg-6 col-xl-4 dash-animate">
            <div class="dash-card h-100">
                <div class="dash-card-head d-flex justify-content-between align-items-center">
                    <div><h5 class="dash-card-title">Top Fee Defaulters</h5><small class="dash-sub">Highest outstanding dues</small></div>
                    <a href="/ERP/FeeDueReminders" class="btn btn-sm btn-primary">Remind All</a>
                </div>
                <div class="dash-card-body dash-scroll">
                    @if (!Model.Defaulters.Any())
                    {
                        <div class="text-muted small p-2">Nobody has an outstanding balance.</div>
                    }
                    @foreach (var d in Model.Defaulters)
                    {
                        <div class="dash-row">
                            <span class="dash-avatar @Soft(accents[Model.Defaulters.IndexOf(d) % accents.Length])">@Initials(d.StudentName)</span>
                            <div class="flex-grow-1 min-w-0">
                                <h6 class="mb-0 text-truncate">@d.StudentName</h6>
                                <small class="text-muted">@d.ClassName@(string.IsNullOrWhiteSpace(d.Section) ? "" : " – " + d.Section)</small>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold" style="color:#dc2626">@Money(d.Due)</div>
                                <a href="/ERP/FeeDueReminders" class="small" style="color:var(--ec-primary)"><i class="bx bx-bell"></i> Remind</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6 col-xl-4 dash-animate" style="animation-delay:.05s">
            <div class="dash-card h-100">
                <div class="dash-card-head d-flex justify-content-between align-items-center">
                    <div><h5 class="dash-card-title">Recent Transactions</h5><small class="dash-sub">Latest fee receipts</small></div>
                    <a href="/ERP/Fee/ManageFee" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                <div class="dash-card-body dash-scroll">
                    @if (!Model.Recent.Any())
                    {
                        <div class="text-muted small p-2">No fee receipts yet.</div>
                    }
                    @foreach (var t in Model.Recent)
                    {
                        <div class="dash-row">
                            <span class="dash-icon soft-green" style="width:2.4rem;height:2.4rem;font-size:1.1rem"><i class="bx bx-rupee"></i></span>
                            <div class="flex-grow-1 min-w-0">
                                <h6 class="mb-0 text-truncate">@t.StudentName</h6>
                                <small class="text-muted">#@t.ReceiptNo@(string.IsNullOrWhiteSpace(t.Mode) ? "" : " · " + t.Mode)</small>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold" style="color:#16a34a">@Money(t.Amount)</div>
                                <small class="text-muted">@(string.IsNullOrWhiteSpace(t.PaymentDate) ? "" : Dates.Show(t.PaymentDate, "dd MMM"))</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        }
        @if (Model.ShowStaff && Model.ShowLeave)
        {
        <div class="col-12 col-xl-4 dash-animate" style="animation-delay:.1s">
            <div class="dash-card h-100">
                <div class="dash-card-head d-flex justify-content-between align-items-center">
                    <div><h5 class="dash-card-title">Pending Approvals</h5><small class="dash-sub">Needs your action</small></div>
                    <span class="dash-pill soft-amber">@Model.Approvals.Count pending</span>
                </div>
                <div class="dash-card-body dash-scroll">
                    @* Leave is the only approval queue that exists — payment verification has
                       no backend, and listing one would send the office to a dead page. *@
                    @if (!Model.Approvals.Any())
                    {
                        <div class="text-muted small p-2">Nothing waiting for approval.</div>
                    }
                    @foreach (var a in Model.Approvals)
                    {
                        <div class="dash-row">
                            <span class="dash-icon soft-amber" style="width:2.4rem;height:2.4rem;font-size:1.1rem"><i class="bx bx-calendar-minus"></i></span>
                            <div class="flex-grow-1 min-w-0">
                                <h6 class="mb-0 text-truncate">@a.FullName</h6>
                                <small class="text-muted text-truncate d-block">@a.LeaveType Leave · @a.Days.ToString("0.#") day@(a.Days == 1 ? "" : "s")</small>
                            </div>
                            @* Approve and Reject both just opened the leave page — two buttons
                               that looked like decisions and were navigation. One link now. *@
                            <a href="/ERP/Leave/LeaveManagement" class="btn btn-sm btn-outline-primary">Review</a>
                        </div>
                    }
                </div>
            </div>
        </div>
        }

        @* ============ EVENTS · BIRTHDAYS ============ *@
        @* (Students per class is the "Class-wise Strength" chart above; the list
           card that repeated it here was removed.) *@
        <div class="col-12 col-lg-6 dash-animate">
            <div class="dash-card h-100">
                <div class="dash-card-head"><h5 class="dash-card-title">Upcoming Events</h5><small class="dash-sub">Academic calendar</small></div>
                <div class="dash-card-body">
                    @* These used to be four hard-coded entries (the same "Half-Yearly Exams
                       15 Jun" for every school); now they are the School Calendar's own. *@
                    @if (!Model.Events.Any())
                    {
                        <div class="text-muted small p-2">Nothing on the school calendar yet.</div>
                    }
                    else
                    {
                        <ul class="dash-timeline">
                            @foreach (var e in Model.Events)
                            {
                                <li><div class="d-flex justify-content-between"><h6 class="mb-0">@e.Title</h6><small class="text-muted">@Dates.Show(e.Date, "dd MMM")</small></div><small class="text-muted">@e.DayType</small></li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        @if (Model.ShowStudents || Model.ShowStaff)
        {
        <div class="col-12 col-lg-6 dash-animate" style="animation-delay:.1s">
            <div class="dash-card h-100">
                <div class="dash-card-head"><h5 class="dash-card-title">🎂 Birthdays Today</h5><small class="dash-sub">Wish them well</small></div>
                <div class="dash-card-body dash-scroll">
                    @if (!Model.Birthdays.Any())
                    {
                        <div class="text-muted small p-2">No birthdays today.</div>
                    }
                    @foreach (var b in Model.Birthdays)
                    {
                        <div class="dash-row">
                            <span class="dash-avatar @Soft(accents[Model.Birthdays.IndexOf(b) % accents.Length])">@Initials(b.Name)</span>
                            <div class="flex-grow-1 min-w-0">
                                <h6 class="mb-0 text-truncate">@b.Name</h6>
                                <small class="text-muted">@b.Who@(string.IsNullOrWhiteSpace(b.Detail) ? "" : " · " + b.Detail)</small>
                            </div>
                            @* The "Wish" button never did anything — there is no message
                               to send and no record of having sent one. *@
                        </div>
                    }
                    @if (Model.Birthdays.Any())
                    {
                        <div class="text-center pt-2">
                            <small class="text-muted">@Model.Birthdays.Count birthday@(Model.Birthdays.Count == 1 ? "" : "s") today</small>
                        </div>
                    }
                </div>
            </div>
        </div>
        }

        @* ============ QUICK ACCESS ============ *@
        <div class="col-12 dash-animate">
            <div class="dash-card">
                <div class="dash-card-head"><h5 class="dash-card-title">Quick Access</h5><small class="dash-sub">Modules your role can open</small></div>
                <div class="dash-card-body">
                    <div class="row g-3">
                        @* Built by DashboardsController: only tiles this role can open. *@
                        @if (!Model.QuickLinks.Any())
                        {
                            <div class="col-12 text-muted small">No modules are enabled for your role yet. Ask your school admin for access.</div>
                        }
                        @foreach (var l in Model.QuickLinks)
                        {
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <a href="@l.Url" class="dash-quick">
                                    <i class="bx @l.Icon" style="color:@l.Color"></i>
                                    <span>@l.Label</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (Model.ShowFinance)
        {
        @* ============ STUDENT FEE MATRIX ============ *@
        <div class="col-12 dash-animate">
            <div class="dash-card">
                <div class="dash-card-head d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                    <div><h5 class="dash-card-title">Student Fee Matrix</h5><small class="dash-sub">Top @Model.Defaulters.Count by outstanding due</small></div>
                    <div class="d-flex flex-column flex-sm-row gap-2 w-100 w-lg-auto">
                        <input type="search" class="form-control dash-search" placeholder="Search student or class...">
                        <a href="/ERP/FeeDueReminders" class="btn btn-primary"><i class="bx bx-bell me-1"></i>Remind Defaulters</a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table dash-table mb-0">
                        <thead><tr><th>Student</th><th>Class</th><th>Total Fee</th><th>Paid</th><th>Due</th><th>Status</th><th>Last Payment</th></tr></thead>
                        <tbody>
                            @if (!Model.Defaulters.Any())
                            {
                                <tr><td colspan="7" class="text-muted small p-3">Nobody has an outstanding balance.</td></tr>
                            }
                            @foreach (var r in Model.Defaulters)
                            {
                                // Paid nothing at all is a different situation from part-paid:
                                // one has never engaged, the other is mid-instalment.
                                var partial = r.Paid > 0;
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="dash-avatar @Soft(accents[Model.Defaulters.IndexOf(r) % accents.Length])">@Initials(r.StudentName)</span>
                                            <div>
                                                <h6 class="mb-0">
                                                    <a asp-area="ERP" asp-controller="Student" asp-action="Dashboard" asp-route-id="@r.PublicId"
                                                       class="text-reset text-decoration-none">@r.StudentName</a>
                                                </h6>
                                                <small class="text-muted">Student</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@r.ClassName@(string.IsNullOrWhiteSpace(r.Section) ? "" : " – " + r.Section)</td>
                                    <td>@Money(r.Total)</td>
                                    <td class="fw-semibold" style="color:#16a34a">@Money(r.Paid)</td>
                                    <td class="fw-semibold" style="color:#dc2626">@Money(r.Due)</td>
                                    <td>
                                        <span class="dash-pill @(partial ? "soft-amber" : "soft-red")">
                                            <i class="bx bxs-circle" style="font-size:.5rem"></i>@(partial ? "Partial" : "Pending")
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(r.LastPayment) ? "—" : Dates.Show(r.LastPayment, "dd MMM"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        }

    </div>
</div>

@section PageScripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // A card with data-card-href opens that page when clicked anywhere on it
            document.querySelectorAll('[data-card-href]').forEach(function (card) {
                card.addEventListener('click', function (e) {
                    if (e.target.closest('a, button')) return;   // its own links work as they are
                    window.location.href = card.getAttribute('data-card-href');
                });
            });

            // Attendance Defaulters: Students / Staff tabs
            document.querySelectorAll('[data-att-tab]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var tab = btn.getAttribute('data-att-tab');
                    document.querySelectorAll('[data-att-tab]').forEach(function (b) { b.classList.toggle('active', b === btn); });
                    document.querySelectorAll('[data-att-pane]').forEach(function (p) { p.classList.toggle('d-none', p.getAttribute('data-att-pane') !== tab); });
                });
            });


            // Real figures, serialized once. Anything the app does not record is not
            // charted — see the removed cards above.
            const DASH = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                trend   = Model.Trend.Select(t => new { label = Dates.Show(t.Date, "ddd"), amount = t.Amount }),
                classes = Model.Classes.Select(c => new { name = c.ClassName, students = c.Students }),
                modes   = Model.Modes.Select(m => new { name = m.Mode, amount = m.Amount })
            }));

            const orange = '#ff8a00', green = '#16a34a', red = '#dc2626', amber = '#d97706', blue = '#0284c7';
            const axis = '#a99e90', grid = '#f0e7db';

            function spark(id, color, data) {
                const el = document.querySelector('#' + id);
                if (!el) return;
                new ApexCharts(el, {
                    chart: { type: 'area', height: 55, sparkline: { enabled: true } },
                    series: [{ data: data }],
                    stroke: { curve: 'smooth', width: 2 },
                    fill: { type: 'gradient', gradient: { opacityFrom: .4, opacityTo: .05 } },
                    colors: [color],
                    tooltip: { enabled: false }
                }).render();
            }
            // Only the collection card has real history (the 7-day trend). Student,
            // staff and outstanding totals are not snapshotted anywhere, so their
            // sparklines were pure invention and are gone.
            spark('sparkCollection', blue, DASH.trend.map(function (t) { return t.amount; }));

            // ---- Collection trend ----
            if (document.querySelector('#collectionTrendChart')) {
                new ApexCharts(document.querySelector('#collectionTrendChart'), {
                    chart: { type: 'area', height: 320, toolbar: { show: false }, parentHeightOffset: 0 },
                    // One series: "Due Cleared" was a second invented line.
                    series: [{ name: 'Collected', data: DASH.trend.map(function (t) { return t.amount; }) }],
                    xaxis: { categories: DASH.trend.map(function (t) { return t.label; }), labels: { style: { colors: axis } }, axisBorder: { show: false }, axisTicks: { show: false } },
                    yaxis: { labels: { formatter: v => '₹' + Math.round(v / 1000) + 'k', style: { colors: axis } } },
                    stroke: { curve: 'smooth', width: 3 },
                    colors: [orange, green],
                    dataLabels: { enabled: false },
                    grid: { borderColor: grid, strokeDashArray: 4 },
                    fill: { type: 'gradient', gradient: { opacityFrom: .3, opacityTo: .03 } },
                    markers: { size: 0, hover: { size: 6 } },
                    legend: { position: 'top', horizontalAlign: 'right' },
                    tooltip: { y: { formatter: v => '₹ ' + v.toLocaleString('en-IN') } }
                }).render();
            }

            // ---- Target radial ----


            // ---- Class strength ----
            if (document.querySelector('#classStrengthChart')) {
                new ApexCharts(document.querySelector('#classStrengthChart'), {
                    chart: { type: 'bar', height: 280, toolbar: { show: false } },
                    series: [{ name: 'Students', data: DASH.classes.map(function (c) { return c.students; }) }],
                    plotOptions: { bar: { borderRadius: 5, horizontal: true, barHeight: '60%', distributed: true } },
                    dataLabels: { enabled: true, style: { colors: ['#fff'] } },
                    xaxis: { categories: DASH.classes.map(function (c) { return c.name; }), labels: { style: { colors: axis } } },
                    grid: { borderColor: grid, strokeDashArray: 4 },
                    legend: { show: false },
                    colors: ['#ff8a00', '#ffa733', '#16a34a', '#d97706', '#0284c7', '#9333ea', '#ff5722', '#6b7280']
                }).render();
            }

            // ---- Payment mode donut ----
            if (document.querySelector('#paymentModeChart')) {
                new ApexCharts(document.querySelector('#paymentModeChart'), {
                    chart: { type: 'donut', height: 240 },
                    series: DASH.modes.map(function (m) { return m.amount; }),
                    labels: DASH.modes.map(function (m) { return m.name; }),
                    colors: [green, orange, amber],
                    stroke: { width: 0 },
                    dataLabels: { enabled: false },
                    legend: { show: false },
                    plotOptions: { pie: { donut: { size: '70%', labels: { show: true, value: { fontSize: '1.4rem', fontWeight: 800, color: '#2b1b12' }, total: { show: true, label: 'Total', color: '#8b8175',
                                        formatter: () => '₹' + DASH.modes.reduce(function (a, m) { return a + m.amount; }, 0).toLocaleString('en-IN') } } } } }
                }).render();
            }
        });
    </script>
}
