@using System.Security.Claims
@using EduCoreDataAccessLayer.Helpers
@inject EduCoreDataAccessLayer.Services.IPermissionService PermissionService
@inject EduCoreDataAccessLayer.Services.Contract.ERP.IClassTeacherService ClassTeacherService

@{
    // Multi-role "focus" switch: list the user's roles (only relevant when they hold 2+).
    int _navTId = int.TryParse(User.FindFirst(Common.SK_TenantId)?.Value, out var _nt) ? _nt : 0;
    int _navSId = int.TryParse(User.FindFirst(Common.SK_SchoolId)?.Value, out var _ns) ? _ns : 0;
    int _navUId = int.TryParse(User.FindFirst(Common.SK_UserId)?.Value, out var _nu) ? _nu : 0;
    var switchRoles = await PermissionService.GetUserRolesListAsync(_navTId, _navSId, _navUId);
    int activeRoleId = Context.Session.GetInt32(Common.SK_ActiveRoleId) ?? 0;
    string activeRoleLabel = activeRoleId > 0
        ? (switchRoles.FirstOrDefault(r => r.RoleId == activeRoleId).RoleName ?? "All roles")
        : "All roles";

    var userName = User.FindFirst(Common.SK_UserName)?.Value
                ?? User.Identity?.Name
                ?? "User";
    var email    = User.FindFirst(Common.SK_EmailId)?.Value ?? "";
    var roleCode = User.FindFirst("role_code")?.Value
                ?? User.FindFirst(ClaimTypes.Role)?.Value
                ?? "";
    var roleName = User.FindFirst("role_name")?.Value ?? "";

    // "Class Teacher · Class 3-A" under the name, for a class teacher (cached 5 min).
    string myClasses = "";
    if (_navTId > 1 && _navSId > 0)
    {
        try { myClasses = string.Join(", ", (await ClassTeacherService.GetClassesOfAsync(_navTId, _navSId, _navUId, cached: true)).Select(c => c.Label)); }
        catch { /* the navbar must never fail to render */ }
    }

    string roleLabel = roleCode switch {
        AppRoles.SuperAdmin   => "Super Admin",
        AppRoles.SchoolAdmin  => "School Admin",
        AppRoles.Teacher      => "Teacher",
        AppRoles.Accountant   => "Accountant",
        AppRoles.Receptionist => "Receptionist",
        _                     => string.IsNullOrWhiteSpace(roleName) ? roleCode : roleName
    };

    var parts    = userName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
        : userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
}

@* ── Mobile sidebar toggle — flex-shrink-0 so it never gets squeezed ─ *@
@if (ViewData["navbarHideToggle"] == null)
{
    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none flex-shrink-0">
        <a class="nav-item nav-link px-0" href="javascript:void(0)" aria-label="Toggle navigation menu">
            <i class="icon-base bx bx-menu bx-md" aria-hidden="true"></i>
        </a>
    </div>
}

@* ── Navbar body: fills all remaining horizontal space ────────────────
   flex-grow-1  → expand to fill the navbar after the mobile toggle
   flex-nowrap  → never let children wrap to a second row
   NOTE: no overflow-hidden here — it would clip the open dropdowns. The
   school-identity wrapper below clips/truncates its own text instead.     *@
<div class="navbar-nav-right d-flex align-items-center flex-grow-1 flex-nowrap"
     id="navbar-collapse">

    @* School identity — me-auto pushes the right items to the far end.
       Self-fetching view component (logo/initials + name + address).
       overflow-hidden lets the name/address truncate when space is tight. *@
    <div class="me-auto overflow-hidden ec-navbar-identity">
        @await Component.InvokeAsync("SchoolIdentity")
    </div>

    @* Right items — flex-shrink-0 so bell + avatar are never compressed *@
    <ul class="navbar-nav flex-row align-items-center gap-2 flex-shrink-0">

        @* ── Notifications ────────────────────────────────────────────
           The Notice Board's newest notices with an unread count, filled by
           the small script below from /ERP/Notice/Latest. School users only:
           the platform super admin has no notice board. *@
        @if (_navTId > 1 && _navSId > 0)
        {
        <li class="nav-item dropdown">
            <a class="nav-link p-2 position-relative"
               href="javascript:void(0);"
               data-bs-toggle="dropdown"
               aria-expanded="false"
               aria-label="Notifications">
                <i class="icon-base bx bx-bell bx-sm" aria-hidden="true"></i>
                <span id="navBellCount" class="badge rounded-pill bg-danger position-absolute top-0 end-0 d-none" style="font-size:.6rem"></span>
            </a>

            @* max-width: min(320px, 90vw) stops dropdown overflowing on narrow screens *@
            <div class="dropdown-menu dropdown-menu-end shadow-sm p-0"
                 style="width:320px;max-width:min(320px,90vw);">
                <div class="px-4 py-3 border-bottom">
                    <h6 class="mb-0 fw-semibold">Notices</h6>
                </div>
                <div id="navBellList">
                    <div class="text-center text-muted small px-4 py-4">
                        <i class="bx bx-bell-off d-block mx-auto mb-2" style="font-size:1.75rem;opacity:.35"></i>
                        No notices
                    </div>
                </div>
                <a class="d-block text-center small fw-semibold py-2 border-top" href="@Url.Action("Index", "Notice", new { area = "ERP" })">Open Notice Board</a>
            </div>
        </li>
        <script>
            // Plain JS: jQuery and site.js load after this partial.
            (function () {
                function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
                fetch('@Url.Action("Latest", "Notice", new { area = "ERP" })', { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (d) {
                        if (!d) return;
                        var badge = document.getElementById('navBellCount');
                        if (d.unread > 0) { badge.textContent = d.unread > 9 ? '9+' : d.unread; badge.classList.remove('d-none'); }
                        if (!d.items || !d.items.length) return;
                        document.getElementById('navBellList').innerHTML = d.items.map(function (n) {
                            // A substitute period links to My Timetable; a notice to the board.
                            return '<a class="dropdown-item py-2 text-wrap" href="' + esc(n.url || '@Url.Action("Index", "Notice", new { area = "ERP" })') + '">'
                                 + (n.isNew ? '<span class="badge bg-label-success me-1">New</span>' : '')
                                 + '<span class="fw-semibold">' + esc(n.title) + '</span>'
                                 + '<div class="small text-muted">' + esc(n.category) + ' · ' + esc(n.posted) + '</div></a>';
                        }).join('');
                    })
                    .catch(function () { /* the bell must never break the page */ });
            })();
        </script>
        }

        @* ── User ───────────────────────────────────────────────────── *@
        <li class="nav-item navbar-dropdown dropdown-user dropdown">
            <a class="nav-link dropdown-toggle hide-arrow p-0 ms-1"
               href="javascript:void(0);"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                <div class="avatar avatar-online">
                    <span class="avatar-initial rounded-circle bg-primary">@initials</span>
                </div>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow mt-1 py-0"
                style="min-width:240px;max-width:min(280px,90vw);">
                <li>
                    <div class="d-flex align-items-center gap-3 px-4 py-3 border-bottom">
                        <div class="avatar avatar-online flex-shrink-0" style="width:42px;height:42px;">
                            <span class="avatar-initial rounded-circle bg-primary">@initials</span>
                        </div>
                        <div class="overflow-hidden">
                            <h6 class="mb-1 text-truncate fw-semibold">@userName</h6>
                            @* The platform account is literally named "Super Admin";
                               don't print the role a second time under it. *@
                            @if (!string.Equals(roleLabel, userName.Trim(), StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-label-primary rounded-pill" style="font-size:.65rem;">@roleLabel</span>
                            }
                            @if (myClasses != "")
                            {
                                <small class="d-block text-muted text-truncate mt-1" title="Class teacher of @myClasses"><i class="bx bx-chalkboard me-1"></i>Class Teacher · @myClasses</small>
                            }
                        </div>
                    </div>
                </li>
                @if (!string.IsNullOrWhiteSpace(email))
                {
                    <li>
                        <div class="px-4 py-2 border-bottom">
                            <small class="text-muted d-block" style="font-size:.65rem;text-transform:uppercase;letter-spacing:.04em;">Signed in as</small>
                            <small class="text-truncate d-block fw-medium">@email</small>
                        </div>
                    </li>
                }
                @* ── Switch role (only when the user holds more than one) ───── *@
                @if (switchRoles.Count > 1)
                {
                    <li>
                        <div class="px-4 pt-2 pb-1">
                            <small class="text-muted d-block" style="font-size:.65rem;text-transform:uppercase;letter-spacing:.04em;">Viewing as</small>
                        </div>
                    </li>
                    <li>
                        <form asp-area="" asp-controller="Account" asp-action="SwitchRole" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roleId" value="0" />
                            <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 @(activeRoleId == 0 ? "active fw-semibold" : "")" style="background:none;border:none;cursor:pointer;text-align:left;width:100%;">
                                <i class="icon-base bx bx-layer icon-md"></i>
                                All roles (combined)
                                @if (activeRoleId == 0) { <i class="bx bx-check ms-auto"></i> }
                            </button>
                        </form>
                    </li>
                    @foreach (var r in switchRoles)
                    {
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="SwitchRole" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roleId" value="@r.RoleId" />
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 @(activeRoleId == r.RoleId ? "active fw-semibold" : "")" style="background:none;border:none;cursor:pointer;text-align:left;width:100%;">
                                    <i class="icon-base bx bx-user icon-md"></i>
                                    @r.RoleName
                                    @if (activeRoleId == r.RoleId) { <i class="bx bx-check ms-auto"></i> }
                                </button>
                            </form>
                        </li>
                    }
                    <li><hr class="dropdown-divider my-0"></li>
                }

                <li>
                    <a asp-area="" asp-controller="Account" asp-action="ChangePassword"
                       class="dropdown-item d-flex align-items-center gap-2 py-2">
                        <i class="icon-base bx bx-key icon-md"></i>
                        Change Password
                    </a>
                </li>
                <li><hr class="dropdown-divider my-0"></li>
                <li>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"
                          class="py-1">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger w-100"
                                style="background:none;border:none;cursor:pointer;text-align:left;">
                            <i class="icon-base bx bx-power-off icon-md"></i>
                            Sign Out
                        </button>
                    </form>
                </li>
            </ul>
        </li>

    </ul>
</div>
