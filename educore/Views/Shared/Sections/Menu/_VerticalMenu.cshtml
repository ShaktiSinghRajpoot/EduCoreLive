@using EduCoreDataAccessLayer.Helpers
@using EduCoreDataAccessLayer.Services.Contract.ERP
@using System.Security.Claims
@inject IAdmissionWorkflowService AdmissionWorkflowService
@inject EduCoreDataAccessLayer.Services.IPermissionService PermissionService

@{
    var currentPage = Context.Request.Path.Value ?? "";
    var appName = "EduCore";
    var supportUrl = "#";

    // Identity / scope (hoisted so the permission gating below can reuse them).
    int _tId = int.TryParse(User.FindFirst(Common.SK_TenantId)?.Value, out var _t) ? _t : 0;
    int _sId = int.TryParse(User.FindFirst(Common.SK_SchoolId)?.Value, out var _s) ? _s : 0;
    int _uId = int.TryParse(User.FindFirst(Common.SK_UserId)?.Value, out var _u) ? _u : 0;

    // Per-school module visibility. The Transport menu is hidden for schools that
    // turned the module off in Admission Workflow settings. Defaults to visible if
    // the school scope or settings can't be resolved (matches pre-toggle behaviour).
    bool showTransport = true;
    if (_tId > 1 && _sId > 0)
    {
        try { showTransport = (await AdmissionWorkflowService.GetAdmissionWorkflowAsync(_tId, _sId, _uId)).EnableTransport; }
        catch { showTransport = true; }
    }

    // ── Dynamic RBAC menu gating ──────────────────────────────────────────────
    // Admins (SUPER_ADMIN / SCHOOL_ADMIN) bypass and see everything. Every other
    // user sees only what the UNION of their roles allows. Resolve ONCE per render.
    int _activeRoleId = Context.Session.GetInt32(Common.SK_ActiveRoleId) ?? 0;   // multi-role "focus" (0 = combined)
    var _access = await PermissionService.GetUserAccessAsync(_tId, _sId, _uId, _activeRoleId);
    bool isAdmin = _access.IsAdmin;
    var _perms = _access.Keys;
    bool Can(string key) => isAdmin || _perms.Contains(key);

    // Group visibility (a group shows if the role can reach at least one item).
    bool gFrontOffice = Can("enquiry.view") || Can("registration.view");
    bool gStudents    = Can("students.view");
    bool gAcademics   = Can("academics.view");
    bool gAttendance  = Can("attendance.view");
    bool gExams       = Can("exams.view");
    bool secAcademic  = gFrontOffice || gStudents || gAcademics || gAttendance || gExams;

    bool gFees        = Can("fees.view");
    bool gAccounting  = isAdmin;                       // no permission key yet → admin-only placeholder
    bool secFinance   = gFees || gAccounting;

    bool gHR          = Can("staff.view");
    bool gLibrary     = isAdmin;                       // placeholder module
    bool gTransport   = showTransport && Can("transport.view");
    bool gHostel      = isAdmin;                       // placeholder module
    bool gInventory   = Can("fees.view");             // Inventory has its own controller; still gated by fees.view until inventory.* exists
    bool secPeople    = gHR || gLibrary || gTransport || gHostel || gInventory;

    bool gComm        = isAdmin;                       // placeholder modules
    bool gCert        = isAdmin;
    bool gReports     = isAdmin || Can("reports.view");
    bool secEngagement = gComm || gCert || gReports;

    // School Settings holds every ONE-TIME / per-year setup screen (school profile,
    // academic setup, fee masters, admission workflow, people masters). The group
    // shows if the role can reach ANY of them; each item keeps its own gate below.
    bool gWorkflow    = Can("admission_workflow.view");
    bool gSettings    = Can("settings.view") || Can("rbac.manage") || Can("academics.view")
                        || Can("fees.view")  || Can("staff.view")  || gWorkflow;
    bool gBilling     = isAdmin;                       // placeholder module
    bool secAdmin     = gSettings || gBilling;

    bool IsActive(string value) =>
        currentPage.Contains(value, StringComparison.OrdinalIgnoreCase);

    string Open(params string[] keys) =>
        keys.Any(IsActive) ? "active open" : "";

    string On(string key) => IsActive(key) ? "active" : "";
}


