@using EduCoreDataAccessLayer.Helpers
@using EduCoreDataAccessLayer.Services.Contract.ERP
@using System.Security.Claims
@inject IAdmissionWorkflowService AdmissionWorkflowService
@inject ITransportTrackingService TransportTrackingService
@inject IStaffSelfService StaffSelfService
@inject IHomeworkService HomeworkService
@inject EduCoreDataAccessLayer.Services.IPermissionService PermissionService

@{
    var currentPage = Context.Request.Path.Value ?? "";

    // Identity / scope (hoisted so the permission gating below can reuse them).
    int _tId = int.TryParse(User.FindFirst(Common.SK_TenantId)?.Value, out var _t) ? _t : 0;
    int _sId = int.TryParse(User.FindFirst(Common.SK_SchoolId)?.Value, out var _s) ? _s : 0;
    int _uId = int.TryParse(User.FindFirst(Common.SK_UserId)?.Value, out var _u) ? _u : 0;

    // Per-school module visibility. The Transport menu is hidden for schools that
    // turned the module off in Admission Workflow settings. Defaults to visible if
    // the school scope or settings can't be resolved (matches pre-toggle behaviour).
    // One read, five flags. A module a school turned off is hidden from the menu
    // entirely — that is how a small school keeps a short menu without us
    // guessing what it needs. Defaults to visible if the scope or settings cannot
    // be resolved (matches pre-toggle behaviour).
    bool showTransport = true, showExams = true, showInventory = true, showPayroll = true;
    bool showAttendance = true, showAcademics = true, showFees = true, showAccounts = true;
    bool showRegistration = true;
    if (_tId > 1 && _sId > 0)
    {
        try
        {
            var _mods = await AdmissionWorkflowService.GetAdmissionWorkflowAsync(_tId, _sId, _uId);
            showRegistration = _mods.EnableRegistration;
            showTransport = _mods.EnableTransport;
            showExams     = _mods.EnableExams;
            showInventory = _mods.EnableInventory;
            showPayroll   = _mods.EnablePayroll;
            showAttendance = _mods.EnableAttendance;
            showAcademics = _mods.EnableAcademics;
            showFees      = _mods.EnableFees;
            showAccounts  = _mods.EnableAccounts;
        }
        catch { /* leave everything visible */ }
    }

    // ── Dynamic RBAC menu gating ──────────────────────────────────────────────
    // Admins (SUPER_ADMIN / SCHOOL_ADMIN) bypass and see everything. Every other
    // user sees only what the UNION of their roles allows. Resolve ONCE per render.
    int _activeRoleId = Context.Session.GetInt32(Common.SK_ActiveRoleId) ?? 0;   // multi-role "focus" (0 = combined)
    var _access = await PermissionService.GetUserAccessAsync(_tId, _sId, _uId, _activeRoleId);
    bool isAdmin = _access.IsAdmin;
    var _perms = _access.Keys;
    // The platform super admin (tenant 1) has no school, so none of the school
    // modules apply -- they would open empty or failing pages. They get Schools instead.
    bool isPlatform = _tId == 1;
    bool Can(string key) => !isPlatform && (isAdmin || _perms.Contains(key));

    // Group visibility (a group shows if the role can reach at least one item).
    // Only modules that actually EXIST appear here. Placeholder groups
    // (Accounting, Library, Hostel, Communication, Certificates & ID) and every
    // "soon" stub were removed: half the old menu led nowhere, which is what made
    // it feel complicated. Planned modules are listed on the "What's coming" page
    // instead. To add a module later, gate it here and add its group below.
    // Matches the group's three links: a view-only students role (e.g. Teacher) has
    // none of them, and used to get an empty "Admissions" heading.
    bool gAdmissions  = Can("enquiry.view") || (showRegistration && Can("registration.view")) || Can("students.manage");
    bool gStudents    = Can("students.view");
    bool gAttendance  = showAttendance && Can("attendance.view");
    bool gExams       = showExams && Can("exams.view");
    bool gAcademics   = showAcademics && Can("academics.view");
    bool secAcademic  = gAdmissions || gStudents || gAttendance || gExams || gAcademics;

    bool gFees        = showFees && Can("fees.view");
    // The front desk takes registration fees (fees.collect) without seeing the fee
    // pages; they still close their own cash counter (QA BUG-099).
    bool gDayClose    = gFees || (showFees && Can("fees.collect"));
    bool gExpenses    = showAccounts && Can("expenses.view");   // expenses + cash book
    bool secFinance   = gDayClose || gExpenses;

    bool gStaffDir    = Can("staff.view");
    bool gPayroll     = showPayroll && Can("payroll.view");   // salary has its own key
    bool gStaff       = gStaffDir || gPayroll;
    bool gTransport   = showTransport && Can("transport.view");
    // "My Bus" is for the bus's assigned driver, who usually has no transport
    // permission at all; being the driver is the permission (cached 5 min).
    bool gMyBus = false;
    if (showTransport && _tId > 1 && _sId > 0)
    {
        try { gMyBus = await TransportTrackingService.IsDriverAsync(_tId, _sId, _uId); }
        catch { /* the menu must never fail to render */ }
    }
    // "My Leave" / "My Payslip" are for anyone with a current staff record here,
    // whatever their role; having the staff record is the permission (cached 5 min).
    // Leave and salary both belong to the Payroll module (gMyStaff); My Timetable
    // does not, so the staff record is read whatever the Payroll switch says.
    bool hasStaffRecord = false;
    if (_tId > 1 && _sId > 0)
    {
        try { hasStaffRecord = await StaffSelfService.HasStaffRecordAsync(_tId, _sId, _uId); }
        catch { /* the menu must never fail to render */ }
    }
    bool gMyStaff = showPayroll && hasStaffRecord;
    // My Timetable is for teaching staff (or anyone who has periods); an accountant or
    // clerk has no timetable (cached 5 min).
    bool gMyTimetable = false;
    if (hasStaffRecord && showAcademics)
    {
        try { gMyTimetable = await StaffSelfService.IsTeachingStaffAsync(_tId, _sId, _uId)
                          || await HomeworkService.TeachesAnyClassAsync(_tId, _sId, _uId); }
        catch { /* the menu must never fail to render */ }
    }
    // Homework is for people who teach a class -- not every staff record (cached 5 min).
    bool gTeaches = false;
    if (_tId > 1 && _sId > 0 && showAcademics && !gAcademics)
    {
        try { gTeaches = await HomeworkService.TeachesAnyClassAsync(_tId, _sId, _uId); }
        catch { /* the menu must never fail to render */ }
    }
    bool gInventory  = showInventory && Can("inventory.view");
    bool secPeople    = gStaff || gTransport || gInventory;

    // Setup screens used to sit in ONE 14-item "School Settings" group, which was
    // a dumping ground. Split by what each screen configures, so a role only sees
    // the setup it can actually reach.
    bool gWorkflow    = Can("admission_workflow.view");
    bool gSetupSchool = Can("settings.view") || gWorkflow;   // profile, formats, session, workflow
    bool gSetupAcad   = Can("academics.view");               // classes, subjects (+ periods, Smart Bell with Academics)
    bool gSetupFees   = showFees && Can("fees.view");        // fee heads & structure
    bool gSetupUsers  = Can("rbac.manage") || Can("staff.view");
    bool secAdmin     = gSetupSchool || gSetupAcad || gSetupFees || gSetupUsers;

    bool IsActive(string value) =>
        currentPage.Contains(value, StringComparison.OrdinalIgnoreCase);

    string Open(params string[] keys) =>
        keys.Any(IsActive) ? "active open" : "";

    string On(string key) => IsActive(key) ? "active" : "";
}


<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">

    <div class='app-brand demo @((ViewData["navbarFull"] != null && Convert.ToBoolean(ViewData["navbarFull"])) ? "d-xl-none" : "")'>
        <a asp-area="" asp-controller="Dashboards" asp-action="Index" class="app-brand-link">
            <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
            @* Set as text, not the wordmark image: at sidebar size the logo's
               "MANAGE · AUTOMATE · EMPOWER" tagline would be unreadable mush.
               menu.css paints this span with the orange brand gradient. *@
            <span class="app-brand-text demo menu-text ms-2 ssw-brand-text">SmartSchoolWala.com</span>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
            <i class="icon-base bx bx-chevron-left d-block d-xl-none align-middle"></i>
        </a>
    </div>

    <div class="sidebar-search"><input type="text" placeholder="Search menu..." /></div>
    <div class="menu-inner-shadow"></div>

    @* menu.js binds PerfectScrollbar to .menu-inner — without this element the
       sidebar cannot scroll and the menu search matches nothing. *@
    <ul class="menu-inner py-1">

        @* Shown by the menu filter below when the search matches nothing. *@
        <li class="menu-search-empty text-muted small px-4 py-3" style="display:none">No menu items match.</li>

        @*
           ============================================================
           Every link here points at a real controller action. There are no
           "soon" placeholders — planned modules live on the What's coming page
           (More → What's coming) so navigation only ever shows working screens.
           Order is roughly how often a school touches something.
           ============================================================
        *@

        @* ===================== MAIN ===================== *@
        @* The platform super admin has no dashboard of their own (Dashboards just
           redirects them to the Schools list), so they get no "Dashboard" item. *@
        @if (!isPlatform)
        {
        <li class='menu-item @On("Dashboards")'>
            <a asp-area="" asp-controller="Dashboards" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-home-smile ic-dash"></i>
                <div class="text-truncate">Dashboard</div>
            </a>
        </li>
        <li class='menu-item @On("ERP/Notice")'>
            <a asp-area="ERP" asp-controller="Notice" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-broadcast ic-dash"></i>
                <div class="text-truncate">Notice Board</div>
            </a>
        </li>
        }
        @if (Can("notices.manage"))
        {
        @* every WhatsApp message to parents (absent alerts, fee reminders, notices) *@
        <li class='menu-item @On("MessageLog")'>
            <a asp-area="ERP" asp-controller="MessageLog" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bxl-whatsapp ic-dash"></i>
                <div class="text-truncate">Message Log</div>
            </a>
        </li>
        }

        @* Teachers (a class on the timetable, or a class teacher) give homework;
           academics.view sees all of it. Other staff (accountant, clerk) do not. *@
        @if (gTeaches || gAcademics)
        {
        <li class='menu-item @On("ERP/Homework")'>
            <a asp-area="ERP" asp-controller="Homework" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-book-open ic-hr"></i>
                <div class="text-truncate">Homework</div>
            </a>
        </li>
        }

        @if (isPlatform)
        {
        <li class="menu-header"><span class="menu-header-text">Platform</span></li>
        <li class='menu-item @On("Schools/SchoolList")'>
            <a asp-area="SuperAdmin" asp-controller="Schools" asp-action="SchoolList" class="menu-link">
                <i class="menu-icon icon-base bx bx-buildings ic-dash"></i>
                <div class="text-truncate">Schools</div>
            </a>
        </li>
        <li class='menu-item @On("Schools/Create")'>
            <a asp-area="SuperAdmin" asp-controller="Schools" asp-action="Create" class="menu-link">
                <i class="menu-icon icon-base bx bx-plus-circle ic-dash"></i>
                <div class="text-truncate">Add School</div>
            </a>
        </li>
        }

        @if (gMyBus)
        {
        <li class='menu-item @On("MyBus")'>
            <a asp-area="ERP" asp-controller="MyBus" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-bus ic-bus"></i>
                <div class="text-truncate">My Bus</div>
            </a>
        </li>
        }

        @if (gMyTimetable)
        {
        <li class='menu-item @On("MyTimetable")'>
            <a asp-area="ERP" asp-controller="MyTimetable" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-time-five ic-hr"></i>
                <div class="text-truncate">My Timetable</div>
            </a>
        </li>
        }
        @if (hasStaffRecord)
        {
        @* attendance is not part of the Payroll module: anyone with a staff record *@
        <li class='menu-item @On("MyAttendance")'>
            <a asp-area="ERP" asp-controller="MyAttendance" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-user-check ic-hr"></i>
                <div class="text-truncate">My Attendance</div>
            </a>
        </li>
        }
        @if (gMyStaff)
        {
        <li class='menu-item @On("MyLeave")'>
            <a asp-area="ERP" asp-controller="MyLeave" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-calendar-minus ic-hr"></i>
                <div class="text-truncate">My Leave</div>
            </a>
        </li>
        <li class='menu-item @On("MyPayslip")'>
            <a asp-area="ERP" asp-controller="MyPayslip" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-receipt ic-hr"></i>
                <div class="text-truncate">My Payslip</div>
            </a>
        </li>
        }
        @if (!isPlatform)
        {
        @* holidays, exams and events: every member of staff sees it, academics.manage edits it *@
        <li class='menu-item @On("SchoolCalendar")'>
            <a asp-area="ERP" asp-controller="SchoolSettings" asp-action="SchoolCalendar" class="menu-link">
                <i class="menu-icon icon-base bx bx-calendar-event ic-hr"></i>
                <div class="text-truncate">School Calendar</div>
            </a>
        </li>
        }

        @* ===================== ACADEMIC ===================== *@
        @if (secAcademic)
        {
        <li class="menu-header"><span class="menu-header-text">Academic</span></li>
        }

        @* ---- Admissions: the funnel, in the order it happens ---- *@
        @if (gAdmissions)
        {
        <li class='menu-item @Open("EnquiryCRM","Registration","Admission/Create","FrontOffice")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-buildings ic-front"></i>
                <div class="text-truncate">Admissions</div>
            </a>
            <ul class="menu-sub">
                @if (Can("enquiry.view"))
                {
                <li class='menu-item @On("EnquiryCRM")'><a asp-area="ERP" asp-controller="Enquiry" asp-action="EnquiryCRM" class="menu-link"><i class="bx bx-message-square-detail submenu-icon c-pink"></i><div class="text-truncate">Enquiries</div><span class="ec-badge ec-badge-hot">CRM</span></a></li>
                <li class='menu-item @On("FrontOffice")'><a asp-area="ERP" asp-controller="FrontOffice" asp-action="Index" class="menu-link"><i class="bx bx-buildings submenu-icon c-teal"></i><div class="text-truncate">Front Office</div></a></li>
                }
                @if (showRegistration && Can("registration.view"))
                {
                <li class='menu-item @On("Registration")'><a asp-area="ERP" asp-controller="Registration" asp-action="Index" class="menu-link"><i class="bx bx-clipboard submenu-icon c-orange"></i><div class="text-truncate">Registrations</div></a></li>
                }
                @* Admitting writes a student (students.manage); a view-only role used to see
                   this link and then could not save the form. *@
                @if (Can("students.manage"))
                {
                <li class='menu-item @On("Admission/Create")'><a asp-area="ERP" asp-controller="Admission" asp-action="Create" class="menu-link"><i class="bx bx-user-plus submenu-icon c-green"></i><div class="text-truncate">New Admission</div></a></li>
                }
            </ul>
        </li>
        }

        @* ---- Students ---- *@
        @if (gStudents)
        {
        <li class='menu-item @Open("StudentList","EditStudent","Promotion","Student/Inactive","Tc/Register","IdCard","ERP/Certificate","DataChecks")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-user-plus ic-students"></i>
                <div class="text-truncate">Students</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item @On("StudentList")'><a asp-area="ERP" asp-controller="Student" asp-action="StudentList" class="menu-link"><i class="bx bx-group submenu-icon c-blue"></i><div class="text-truncate">Student Directory</div></a></li>
                @if (showInventory && !Can("inventory.view"))
                {
                @* class teachers: who in my class has the books / uniform (store staff find it under Inventory) *@
                <li class='menu-item @On("StoreRegister")'><a asp-area="ERP" asp-controller="StoreRegister" asp-action="Index" class="menu-link"><i class="bx bx-check-square submenu-icon c-green"></i><div class="text-truncate">Books &amp; Uniform Register</div></a></li>
                }
                @if (Can("students.manage"))
                {
                <li class='menu-item @On("Promotion")'><a asp-area="ERP" asp-controller="Student" asp-action="Promotion" class="menu-link"><i class="bx bx-up-arrow-circle submenu-icon c-orange"></i><div class="text-truncate">Promote Students</div></a></li>
                }
                <li class='menu-item @On("PromoteHistory")'><a asp-area="ERP" asp-controller="Student" asp-action="PromoteHistory" class="menu-link"><i class="bx bx-history submenu-icon c-blue"></i><div class="text-truncate">Promotion History</div></a></li>
                <li class='menu-item @On("Student/Inactive")'><a asp-area="ERP" asp-controller="Student" asp-action="Inactive" class="menu-link"><i class="bx bx-user-x submenu-icon c-red"></i><div class="text-truncate">Inactive / Left</div></a></li>
                <li class='menu-item @On("Tc/Register")'><a asp-area="ERP" asp-controller="Tc" asp-action="Register" class="menu-link"><i class="bx bx-award submenu-icon c-teal"></i><div class="text-truncate">TC Register</div></a></li>
                <li class='menu-item @On("ERP/Certificate")'><a asp-area="ERP" asp-controller="Certificate" asp-action="Index" class="menu-link"><i class="bx bx-certification submenu-icon c-orange"></i><div class="text-truncate">Certificates</div></a></li>
                <li class='menu-item @On("IdCard")'><a asp-area="ERP" asp-controller="IdCard" asp-action="Index" class="menu-link"><i class="bx bx-id-card submenu-icon c-purple"></i><div class="text-truncate">ID Cards</div></a></li>
                <li class='menu-item @On("DataChecks")'><a asp-area="ERP" asp-controller="DataChecks" asp-action="Index" class="menu-link"><i class="bx bx-check-shield submenu-icon c-green"></i><div class="text-truncate">Data Checks</div></a></li>
            </ul>
        </li>
        }

        @* ---- Attendance ---- *@
        @if (gAttendance)
        {
        <li class='menu-item @Open("StudentAttendance","AttendanceReport","AttendanceOverview")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-user-check ic-att"></i>
                <div class="text-truncate">Attendance</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item @On("StudentAttendance")'><a asp-area="ERP" asp-controller="Attendance" asp-action="StudentAttendance" class="menu-link"><i class="bx bx-user-check submenu-icon c-green"></i><div class="text-truncate">Mark Attendance</div></a></li>
                <li class='menu-item @On("AttendanceReport")'><a asp-area="ERP" asp-controller="Attendance" asp-action="AttendanceReport" class="menu-link"><i class="bx bx-bar-chart submenu-icon c-purple"></i><div class="text-truncate">Attendance Reports</div></a></li>
                @if (Can("reports.view"))
                {
                <li class='menu-item @On("AttendanceOverview")'><a asp-area="ERP" asp-controller="AttendanceOverview" asp-action="Index" class="menu-link"><i class="bx bx-pie-chart-alt-2 submenu-icon c-orange"></i><div class="text-truncate">Overview</div></a></li>
                }
            </ul>
        </li>
        }

        @* ---- Examinations ---- *@
        @if (gExams)
        {
        <li class='menu-item @Open("CreateExam","Datesheet","AdmitCard","MarkEntry","ResultSheet","GradeScale","ReportCard")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-file ic-exam"></i>
                <div class="text-truncate">Examinations</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item @On("CreateExam")'><a asp-area="ERP" asp-controller="Exam" asp-action="CreateExam" class="menu-link"><i class="bx bx-calendar-event submenu-icon c-red"></i><div class="text-truncate">Exam Schedule</div></a></li>
                <li class='menu-item @On("Datesheet")'><a asp-area="ERP" asp-controller="Exam" asp-action="Datesheet" class="menu-link"><i class="bx bx-calendar submenu-icon c-teal"></i><div class="text-truncate">Datesheet</div></a></li>
                <li class='menu-item @On("AdmitCard")'><a asp-area="ERP" asp-controller="AdmitCard" asp-action="Index" class="menu-link"><i class="bx bx-id-card submenu-icon c-blue"></i><div class="text-truncate">Admit Cards</div></a></li>
                <li class='menu-item @On("MarkEntry")'><a asp-area="ERP" asp-controller="Exam" asp-action="MarkEntry" class="menu-link"><i class="bx bx-edit submenu-icon c-purple"></i><div class="text-truncate">Marks Entry</div></a></li>
                <li class='menu-item @On("ResultSheet")'><a asp-area="ERP" asp-controller="Exam" asp-action="ResultSheet" class="menu-link"><i class="bx bx-table submenu-icon c-green"></i><div class="text-truncate">Result Sheet</div></a></li>
                <li class='menu-item @On("ReportCard")'><a asp-area="ERP" asp-controller="ReportCard" asp-action="Index" class="menu-link"><i class="bx bx-spreadsheet submenu-icon c-blue"></i><div class="text-truncate">Report Cards</div></a></li>
                <li class='menu-item @On("GradeScale")'><a asp-area="ERP" asp-controller="Exam" asp-action="GradeScale" class="menu-link"><i class="bx bx-award submenu-icon c-orange"></i><div class="text-truncate">Grade Scale</div></a></li>
            </ul>
        </li>
        }

        @* ---- Timetable: a single screen, so a direct link beats a group of one ---- *@
        @if (gAcademics)
        {
        <li class='menu-item @On("SchoolSettings/Timetable")'>
            <a asp-area="ERP" asp-controller="SchoolSettings" asp-action="Timetable" class="menu-link">
                <i class="menu-icon icon-base bx bx-time-five ic-academic"></i>
                <div class="text-truncate">Timetable</div>
            </a>
        </li>
        }

        @* ===================== FINANCE ===================== *@
        @if (secFinance)
        {
        <li class="menu-header"><span class="menu-header-text">Finance</span></li>
        }

        @if (gDayClose)
        {
        <li class='menu-item @Open("ManageFee","FeeDueReminders","Fee/Reports","DayClose","Fee/YearEnd","FeeDashboard")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-wallet ic-fees"></i>
                <div class="text-truncate">Fees</div>
            </a>
            <ul class="menu-sub">
                @* Fee Heads / Fee Structure are one-time setup → School Settings. *@
                @if (gFees)
                {
                <li class='menu-item @On("FeeDashboard")'><a asp-area="ERP" asp-controller="FeeDashboard" asp-action="Index" class="menu-link"><i class="bx bx-line-chart submenu-icon c-orange"></i><div class="text-truncate">Fee Dashboard</div></a></li>
                <li class='menu-item @On("ManageFee")'><a asp-area="ERP" asp-controller="Fee" asp-action="ManageFee" class="menu-link"><i class="bx bx-money submenu-icon c-green"></i><div class="text-truncate">Collect Fees</div></a></li>
                <li class='menu-item @On("FeeDues")'><a asp-area="ERP" asp-controller="FeeDues" asp-action="Index" class="menu-link"><i class="bx bx-calendar-exclamation submenu-icon c-red"></i><div class="text-truncate">Month-wise Dues</div></a></li>
                }
                <li class='menu-item @On("DayClose")'><a asp-area="ERP" asp-controller="DayClose" asp-action="Index" class="menu-link"><i class="bx bx-lock-alt submenu-icon c-teal"></i><div class="text-truncate">Day Close</div></a></li>
                @if (gFees)
                {
