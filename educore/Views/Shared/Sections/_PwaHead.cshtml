@{
    // Branding / PWA head tags for SmartSchoolWala.com. Kept out of the master
    // layout because the iOS launch-screen list is long and never changes.
    string appName = TempData.Peek("appName") as string ?? "SmartSchoolWala.com";
}

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="~/img/favicon/favicon.ico" />
<link rel="icon" type="image/png" sizes="256x256" href="~/img/favicon/favicon-256.png" />

<!-- PWA.
     asp-append-version matters here: browsers cache manifest.json hard, so after
     the EduCore -> SmartSchoolWala rename an installed app kept showing the OLD
     name. The ?v= hash changes whenever the file changes, forcing a re-read. -->
<link rel="manifest" href="~/manifest.json" asp-append-version="true" />
<meta name="theme-color" content="#FF8A00" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="application-name" content="@appName" />

<!-- iOS home-screen app. The title is the SHORT name on purpose: iOS truncates
     the home-screen label at ~12 characters, so ".com" would be cut anyway. -->
<link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="SmartSchoolWala" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

