@inject Microsoft.Extensions.Options.IOptions<educore.Services.SupportSettings> SupportOptions
@{
    Layout = null;

    // Contact details come from the "Support" section of appsettings.json (Support__* env vars
    // override them), the same ones the "school unavailable" page shows.
    var support = SupportOptions.Value;
    string waText = "Hello, I would like a free demo of SmartSchoolWala for my school.";
    string waLink = string.IsNullOrWhiteSpace(support.WhatsApp) ? "" : "https://wa.me/" + support.WhatsApp + "?text=" + Uri.EscapeDataString(waText);
    string telLink = "tel:" + new string((support.Phone ?? "").Where(c => char.IsDigit(c) || c == '+').ToArray());
    string loginUrl = Url.Action("Login", "Account", new { area = "" })!;
    int year = DateTime.Now.Year;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SmartSchoolWala.com | School management software for Indian schools</title>
    <meta name="description" content="SmartSchoolWala runs your whole school in one place: admissions, fees and receipts, attendance with WhatsApp alerts, exams and report cards, timetable, staff salary, transport and the school store. Book a free demo." />
    <meta property="og:title" content="SmartSchoolWala.com | School management software for Indian schools" />
    <meta property="og:description" content="Fees, attendance, exams, staff and more: one simple system for your whole school. Book a free demo." />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/brand/ssw-stacked.png")" />
    <meta name="theme-color" content="#0B0705" />
    <link rel="icon" type="image/x-icon" href="~/img/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site/home.css" asp-append-version="true" />
</head>
<body>

<!-- ───────────── Top bar ───────────── -->
<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="/" class="nav-logo" aria-label="SmartSchoolWala.com home">
      <img src="~/img/brand/ssw-icon.svg" alt="" /><span>SmartSchool<b>Wala</b></span>
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="#roles">Who it is for</a>
      <a href="#modules">Features</a>
      <a href="#start">Getting started</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="nav-cta">
      <a href="@loginUrl" class="btn btn-login"><i class="bx bx-lock-alt"></i>Login</a>
      <a href="#contact" class="btn btn-primary nav-demo">Book a free demo</a>
      <button class="nav-burger" id="navBurger" aria-label="Open menu"><i class="bx bx-menu"></i></button>
    </div>
  </div>
</header>

<!-- ───────────── Hero: the school in pieces, put together as you scroll ─────────────
     Plain HTML/CSS pieces (a register, a receipt, an ID card, a report card, the bus, the
     timetable, coins, a WhatsApp message) lie scattered around a closed laptop. home.js
     (GSAP ScrollTrigger) opens the laptop and flies each piece to its place on the screen,
     where it turns into a dashboard tile. The section is tall and the stage sticks meanwhile.
     Without the script (or with reduced motion) the stage is a normal hero: text + the
     finished laptop. Figures are sample data. -->
<section class="build" id="build">
  <div class="build-stage">

    <div class="scene" aria-hidden="true">
      <div class="lap" id="lap">
        <div class="lid" id="lid">
          <div class="screen">
            <div class="scr-off"></div>
            <aside class="scr-side">
              <img src="~/img/brand/ssw-icon.svg" alt="" />
              <i></i><i></i><i></i><i></i><i></i>
            </aside>
            <div class="scr-main">
              <div class="scr-hi"><b>Good morning, Principal</b><small>Today at a glance</small></div>
              <div class="slots">

                <div class="pc p-id" data-at="12,26" data-r="-18">
                  <div class="obj idcard"><span class="ph"></span><b>STUDENT ID</b><i></i><i></i><em>2026-27</em></div>
                  <div class="tile"><small>Students</small><b>1,240</b><span>+38 this session</span></div>
                </div>

                <div class="pc p-reg" data-at="87,24" data-r="14">
                  <div class="obj register"><b>ATTENDANCE<br />REGISTER</b><small>Class 5-A · 2026-27</small></div>
                  <div class="tile"><small>Present today</small><b>96.4%</b><span>1,195 marked</span></div>
                </div>

                <div class="pc p-rcpt" data-at="10,72" data-r="12">
                  <div class="obj receipt"><b>FEE RECEIPT</b><i></i><i></i><i></i><em>₹ 8,200</em><span class="paid">PAID</span></div>
                  <div class="tile"><small>Fees today</small><b>₹1,86,400</b><span>74 receipts</span></div>
                </div>

                <div class="pc p-coins" data-at="30,88" data-r="-10">
                  <div class="obj coins"><span>₹</span><span>₹</span><span>₹</span></div>
                  <div class="tile chart"><small>Fee collection · Apr–Oct</small><div class="bars"><i style="--h:55%"></i><i style="--h:42%"></i><i style="--h:50%"></i><i style="--h:66%"></i><i style="--h:54%"></i><i style="--h:72%"></i><i class="hl" style="--h:90%"></i></div></div>
                </div>

                <div class="pc p-tt" data-at="72,88" data-r="-8">
                  <div class="obj timetable"><b>TIME TABLE</b><div class="tt-grid">@for (int i = 0; i < 12; i++) { <i></i> }</div></div>
                  <div class="tile"><small>Timetable</small><b>No clashes</b><span>3 substitutes today</span></div>
                </div>

                <div class="pc p-rc" data-at="89,72" data-r="16">
                  <div class="obj reportcard"><b>REPORT CARD</b><i></i><i></i><i></i><em>A+</em></div>
                  <div class="tile"><small>Results</small><b>Published</b><span>Half yearly · 312 cards</span></div>
                </div>

                <div class="pc p-bus" data-at="50,15" data-r="-6">
                  <div class="obj bus2"><i class="bx bx-bus-school"></i></div>
                  <div class="tile"><small>Transport</small><b>6 routes</b><span>418 riders on board</span></div>
                </div>

              </div>
            </div>
            <div class="pc p-wa" data-at="88,48" data-r="8">
              <div class="obj wa"><i class="bx bxl-whatsapp"></i><div><b>Absent alert sent</b><small>Parents of 12 students</small></div></div>
            </div>
          </div>
        </div>
        <div class="base"></div>
      </div>
    </div>

    <div class="cap cap-1" data-from="0" data-to="0.18">
      <span class="pill"><span class="dot"></span>School ERP made for Indian schools</span>
      <h2 class="cap-big">Registers. Receipts.<br />Fee slips. Report cards.<br /><span class="grad">All over the place?</span></h2>
      <p class="cap-hint"><span class="mouse"><span></span></span>Scroll to put your school together</p>
    </div>
    <div class="cap cap-2" data-from="0.22" data-to="0.46">
      <h2 class="cap-mid">Every piece of your school&hellip;</h2>
    </div>
    <div class="cap cap-3" data-from="0.5" data-to="0.74">
      <h2 class="cap-mid">&hellip;snaps into <span class="grad">one system.</span></h2>
    </div>

    <div class="cap cap-final" data-from="0.8" data-to="9">
      <span class="pill"><span class="dot"></span>SmartSchoolWala.com</span>
      <h1 class="hero-h">Your whole school.<br /><span class="grad">One smart system.</span></h1>
      <p class="lead">Admissions, fees and receipts, attendance with WhatsApp alerts, exams and report cards, staff salary, transport and the school store. On the computer and on the phone.</p>
      <div class="hero-btns">
        <a href="#contact" class="btn btn-primary btn-lg">Book a free demo<i class="bx bx-right-arrow-alt"></i></a>
        <a href="@loginUrl" class="btn btn-glass btn-lg"><i class="bx bx-lock-alt"></i>Login to your school</a>
      </div>
      <ul class="hero-ticks">
        <li><i class="bx bx-check"></i>Your data brought in from Excel</li>
        <li><i class="bx bx-check"></i>Staff trained by us</li>
        <li><i class="bx bx-check"></i>Works on any phone</li>
      </ul>
    </div>
  </div>
</section>

<!-- ───────────── Trust strip ───────────── -->
<section class="strip-sec">
  <div class="wrap strip">
    <div><i class="bx bx-rupee"></i><span><b>Fees in ₹</b>A4, A5 and thermal receipts</span></div>
    <div><i class="bx bxl-whatsapp"></i><span><b>WhatsApp alerts</b>to parents, from the school</span></div>
    <div><i class="bx bx-mobile-alt"></i><span><b>Works on any phone</b>install it like an app</span></div>
    <div><i class="bx bx-shield-quarter"></i><span><b>Your data stays yours</b>each school kept separate</span></div>
  </div>
</section>

<!-- ───────────── Who it is for ───────────── -->
<section class="sec" id="roles">
  <div class="wrap">
    <div class="sec-head" data-up>
      <span class="kicker">Who it is for</span>
      <h2>One system. Everyone in the school sees what they need.</h2>
      <p>The owner sees the money, the principal sees the school, the office gets the daily work done, and nobody sees what is not theirs.</p>
    </div>
    <div class="roles">
      <article class="role" data-up>
        <span class="role-ic"><i class="bx bx-line-chart"></i></span>
        <h3>For the owner &amp; management</h3>
        <ul>
          <li><i class="bx bx-check"></i>Today's fee collection and pending dues, on your phone</li>
          <li><i class="bx bx-check"></i>Every receipt numbered; a cancellation needs a reason</li>
          <li><i class="bx bx-check"></i>Day close shows what each counter collected</li>
          <li><i class="bx bx-check"></i>Expenses and cash book beside the fee income</li>
          <li><i class="bx bx-check"></i>Staff salary worked out from attendance and leave</li>
        </ul>
      </article>
      <article class="role role-mid" data-up>
        <span class="role-ic"><i class="bx bx-medal"></i></span>
        <h3>For the principal</h3>
        <ul>
          <li><i class="bx bx-check"></i>Attendance of the whole school, class by class, today</li>
          <li><i class="bx bx-check"></i>Marks, grades, ranks and printed report cards</li>
          <li><i class="bx bx-check"></i>Timetable without clashes, substitutes for absent teachers</li>
          <li><i class="bx bx-check"></i>Notices to staff and parents, school calendar</li>
          <li><i class="bx bx-check"></i>Roles: each teacher and clerk sees only their part</li>
        </ul>
      </article>
      <article class="role" data-up>
        <span class="role-ic"><i class="bx bx-receipt"></i></span>
        <h3>For the office &amp; accounts</h3>
        <ul>
          <li><i class="bx bx-check"></i>Enquiry, registration and admission in one flow</li>
          <li><i class="bx bx-check"></i>Collect fees and print the receipt in seconds</li>
          <li><i class="bx bx-check"></i>TC, bonafide and character certificates with seal</li>
          <li><i class="bx bx-check"></i>ID cards, admit cards, transport and the store</li>
          <li><i class="bx bx-check"></i>Your old records brought in from Excel</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<!-- ───────────── Features / modules ───────────── -->
<section class="sec sec-soft" id="modules">
  <div class="wrap">
    <div class="sec-head" data-up>
      <span class="kicker">Features</span>
      <h2>Everything a school runs on</h2>
      <p>Start with what you need most. Add the rest when you are ready; a module you do not use never gets in the way.</p>
    </div>
    <div class="mods">
      <article class="mod" data-up><span class="mi"><i class="bx bx-user-plus"></i></span><h3>Admissions</h3><p>Enquiry, follow-ups, registration and admission. Admission form, documents and ID cards.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-wallet"></i></span><h3>Fees &amp; receipts</h3><p>Fee structure per class, counter collection, concessions, month-wise dues and reminders.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-calendar-check"></i></span><h3>Attendance</h3><p>Marked on the phone in seconds. Parents of absent children get a WhatsApp message.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-medal"></i></span><h3>Exams &amp; results</h3><p>Datesheet, admit cards, marks by subject teacher, grades, ranks and report cards.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-time-five"></i></span><h3>Timetable &amp; homework</h3><p>Clash-free timetable, substitutes, the school bell, and homework with who did it.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-group"></i></span><h3>Staff &amp; salary</h3><p>Staff records, staff attendance, leave, monthly salary and payslips on the phone.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-bus"></i></span><h3>Transport</h3><p>Routes, stops and riders; the transport fee is added to the child's fees.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-package"></i></span><h3>School store</h3><p>Books, uniform and stationery: purchase, stock, issue to students, sale receipts.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-spreadsheet"></i></span><h3>Accounts</h3><p>Expenses by category and a cash book next to your fee collection.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-certification"></i></span><h3>Certificates &amp; TC</h3><p>Transfer, bonafide and character certificates with the school's seal and signature.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-bell"></i></span><h3>Notices &amp; calendar</h3><p>Notice board for staff and parents; holidays and events on the calendar.</p></article>
      <article class="mod" data-up><span class="mi"><i class="bx bx-lock-alt"></i></span><h3>Roles &amp; permissions</h3><p>Principal, accountant, teacher, front desk: each sees only what their job needs.</p></article>
    </div>
  </div>
</section>

<!-- ───────────── Why us ───────────── -->
<section class="sec" id="why">
  <div class="wrap why">
    <div class="why-text" data-up>
      <span class="kicker">Why SmartSchoolWala</span>
      <h2>Built the way a real school office works</h2>
      <p>We sat with school offices before writing a line: how fees are collected at the counter, how a class teacher marks attendance between periods, how results go out. The software follows that, so your staff do not have to change how they work.</p>
    </div>
    <div class="why-grid">
      <div class="why-card" data-up><i class="bx bx-mobile-alt"></i><h3>Phone first</h3><p>Teachers mark attendance and enter marks from their phone.</p></div>
      <div class="why-card" data-up><i class="bx bxl-whatsapp"></i><h3>Parents stay informed</h3><p>Absent alerts, fee reminders and notices on WhatsApp.</p></div>
      <div class="why-card" data-up><i class="bx bx-shield-quarter"></i><h3>Safe and private</h3><p>Each school's data is kept apart; photos open only for your staff.</p></div>
      <div class="why-card" data-up><i class="bx bx-support"></i><h3>We stay with you</h3><p>Setup, training and a phone call away when your office needs help.</p></div>
    </div>
  </div>
</section>

<!-- ───────────── Getting started ───────────── -->
<section class="sec sec-soft" id="start">
  <div class="wrap">
    <div class="sec-head" data-up>
      <span class="kicker">Getting started</span>
      <h2>From your registers to live in days, not months</h2>
      <p>No need to type every student again. We bring your existing data over and stay with you until your office is comfortable.</p>
    </div>
    <ol class="steps">
      <li data-up><span>1</span><h3>Free demo</h3><p>We show you the system with a sample school, on a call or at your school.</p></li>
      <li data-up><span>2</span><h3>Your data comes in</h3><p>Students, staff and old dues imported from Excel, checked row by row.</p></li>
      <li data-up><span>3</span><h3>Setup &amp; training</h3><p>Classes, fee structure and timetable set up together; your staff trained.</p></li>
      <li data-up><span>4</span><h3>Go live</h3><p>Start collecting fees and marking attendance. We are a call away.</p></li>
    </ol>
  </div>
</section>

<!-- ───────────── FAQ ───────────── -->
<section class="sec" id="faq">
  <div class="wrap faq-wrap">
    <div class="sec-head left" data-up>
      <span class="kicker">FAQ</span>
      <h2>Questions schools ask us</h2>
      <p>Anything else? Ask us on the demo call, or call @support.Name directly.</p>
    </div>
    <div class="faq">
      <details><summary>How much does it cost?<i class="bx bx-plus"></i></summary><p>The price depends on the number of students and the modules your school takes. Book a free demo and we will send a quote for your school.</p></details>
      <details><summary>Do we need to install anything?<i class="bx bx-plus"></i></summary><p>No. It opens in the browser on any computer or phone. On a phone it can be added to the home screen and used like an app.</p></details>
      <details><summary>We already have our data in Excel. Do we type it again?<i class="bx bx-plus"></i></summary><p>No. Students, staff and previous dues are imported from Excel. Every row is checked first, and nothing is saved until you confirm.</p></details>
      <details><summary>Can a teacher see fees or salaries?<i class="bx bx-plus"></i></summary><p>Only if you allow it. Every role has its own permissions: a teacher sees their classes, the accountant sees fees, and salary stays with whoever you choose.</p></details>
      <details><summary>Is our data safe?<i class="bx bx-plus"></i></summary><p>Each school's data is kept separate from every other school's. Photos and documents open only for your signed-in staff, and every receipt records who collected it.</p></details>
      <details><summary>Can we start with only fees and add the rest later?<i class="bx bx-plus"></i></summary><p>Yes. Modules are switched on per school, so you can begin with what you need most and add others whenever you are ready.</p></details>
    </div>
  </div>
</section>

<!-- ───────────── Contact + demo form ─────────────
     The form posts to /enquiry (SiteController); the Super Admin sees it under
     Platform > Website Enquiries. "website" is a hidden trap field for bots. -->
<section class="sec contact-sec" id="contact">
  <div class="wrap contact">
    <div class="contact-info" data-up>
      <span class="kicker kicker-l">Book a free demo</span>
      <h2>See it with your own school's work</h2>
      <p>Tell us a little about your school. We will call you within one working day and fix a time that suits your office.</p>
      <div class="person">
        <span class="avatar">@(string.IsNullOrWhiteSpace(support.Name) ? "S" : support.Name.Substring(0, 1))</span>
        <div><b>@support.Name</b><small>SmartSchoolWala.com</small></div>
      </div>
      <ul class="contact-list">
        @if (!string.IsNullOrWhiteSpace(support.Phone))
        {
          <li><i class="bx bx-phone"></i><a href="@telLink">@support.Phone</a></li>
        }
        @if (waLink.Length > 0)
        {
          <li><i class="bx bxl-whatsapp"></i><a href="@waLink" target="_blank" rel="noopener">Chat on WhatsApp</a></li>
        }
        @if (!string.IsNullOrWhiteSpace(support.Email))
        {
          <li><i class="bx bx-envelope"></i><a href="mailto:@support.Email">@support.Email</a></li>
        }
        @if (!string.IsNullOrWhiteSpace(support.Hours))
        {
          <li><i class="bx bx-time-five"></i><span>@support.Hours</span></li>
        }
      </ul>
    </div>

    <form class="enq" id="enqForm" method="post" action="/enquiry" novalidate data-up>
      @Html.AntiForgeryToken()
      <div class="enq-grid">
        <label>Your name *<input name="Name" maxlength="100" required autocomplete="name" /></label>
        <label>You are
          <select name="Designation">
            <option>Owner / Director</option>
            <option>Principal</option>
            <option>Administrator</option>
            <option>Accountant</option>
            <option>Other</option>
          </select>
        </label>
        <label class="full">School name *<input name="School" maxlength="150" required autocomplete="organization" /></label>
        <label>City<input name="City" maxlength="80" autocomplete="address-level2" /></label>
        <label>Number of students
          <select name="Students">
            <option value="">Select</option>
            <option>Up to 300</option>
            <option>300 to 700</option>
            <option>700 to 1500</option>
            <option>More than 1500</option>
          </select>
        </label>
        <label>Mobile number *<input name="Phone" type="tel" inputmode="numeric" maxlength="14" required autocomplete="tel" placeholder="10-digit mobile" /></label>
        <label>E-mail<input name="Email" type="email" maxlength="150" autocomplete="email" /></label>
        <label class="full">Anything you want us to know<textarea name="Message" rows="3" maxlength="1000" placeholder="e.g. we want to start with fees and attendance"></textarea></label>
        <label class="trap" aria-hidden="true">Website<input name="Website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button type="submit" class="btn btn-primary btn-lg enq-btn" id="enqBtn">Request a call back<i class="bx bx-right-arrow-alt"></i></button>
      <p class="enq-msg" id="enqMsg" role="status"></p>
      <p class="enq-note">We use these details only to contact you about the demo.</p>
    </form>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-in">
    <span class="nav-logo"><img src="~/img/brand/ssw-icon.svg" alt="" /><span>SmartSchool<b>Wala</b></span></span>
    <span class="foot-copy">© @year SmartSchoolWala.com · School management software for Indian schools</span>
    <span class="foot-links">
      @if (!string.IsNullOrWhiteSpace(support.Phone)) { <a href="@telLink">@support.Phone</a> }
      <a href="@loginUrl">Login</a>
    </span>
  </div>
</footer>

@* GSAP runs only the hero assembly. If it fails to load, the hero shows the finished laptop
   and everything else is plain HTML; home.js only hides things it is about to animate. *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="~/js/site/home.js" asp-append-version="true"></script>
</body>
</html>
