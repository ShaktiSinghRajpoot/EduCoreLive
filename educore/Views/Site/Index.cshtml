    <article class="reel" data-reel>
      <div class="reel-bars"><i></i><i></i><i></i></div>
      <div class="reel-top"><img src="~/img/brand/ssw-icon.svg" alt="" /><b>smartschoolwala</b><span>Salary</span></div>
      <div class="reel-stage st-pay">
        <div class="slip">
          <b>Payslip · October</b><small>Staff attendance 25 / 26 days</small>
          <p><span>Basic</span><span>₹ 28,000</span></p>
          <p><span>Allowances</span><span>₹ 4,500</span></p>
          <p><span>Deductions</span><span>− ₹ 1,800</span></p>
          <p class="tot"><span>Net pay</span><span>₹ 30,700</span></p>
        </div>
        <div class="notif"><i class="bx bx-bell"></i><div><b>Your payslip is ready</b><small>Open it on your phone</small></div></div>
