          <span class="stop s4"><em>School</em></span>
          <div class="bus"><i class="bx bx-bus-school"></i></div>
        </div>
        <div class="bus-card"><b>Route 3 · 42 riders</b><small>Transport fee added to each child's fees</small></div>
      </div>
      <div class="reel-side"><i class="bx bx-heart"></i><i class="bx bx-message-rounded"></i><i class="bx bx-send"></i></div>
