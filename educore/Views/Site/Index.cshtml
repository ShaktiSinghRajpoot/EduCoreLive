<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="~/js/site/assemble3d.js" asp-append-version="true"></script>
<script src="~/js/site/home.js" asp-append-version="true"></script>
</body>
</html>
