@inject Microsoft.Extensions.Options.IOptions<educore.Services.SupportSettings> SupportOptions
@using educore.Models
@{
    // The homepage of the public website. Head, top bar, demo form and footer are in _SiteLayout.
    Layout = "_SiteLayout";
    ViewData["Title"] = "School ERP Software for Indian Schools | SmartSchoolWala";
    ViewData["Description"] = "SmartSchoolWala is school ERP and school management software for Indian schools: admissions, fee management and receipts, attendance with WhatsApp alerts, exams, staff salary and transport. Book a free demo.";
    ViewData["Path"] = "/";

    var support = SupportOptions.Value;
    string siteUrl = support.PublicUrl(Context.Request);
    string loginUrl = Url.Action("Login", "Account", new { area = "" })!;

    var faqs = new List<SiteFaq>
    {
        new("How much does it cost?", "The price depends on the number of students and the modules your school takes. Book a free demo and we will send a quote for your school."),
        new("Do we need to install anything?", "No. It opens in the browser on any computer or phone. On a phone it can be added to the home screen and used like an app."),
        new("We already have our data in Excel. Do we type it again?", "No. Students, staff and previous dues are imported from Excel. Every row is checked first, and nothing is saved until you confirm."),
        new("Can a teacher see fees or salaries?", "Only if you allow it. Every role has its own permissions: a teacher sees their classes, the accountant sees fees, and salary stays with whoever you choose."),
        new("Is our data safe?", "Each school's data is kept separate from every other school's. Photos and documents open only for your signed-in staff, and every receipt records who collected it."),
        new("Can we start with only fees and add the rest later?", "Yes. Modules are switched on per school, so you can begin with what you need most and add others whenever you are ready.")
    };

    // Structured data (schema.org JSON-LD) for search engines: the site's name, the company
    // and its contact, and the product (the FAQ's own block comes from the _Faq partial).
    // Only facts that are true and shown on the page go in here -- no price and no ratings
    // until there are real ones.
    // System.Text.Json escapes < and >, so the text cannot break out of the <script> tag.
    var org = new Dictionary<string, object>
    {
        ["@type"] = "Organization",
        ["@id"] = siteUrl + "/#organization",
        ["name"] = "SmartSchoolWala",
        ["url"] = siteUrl + "/",
        ["logo"] = siteUrl + "/img/brand/ssw-stacked.png",
        ["contactPoint"] = new Dictionary<string, object>
        {
            ["@type"] = "ContactPoint",
            ["contactType"] = "sales",
            ["telephone"] = support.Phone ?? "",
            ["email"] = support.Email ?? "",
            ["areaServed"] = "IN"
        }
    };
    var webSite = new Dictionary<string, object>
    {
        ["@type"] = "WebSite",
        ["@id"] = siteUrl + "/#website",
        ["name"] = "SmartSchoolWala",
        ["url"] = siteUrl + "/",
        ["publisher"] = new Dictionary<string, object> { ["@id"] = siteUrl + "/#organization" }
    };
    var app = new Dictionary<string, object>
    {
        ["@type"] = "SoftwareApplication",
        ["name"] = "SmartSchoolWala",
        ["url"] = siteUrl + "/",
        ["description"] = ViewData["Description"],
        ["applicationCategory"] = "BusinessApplication",
        ["applicationSubCategory"] = "School ERP and school management software",
        ["operatingSystem"] = "Web browser, Android, iOS",
        ["featureList"] = new[] { "Admissions", "Fee management and receipts", "Attendance with WhatsApp alerts", "Exams and report cards", "Timetable and homework", "Staff and salary", "Transport", "School store", "Accounts", "Certificates and TC" },
        ["provider"] = new Dictionary<string, object> { ["@id"] = siteUrl + "/#organization" }
    };
    string jsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[] { org, webSite, app }
    });
}
@section StructuredData {
    @* written raw: Razor's tag helpers would encode the "+" in the type as &#x2B; *@
    @Html.Raw("<script type=\"application/ld+json\">" + jsonLd + "</script>")
}

<!-- ───────────── Hero ─────────────
