@{
    Layout = null;

    // Contact details shown on the website. PLACEHOLDERS until the owner gives the real
    // ones: put the WhatsApp number with country code and no + or spaces (e.g. 919876543210).
    // While it is empty, "Book a free demo" opens an e-mail instead of WhatsApp.
    const string WhatsApp = "";
    const string PhoneShown = "+91 XXXXX XXXXX";
    const string Email = "hello@smartschoolwala.com";

    string demoText = "Hello SmartSchoolWala, I would like a free demo for my school.\nSchool name: \nCity: \nNumber of students: ";
    string demoLink = WhatsApp.Length > 0
        ? "https://wa.me/" + WhatsApp + "?text=" + Uri.EscapeDataString(demoText)
        : "mailto:" + Email + "?subject=" + Uri.EscapeDataString("Free demo for my school") + "&body=" + Uri.EscapeDataString(demoText);
    string loginUrl = Url.Action("Login", "Account", new { area = "" })!;
    int year = DateTime.Now.Year;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SmartSchoolWala.com | School ERP for Indian schools</title>
    <meta name="description" content="SmartSchoolWala.com runs your whole school in one place: admissions, fees and receipts, attendance with WhatsApp alerts, exams and report cards, timetable, staff and salary, transport and the school store." />
    <meta property="og:title" content="SmartSchoolWala.com | School ERP for Indian schools" />
    <meta property="og:description" content="Admissions, fees, attendance, exams, staff, transport and store: one simple system for your whole school." />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/brand/ssw-stacked.png")" />
    <meta name="theme-color" content="#0B0705" />
    <link rel="icon" type="image/x-icon" href="~/img/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="~/css/site/home.css" asp-append-version="true" />
</head>
<body>

<div class="progress" id="progress"></div>
<div class="cursor-glow" id="cursorGlow"></div>

<!-- ───────────── Top bar ───────────── -->
<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="/" class="nav-logo" aria-label="SmartSchoolWala.com home">
      <img src="~/img/brand/ssw-icon.svg" alt="" /><span>SmartSchool<b>Wala</b></span>
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="#reels">See it work</a>
      <a href="#modules">Modules</a>
      <a href="#why">Why us</a>
      <a href="#switch">Getting started</a>
      <a href="#faq">FAQ</a>
      <a href="@loginUrl" class="nav-login-m">Login</a>
    </nav>
    <div class="nav-cta">
      <a href="@loginUrl" class="btn btn-ghost"><i class="bx bx-lock-alt"></i>Login</a>
      <a href="@demoLink" class="btn btn-primary" target="_blank" rel="noopener">Book a free demo</a>
      <button class="nav-burger" id="navBurger" aria-label="Open menu"><i class="bx bx-menu"></i></button>
    </div>
  </div>
</header>

<!-- ───────────── Hero: the school in pieces, put together as you scroll ─────────────
     home.js draws a 3D desk on the canvas. At the top everything (books, bag, bus, coins,
     registers, laptop keys, dashboard tiles) floats around in pieces; scrolling flies each
     piece to its place until the laptop is running SmartSchoolWala on a tidy desk.
     The section is tall (set in CSS) and the stage sticks to the screen meanwhile.
     Without WebGL the stage is a normal hero showing only the last caption. -->
<section class="build" id="build">
  <div class="build-stage">
    <canvas class="build-canvas" id="buildCanvas" aria-hidden="true"></canvas>

    <div class="cap cap-1" data-from="0" data-to="0.2">
      <span class="pill"><span class="dot"></span>School ERP made for Indian schools</span>
      <h2 class="cap-big">Registers. Receipts.<br />Fee slips. Report cards.<br /><span class="grad">All over the place?</span></h2>
      <p class="cap-hint"><span class="mouse"><span></span></span>Scroll to put your school together</p>
    </div>
    <div class="cap cap-2" data-from="0.24" data-to="0.48">
      <h2 class="cap-mid">Every piece of your school&hellip;</h2>
    </div>
    <div class="cap cap-3" data-from="0.52" data-to="0.76">
      <h2 class="cap-mid">&hellip;snaps into <span class="grad">one system.</span></h2>
    </div>

    <div class="cap cap-final" data-from="0.8" data-to="9">
      <span class="pill"><span class="dot"></span>SmartSchoolWala.com</span>
      <h1 class="hero-h">Your whole school.<br /><span class="grad">One smart system.</span></h1>
      <p class="lead">Admissions, fees and receipts, attendance with WhatsApp alerts, exams and report cards, staff salary, transport and the school store. On the computer and on the phone.</p>
      <div class="hero-btns">
        <a href="@demoLink" class="btn btn-primary btn-lg magnet" target="_blank" rel="noopener">Book a free demo<i class="bx bx-right-arrow-alt"></i></a>
        <a href="#reels" class="btn btn-glass btn-lg"><i class="bx bx-play-circle"></i>See it work</a>
      </div>
      <ul class="hero-ticks">
        <li><i class="bx bx-check"></i>Your data brought in from Excel</li>
        <li><i class="bx bx-check"></i>Staff trained by us</li>
        <li><i class="bx bx-check"></i>Works on any phone</li>
      </ul>
    </div>
  </div>
</section>

<!-- ───────────── Marquee bands ───────────── -->
<div class="bands" aria-hidden="true">
  <div class="band band-1"><div class="band-track">
    @for (int i = 0; i < 2; i++)
    {
      <span>Admissions</span><i>✦</i><span>Fees &amp; receipts</span><i>✦</i><span>Attendance</span><i>✦</i><span>Exams</span><i>✦</i><span>Timetable</span><i>✦</i><span>Salary</span><i>✦</i><span>Transport</span><i>✦</i><span>Store</span><i>✦</i>
    }
  </div></div>
  <div class="band band-2"><div class="band-track">
    @for (int i = 0; i < 2; i++)
    {
      <span>WhatsApp alerts</span><i>●</i><span>Report cards</span><i>●</i><span>Thermal receipts</span><i>●</i><span>Payslips</span><i>●</i><span>TC &amp; certificates</span><i>●</i><span>Works on phone</span><i>●</i>
    }
  </div></div>
</div>

<!-- ───────────── Reels (pinned sideways scroll on a computer, swipe on a phone) ───────────── -->
<section class="reels" id="reels">
  <div class="reels-head wrap">
    <span class="kicker">See it work</span>
    <h2>Your school, <span class="grad">in reels</span></h2>
    <p>Scroll on. Each one is a real job your office does every day.</p>
  </div>
  <div class="reels-track" id="reelsTrack">

    <article class="reel" data-reel>
      <div class="reel-bars"><i></i><i></i><i></i></div>
      <div class="reel-top"><img src="~/img/brand/ssw-icon.svg" alt="" /><b>smartschoolwala</b><span>Attendance</span></div>
      <div class="reel-stage st-att">
        <div class="att-head"><b>Class 5-A</b><small>Mon · Period 1</small></div>
        <div class="att-row"><span>Aarav Sharma</span><em class="p">P</em></div>
        <div class="att-row"><span>Diya Verma</span><em class="p">P</em></div>
        <div class="att-row"><span>Kabir Singh</span><em class="p">P</em></div>
        <div class="att-row"><span>Meera Joshi</span><em class="p">P</em></div>
        <div class="att-row"><span>Rohan Gupta</span><em class="a">A</em></div>
        <div class="wa-msg"><i class="bx bxl-whatsapp"></i><div><b>Rohan was absent today</b><small>Sent to parent · 9:05 AM</small></div></div>
      </div>
      <div class="reel-side"><i class="bx bx-heart"></i><i class="bx bx-message-rounded"></i><i class="bx bx-send"></i></div>
      <div class="reel-cap"><b>Attendance in 30 seconds</b><p>Teachers mark it on the phone. Parents of absent children get WhatsApp.</p></div>
    </article>

    <article class="reel" data-reel>
      <div class="reel-bars"><i></i><i></i><i></i></div>
      <div class="reel-top"><img src="~/img/brand/ssw-icon.svg" alt="" /><b>smartschoolwala</b><span>Fees</span></div>
      <div class="reel-stage st-fee">
        <div class="printer"></div>
        <div class="rcpt">
          <b>Receipt #2418</b><small>Class 5-A · Oct fees</small>
          <p><span>Tuition</span><span>₹ 6,500</span></p>
          <p><span>Transport</span><span>₹ 1,200</span></p>
          <p><span>Activity</span><span>₹ 500</span></p>
          <p class="tot"><span>Total</span><span>₹ 8,200</span></p>
          <div class="stamp">PAID</div>
        </div>
      </div>
      <div class="reel-side"><i class="bx bx-heart"></i><i class="bx bx-message-rounded"></i><i class="bx bx-send"></i></div>
      <div class="reel-cap"><b>Fee collected. Receipt printed.</b><p>A4, A5 or thermal. Every receipt numbered, the day close adds up.</p></div>
    </article>

    <article class="reel" data-reel>
      <div class="reel-bars"><i></i><i></i><i></i></div>
      <div class="reel-top"><img src="~/img/brand/ssw-icon.svg" alt="" /><b>smartschoolwala</b><span>Exams</span></div>
      <div class="reel-stage st-exam">
        <div class="rc-head"><b>Report card</b><small>Half yearly · Class 10</small></div>
        <div class="sub"><span>Maths</span><i style="--w:92%"></i></div>
        <div class="sub"><span>Science</span><i style="--w:86%"></i></div>
        <div class="sub"><span>English</span><i style="--w:78%"></i></div>
        <div class="sub"><span>Hindi</span><i style="--w:88%"></i></div>
        <div class="sub"><span>Social</span><i style="--w:81%"></i></div>
        <div class="grade">A+</div>
      </div>
      <div class="reel-side"><i class="bx bx-heart"></i><i class="bx bx-message-rounded"></i><i class="bx bx-send"></i></div>
      <div class="reel-cap"><b>Marks in. Report cards out.</b><p>Teachers enter marks, grades and ranks are worked out, cards print.</p></div>
    </article>

    <article class="reel" data-reel>
      <div class="reel-bars"><i></i><i></i><i></i></div>
      <div class="reel-top"><img src="~/img/brand/ssw-icon.svg" alt="" /><b>smartschoolwala</b><span>Transport</span></div>
