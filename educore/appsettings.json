
{
  // SECURITY: no DB credentials live in this file (it is committed to git).
  //  - Local dev: set DefaultConnection in appsettings.Development.json (git-ignored).
  //  - Production: set the environment variable  ConnectionStrings__DefaultConnection
  //    (double underscore maps to ConnectionStrings:DefaultConnection).
  "Security": {
    // Flip to true ONLY when the site is served over HTTPS (valid TLS cert / reverse proxy).
    // When true: auth + session cookies become Secure-only, HTTPS redirection + HSTS turn on.
    // Leave false for plain-HTTP hosting, otherwise users cannot log in (Secure cookies are dropped over HTTP).
    "RequireHttps": false
  },
  // Purpose string for IDataProtector (see Program.cs / AppSettings.cs). Not a secret —
  // it is a label, not a key — but it must never change once values have been protected.
  "AppSettings": {
    "ProtectorValue": "f18f65aa-1ac1-4ac9-992f-b1295f0eaca4"
  },
  // Where the Data Protection key ring is written. Relative paths resolve against the
  // content root. Local dev keeps keys in App_Data/keys (git-ignored). In production set
  // DataProtection__KeyPath to a MOUNTED VOLUME path (e.g. /app/keys) — a plain container
  // path is wiped on every deploy, which silently signs every user out.
  "DataProtection": {
    "KeyPath": "App_Data/keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Support contacts shown on Account/SchoolUnavailable — the page a user reaches
  // when their password is correct but the school's status (Inactive / Suspended /
  // Closed / Pending) blocks sign-in. Public details, not secrets, so they belong
  // here. Override per environment with Support__* env vars.
  "Support": {
    "Email": "support@educore.com",
    "Phone": "+91 98765 43210",
    "Hours": "Monday to Saturday, 9:00 AM - 6:00 PM IST",
    "Website": ""
  },
  // SMTP for transactional email (new-school-admin welcome credentials).
  // SECRET-FREE here. Set Username/Password (and override Host/From) in
  // appsettings.Development.json (git-ignored) or Email__* env vars in production.
  // Leave Enabled=false until SMTP creds are configured — sends are then logged and skipped.
  "Email": {
    "Enabled": true,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "SmartSchoolWala.com"
  },
  // Multi-channel notifications. Email is configured above. SMS/WhatsApp stay disabled
  // until a provider is wired — while disabled the message (e.g. an OTP) is written to the
  // app log so the flow is testable for free. Put provider ApiKey/SenderId in
  // appsettings.Development.json or Notifications__* env vars (never commit secrets here).
  "Notifications": {
    "Sms": {
      "Enabled": false,
      "Provider": "",
      "ApiKey": "",
      "SenderId": ""
    },
    "WhatsApp": {
      "Enabled": false,
      "Provider": "",
      "ApiKey": "",
      "FromNumber": ""
    }
  },
  "AllowedHosts": "*"
}